          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}} ơi, làm ơn nói với anh là em vừa KHÔNG gõ đáp lại đường ống đi!!",
