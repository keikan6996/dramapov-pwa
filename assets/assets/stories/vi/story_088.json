          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Đèn pha từ một chiếc ca-nô rọi xuyên màn sương cảng, chiếu thẳng vào người bạn bên cột cầu tàu.",
