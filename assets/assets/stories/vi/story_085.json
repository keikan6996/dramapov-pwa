          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "ghost",
          "text": "Cảnh báo: một tiếp viên trên chuyến bay là người của hắn. Đừng tin bất kỳ ai mặc đồng phục.",
