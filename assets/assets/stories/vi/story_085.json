          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "Đèn khoang khách đột ngột chuyển sang màu hổ phách. Gã ghế 14A tháo dây an toàn rồi đứng phắt dậy—chắn ngang lối đi tới nhà vệ sinh.",
