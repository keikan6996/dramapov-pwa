          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Tiếp viên trưởng Elena dừng ngay cạnh hàng ghế, liếc nhìn chiếc điện thoại đen:",
