          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Cô là người phụ nữ va vào tôi ở cổng 19! Tại sao cô lại nhét thứ này vào túi tôi?!",
          "timestamp_label": "23:14",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "ghost",
          "duration_sec": 8,
          "transcript": "[tiếng động cơ phản lực, thì thầm] Gã ngồi ghế 14A đang mang sổ cái vũ khí sinh học bị đánh cắp. Hắn nhận ra tôi ở cửa an ninh, nên tôi buộc phải chuyển khóa giải mã cho hành khách sạch—là bạn.",
