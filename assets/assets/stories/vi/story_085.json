        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ghost",
          "text": "Cô ta chính là nội gián! Khóa trái cửa trong nhà vệ sinh 2B rồi chờ tín hiệu—tôi đang chèn tín hiệu khẩn vào buồng lái!",
