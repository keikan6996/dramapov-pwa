      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "ĐỘ CAO 10.000M · Chuyến bay 408 đi Zurich. Đèn thắt dây an toàn vừa tắt. Trong túi xách của bạn, một chiếc điện thoại gập lạ hoắc rung lên qua sóng vệ tinh.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ghost",
          "text": "Đừng giao chiếc điện thoại này cho tiếp viên, {{player_name}}. Nhìn sang ghế 14A đi.",
