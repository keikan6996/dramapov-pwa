          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "seat4b",
          "text": "Để lại cái áo khoác trên ghế đi, {{player_name}}. Bạn không muốn biết ai đã trả tiền gắn thiết bị đó đâu.",
