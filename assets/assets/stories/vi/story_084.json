          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "seat4b",
          "text": "Cái đó chỉ là mồi nhử thôi, {{player_name}}. Kiểm tra đế giày trái đi.",
