          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "liam",
          "text": "Kiểm tra ngay túi áo khoác với khóa ba lô đi! Đừng xuống ở ga vắng người nhé, {{player_name}}.",
