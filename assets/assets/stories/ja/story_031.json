            {
              "option_id": "e1_opt_vip",
              "label": "スマホのカメラで男の顔をズームする",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "11Dのベランダをズームしてみる……",
              "next_node_id": "e1_n08_vip"
