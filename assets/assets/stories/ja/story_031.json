        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "リビングが闇に包まれます。5秒後、中庭の向こう側のベランダの明かりもぷつりと消えました。",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
