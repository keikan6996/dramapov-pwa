      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前2:28 · 明るいキッチンの明かりの下で水を注いでいます。狭い中庭の向かい側にはB棟がそびえています。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "葵、キッチンの明かりから離れて！11Dのベランダにいる背の高い男が、40分間ずっとあんたを真っすぐ見つめてる！",
          "timestamp_label": "午前2:28",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "待って、見えた……雨も降ってないのに灰色のレインコートを着てる。まったく動かないよ。",
          "timestamp_label": "午前2:29",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "素敵なキッチンだね。ベランダの鍵、開いてるよ。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "今管理会社に電話した！葵、11D号室は3年間ずっと封鎖されてて空き部屋なんだって！！",
          "timestamp_label": "午前2:30",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[棟の間を吹き抜ける風の音、かすかなカメラのシャッター音] ……ブラインドを閉めないで、葵。もうすぐそちらへ行くから……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "11Dの影がゆっくりと両腕を上げます――まさにあなたがスマホを持っているのと同じ形を真似しています。",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "ブラインドを閉めて明かりを消す",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "ブラインド閉めた、電気も消した！",
              "next_node_id": "e1_n08_free"
