          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "着信を拒否しました。その瞬間、玄関ドアの隙間の下で廊下の人感センサーライトが点灯します。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "彼は渡ってきた",
          "teaser_text": "エピソード2：玄関ドアのすぐ外で影が立ち止まります――そして、ベランダの鍵がカチリと鳴りました。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
