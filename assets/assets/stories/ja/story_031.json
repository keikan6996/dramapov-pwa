        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "秘密解放：彼には目がありません――キッチンの明かりを反射する2つの暗いカメラレンズと、あなたの階のカードキーだけでした。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "11Dのベランダから消えた！！待って――そっちの棟のエレベーター表示が今、11階へ向かって点灯した！",
          "timestamp_label": "午前2:32",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
