        },
        {
          "id": "e3_n07",
          "type": "voice_note",
          "sender_id": "julian",
          "duration_sec": 11,
          "transcript": "[祭壇マイクのそばでささやく声] 60秒だけ俺を信じてくれ。俺のスマホの銀行口座番号を見て――リアムの海外信託口座だ。",
          "audio_asset": null,
