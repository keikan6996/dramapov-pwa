          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "liam",
          "text": "これで終わりだと思うなよ？お祖父様の信託委員会は今夜午前0時に開かれるんだ！",
          "timestamp_label": "午後10:24",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n12"
        },
        {
          "id": "e3_n12",
          "type": "text",
          "sender_id": "julian",
          "text": "なら午前0時に会おう、弟よ――俺たちの夫婦としてな。",
