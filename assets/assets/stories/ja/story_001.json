          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n05"
        },
        {
          "id": "e3_n05",
          "type": "unsent_message",
          "sender_id": "julian",
          "text": "昨夜、元の婚前契約書は破り捨てた。君に本当に恋をしてしまったから。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
