              "next_node_id": "e1_n10_vip"
            }
          ]
        },
        {
          "id": "e1_n10_free",
          "type": "narrator",
          "text": "車両甲板は潮しぶきで滑りやすくなっています。ニーナの大型車の横には、落とされたばかりのフェリー乗組員のカードキーがまだ温もりを残して落ちていました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n10_vip",
          "type": "narrator",
          "text": "バックパックの手がかり：裏地の中には「片道のみ」のフェリー乗船券と――コールが署名した借用書が入っていました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n11_merge",
          "type": "text",
          "sender_id": "nina",
          "text": "{{player_name}}、今船長がエンジンを止めた。サーチライトが海面を照らして捜索してる！",
          "timestamp_label": "午前12:31",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12_end"
        },
        {
          "id": "e1_n12_end",
          "type": "cliffhanger",
          "headline": "貨物バンの中で何かがノックした",
          "teaser_text": "エピソード2：イーサンは海に落ちてなどいません――車両甲板に停まったバンの中に閉じ込められているのです。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
