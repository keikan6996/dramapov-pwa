        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "disp",
          "text": "第4部隊指令室：{{player_name}}、盗まれた救急車に緊急手配を出しましたが——最寄りのパトカーでもあなたのアパートまでまだ12分かかります！",
          "timestamp_label": "午前2:24",
