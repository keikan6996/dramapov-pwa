          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "unsent_message",
          "sender_id": "sister",
          "text": "しまった……お母さんの信託が締まるまでソフィアのことは絶対に言わないって、お父さんと約束したのに！",
