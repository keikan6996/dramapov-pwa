          "reveal_ms": 1900,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n05"
        },
        {
          "id": "n05",
          "type": "text",
          "sender_id": "sister",
          "text": "そのスマホを置きなさい、{{player_name}}！お父さんが集中治療室にいる間に、お母さんに余計なストレスをかけないようにしよう！",
