        {
          "id": "e3_n07_free",
          "type": "narrator",
          "text": "警察官たちが知財詐欺容疑でチャドに手錠をかける一方、レイチェルは誰もいない廊下に惨めに立ち尽くしました。",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "rachel_ex",
          "text": "{{player_name}}、お願い！あなたがいつも黙々と働いてばかりだったから離れただけなの――タイタン・ベンチャーズのオーナーだなんて知らなかったのよ！",
          "timestamp_label": "午前9:18",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n09_merge"
