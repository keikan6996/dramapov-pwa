          "timestamp_label": "午前9:18",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "narrator",
          "text": "チャドとレイチェルの背後でガラスの扉がカチリと閉まり――過去との縁が永遠に断ち切られました。",
