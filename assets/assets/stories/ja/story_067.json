          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "unsent_message",
          "sender_id": "fiance",
          "text": "ポーカーの借金を返す担保に使うために、ほんの数ヶ月だけサインさせてくれよ！",
