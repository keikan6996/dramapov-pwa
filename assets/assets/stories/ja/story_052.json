          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "marcus",
          "text": "私はダウンタウンのチャリティー晩餐会に出席している。法務部が確認する前にそのクリップを公開してはならない。",
          "timestamp_label": "午前12:42",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "unsent_message",
          "sender_id": "claire",
          "text": "MayaはMarcusが揉み消すためにポッドキャストへ出資していたことに気づいた――",
