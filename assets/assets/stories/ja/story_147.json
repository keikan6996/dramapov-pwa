            {
              "option_id": "opt_story_147_e1_free",
              "label": "事故ファイルについてレイエス刑事に聞く",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "レイエス刑事、リアムの亡くなった番号から二人の秘密を知っている何者かが連絡してきています！",
              "next_node_id": "e1_n07a"
            },
