      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前1:14 · リアムの車が国道19号線から転落してから、ちょうど1分1秒違わず6か月目。アーカイブ済みの彼のチャット吹き出しが脈打ち始めます。「入力中…」",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "fiance",
          "text": "翠……起きているか？パニックになるな。夜明け前に19マイル標識のところへ行かなきゃいけないんだ。",
