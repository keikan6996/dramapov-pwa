          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "誰がリアムのスマホを盗んだの！？悪趣味すぎる――この番号を警察に通報するから！",
