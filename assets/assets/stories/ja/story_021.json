    {
      "episode_number": 1,
      "title": "点灯した13番ボタン",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前2時14分 · エレベーターがガクンと停止します。赤い発光ランプ表示が12を通り過ぎて『13』で固定されました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}さん、モニターでB号機が止まったのが見えました。なぜ保守用上書きボタンを押したんですか？",
          "timestamp_label": "午前2:14",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "何も触っていません！扉が勝手に開いて、真っ暗な廊下に出たんです。誰かがこちらに手を振っています。",
          "timestamp_label": "午前2:15",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "よし。外へ出てきてくれれば、ようやく俺が出られる。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "かごの中に留まってください！絶対に敷居をまたいではいけません。今すぐ『閉』ボタンを押しなさい。",
          "timestamp_label": "午前2:15",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[蛍光灯の唸り音、ゆっくりとした足音] ……何を見つめているの、{{player_name}}？もうあなたもこの階の住人なんだから……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "扉が閉まりません。冷たい空気がエレベーターの中に流れ込んできます。",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "赤い非常通報ベルを叩き押す",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "非常ベルを連打します！",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "13階の奥へスマホのライトを向ける",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "懐中電灯をつけます……",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "ベルが鳴り響きます――昇降路の中ではなく、暗い廊下に立つその人影のすぐ背後で。",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "秘密解放：13階のすべての部屋のドアに真鍮の表札が掛かっており――そのすべてに『あなたの名前』が彫られていました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "待ってください……警備デスクの電話が勝手に鳴っています。ロビーのカメラ映像を見てください。",
          "timestamp_label": "午前2:17",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "ロビー警備デスク",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "取り乱した声が息を切らして叫びます。『ヘクターです！20分前に誰かにスマホを盗まれたんです――あなたは今誰とやり取りしてるんですか？！』",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "着信を拒否すると、即座に留守電が文字起こしされます。『ヘクターです――私はロビーに閉じ込められています！あなたにメッセージを送っているのは私じゃありません！』",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "ではメッセージを送っていたのは誰？",
          "teaser_text": "エピソード2：13階の人影が光るスマホを掲げ――微笑みます。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
