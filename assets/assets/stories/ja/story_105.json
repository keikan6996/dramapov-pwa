    {
      "episode_number": 1,
      "title": "仕組まれた窃盗",
      "start_node_id": "e1_n01",
      "default_ambient": "family_drama",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午後8:00 · ブラックウッド邸。亡き姉の6歳の息子を守るため住み込みシッターとして潜入して3週間後、ヴィヴィアンがあなたの部屋へ怒鳴り込んできました。",
          "style": "banner",
          "sfx": "knock",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "vivian",
          "text": "このシッターのスーツケースを調べなさい、ギデオン！亡き義娘の5万ドルの家宝の指輪が私の化粧台から消えたのよ！",
          "timestamp_label": "午後8:00",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "今日一日、あなたの寝室には一歩も近づいていません、ヴィヴィアン奥様。ずっとレオ坊ちゃまの家庭教師をしておりました。",
          "timestamp_label": "午後8:00",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "butler",
          "text": "見つかりました、奥様！彼女のコートのポケットの奥に押し込まれておりました！",
          "timestamp_label": "午後8:02",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "vivian",
          "text": "完璧ね——彼女がレオの本当の信託書類を見つける前に警察に連行させるため、奥にしっかり仕込んでおきなさい。",
          "unsent_placeholder": "ヴィヴィアンがメッセージの送信を取り消しました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "ヴィヴィアンが幼いレオの目の前であなたに平手打ちを食らわせようと手を振り上げました：",
          "options": [
            {
              "option_id": "opt_story_105_e1_free",
              "label": "手首を掴み火災報知器を指差す",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "気をつけて、ヴィヴィアン。先週私が子供部屋の警備設備をアップグレードしたことをお忘れのようね。",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_105_e1_vip",
              "label": "リアムに合図して屋敷の防犯カメラログを抜く",
              "cost_type": "vip_rewarded",
              "badge_text": "シークレット · 広告を見る",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "あなたはしっかりと彼女の手首を掴み返します。ドア枠の上で点滅する小さな真紅のレンズに気づいたギデオンが凍りつきました。",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "vivian",
          "text": "使用人の分際でよくも私に触れたわね！その指輪には私の一族の紋章が入ってるのよ——警察を呼びなさい！",
          "timestamp_label": "午後8:02",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "リアムが即座に廊下の映像をあなたのスマホへ送信します：10分前にギデオンがあなたのコートに指輪を滑り込ませる瞬間が映っていました！",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "detective",
          "text": "高画質映像で押さえましたよ、琴音。ブラックウッド邸の真の所有者が誰か明かす準備はいいですか？",
          "timestamp_label": "午後8:02",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "印刷された立ち退き通知書を振りかざしてヴィヴィアンが嘲笑う中、幼いレオがあなたの足にぎゅっとしがみつきました。",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "vivian",
          "text": "ボロ切れをまとめなさい！明日裁判所が「私の」息子をブラックウッドの単独相続人に指名する——そしてレオは寄宿学校行きよ！",
          "timestamp_label": "午後8:05",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "盗まれた紋章",
          "teaser_text": "ヴィヴィアンは一文無しのシッターを追い出しているつもりでいる——あなたがマスター権利証を持つ姉の億万長者の双子の妹とは知らずに。",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
