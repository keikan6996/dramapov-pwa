          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "mrk",
          "text": "生放送してやがるのか？！エンジンを止めろ——正体が割れた！",
