          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "viewer",
          "text": "いい青いパーカーだね、律。今12,418人が君のデッドボルト施錠を見てたよ。",
