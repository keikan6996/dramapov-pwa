          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "viewer",
          "text": "ノートパソコンじゃない。クローゼットの一番上の棚を見てみな——赤い発光ランプが点滅してるだろ。",
          "unsent_placeholder": "視聴者 #001がメッセージの送信を取り消しました",
