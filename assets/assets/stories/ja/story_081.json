          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "viewer",
          "duration_sec": 7,
          "transcript": "[くぐもった息遣い、木製ハンガーの触れ合う音] まだ立ち上がるなよ、律。視聴者が君のリアクションを見るために500ドル投げ銭したばかりなんだ。",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "すぐ60センチ後ろのクローゼットのルーバーが軋みました。素早く動いてください：",
          "options": [
            {
              "option_id": "opt_081_e1_free",
              "label": "冷静を装い密かにキラへメッセージを送る",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "キラ、絶対に電話しないで。誰かが私のクローゼットから私を生配信してる。",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_081_e1_vip",
              "label": "クローゼットの取っ手に椅子を挟み込む",
              "cost_type": "vip_rewarded",
