      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "n01",
          "type": "narrator",
          "text": "午後12:08 · 祖母の客間。ビロードのロープに囲まれた20人の裕福なコレクターたち。木槌が出品番号14の上で宙に止まります。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n02"
        },
        {
          "id": "n02",
          "type": "text",
          "sender_id": "aunt",
          "text": "19万5000ドルで落札！待って――誰が{{player_name}}を正門から通したの！？",
          "timestamp_label": "午後12:08",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n03"
        },
        {
          "id": "n03",
          "type": "text",
          "sender_id": "player",
          "text": "取引を凍結してください！出品番号14を購入する方は、記録上証明された盗品を買い取ることになります。",
          "timestamp_label": "午後12:09",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "unsent_message",
          "sender_id": "cousin",
          "text": "ママ、最前列の買い手が小切手を引っ込めようとしてる！！",
