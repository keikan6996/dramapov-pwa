          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "n08_vip"
        },
        {
          "id": "n08_vip",
          "type": "text",
          "sender_id": "aunt",
          "text": "嘘……嘘よ！あの人が屋敷丸ごとをあんたに遺したっていうの！？私たちに行く場所がなくなっちゃうじゃない！",
          "timestamp_label": "午後12:15",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n09_merge"
