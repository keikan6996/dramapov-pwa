        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "cousin",
          "text": "本当に今地下室の床をぶち壊してる最中だぞ！！",
          "timestamp_label": "午後6:16",
          "typing_delay_ms": 600,
          "sfx": "gasp",
