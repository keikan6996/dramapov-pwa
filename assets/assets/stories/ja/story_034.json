      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "午前12:56 · 遠くでパトカーのサイレンが鳴り響きます。ドアの外では廊下のタイル一面に水が溜まっていました。",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}さん、タンクにスマホを落としてしまって――警備員さんの携帯を使ってます！ドアは開けずに警察を待ってください！",
          "timestamp_label": "午前12:56",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "ゲイブさん、天井から漏れてくる水が氷みたいに冷たくて――誰かがドアを優しくノックしてるの。",
          "timestamp_label": "午前12:57",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[滴る水音、かすかなすすり泣き] ……あいつが私を突き落として蓋にボルトを締めたの……警察に伝えて、{{player_name}}……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "屋上タンクの唯一の鍵を持っているのは建物の管理人だ。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "text",
          "sender_id": "ally",
          "text": "待って――管理人が南京錠を持って屋上の階段へ走っていった！警察が来る前にタンクを締め切るつもりだ！",
          "timestamp_label": "午前12:59",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "choice",
          "prompt": "ドアのノックが止みました。重いブーツの足音が屋上階段を駆け上がっていきます。",
          "options": [
            {
              "option_id": "e2_opt_free",
              "label": "到着した警察に屋上を指し示す",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "警察官を屋上へ案内する！",
              "next_node_id": "e2_n08_free"
            },
            {
              "option_id": "e2_opt_vip",
              "label": "階段室から管理人を録画する",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "今屋上ドアの前を撮影してる！",
              "next_node_id": "e2_n08_vip"
            }
          ]
        },
        {
          "id": "e2_n08_free",
          "type": "narrator",
          "text": "あなたは警察官たちを真っすぐ階段の上へ案内しました――スチール製の貯水槽の蓋にボルトを締めようとしていた管理人を現行犯で取り押さえました。",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n08_vip",
          "type": "narrator",
          "text": "秘密解放：録画を再生すると、管理人の背後でタンクから濡れた白い手が伸び――警察が手錠をかけるまで彼を押さえつけていたのが映っていました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "赤と青の光が屋上を照らします。貯水槽の水が抜かれると、あなたの部屋の蛇口からは再び透き通った水が流れるようになりました。",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "5B号室 (解約済み)",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n11_ans",
          "on_decline_node_id": "e2_n11_dec"
        },
        {
          "id": "e2_n11_ans",
          "type": "narrator",
          "text": "優しく安堵したような吐息が囁きます。「ありがとう、{{player_name}}さん。もう寒くないわ」",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n11_dec",
          "type": "narrator",
          "text": "着信を拒否しました。曇ったバスルームの鏡に、整った2つの文字が浮かび上がり、消えました。「ありがとう」",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n12",
          "type": "cliffhanger",
          "headline": "浮かび上がった真実",
          "teaser_text": "シーズンフィナーレ · 心霊現象の中には呪いではなく、助けを求める叫びもあるのです。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
