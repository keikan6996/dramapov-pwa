          "haptic": "medium",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "stella",
          "text": "嘘でしょ！！{{player_name}}、あなたが何者かなんて知らなかったの！デイモンが貧乏なウェイトレスだって言ったから！今すぐこいつに謝らせるわ！！",
          "timestamp_label": "午後7:42",
