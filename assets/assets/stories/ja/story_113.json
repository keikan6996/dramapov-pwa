      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "午後7:42・うっかりスピーカー通話になったステラのスマホから、怯えきった父親の声がダイニング全体に鳴り響きました！",
          "style": "banner",
          "sfx": "gasp",
