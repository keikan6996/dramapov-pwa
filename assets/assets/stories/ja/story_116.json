          "sfx": "gasp",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "kevin",
          "text": "か、会長{{player_name}}様！？私は物流部の者でして――てっきり自分のボーナスカードだと思い込んでいたんです！！",
          "timestamp_label": "午後9:10",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n03"
