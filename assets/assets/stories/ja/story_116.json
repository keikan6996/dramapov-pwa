        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "amber",
          "text": "ちょっと待って！！物流部ですって！？ケヴィン、私にはスカイクラウンの社長だって言ってたじゃない！！",
          "timestamp_label": "午後9:10",
          "typing_delay_ms": 600,
