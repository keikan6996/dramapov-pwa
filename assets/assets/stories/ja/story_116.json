  "episodes": [
    {
      "episode_number": 1,
      "title": "1A席",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午後9:00・スカイクラウン航空001便。新しいジェット格納庫の視察を終えて疲れ切ったあなたが、色褪せたグレーのパーカー姿で1A席に乗り込んだその時――アンバーがブランドバッグをあなたの肘掛けに叩きつけました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "amber",
          "text": "ちょっと、古着パーカーのお姉さん――エコノミー席に引っ込みなさいよ！私の彼氏のケヴィンはスカイクラウン航空の役員なんだから、1A席は私が座るの！",
          "timestamp_label": "午後9:00",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "スカイクラウン航空の役員ですって？おかしいわね――うちの会社の副社長クラスは全員顔を知っているけれど、ケヴィンなんて聞いたこともないわ。",
          "timestamp_label": "午後9:00",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "kevin",
          "text": "口の利き方に気をつけろ！このフライトには俺の法人ブラックカードで1万4000ドル払ってるんだ！客室乗務員――俺が取締役会に電話する前に、このパーカー女を叩き出せ！",
          "timestamp_label": "午後9:02",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "kevin",
          "text": "部長が東京出張中に購買課の引き出しに法人出張カードを置き忘れてくれて助かったぜ……",
          "unsent_placeholder": "ケヴィンがメッセージの送信を取り消しました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "アンバーがあなたを1A席から引きずり出そうとパーカーの袖を掴みました：",
          "options": [
            {
              "option_id": "opt_story_116_e1_free",
              "label": "落ち着いて操縦室直通チャイムを押す",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "触らないで――それに取締役会に電話する手間も要らないわ。機長に直接聞いてみましょう。",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_116_e1_vip",
              "label": "タブレットでケヴィンの法人カードを照会する",
              "cost_type": "vip_rewarded",
              "badge_text": "シークレット · 広告を見る",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "あなたが隠しボタンの会長専用チャイムを2回押すと、コックピットのドアが即座に解錠されました。",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "amber",
          "text": "ハハッ！機長が役員を差し置いて無名のパーカー女の味方するとでも思ってるの！？",
          "timestamp_label": "午後9:02",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "あなたのスカイクラウン財務アプリが真っ赤に点滅しました――ケヴィンは役員などではなく、上司から「盗んだ」カードを使っている下級購買事務員だったのです！",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "captain",
          "text": "{{player_name}}会長、確認いたしました！その法人カードは20分前、東京から盗難届が出されたものです！",
          "timestamp_label": "午後9:02",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "主席操縦士のヴァンス機長がファーストクラスの通路をまっすぐ歩いてきて――あなたの色褪せたグレーのパーカーに向かってキビキビと敬礼しました！",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "captain",
          "text": "こんばんは、{{player_name}}会長！この乗客はスカイクラウン航空のオーナー様にご迷惑をおかけしておりますか？",
          "timestamp_label": "午後9:05",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "離陸許可――ただしお前は別",
          "teaser_text": "盗んだ会社のカードを使って自分の億万長者会長を1A席から追い出そうとしたと悟り、ケヴィンは顎が外れんばかりに驚愕しました。",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
