          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n05"
        },
        {
          "id": "n05",
          "type": "text",
          "sender_id": "husband",
          "text": "ベイビー、母さんが過呼吸になってるんだ。誤解だよ――クロエはただの家族ぐるみの事業投資なんだ！",
