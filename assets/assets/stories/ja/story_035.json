  "episodes": [
    {
      "episode_number": 1,
      "title": "招かれざる客",
      "start_node_id": "e1_n01",
      "default_ambient": "family_drama",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前12:01 · 鬼月の初夜。家族チャットのシステム通知：「000番 が招待リンクから参加しました」",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "誰も 000番 を削除するんじゃないよ！！楓、今すぐカーテンを閉めなさい！グループから追い出したら、表の門を叩きに来るからね！",
          "timestamp_label": "午前12:01",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "おばあちゃん、ただのスパムボットだよ……待って、どうして庭から撮った本家の写真を持ってるの！？",
          "timestamp_label": "午前12:02",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "仏壇にわしのご飯茶碗を供え忘れたな。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "なんということだい……おじいちゃんの絶縁していた弟さんだよ！今夜の命日のお線香を忘れてしまっていたんだね！",
          "timestamp_label": "午前12:03",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[線香の爆ぜる音、鉄門をガタガタ揺らす音] ……中に入れてくれ、楓……わしははるばる歩いて帰ってきたんだぞ……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "いとこがグループチャットで「メンバーを削除」をタップしました。表の鉄門が激しい音を立てて閉まります。",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "仏壇で3本のお線香に火をつける",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "今すぐ仏壇にお線香を上げるね！",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "グループチャットの管理ログを確認する",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "誰が 000番 を招待したか調べてみる……",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "マッチが擦られます――すると3本の線香の火がすべて不吉な前兆のように下向きに丸まっていきました。",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "秘密解放：招待リンクは午後11:59にあなた自身のスマホから生成されていました――画面がロックされていた間に。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "000番 が勝手にグループに再参加したよ！しかも今、グループ名を「門を開けろ」に変えた！",
          "timestamp_label": "午前12:05",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "000番 (グループビデオ通話)",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "カメラにはあなたの家の暗い裏庭が映っています――そしてあなたの背後にあるガラス戸へと着実に近づいてきます。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "着信を拒否しました。その瞬間、階下のすべての電球がぼんやりとしたオレンジ色に暗くなりました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "それは庭にいる",
          "teaser_text": "エピソード2：濡れた灰の足跡が、先祖を祀る部屋のすぐ外で止まっています。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "忘れられた席",
      "start_node_id": "e2_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "午前12:08 · 中庭の屋根を雨が打ちつけます。風などまったくないのに、仏壇のロウソクが激しく揺らめきました。",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "楓、怖がらなくていいからね――きれいな茶碗にご飯をよそって、お茶と一緒に玄関の段に置いて、丁寧にお名前を呼びなさい！",
          "timestamp_label": "午前12:08",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "おばあちゃん、ガラス戸が外側から曇ってる。誰かが結露に「000」って書いたよ！",
          "timestamp_label": "午前12:09",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[縁側の板が軋む音] ……わしに返事をしてくれたのは楓だけだったな……食卓にわしの席を用意してくれ……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "おばあちゃんに伝えてくれ、わしは家族を許していると。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "text",
          "sender_id": "ally",
          "text": "待って――さっき送信取り消しにしたメッセージを見たかい！？もう怒ってなんかいないんだよ、楓！ただ忘れられたくなかっただけなんだよ！",
          "timestamp_label": "午前12:11",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "choice",
          "prompt": "軒先から雨が流れ落ちる中、玄関灯がちらつきます。",
          "options": [
            {
              "option_id": "e2_opt_free",
              "label": "玄関の段にご飯とお茶を供える",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "今お供え物を外に置いてくるね……",
              "next_node_id": "e2_n08_free"
            },
            {
              "option_id": "e2_opt_vip",
              "label": "家族グループの説明に大伯父の名を記す",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "グループに大伯父さんの名前を追加するね……",
              "next_node_id": "e2_n08_vip"
            }
          ]
        },
        {
          "id": "e2_n08_free",
          "type": "narrator",
          "text": "ドアを少し開けて温かい茶碗を置き、深くお辞儀をしました。吹き荒れていた風が穏やかなそよ風に変わります。",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n08_vip",
          "type": "narrator",
          "text": "秘密解放：線香の炎が真っすぐ明るく燃え上がります。000番 はハートのリアクションを一つ残し、静かにチャットから退出しました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "いつもより早く朝日が差し込みます。玄関の段を確かめると、湯呑みは空になっており――鉄門はきちんと施錠されていました。",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "incoming_call",
          "caller_id": "ally",
          "caller_label": "リンおばあちゃん",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n11_ans",
          "on_decline_node_id": "e2_n11_dec"
        },
        {
          "id": "e2_n11_ans",
          "type": "narrator",
          "text": "おばあちゃんが優しく安堵の息を漏らします。「私の夢に出てきて、あんたに感謝してたよ、楓。次の鬼月も忘れちゃダメだよ」",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n11_dec",
          "type": "narrator",
          "text": "着信を拒否して力なく微笑みました――その時、来年の同じ日に 000番 が設定したカレンダー通知がスマホに届きました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n12",
          "type": "cliffhanger",
          "headline": "また来年の七月に",
          "teaser_text": "シーズンフィナーレ · 家族チャットからご先祖様の番号を消してはいけません。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
