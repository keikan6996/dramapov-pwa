        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "JulianがVanessaの真正面まで歩み寄ると、その優しかった笑みが氷のように冷たく変わりました。",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
