        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "sil",
          "text": "なっ！？{{player_name}}！？どうやってエレベーターから出たわけ――それにどうして会長に触れているのよ！？",
          "timestamp_label": "午後8:05",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
