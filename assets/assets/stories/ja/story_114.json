        {
          "id": "e2_n10",
          "type": "text",
          "sender_id": "chairman",
          "text": "妙だな――業務用エレベーターのカメラには、君がパス#007を奪い、私の主賓を閉じ込めるためにベルボーイを買収している姿が映っているんだが。",
          "timestamp_label": "午後8:08",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "主賓の正体",
          "teaser_text": "Vanessaは悟りました――自分が締め出したのは単なる義妹ではなく、会長の個人的なVIPであり、同時に合併パートナー本人だったのだと。",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
