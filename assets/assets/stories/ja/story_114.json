      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "午後8:02・60階プライベートロビー。鋼鉄の扉が開くと、パリッとしたスーツを着こなし温かな笑みを浮かべた男性が手を差し伸べてきました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "chairman",
          "text": "やっと会えたね！20億ドル規模の合併交渉の間、君の真夜中のジョークが俺の正気を保ってくれたんだ、{{player_name}}。さあ、君のパスを盗んだ相手を見に行こう。",
          "timestamp_label": "午後8:02",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "待って――あなたがJulian会長だったの！？私、6か月間もあなたに義姉の愚痴をこぼし続けていたのに！！",
          "timestamp_label": "午後8:02",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "image",
