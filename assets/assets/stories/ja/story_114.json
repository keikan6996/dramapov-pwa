        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "sil",
          "text": "違う！！私はなりすましじゃない！{{player_name}}の義姉よ――彼女が私にチケットをくれたの！！",
          "timestamp_label": "午後8:05",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
