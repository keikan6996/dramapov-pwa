            {
              "option_id": "opt_vip_probation",
              "label": "離婚を成立させ最初から口説き直させる",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · 女王の試練",
              "player_reply_text": "結婚は終わりよ、Alexander。{{player_name}}会長とデートしたいなら、列に並びなさい。",
              "next_node_id": "e2_n07b"
            }
          ]
        },
        {
          "id": "e2_n07a",
          "type": "text",
          "sender_id": "alexander",
          "text": "サインするよ……君に自由を与える義務が俺にはあるから。さようなら、{{player_name}}。",
          "timestamp_label": "午前11:20",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08"
        },
        {
          "id": "e2_n07b",
          "type": "text",
          "sender_id": "alexander",
          "text": "毎朝欠かさず列の一番前に並び続けるよ、{{player_name}}会長。たとえ10年かかっても。",
          "timestamp_label": "午前11:20",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08"
