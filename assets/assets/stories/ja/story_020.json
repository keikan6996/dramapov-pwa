          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n07"
        },
        {
          "id": "e3_n07",
          "type": "unsent_message",
          "sender_id": "alexander",
          "text": "たとえ今日君が俺の会社を叩き潰しても、俺はSterlingの王冠より君を選ぶ。",
