        {
          "id": "e2_n08",
          "type": "cliffhanger",
          "headline": "会長万歳。",
          "teaser_text": "シーズンフィナーレ · 床から天井までの窓から振り返ったあなたはApex取締役会を率います――王冠は揺るぎなくあなた自身の頭上に。",
          "sfx": "gasp",
          "ambient": "night_city",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
      "episode_number": 3,
      "title": "机の上の指輪",
