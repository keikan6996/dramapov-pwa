          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n05"
        },
        {
          "id": "e4_n05",
          "type": "narrator",
          "text": "彼の叔父がせせら笑います。『こいつはお前が捨てたただの専業主婦だろう、Alexander――降伏書にサインしろ！』",
          "style": "system_alert",
