        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "目がくらむようなパティオの投光器と110デシベルのサイレンが庭中に鳴り響き――ゲイリーは慌ててダイアンのセダンへと走り戻りました。",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "det",
          "text": "巡回班が角で銀色のセダンを包囲しました！あれはダイアンの車ですか！？",
          "timestamp_label": "午後6:15",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "青いパトランプが子ども部屋のカーテンを照らす中、警官たちはダイアンの車の助手席からゲイリーを引きずり出しました。",
