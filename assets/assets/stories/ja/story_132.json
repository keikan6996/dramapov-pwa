        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "det",
          "text": "パトカー2台がこの区画に入りました――鍵を閉めた部屋の中で2階にいてください！",
          "timestamp_label": "午後6:15",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
