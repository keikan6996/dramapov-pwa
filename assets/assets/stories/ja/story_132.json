        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "玄関は絶対に開けないで、ノア。今すぐ署のキム巡査部長に電話して。",
          "timestamp_label": "午後6:10",
          "typing_delay_ms": 0,
