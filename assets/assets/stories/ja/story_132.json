          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "husband",
          "text": "廊下カメラを見てくれ――午後2:00から2:45まで映像が空になってる！誰かが母さんと共有していたカメラアプリにログインして削除したんだ！",
          "timestamp_label": "午後6:10",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
