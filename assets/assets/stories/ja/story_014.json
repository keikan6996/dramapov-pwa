  "episodes": [
    {
      "episode_number": 1,
      "title": "盗まれたアイデンティティ",
      "start_node_id": "e1_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前10時05分 · 私立クリニック。『ブレーキ故障』による衝突事故から目を覚ましたばかりのあなたは、看護師のタブレットを借りてクラウドチャットにログインします。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "gabriel",
          "text": "本当に結婚式を今週土曜に前倒ししていいのかい、{{player_name}}？あの旅行から帰って以来、なんだか別人みたいだ。",
          "timestamp_label": "午前9:58",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "narrator",
          "text": "誰かが『あなたの』スマホから返信しています！あなたは双子の姉妹スカーレットのチャットに切り替え、サブアカウントから彼女を問い詰めます。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "目が覚めたわよ、スカーレット。今すぐ私の婚約指輪を外しなさい。",
          "timestamp_label": "午前10:07",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "twin",
          "text": "あり得ない……医者は何ヶ月も目を覚まさないって言ったのに！そのままそのクリニックにいなさい。ガブリエルは『私』があなただと思ってるんだから！",
          "timestamp_label": "午前10:08",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "unsent_message",
          "sender_id": "twin",
          "text": "4億ドルの結婚式を手放すためだけにあなたのブレーキホースを切ったんじゃないわ！",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1900,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "voice_note",
          "sender_id": "twin",
          "duration_sec": 8,
          "transcript": "[冷酷な笑い声] 身分証もない『妄想患者』の言葉なんて誰も信じないわよ。土曜の夜には、私がガブリエル・スターリング夫人になっているんだから。",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "choice",
          "prompt": "スカーレットはあなたのブレーキを切ったことを自白しました――土曜日まであと48時間です。",
          "options": [
            {
              "option_id": "opt_test_gabriel",
              "label": "本物のあなたしか知らない秘密をガブリエルに送る",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "ガブリエル――『私』に京都の雨の夜に何が起きたか聞いてみて。あの子は知らないから。",
              "next_node_id": "e1_n09a"
            },
            {
              "option_id": "opt_vip_police",
              "label": "自白を保存し祭壇に姿を現す",
              "cost_type": "vip_rewarded",
              "badge_text": "特別 · 逆襲の罠",
              "player_reply_text": "ガブリエル、気づいたことを彼女に悟られないで。今送ったスクショを見て。",
              "next_node_id": "e1_n09b"
            }
          ]
        },
        {
          "id": "e1_n09a",
          "type": "text",
          "sender_id": "gabriel",
          "text": "やっぱりだ！！昨日あいつ、俺の犬の名前を間違えたんだ！今すぐそのクリニックの住所を送ってくれ、{{player_name}}！",
          "timestamp_label": "午前10:11",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n09b",
          "type": "text",
          "sender_id": "gabriel",
          "text": "あいつが君のブレーキを切ったのか？！今すぐ民間の警備隊を送ってそのクリニックから君を保護させる――そして警察にも通報する。",
          "timestamp_label": "午前10:11",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "cliffhanger",
          "headline": "本物の花嫁が向かっている。",
          "teaser_text": "エピソード2：土曜日の正午。あなたのウェディングドレスを着たスカーレットが祭壇に立つ時――大聖堂の扉が勢いよく開かれます。",
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "祭壇の二人の花嫁",
      "start_node_id": "e2_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "土曜日 · 午前11時58分。あなたは大聖堂の脇扉の裏で待機しています。祭壇からガブリエルがメッセージを送ってきました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "gabriel",
          "text": "後列にゲストに変装した刑事たちが待機している。俺の合図を待っていてくれ、{{player_name}}。",
          "timestamp_label": "午前11:58",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "twin",
          "text": "もし抜け出していた時のために教えてあげるわ：あと5秒で私が『誓います』って言うところよ。来世で頑張ってね！💅",
          "timestamp_label": "午前11:59",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "player",
          "text": "聖歌隊のバルコニーを見上げて、スカーレット。警察に向けて笑って。",
          "timestamp_label": "午前11:59",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "twin",
          "text": "やめて！！ガブリエル、彼女が偽物だって言って！！",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "voice_note",
          "sender_id": "gabriel",
          "duration_sec": 7,
          "transcript": "[祭壇のマイクに向かって話す声] 警察官の方々、私の隣に立っている女は婚約者ではありません――そしてこれが彼女の殺人未遂の自白です。",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "choice",
          "prompt": "スカーレットは手錠をかけられて連行されます。ガブリエルが本物の指輪を手にあなたの方へ歩いてきます。",
          "options": [
            {
              "option_id": "opt_hug_gabriel",
              "label": "ようやく安心しガブリエルの腕に飛び込む",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "どうして最初から私じゃないって気づいたの？",
              "next_node_id": "e2_n08a"
            },
            {
              "option_id": "opt_vip_marry",
              "label": "花を無駄にせず今すぐ結婚しようと告げる",
              "cost_type": "vip_rewarded",
              "badge_text": "特別 · 真実の誓い",
              "player_reply_text": "ゲストはもう勢揃いしているわ、ガブリエル。本物の双子と結婚する気はある？",
              "next_node_id": "e2_n08b"
            }
          ]
        },
        {
          "id": "e2_n08a",
          "type": "text",
          "sender_id": "gabriel",
          "text": "君のように俺を見つめてくれる人なんて、他に誰もいないからだよ、{{player_name}}。",
          "timestamp_label": "午後12:04",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n08b",
          "type": "text",
          "sender_id": "gabriel",
          "text": "すでに控え室で君の『本物』のドレスにスチームをかけて用意してある、{{player_name}}。結婚しよう。💍",
          "timestamp_label": "午後12:04",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n09",
          "type": "cliffhanger",
          "headline": "一つの顔。一つの真実の愛。",
          "teaser_text": "エピソード3：スカーレットは勾留されました――しかし病院の記録から、私立クリニック内で彼女のすり替わりを手助けした内通者が浮上します。",
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
      "episode_number": 3,
      "title": "すり替えられたリストバンド",
      "start_node_id": "e3_n01",
      "default_ambient": "office_tension",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "午後1時30分 · 大聖堂の聖具室。刑事たちが手錠をかけたスカーレットを連行した直後――ガブリエルの調査官がクリニックの監査結果を送ってきます。",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "gabriel",
          "text": "{{player_name}}、落ち着いて座ってくれ。スカーレットは一人で昏睡隠蔽をやり遂げたんじゃない――クリニックの夜勤医が君の生体情報カルテをすり替えていたんだ！",
          "timestamp_label": "午後1:30",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "image",
          "sender_id": "gabriel",
          "image_asset": "assets/media/evidence/dna_report.webp",
          "caption": "医療カルテ監査 · スカーレットとヘイル医師があなたの患者身分証リストバンドを交換したことを証明する生体認証スキャン。",
          "blur_until_tap": true,
          "typing_delay_ms": 850,
          "sfx": "photo_snap",
          "haptic": "heavy",
          "next_node_id": "e3_n04"
        },
        {
          "id": "e3_n04",
          "type": "text",
          "sender_id": "player",
          "text": "ヘイル医師？！今朝私が自分のスマホを返してほしいと頼んだ時、『妄想だ』と言い放ったまさにその医者よ！",
          "timestamp_label": "午後1:32",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n05"
        },
        {
          "id": "e3_n05",
          "type": "unsent_message",
          "sender_id": "twin",
          "text": "もしヘイル医師が取り調べで口を割ったら、ブレーキ整備士に送った送金までバレてしまう……",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n06"
        },
        {
          "id": "e3_n06",
          "type": "text",
          "sender_id": "gabriel",
          "text": "刑事たちが警察署から監視付きでスカーレットに1回だけ通話を許したんだ――そしたら彼女、ヘイル医師に君の入院ファイルを破棄するよう警告しようとした！",
          "timestamp_label": "午後1:33",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n07"
        },
        {
          "id": "e3_n07",
          "type": "voice_note",
          "sender_id": "gabriel",
          "duration_sec": 10,
          "transcript": "[保護的で落ち着いた声] 俺の警備隊がすでにクリニックの薬局の外に待機している。教えてくれ、{{player_name}}――ヘイル医師を警察に任せるか、それとも君にタブレットを貸してくれた看護師と一緒に問い詰めるか？",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n08"
        },
        {
          "id": "e3_n08",
          "type": "text",
          "sender_id": "twin",
          "text": "お姉ちゃん（妹）、お願い――弁護士のスマホから1通だけ打たせてもらえたの！殺人未遂で告訴しないで！私たち双子じゃない！",
          "timestamp_label": "午後1:35",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n09"
        },
        {
          "id": "e3_n09",
          "type": "choice",
          "prompt": "スカーレットが慈悲を乞う一方、ヘイル医師があなたのカルテをシュレッダーにかけようとしています。どう動きますか？",
          "options": [
            {
              "option_id": "e3_opt_free",
              "label": "即座に警察を向かわせヘイル医師を逮捕させる",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "私のブレーキを切ったくせに、スカーレット――今まさに警察がヘイル医師を逮捕しに向かってるわ。",
              "next_node_id": "e3_n10a"
            },
            {
              "option_id": "e3_opt_vip",
              "label": "ヘイル医師を逮捕し勇敢な看護師を表彰する",
              "cost_type": "vip_rewarded",
              "badge_text": "特別 · 秘密の展開",
              "player_reply_text": "ヘイル医師を閉じ込めて――そして私にタブレットを貸してくれた看護師さんを昇進させて！",
              "next_node_id": "e3_n10b"
            }
          ]
        },
        {
          "id": "e3_n10a",
          "type": "text",
          "sender_id": "gabriel",
          "text": "今確認が取れた：シュレッダーの前で君の入院ファイルを手にしていたヘイル医師を警察が現行犯逮捕したぞ！",
          "timestamp_label": "午後1:36",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n10b",
          "type": "narrator",
          "text": "特別展開：ガブリエルがあなたを救った勇敢な看護師のために奨学基金を設立――一方ヘイル医師は即座に寝返り、スカーレットの整備士への領収書を差し出します！",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "twin",
          "text": "嘘よ！！ガブリエルに言って、私は追い詰められてたの――両親はいつもあなたばかり贔屓してたから！",
          "timestamp_label": "午後1:37",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n12"
        },
        {
          "id": "e3_n12",
          "type": "text",
          "sender_id": "gabriel",
          "text": "あいつが君を傷つけることはもう二度とない、{{player_name}}。待て――クリニックの防犯映像から、君の衝突事故の夜のクリップがもう1本見つかった。",
