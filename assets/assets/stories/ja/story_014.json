      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "午後3時15分 · 警察署の待合ラウンジ。あなたとガブリエルはバックアップサーバーから復元されたクリニック廊下の映像を確認します。",
          "style": "banner",
