      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前3時00分 · 寮のグループチャット。誰も削除できずに残っていた名前の下に、灰色の吹き出しが現れます。『Hannahが入力中…』",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}！！これ見てる？！誰がHannahのアカウントに入ったの？！",
          "timestamp_label": "午前3:00",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "彼女のお母さんがスマホも一緒に埋葬したはずよ。パスコードを知ってる人なんていないのに。",
