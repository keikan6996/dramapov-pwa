          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "ビデオ映像に映し出されたのは『あなたの』ベッドフレームの暗い裏側――垂れ下がったあなたの手を真下から見上げていました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "あなたは慌てて拒否を押します。その瞬間、ベッドの下から伸びた冷たい手が毛布の端を掴みました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "ベッドフレームの下",
          "teaser_text": "エピソード2：彼女は一人ではありません――そして本当に指輪を盗んだのが誰なのかを知っています。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
