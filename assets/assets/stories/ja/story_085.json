          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ghost",
          "text": "彼女が内通者だ！2Bの化粧室に閉じこもって私の合図を待て——今コックピットのACARSを偽装している！",
