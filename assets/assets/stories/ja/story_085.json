      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "高度35,000フィート · チューリッヒ行き408便。シートベルト着用サインが消灯します。トートバッグの中で、見覚えのない黒い折りたたみ携帯が衛星回線で震え始めました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ghost",
          "text": "その携帯を客室乗務員に渡すな、{{player_name}}。14A席を見ろ。",
          "timestamp_label": "午後11:14",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "あなたは19番ゲートで私にぶつかってきた女性ね！どうしてこんなものを私のバッグに入れたの？！",
