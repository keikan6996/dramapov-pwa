          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "ghost",
          "duration_sec": 8,
          "transcript": "[ジェット機の轟音、囁き声] 14Aの男は盗まれた生物兵器台帳を運んでいる。保安検査場で私に気づかれたため、潔白な乗客——つまりあなたに復号キーを託すしかなかった。",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "ghost",
          "text": "警告：客室乗務員の1人が奴に買収されている。制服を着た者は誰も信じるな。",
          "unsent_placeholder": "GHOST-19がメッセージの送信を取り消しました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "チーフパーサーのElenaがあなたの座席の横に立ち止まり、黒い携帯に目を留めました：",
