          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "突然機内の照明がオレンジ色に暗転しました。14A席の男がシートベルトを外して立ち上がり——あなたと化粧室の間の通路を塞ぎます。",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "高度35,000フィートで逃げ場なし",
          "teaser_text": "14Aの男が真っ直ぐあなたの席へ歩いてきており、Elenaは今まさに背後のコックピットカーテンを閉めた。",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
