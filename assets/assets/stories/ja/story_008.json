          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "違うわ。婚姻取消のための荷造りよ。どうして自分の親友の秘密をばらしたの、セバスチャン？",
          "timestamp_label": "午後11:46",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "unsent_message",
          "sender_id": "sebastian",
          "text": "あいつが君の指に指輪をはめるのを見ているのが、俺の人生で一番つらい日だったからだ。",
