      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "午後11時45分 · モナコのヨットの写真を見た後、スイートへ戻ったあなた。階下の中庭からセバスチャンのメッセージが届きます。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "sebastian",
          "text": "バルコニーの明かりがまだ点いてるね、{{player_name}}。あいつの元へ戻る荷造りをしてるんじゃないと言ってくれ。",
