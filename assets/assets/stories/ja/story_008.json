    {
      "episode_number": 1,
      "title": "パリでひとりきり",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午後10時30分 · ホテル・リッツ・パリ。オーウェンは『緊急の合併案件』のため2日目にニューヨークへ飛び戻りました。あなたのスマホが光ります。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "sebastian",
          "text": "{{player_name}}、今階下のリッツのバーにいる。降りておいでよ――新婚旅行の夜に一人でルームサービスなんて食べるべきじゃない。",
          "timestamp_label": "午後10:30",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "セバスチャン？！パリで何してるの？ニューヨークでオーウェンと一緒に合併をまとめてるんじゃなかったの？！",
          "timestamp_label": "午後10:31",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "sebastian",
          "text": "合併案件なんて存在しないよ、{{player_name}}。あの契約は先週木曜に署名済みだ。それにオーウェンはニューヨークにもいない。",
          "timestamp_label": "午後10:32",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "sebastian",
          "text": "あいつは元カノとモナコにいる――俺は君に一人でその事実を知らせたくなくて、7時間かけて飛んできたんだ。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1900,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "owen",
          "text": "ベイビー、役員会議が午前0時まで長引きそうなんだ。セバスチャンに振り回されて大変だよ。会いたいな！😘",
          "timestamp_label": "午後10:33",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "voice_note",
          "sender_id": "sebastian",
          "duration_sec": 8,
          "transcript": "[背景に柔らかなピアノの音色] あいつ、また平然と君に嘘をついただろう？4番テーブルに降りておいで、{{player_name}}。あいつの搭乗券を見せてやる。",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "choice",
          "prompt": "夫は今まさに嘘をつき――彼の親友が階下であなたを待っています。",
          "options": [
            {
              "option_id": "opt_go_down",
              "label": "エレベーターで降りてセバスチャンに会う",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "ボルドーを2杯注文しておいて。今降りるわ。",
              "next_node_id": "e1_n09a"
            },
            {
              "option_id": "opt_vip_selfie",
              "label": "オーウェンにセバスチャンへ電話を代わるよう言う",
              "cost_type": "vip_rewarded",
              "badge_text": "特別 · 容赦ない反撃",
              "player_reply_text": "へえ、そうなんだ、オーウェン？じゃあ挨拶したいからセバスチャンに電話代わって。",
              "next_node_id": "e1_n09b"
            }
          ]
        },
        {
          "id": "e1_n09a",
          "type": "text",
          "sender_id": "sebastian",
          "text": "テラス側の窓際にいるよ。泣かないで――あいつには君の涙一粒の価値もない。",
          "timestamp_label": "午後10:35",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n09b",
          "type": "text",
          "sender_id": "owen",
          "text": "あ――あいつ今トイレに行ったところなんだ！バッテリー残り2%、じゃあな！",
          "timestamp_label": "午後10:35",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "cliffhanger",
          "headline": "なぜセバスチャンは本当にパリへ飛んだのか？",
          "teaser_text": "エピソード2：キャンドルが揺れるバーのテーブル越しに、セバスチャンが一本のベルベット包みの鍵を滑らせ――5年間の秘密を告白します。",
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
