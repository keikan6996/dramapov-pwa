      "start_node_id": "e3_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "午前9時10分 · ガラの翌朝。お父様から涙声の電話がかかってきます――一晩でクリニックの借金が1セント残らず消えたのです。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "kieran",
          "text": "おはよう、{{player_name}}。お父様のクリニックはもう安全だ。さあ、5年前に君が俺の元を去った本当の理由を話し合おう。",
          "timestamp_label": "午前9:10",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "text",
          "sender_id": "player",
          "text": "キーラン、一度に全部払わなくてもよかったのに……私が去ったのは、あなたのお母様が父を破滅させると脅したからよ！",
          "timestamp_label": "午前9:11",
          "typing_delay_ms": 0,
          "sfx": "ting",
