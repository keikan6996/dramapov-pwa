      "start_node_id": "e3_n01",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "午前0:34 · ダミアンが救急外来へ向かうため専用の駐車場エレベーターにクロエを押し込みます。扉が閉まり――階数表示がB3で凍りつきました。",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "husband",
          "text": "非常ボタンが死んでる。クロエ、どうして金を盗んだなんて言ったんだ！？誰の金だ！？",
          "timestamp_label": "午前0:35",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n03"
