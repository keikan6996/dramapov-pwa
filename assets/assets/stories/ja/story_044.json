          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "marco",
          "text": "えっと……みんな？誰かが俺のバックアップ用タブレットにログインして、午後7:30から8:00までの写真を全部削除したぞ。",
