      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午後8:15 · グループチャット「エレナの晴れの舞台」。200人のゲストがバンケットホールで待っています。エレナが消えました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "evan",
          "text": "エレナはどこだ？バンドがもう2回もファーストダンスの案内をしたぞ。",
          "timestamp_label": "午後8:15",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "chloe",
          "text": "ベールもスマホも化粧台に置かれたままだよ。裸足で飛び出したりするはずがないのに！",
