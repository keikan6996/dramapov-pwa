          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "unsent_message",
          "sender_id": "chloe",
          "text": "バルコニーの写真を消したのは、エレナが取り乱して見えて可哀想だったからだけで――",
