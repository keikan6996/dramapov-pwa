          "next_episode_number": 4
        }
      ]
    },
    {
      "episode_number": 4,
      "title": "屋上での告白",
      "start_node_id": "e4_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "午後0時30分 · 役員用屋上テラス。風がテオのネクタイを揺らす中、彼が温かいジャスミンティーを差し出してくれます。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n02"
        },
        {
          "id": "e4_n02",
          "type": "text",
          "sender_id": "theo",
          "text": "2年前、嵐の中でセント・ジュード病院の外にいた時、見知らぬ女性がずぶ濡れの男に最後の傘とバス代をくれたんだ。",
          "timestamp_label": "午後12:30",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n03"
        },
        {
          "id": "e4_n03",
          "type": "text",
          "sender_id": "player",
          "text": "待って……お祖父様のお見舞いの後にスマホの充電が切れていたあの男性――あれがあなただったの？！",
          "timestamp_label": "午後12:31",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n04"
        },
        {
          "id": "e4_n04",
          "type": "text",
          "sender_id": "theo",
          "text": "君は俺の名前すら聞かなかった。6ヶ月前に君の履歴書を見た時、傘のタグに書かれていた筆跡に気づいたんだ。",
          "timestamp_label": "午後12:33",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n05"
        },
        {
          "id": "e4_n05",
          "type": "narrator",
          "text": "スマホが震えます――クビになった管理人が、テオがあなたの部屋に入る切り取り写真を取締役会にリークしました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n06"
        },
        {
          "id": "e4_n06",
