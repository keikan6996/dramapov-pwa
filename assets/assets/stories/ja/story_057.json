          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "待って――Brad、あんたベースキャンプに着いてからもう40分も経ってるよ。一度も救急箱を頼んでなんかいないじゃない。",
          "timestamp_label": "午後5:43",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05",
          "ambient": "heartbeat"
        },
        {
          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "sam",
          "duration_sec": 8,
          "transcript": "[吹き荒れる風音、ノイズ] {{player_name}}……聞こえるか！？古い監視塔のそばにいる――誰かが俺のリュックとコンパスを谷底へ放り投げたんだ――",
          "audio_asset": null,
          "typing_delay_ms": 950,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "unsent_message",
          "sender_id": "brad",
          "text": "SamのGPS追跡機もリュックと一緒に谷へ落ちるはずだったのに――",
