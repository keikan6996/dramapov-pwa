          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_choice"
        },
        {
          "id": "e1_n09_choice",
          "type": "choice",
          "prompt": "Samのメッシュ通信信号がバッテリー残り4%で弱まっています！どうしますか？",
