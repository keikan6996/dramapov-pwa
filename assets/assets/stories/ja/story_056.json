          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n11_merge",
          "type": "text",
          "sender_id": "mateo",
          "text": "律、今ウォークイン冷蔵庫のドアがバタンと閉まった――ソフィーが中に閉じ込められてる！",
