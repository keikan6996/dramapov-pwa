          "teaser_text": "エピソード2：泥棒はまだ厨房の中にいます――そしてレシピ本はケーキ箱の中に隠されているのです。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
