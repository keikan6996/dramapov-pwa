          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "エレナ・パク……1年前にロンドンへ引っ越したはずの、彼の『退職した』アシスタント？！",
