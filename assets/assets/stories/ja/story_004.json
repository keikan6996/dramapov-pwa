          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "victor",
          "text": "やあ{{player_name}}、今シンガポールに着いたよ。くたくただ。このまま寝るね、愛してる。",
