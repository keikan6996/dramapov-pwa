      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午後10時12分 · 役員会議のためシンガポールにいると言っていたヴィクター。その時、自動送信のショートメールが届きます。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "hospital",
          "text": "ご出産おめでとうございます！特別産科スイート904号室の退院請求額（18,400ドル）がヴィクター・スターリング様の家族プランに課金されました。母親：エレナ・パク様。",
