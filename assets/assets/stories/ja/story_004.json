          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "voice_note",
          "sender_id": "victor",
          "duration_sec": 10,
          "transcript": "[背景で小さく泣く赤ちゃんの声] ベイビー、聞いてくれ、俺はホテルのロビーにいるんだ――シーッ、エレナ、ドアを閉めろ――明日の朝一番の便で帰るから！",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n09"
        },
        {
          "id": "e1_n09",
          "type": "choice",
          "prompt": "彼のすぐ後ろで赤ちゃんが泣く声が聞こえました。どう動きますか？",
