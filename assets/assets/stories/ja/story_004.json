          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11"
        },
        {
          "id": "e1_n10b",
          "type": "text",
          "sender_id": "victor",
          "text": "法人カードを凍結したのか？！母さんは跡取りが必要だったんだ、{{player_name}}――君には俺に子どもを授けられなかったじゃないか！",
