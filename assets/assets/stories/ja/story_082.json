          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "Devon！第4エレベーターに閉じ込められた。非常通報ボタンが死んでる！",
          "timestamp_label": "午前1:17",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "devon",
          "text": "落ち着いて、{{player_name}}。電力ログを確認中…おかしいな。第4シャフトだけ電気が落ちていて、入館端末にはタワー内に他に誰もいないと出ている。",
