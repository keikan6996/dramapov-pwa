          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "devon",
          "text": "なんてこった——シャフトのサーマルカメラに奴が映った！レンチと結束バンドのキットを持ってる。911に通報する！",
