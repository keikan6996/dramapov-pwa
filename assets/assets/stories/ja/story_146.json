          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "landlord",
          "text": "前の入居者からの連絡は一切無視してください。彼は急遽引っ越したのです。",
          "unsent_placeholder": "このメッセージは送信取り消しされました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "転がる音があなたの枕の真上でぴたりと止まります：",
