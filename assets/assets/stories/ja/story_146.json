          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "prev_tenant",
          "duration_sec": 8,
          "transcript": "[小声、滴り落ちる水音]「5階なんてないのは分かってる！あるのはコンクリートの屋上と貯水タンクだけだ！通気口から降りてくる前に今すぐ2回叩け！」",
          "audio_asset": null,
