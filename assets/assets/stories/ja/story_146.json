          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08_merge"
        },
        {
          "id": "e1_n07b",
          "type": "text",
          "sender_id": "prev_tenant",
          "text": "Mr. Vanceを信用するな！もし深夜過ぎに直接家賃を徴収に来たら、足元に影があるか確かめろ！",
          "timestamp_label": "午前2:17",
