          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "待って――誰が私の番号を教えたの？それにここは最上階よ！4Bの上には5階なんてないはずなのに！",
