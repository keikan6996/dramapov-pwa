            {
              "option_id": "opt_story_146_e1_free",
              "label": "ほうきの柄で天井を2回叩く",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "コン……コン。よし、転がる音が完全に止まったわ！",
              "next_node_id": "e1_n07a"
            },
            {
              "option_id": "opt_story_146_e1_vip",
              "label": "屋上の騒音についてMr. Vanceに連絡する",
              "cost_type": "vip_rewarded",
              "badge_text": "シークレット · 広告を見る",
              "player_reply_text": "Mr. Vance、なぜ午前2時15分に4Bの上の屋上を誰かが歩いているんですか？",
              "next_node_id": "e1_n07b"
            }
          ]
        },
        {
          "id": "e1_n07a",
          "type": "text",
          "sender_id": "prev_tenant",
          "text": "よし！今度は玄関ドアの下を見てくれ――覗き穴カバーの内側にルール2とルール3をテープで貼っておいたんだ。",
