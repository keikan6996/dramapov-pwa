          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "10… 9… 8… 9番ゴンドラに乗りに来て。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "待て――チャンネル3で子供の声がカウントダウンしてる！それに9番ゴンドラがちょうど一番下の乗り場の手前で止まったぞ！",
