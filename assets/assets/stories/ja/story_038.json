          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[歪んだメリーゴーランドのメロディ、無線のノイズ] ……7… 6… 5… {{player_name}}、安全バーを忘れないでね……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "電源を切っていたはずのトランシーバーが勝手にカチリと入り、鮮やかな緑色に光りました。",
