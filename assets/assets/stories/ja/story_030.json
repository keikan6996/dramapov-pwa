          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "通話越しにゆっくりとした湿った足音が響きます――あなたのデスクへ向かって歩いてくる足音と寸分違わず一致していました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "着信を拒否すると、消毒液の匂いを帯びた冷たい風が首筋を撫で、一枚のシーツがあなたの椅子に落ちました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "7番引き出しは空っぽだ",
          "teaser_text": "エピソード2：霊安室のカードキーリーダーが赤く点滅します――あなたは『それ』と共にB2に閉じ込められました。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
