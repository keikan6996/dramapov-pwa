      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前2時33分 · 地下2階病理検査室。7番冷蔵引き出しの温度警報が赤いアラートを鳴らします。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}、俺のスマホに高温警報が届いたぞ！なぜ7番引き出しが37°C――人間の体温を示しているんだ？！",
          "timestamp_label": "午前2:33",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "コンプレッサーは正常に動いています、先生！待って――7番引き出しの封印済み証拠品のスマホから今メッセージが来ました！",
          "timestamp_label": "午前2:34",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "出してくれ。この鉄の箱の中は暗すぎる。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "あり得ない！あのスマホはバッテリーを抜いて4番ロッカーに封印したはずだ！離れた場所から引き出しの掛け金を確認しろ！",
          "timestamp_label": "午前2:35",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 12,
          "transcript": "[鉄板を内側からくぐもった音で叩く音、荒い息遣い] ……{{player_name}}……俺は死んでいない……取っ手を引いてくれ……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "7番引き出しの鋼鉄製ハンドルから霜が溶け落ちます。リズミカルな重い衝撃が掛け金を揺らしました。",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "7番引き出しの検視タグを確認する",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "搬入ファイルを呼び出します……",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "ボイスノートを2倍音量で再生し直す",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "背景の音をよく聴いてみます……",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "あなたは凍りつきます。搬入記録には、身元不明男性7号はすでに午後6時に解剖済み――心臓も摘出済みと記されていました。",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "秘密解放：叩く音の下に聞こえていたのは7番引き出しではありません――まさに『あなたのすぐ背後』で検査室のガラス扉がスライドして開く音でした。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}！！今B2の防犯カメラを見てる！7番引き出しは10分間もずっと『全開』になったままだぞ！！",
          "timestamp_label": "午前2:37",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "証拠袋07番（シムなし）",
