      "nodes": [
        {
          "id": "n01",
          "type": "narrator",
          "text": "午前8:05 · すべての取引画面に速報が点滅します。4億ドルの大型合併案が一夜にしてリークされ、株価が22%急落しました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n02"
        },
        {
          "id": "n02",
          "type": "text",
          "sender_id": "sec",
          "text": "{{player_name}}、社員証が凍結されました。メディアに流出したPDFにはあなたの見えない電子透かしが入っており、午前2時14分にあなたの自宅IPからダウンロードされています。",
          "timestamp_label": "午前8:05",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n03"
        },
        {
          "id": "n03",
          "type": "text",
          "sender_id": "player",
          "text": "午前2時14分？！熟睡していたはずよ！昨夜私のアパートにいた他の人間といえば…Ethanしかいない。",
