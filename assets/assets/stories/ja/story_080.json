          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "unsent_message",
          "sender_id": "fiance",
          "text": "ボス、うちの空売り取引で800万ドル確定しました！ご心配なく——電子透かしは俺じゃなく楓を指していますから。",
