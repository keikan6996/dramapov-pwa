          "sender_id": "chair",
          "duration_sec": 10,
          "transcript": "[氷のように冷たい声] {{player_name}}、午前10時に連邦規制当局が到着する。午前2時14分に他の誰かが君のパソコンを触ったと証明できなければ、インサイダー取引容疑で起訴されるぞ。",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n07"
        },
