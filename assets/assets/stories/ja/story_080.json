          ]
        },
        {
          "id": "n08_free",
          "type": "text",
          "sender_id": "sec",
          "text": "待って…ファイルはイーサンの勤務先であるライバル銀行エイペックス 銀行に登録された暗号化ユーエスビーにコピーされているわ！",
          "timestamp_label": "午前8:14",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n10_merge"
