          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[酸素マスクのシューという音] ……脈を測って、{{player_name}}……どうして誰も私の脈を見てくれないの？……",
          "audio_asset": null,
          "typing_delay_ms": 900,
