          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "2人の警備員と一緒に非常階段を駆け上がっている！薬品庫の中に鍵をかけて隠れろ、{{player_name}}！",
          "timestamp_label": "午前2:58",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
