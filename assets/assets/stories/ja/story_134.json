          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "fiancee",
          "text": "イーサン、妹にはパーティーに来ないように伝えて――私、誰にも写真を撮られたくないの！",
