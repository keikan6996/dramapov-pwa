        {
          "id": "e2_n11_dec",
          "type": "narrator",
          "text": "着信を拒否してクローゼットを確認しました。服の間に安全に掛かっていたのは、乾いたジャスミンの花が一輪だけでした。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n12",
          "type": "cliffhanger",
          "headline": "深夜以降の返品不可",
          "teaser_text": "シーズンフィナーレ · 今度ヴィンテージを買うときは、必ず先に裏地を確かめてください。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
