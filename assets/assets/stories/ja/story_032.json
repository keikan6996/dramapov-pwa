          "on_decline_node_id": "e2_n11_dec"
        },
        {
          "id": "e2_n11_ans",
          "type": "narrator",
          "text": "ミナが息を呑みます。「遥、店の防犯カメラを見たら――あの黒いコートがうちのラックに戻って、水滴を垂らしてる！」",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
