          "haptic": "medium",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "text",
          "sender_id": "ally",
          "text": "急いで！左ポケットにお札を折り戻すか、お香を焚いて敷居の外にコートを置いて！",
          "timestamp_label": "午前2:57",
          "typing_delay_ms": 700,
