        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "完全な静寂の中で午前3:00が過ぎます。確認のために玄関を開けると――黒いコートはどこにもありませんでした。",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n10"
        },
