  "episodes": [
    {
      "episode_number": 1,
      "title": "赤い護符",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前2:30 · ナイトマーケットで買ったヴィンテージのウールコートから、湿った土とジャスミンの匂いがかすかに漂ってきます。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "遥、こんな時間に起こしてごめんなさい！あの黒いコートの左内ポケットを確認して――折り畳んだ赤い紙、まだ縫い閉じたままになってる？",
          "timestamp_label": "午前2:30",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "古いクリーニングのタグかと思って、1時間前に引きちぎってゴミ箱に捨てちゃった……え、どういうこと！？",
          "timestamp_label": "午前2:31",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "私のコートを返して。凍えそうなの。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "そんな！あの荷物は遺品整理から回ってきたもので――お坊さんが封印したコートだったの！午前3時になる前に外へ持ち出して燃やして！",
          "timestamp_label": "午前2:32",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[歯の鳴る音、布の擦れる音] ……とてもよく似合ってるわ、遥……一緒に着させてちょうだい……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "椅子に掛けてあった空のコートの袖が、まるで目に見えない腕を通したかのようにゆっくりと持ち上がります。",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "コートを廊下のダストシュートへ押し込む",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "ダストシュートに放り込む！",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "ゴミ箱から破れた赤いお札を拾い出す",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "ゴミ箱から赤い紙を取り出す！",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "コートが5階分滑り落ちていく音が聞こえます。寝室を振り返ると――それは再び椅子の上に綺麗に掛けられており、ずぶ濡れになっていました。",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "秘密解放：赤いお札の裏には名前と命日が殴り書きされていました――今夜でちょうど四十九日目でした。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "捨てようとしちゃダメ！前の購入者は川に投げ捨てたのに、目が覚めたら首元までボタンを留めて着ていたの！",
          "timestamp_label": "午前2:35",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "非通知 · 凍てつくノイズ",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "震える女性の声が囁きます。「ボタンを留めて、遥。土の中はとても冷たいの」",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "着信を拒否しました。その瞬間、寝室の鏡の内側に濡れた手形が浮かび上がり――ジャスミンの強い香りが広がります。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "四十九日の夜",
          "teaser_text": "エピソード2：午前3時が近づくにつれ、袖があなたの肩へと伸びてきます。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "午前3時の鐘が鳴る前に",
      "start_node_id": "e2_n01",
      "default_ambient": "heartbeat",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "午前2:54 · 窓ガラスに霜が降ります。黒いウールコートは首のないマネキンのように、ベッドの横に直立しています。",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "遥、今お坊さんと連絡がついた！絶対に燃やすなと言ってる――燃やすと彼女の怒りを閉じ込めてしまうって！小銭と一緒に返して、代金を払ったと伝えて！",
          "timestamp_label": "午前2:54",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "コートのボタンが勝手に一つずつ留まっていく！指先の感覚がなくなってきた！",
          "timestamp_label": "午前2:55",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[床を引きずる重いウールの音] ……あと5分だけ、遥……私を温めて……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "赤いお札をポケットに戻して。",
