          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n08_vip",
          "type": "narrator",
          "text": "秘密解放：部屋が一気に暖かくなります。柔らかな声が「温もりを返してくれてありがとう」と吐息を漏らし、ジャスミンの香りとともに消えました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
