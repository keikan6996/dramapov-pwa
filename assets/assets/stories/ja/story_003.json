  "episodes": [
    {
      "episode_number": 1,
      "title": "14秒の真実",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午後5時40分 · リハーサル用のドレスにスチームを当てていると、クロエがチャットにボイスノートを落とします。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "voice_note",
          "sender_id": "chloe",
          "duration_sec": 14,
          "transcript": "[くすくす笑いながら] ベイビー、白いビキニも詰めたよ。明日の夜、私たちが紗良のバリ新婚旅行のチケットを使っちゃうなんて、あの子まだ全然気づいてない――待って、これ違うチャット？！",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "unsent_message",
          "sender_id": "chloe",
          "text": "うそ、無視して！バチェロレッテ用のドッキリだったの！！",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1700,
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "おかしいわね。私のバチェロレッテは先週終わったよ、クロエ。それに手が震えてるのは私じゃなくて、あなたの方よ。",
          "timestamp_label": "午後5:41",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "chloe",
          "text": "お願い電話に出て、紗良！聞き間違いよ！私は新しい彼氏に話してたの、ライアンじゃない！",
          "timestamp_label": "午後5:42",
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "ryan",
          "text": "ねえ愛してる、ちょっとお願い――バリ行きの航空券確認書を転送してくれる？座席番号を確認したくて。😘",
          "timestamp_label": "午後5:43",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "narrator",
          "text": "胃がすっと冷たくなります。そのファーストクラスのバリ行き航空券2枚は、あなたが自分の貯金で支払ったものでした。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "choice",
          "prompt": "ライアンとクロエは二人ともまだ嘘をつき通せると思っています。どう反撃しますか？",
          "options": [
            {
              "option_id": "opt_cancel_tickets",
              "label": "今すぐ黙ってバリの航空券をキャンセルする",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "いいわよ、ライアン。今あなたのメールに更新通知を送ったところ。",
              "next_node_id": "e1_n09a"
            },
            {
              "option_id": "opt_vip_play_audio",
              "label": "ディナーの乾杯スピーチまで音声を取っておく",
              "cost_type": "vip_rewarded",
              "badge_text": "特別 · 容赦ない反撃",
              "player_reply_text": "もう手配したわ、ライアン。今夜の私のスピーチを楽しみにしていて。",
              "next_node_id": "e1_n09b"
            }
          ]
        },
        {
          "id": "e1_n09a",
          "type": "text",
          "sender_id": "ryan",
          "text": "待って……なんで航空会社からのメールが『払い戻し手続き完了』になってるの？紗良？？",
          "timestamp_label": "午後5:45",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n09b",
          "type": "narrator",
          "text": "あなたはクロエの14秒のボイスノートをクラウドに保存し、宴会場のディージェイにメッセージを送ります。『ファーストダンスの曲をトラック1に差し替えて』",
          "style": "system_alert",
          "sfx": "photo_snap",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "chloe",
          "text": "わかったわよ！ライアンと私は8ヶ月前から付き合ってたの。彼のご両親の前で騒ぎを起こさないで！",
          "timestamp_label": "午後5:46",
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n11"
        },
        {
          "id": "e1_n11",
          "type": "cliffhanger",
          "headline": "裏切りの8ヶ月間。",
          "teaser_text": "エピソード2：落ち着いた笑顔でリハーサルディナーへ足を踏み入れたあなた――そしてライアンの裕福な父親がグラスを鳴らします。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "リハーサルの乾杯",
      "start_node_id": "e2_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "午後7時30分 · 80人のゲストがキャンドルの灯るテーブルを囲んでいます。テーブルクロスの下で、ライアンが必死にあなたへメッセージを送ってきます。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ryan",
          "text": "紗良、お願いだ。今夜が終わったら父が俺たちに会社の株を譲渡するんだ。ディナーの後で二人きりで話そう。",
          "timestamp_label": "午後7:30",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "へえ、お父様の株をもらうためだけに私の苗字が必要だったのね。よくわかったわ。",
          "timestamp_label": "午後7:31",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "chloe",
          "text": "彼のお父様の顔を見て――あなたのことが大好きなのよ。ここで出ていったらライアンはすべてを失う。みっともない真似はやめて！",
          "timestamp_label": "午後7:31",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "chloe",
          "text": "それに私はライアンの赤ちゃんを妊娠2ヶ月なんだから、どっちみち彼は私のものよ。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1900,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "narrator",
          "text": "遅かったわね――すでにスクショ済みよ。司会者があなたにワイヤレスマイクを手渡します。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "voice_note",
          "sender_id": "ryan",
          "duration_sec": 6,
          "transcript": "[テーブル越しにパニックで囁く声] マイクを置いて、紗良！家はあげるから、ただ笑ってくれ！",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n08"
        },
        {
          "id": "e2_n08",
          "type": "choice",
          "prompt": "あなたの乾杯スピーチを待ち、会場全体が静まり返ります。最後の一撃を放ってください。",
          "options": [
            {
              "option_id": "opt_play_speaker",
              "label": "スマホをマイクに当てて再生ボタンを押す",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "乾杯の前に、私の花嫁介添人が新郎へ特別なメッセージを用意してくれています。",
              "next_node_id": "e2_n09a"
            },
            {
              "option_id": "opt_vip_congrats",
              "label": "その場でクロエの妊娠を祝福してあげる",
              "cost_type": "vip_rewarded",
              "badge_text": "特別 · 究極",
              "player_reply_text": "グラスを掲げてください――私たちの結婚ではなく、ライアンとクロエの新しい赤ちゃんのために！",
              "next_node_id": "e2_n09b"
            }
          ]
        },
        {
          "id": "e2_n09a",
          "type": "narrator",
          "text": "クロエのくすくす笑う声がボールルーム中のスピーカーから響き渡ります。ライアンの父親がシャンパングラスを取り落としました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n09b",
          "type": "narrator",
          "text": "死のような静寂。ライアンの父親が立ち上がり株式譲渡契約書を真っ二つに引き裂く中、クロエの顔がチョークのように真っ白になります。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "text",
          "sender_id": "ryan",
          "text": "俺の人生を丸ごと台無しにしやがって、紗良。",
          "timestamp_label": "午後7:36",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n11"
        },
        {
          "id": "e2_n11",
          "type": "cliffhanger",
          "headline": "指輪を外し、王冠を戴く。",
          "teaser_text": "エピソード3：ロールスロイスの車内でライアンの従兄弟が爆弾発言――クロエとライアンは数週間前から1904号室を予約していたのです。",
          "sfx": "gasp",
          "ambient": "night_city",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
      "episode_number": 3,
      "title": "1904号室の領収書",
      "start_node_id": "e3_n01",
      "default_ambient": "family_drama",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "午後10時15分 · リハーサル会場を後にし滑るように走るロールスロイスの後部座席。スマホに不在着信が殺到します。",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "ryan",
          "text": "紗良、今すぐ俺の従兄弟の車から降りろ！あのボイスノートは前後の文脈を切り取られただけだ！",
          "timestamp_label": "午後10:15",
          "typing_delay_ms": 650,
          "sfx": "ting",
