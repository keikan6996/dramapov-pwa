      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "午後11時05分 · 空港のプライベートラウンジ。氷で冷やされたシャンパンの傍ら、ガラス扉の前までライアンが怒鳴り込んで来ます。",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e4_n02"
        },
        {
          "id": "e4_n02",
          "type": "text",
          "sender_id": "ryan",
          "text": "警備員が特別ラウンジに入れてくれない――紗良、外に出てきて話してくれ！",
          "timestamp_label": "午後11:05",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n03"
        },
        {
          "id": "e4_n03",
          "type": "image",
