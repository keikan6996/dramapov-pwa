        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "あなたが黄金のスポットライトの中へ歩み出た瞬間、ネイサンは手にしていたシャンパングラスを落とし、床にクリスタルが砕け散りました。",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "nathan",
          "text": "{{player_name}}！？お前がセントジュードの理事長なのか！？待て――俺の手術を執刀したのもお前だったのか！？",
          "timestamp_label": "午後7:03",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
