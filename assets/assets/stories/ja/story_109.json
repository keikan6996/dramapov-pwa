        {
          "id": "e2_n10",
          "type": "text",
          "sender_id": "director",
          "text": "昨日、{{player_name}}理事長と離婚されたため、配偶者免除枠は無効となりました。手術費残高200万ドルのお支払い期限は7日以内です。",
          "timestamp_label": "午後7:06",
