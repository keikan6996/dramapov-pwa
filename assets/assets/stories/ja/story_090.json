          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "患者 #4409 ですって？！9号ベッドに入っているのは誰ですか、Patel先生？！",
