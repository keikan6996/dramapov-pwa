          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "zday",
          "text": "ビットコインは不要だ、{{player_name}}。マスターデータベースから患者 #4409 の毒物検査報告書を抹消すれば、即座に復号キーを渡してやる。",
