    {
      "episode_number": 1,
      "title": "3回の金属音",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前2時45分 · カン。カン。カン。ベッドの横の鉄パイプを伝って、鋭い3回のノック音が響き上がってきます。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "翠、頼むから今パイプを叩き返してないって言ってくれ！！",
          "timestamp_label": "午前2:45",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "配管修理してる奴に黙れって伝えるために2回叩き返したけど！どうして、何かあるの？",
          "timestamp_label": "午前2:46",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "3階へお招きいただき、ありがとう。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "先週の火曜、俺の兄貴が叩き返したんだ！翌朝、配管工が浴室の排水口の横に残された兄貴のスリッパだけを見つけたんだぞ！",
          "timestamp_label": "午前2:47",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[虚ろな金属の擦れる音] ……2回の返事……今翠のもとへ登っていくよ……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "寝室のパイプのノック音が止み――あなたの浴室の床の排水口の真下から再び鳴り始めました。",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "浴室の排水口カバーに重しを載せる",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "排水口の上に重いバケツを載せる！",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "排水口に沸騰した塩水を流し込む",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "今すぐ熱湯の塩水を流し込む！",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "重いバケツがタイルから数センチ浮き上がります――下から伸びた長く青白い指に押し上げられて。",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "秘密解放：濡れた悲鳴が配管シャフトの奥へ響き渡ります。ベンの行方不明の兄が着けていた金の指輪が、タイルの上に勢いよく弾き飛ばされてきました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "今天井の通気口を這い回ってるぞ！俺のランプの真上でペタペタと濡れた音が聞こえる！",
          "timestamp_label": "午前2:49",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "不明 · 反響する回線",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "聞こえるのは滴り落ちる水音だけ――そして、あなたの心臓の鼓動にぴったり同期した3回のリズミカルなノック音。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "着信を拒否すると、その瞬間に浴室の洗面台の蛇口が勝手に全開になり、濃い赤錆の水が溢れ出しました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "3階に到達した",
          "teaser_text": "エピソード2：浴室のドアノブが内側からゆっくりと回り始めます。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
