      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午後11時30分 · 屋上ヨットパーティー。シャンパングラスを2つ取りにケイレブが席を外した瞬間、見知らぬ番号からメッセージが届きます。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "anon",
          "text": "今夜、ケイレブにその三文字を言うな、{{player_name}}。あいつはカントリークラブの仲間と、午前0時までに君を惚れさせるかで1000万ドル賭けている。",
          "timestamp_label": "午後11:30",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "悪趣味な冗談ね。ケイレブはそんな人じゃない。証拠を見せて。",
