      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午後6:12 · 家族チャットに47件の未読メッセージが殺到してスマホが鳴り止みません。Hannahにブライズメイド代表から駐車場係へ降格された後、あなたが最後の会場費1万8000ドルの送金を拒否したからです。",
          "style": "system_alert",
          "sfx": "ting_soft",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "mom",
          "text": "{{player_name}}、いい加減にして！今すぐ1万8000ドルを会場のカードに戻しなさい――Hannahが泣き崩れているのよ！",
          "timestamp_label": "午後6:12",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "私のパートナーへの招待を取り消したうえに、会ったこともない160人分の費用まで払えって言われたのよ。",
          "timestamp_label": "午後6:12",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "sister",
          "text": "お母さん、もし{{player_name}}が会場をキャンセルしたらBrettが結婚を取りやめて家の頭金も持っていくって言って！",
          "unsent_placeholder": "このメッセージは送信取り消しされました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "caterer",
          "duration_sec": 8,
          "transcript": "[ためらいがちな小声]「{{player_name}}さん、Briarwood会場のMarcoです。キャンセルの前に――新郎が6か月前にも別の花嫁の名前でこの大広間を予約していたことはご存知ですか？」",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Marcoのボイスメッセージに血の気が引きます：",
          "options": [
            {
              "option_id": "opt_131_e1_free",
              "label": "Marcoに別の花嫁の契約書を送ってもらう",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "ちょっと待って――同じ新郎が6か月前にも！？今すぐその予約詳細を送ってください、Marco！",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_131_e1_vip",
              "label": "1万8000ドルの保留を維持しBrettを引き止める",
