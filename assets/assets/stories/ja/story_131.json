          "type": "cliffhanger",
          "headline": "結婚式ではない――詐欺だ",
          "teaser_text": "次回：返金詐欺――ハンナが「ブレットの結婚資金」として送ってきた銀行口座番号を確認すると、6か月前にマルコがマークしていた海外口座と完全に一致しました……。",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
