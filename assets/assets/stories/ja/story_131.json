          "sfx": "ting_soft",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "mom",
          "text": "{{player_name}}、いい加減にして！今すぐ1万8000ドルを会場のカードに戻しなさい――ハンナが泣き崩れているのよ！",
