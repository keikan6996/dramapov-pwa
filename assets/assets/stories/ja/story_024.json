  "episodes": [
    {
      "episode_number": 1,
      "title": "次の停車駅：アッシュウッド",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前2時19分 · 車両が果てしない暗闇のトンネルを揺れながら進みます。他の乗客は全員、目を閉じたまま微動だにしません。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "雫、今どこだ？中央駅で待ってるんだけど――駅員が4号線は2時間前に運行終了したって言ってるぞ。",
          "timestamp_label": "午前2:19",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "えっ？！私、文字通り今4号線に乗ってるんだけど。発光ランプ表示が『アッシュウッド駅』に切り替わった。",
          "timestamp_label": "午前2:20",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "扉が開いても、決して目を開けるな。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "アッシュウッド駅は1998年に全焼したんだぞ！！トンネルも封印されてる！雫、非常ブレーキを引け！",
          "timestamp_label": "午前2:21",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[レールの軋む音、重なり合う囁き声] ……1998年行きへようこそ……切符を拝見します、雫さん……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "乗客たちが一斉に目を開け――全員があなたの席の方へ首を巡らせました。",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "隣の車両へ走り抜ける",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "先頭車両へ移動します！",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "ポケットの中の紙の切符を確かめる",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "待って、紙の切符を持ってる……",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "引き戸を勢いよく抜けると――前の車両は黒焦げの木製ベンチ以外、完全に無人でした。",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "秘密解放：切符の日付は今日ではありません。あなたの生年月日が正確に刻印されており――『片道』と記されていました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "街の地図から君の位置情報ドットが消えた！減速してるって言ってくれ！",
          "timestamp_label": "午前2:23",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "車掌インターホン",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "雑音が響きます。『終点、アッシュウッド。切符を破いたお客様のみ、車内に留まることができます』",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "着信を拒否すると、即座に頭上の車内スピーカーが鳴り響きました。『3号車にて検札を行います』",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "扉が開こうとしている",
          "teaser_text": "エピソード2：灰色の灰に覆われたホームが外に現れ――ランタンを手にした誰かが待っています。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "アッシュウッド・ホーム",
      "start_node_id": "e2_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "午前2時25分 · 電車がシューッと音を立てて停車します。開いた扉から煤が舞い込み、駅の時計の針が逆回転を始めました。",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "雫、古い新聞記事を見つけた！12人の通勤客がその電車で失踪して――ホームに降りた人間は誰一人戻らなかったそうだ！",
          "timestamp_label": "午前2:25",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "焦げた制服を着た車掌が通路をこっちへ歩いてくる。改札鋏を持ってる。",
          "timestamp_label": "午前2:26",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[金属製の鋏がカチリと鳴る音] ……電車を降りなさい、雫。あなたの降車駅は20年前ですよ……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "扉のチャイムが鳴るまで目を閉じていなさい。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "text",
          "sender_id": "ally",
          "text": "顔を見るな！生存者掲示板の話を思い出せ――電車が動き出すまで寝たふりをするんだ！",
          "timestamp_label": "午前2:27",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "choice",
          "prompt": "車掌があなたの席の横で立ち止まります。冷たい煙が肺を満たしました。",
          "options": [
            {
              "option_id": "e2_opt_free",
              "label": "目を固く閉じて息を止める",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "目を閉じた。動かない……",
              "next_node_id": "e2_n08_free"
            },
            {
              "option_id": "e2_opt_vip",
              "label": "1998年の切符を真っ二つに破る",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "今切符を破り捨てる！",
              "next_node_id": "e2_n08_vip"
            }
          ]
        },
        {
          "id": "e2_n08_free",
          "type": "narrator",
          "text": "焼け焦げた手があなたの頬から数センチの位置で止まります。扉のチャイムが鳴り――電車は暗闇の中へガクンと発車しました。",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n08_vip",
          "type": "narrator",
          "text": "秘密解放：指の中で紙が温かい灰へと変わります。車掌が一度お辞儀をすると、蛍光灯がパッと真っ白な光に戻りました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "明るい駅名標が視界を横切ります：『中央駅』。あなたはハッと身を乗り出します――車両は清潔で無人でした。",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "incoming_call",
          "caller_id": "ally",
          "caller_label": "サム (親友)",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n11_ans",
          "on_decline_node_id": "e2_n11_dec"
        },
        {
          "id": "e2_n11_ans",
          "type": "narrator",
          "text": "サムが息を呑みます。『生きててよかった！待て――なんでお前のコートの背中に煤の手形がついてるんだ？』",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n11_dec",
          "type": "narrator",
          "text": "明るいホームに降り立ったあなたは――スマホの壁紙がアッシュウッド駅の写真に変わっていることに気づきます。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n12",
          "type": "cliffhanger",
          "headline": "足元にご注意ください",
          "teaser_text": "シーズンフィナーレ · あなたの交通系電子カードカードの履歴には、まだ進行中の乗車が1件残っています：『行き先不明』。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
      "episode_number": 3,
