          "next_node_id": "e3_n06"
        },
        {
          "id": "e3_n06",
          "type": "text",
          "sender_id": "threat",
          "text": "改札で死者の交通カードをかざしましたね、雫。こうなったら最終終着駅までお乗りいただきます。",
          "timestamp_label": "午前2:30",
