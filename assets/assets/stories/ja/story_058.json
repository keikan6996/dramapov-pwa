          "type": "voice_note",
          "sender_id": "aunt_mei",
          "duration_sec": 9,
          "transcript": "[小声] {{player_name}}、まだ警察を呼ばないで！2日前にバスターミナルからレイが「売っていい、俺を探すな」ってメモを添えてその時計を郵送してきたの。",
          "audio_asset": null,
          "typing_delay_ms": 950,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_choice"
        },
