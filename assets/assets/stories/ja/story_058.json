      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午後8:30 · 家族チャット「リン家のいとこ会」。レイ叔父さんはパスポートも持たずに3週間前から行方不明になっています。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "diana",
          "text": "みんな、ちょっと手を止めて。今 クイックセル でレイ叔父さんの金のオメガ時計が6,500ドルで出品されてるのを見つけた。",
          "timestamp_label": "午後8:30",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "aunt_mei",
          "text": "本当に叔父さんのものなの？同じ見た目の時計なんて何千個もあるわよ。",
