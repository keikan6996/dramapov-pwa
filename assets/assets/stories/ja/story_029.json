      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "午前1時12分 · 木製のハシゴが床板にどんと下ります。暗い開口部から冷たい松の霧が流れ落ちてきました。",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "そのままベッドから動かないで、{{player_name}}さん。五つ星のゲストは日の出前には決して帰りませんよ。",
          "timestamp_label": "午前1:12",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "嘘をついたわね！私の予約を受けた時から、上に何が潜んでいるか知っていたくせに！",
          "timestamp_label": "午前1:13",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[軋みながら降りてくるハシゴの音] ……1段……2段……ポーチの電気は点けないで、{{player_name}}……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "車のスペアキーはポーチの植木鉢の下にテープで貼ってある。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "text",
          "sender_id": "ally",
          "text": "ポーチのシダ植物の下に門のスペアキーを置いてあります――待って、今のは私が打っていません！中へ戻ってください！",
          "timestamp_label": "午前1:15",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n07"
