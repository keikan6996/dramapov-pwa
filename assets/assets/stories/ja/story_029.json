        {
          "id": "e2_n08_vip",
          "type": "narrator",
          "text": "秘密解放：青い炎がページを呑み込みます。人影は灰となって霧散し、玄関の補助錠が勝手にカチリと解錠されました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
