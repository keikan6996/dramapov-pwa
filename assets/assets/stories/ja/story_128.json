          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "緊張なんかしていません、イヴリン。ただ、第3検査室からどの看護師が出てくるか見ているだけです。",
