          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "今夜あなたを家から追い出すための離婚届をすでに頭の中で起草しながら、イヴリンは得意げにロレックスを確認しています。",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "husband",
          "text": "お袋が、午後5時には至急鑑定の結果が出るって言ってる。みんなで一緒に封筒を開けるまで家にいてくれ、{{player_name}}。",
          "timestamp_label": "午後2:18",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
