          "sfx": "ting_soft",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "lab",
          "text": "複製検体を封印し、私個人の生体認証金庫室に記録保存いたしました！",
