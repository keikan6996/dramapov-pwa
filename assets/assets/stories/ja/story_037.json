              "option_id": "e1_opt_vip",
              "label": "額縁の裏側を懐中電灯で照らす",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "キャンバスの裏を確認してみる……",
              "next_node_id": "e1_n08_vip"
            }
