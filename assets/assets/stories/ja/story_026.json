              "label": "階段に向けて鏡の破片を掲げる",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "自分自身の姿を見せてやる……",
              "next_node_id": "e2_n08_vip"
            }
