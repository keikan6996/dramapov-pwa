  "episodes": [
    {
      "episode_number": 1,
      "title": "午前2時10分の遺失物",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前2時10分 · 共有の配車アカウントを使っているLucas。担当ドライバーから遺失物通知が飛び込みます。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "driver",
          "text": "こんにちは{{player_name}}様、先ほどご主人をベルベット・ラウンジでお降ろししました。後部座席でプラチナの結婚指輪を外して置いていかれましたよ。",
          "timestamp_label": "午前2:10",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "待って――ベルベット・ラウンジ？！Lucasは今夜病院の救命救急で徹夜勤務だって言っていたのに！",
          "timestamp_label": "午前2:11",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "driver",
          "text": "手術着は着ておられませんでしたよ、奥様。それに膝の上に乗っていた金髪の女性が笑って、指輪を置いていくよう言っていました。",
          "timestamp_label": "午前2:12",
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "driver",
          "text": "必要でしたら車内ドライブレコーダーに一部始終が映っていますよ。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "lucas",
          "text": "やあベイビー、今夜ERが大忙しだよ。手洗い中に指輪をなくしちゃって――心配しないで、警備員が探してくれてるから！❤️",
          "timestamp_label": "午前2:13",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "voice_note",
          "sender_id": "driver",
          "duration_sec": 7,
          "transcript": "[ウインカーのカチカチという音] あのね、去年妹が浮気されたんです。お宅から5分のところにいます――指輪とドラレコ映像をお届けしましょうか？",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "choice",
          "prompt": "Lucasが人生最悪の嘘を送ってきました。どうしますか？",
          "options": [
            {
              "option_id": "opt_get_clip",
              "label": "ドライバーに200ドル渡して映像を受け取る",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "はい、両方とも門の前まで持ってきてください。現金で200ドルのチップをお渡しします。",
              "next_node_id": "e1_n09a"
            },
            {
              "option_id": "opt_vip_ride",
              "label": "ドライバーにベルベット・ラウンジへ送らせる",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · 待ち伏せ",
              "player_reply_text": "5分後に門の前で拾ってください――ベルベット・ラウンジへ引き返します。",
              "next_node_id": "e1_n09b"
            }
          ]
        },
        {
          "id": "e1_n09a",
          "type": "text",
          "sender_id": "driver",
          "text": "お金は結構ですよ、奥様。今お宅の前に停めます――その女性が誰か見たら驚きますよ。",
          "timestamp_label": "午前2:16",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n09b",
          "type": "text",
          "sender_id": "driver",
          "text": "すぐ向かいます、奥様。メーターは倒しません――この乗車はサービスです。",
          "timestamp_label": "午前2:16",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "cliffhanger",
          "headline": "ドラレコは嘘をつかない。",
          "teaser_text": "エピソード2：ドライブレコーダーの映像を一時停止したあなたは――夫とキスしている女の正体に気づきます。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "午前2時40分の帰還",
      "start_node_id": "e2_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "午前2時40分 · ベルベット・ラウンジのVIPブースに座るあなた――その真正面に、Lucasとあなたの義妹（義姉）の親友が座っていました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "player",
          "text": "やあLucas。結婚指輪を見つけたよ。後ろを振り向いて。",
          "timestamp_label": "午前2:40",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "lucas",
          "text": "なんだって――{{player_name}}？！スマホをしまえ！ラウンジ中の前で騒ぎを起こすな！",
          "timestamp_label": "午前2:41",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "player",
          "text": "落ち着いて。騒ぎになんてしないわ。ただ、私のクレジットカードで4000ドルのドン・ペリニヨンをどうやって払うつもりか知りたいだけよ。",
          "timestamp_label": "午前2:41",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "lucas",
          "text": "待て――カード請求を見たのか？！頼む、今すぐカードを止めないでくれ、ウェイターが目の前に立ってるんだ！",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "voice_note",
          "sender_id": "lucas",
          "duration_sec": 7,
          "transcript": "[汗だくでスマホに囁く声] {{player_name}}、頼む！彼女と同僚の前でカードが決済拒否されたら俺はおしまいだ！家に帰ろう！",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "choice",
          "prompt": "ウェイターがLucasのテーブルにカード決済端末を持ってきました。",
          "options": [
            {
              "option_id": "opt_decline_card",
              "label": "彼がカードをかざした瞬間に凍結する",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "さあタッチして、Lucas。画面が赤く変わるのを見てなさい。",
              "next_node_id": "e2_n08a"
            },
            {
              "option_id": "opt_vip_drop_ring",
              "label": "グラスに指輪を落としカードを凍結する",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · 圧倒的勝利",
              "player_reply_text": "ほらあなたの指輪――4000ドルのツケを払うために質に入れなさい。私たちは終わりよ。",
              "next_node_id": "e2_n08b"
            }
          ]
        },
        {
          "id": "e2_n08a",
          "type": "narrator",
          "text": "ピッ！『カード利用不可』。金髪の女は即座にバッグを掴むと、一度も振り返らずブースから出ていきました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n08b",
          "type": "narrator",
          "text": "端末に『決済拒否』が点滅すると同時に、プラチナの指輪がシャンパングラスに音を立てて落ちます。VIP席中のスマホが一斉に録画を始めました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n09",
          "type": "text",
          "sender_id": "driver",
          "text": "正面ドアのすぐ外でエアコンを効かせて待っていますよ、{{player_name}}様。ご自宅へ帰る準備はよろしいですか？",
          "timestamp_label": "午前2:45",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "cliffhanger",
          "headline": "ドライバーには星5つ。夫にはゼロ。",
          "teaser_text": "エピソード3：ベルベット・ラウンジからLeoの車で立ち去る中、Lucasがパニックになり――そしてあなたはLeoの本当の正体を知ります。",
          "sfx": "gasp",
          "ambient": "night_city",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
      "episode_number": 3,
      "title": "ドラレコの真実",
      "start_node_id": "e3_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "午前2時55分 · ベルベット・ラウンジを離れるLeoの静かな黒いセダンの車内。Lucasからの着信通知でスマホが鳴り止みません。",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "lucas",
          "text": "{{player_name}}、車のドアを開けろ！！警備員があの4000ドルのボトルの担保に俺の腕時計を取り上げたぞ！！",
          "timestamp_label": "午前2:55",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "image",
          "sender_id": "driver",
          "image_asset": "assets/media/evidence/generic_ring_closeup.webp",
          "caption": "ダッシュボードトレイ · ベルベット・ラウンジのバレー半券の横に置かれたLucasのプラチナ結婚指輪。",
          "blur_until_tap": true,
          "typing_delay_ms": 850,
          "sfx": "photo_snap",
          "haptic": "heavy",
          "next_node_id": "e3_n04"
        },
        {
          "id": "e3_n04",
          "type": "text",
          "sender_id": "player",
          "text": "お義妹（お義姉）の親友に割り勘してもらえば、Lucas。あら残念――もう逃げ出しちゃったみたいね！",
          "timestamp_label": "午前2:57",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n05"
        },
        {
          "id": "e3_n05",
          "type": "unsent_message",
          "sender_id": "lucas",
          "text": "もし病院の理事会にラウンジの動画を見られたら、俺は外科フェローシップをクビになる！",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n06"
        },
        {
          "id": "e3_n06",
          "type": "text",
          "sender_id": "driver",
          "text": "奥様、今夜ご主人にすぐ気づいた本当の理由をまだお伝えしていませんでしたね。先週火曜日の2本目の映像をよくご覧ください。",
          "timestamp_label": "午前2:58",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n07"
        },
        {
          "id": "e3_n07",
          "type": "voice_note",
          "sender_id": "driver",
          "duration_sec": 11,
          "transcript": "[落ち着いた揺るぎない声] 2週間前、私はLucasを病院からホテルまで乗せたんです――浮気だけじゃない、あなたの家の権利書を母親名義に書き換える話を得意げにしていました。",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n08"
        },
        {
          "id": "e3_n08",
          "type": "text",
          "sender_id": "driver",
          "text": "私はただの夜勤ドライバーじゃないんです、{{player_name}}様。非番の私立探偵ですよ――妹の事件も、まさに同じ一族が相手だったんです。",
          "timestamp_label": "午前3:00",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n09"
        },
        {
          "id": "e3_n09",
          "type": "choice",
          "prompt": "Leoが今、Lucasがあなたの家の名義変更を企んでいると明かしました。どう動きますか？",
          "options": [
            {
              "option_id": "e3_opt_free",
              "label": "Leoに郡の不動産登記ログを調べさせる",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "今すぐ不動産登記簿を確認して――私の家には指一本触れさせないわ！",
              "next_node_id": "e3_n10a"
            },
            {
              "option_id": "e3_opt_vip",
              "label": "Leoを雇いLucasの不倫網を丸ごと暴く",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · 秘密の展開",
              "player_reply_text": "ドラレコの全アーカイブを引き出して、今夜中にLucasの嘘を終わらせましょう！",
              "next_node_id": "e3_n10b"
            }
          ]
        },
        {
          "id": "e3_n10a",
          "type": "text",
          "sender_id": "driver",
          "text": "すでに調べました――昨日の午後、委任状を使って名義書換申請を提出しています！",
          "timestamp_label": "午前3:01",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n10b",
          "type": "narrator",
          "text": "VIP展開：Leoのアーカイブにより、Lucasが病院のチャリティー旅費資金に高級ホテルの週末滞在3回分を請求していたことも発覚します！",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "lucas",
          "text": "{{player_name}}、頼むからカードのロックを解除してくれ！ソファで寝るし、あいつとも縁を切るから、警察だけは呼ばせないでくれ！",
          "timestamp_label": "午前3:02",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n12"
        },
        {
          "id": "e3_n12",
          "type": "text",
          "sender_id": "driver",
          "text": "ご安心ください、奥様。最初の目的地は24時間対応の公証役場です――日の出前に彼の委任状を取り消しましょう。",
          "timestamp_label": "午前3:03",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n13_end"
        },
        {
