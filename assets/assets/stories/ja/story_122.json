      "episode_number": 1,
      "title": "7ページ目の罠",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前9:00・コールタワーの大理石の会議室であなたは目を覚ましました。婚前契約書のインクはまだ乾いていません――そしてあなたはまだサインしていないのです。",
          "style": "system_alert",
          "sfx": "ting_soft",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "husband",
          "text": "ベイビー、7ページ目にイニシャルを書いてくれ。午前11時のコモ湖行きフライトに間に合うよう、うちの弁護士がすごくシンプルにしておいたから。",
          "timestamp_label": "午前9:00",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "シンプルですって？7ページ目は私のフレグランスブランドの知的財産権を100％、あなたの持株会社に譲渡する条項じゃないの。",
          "timestamp_label": "午前9:00",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "bestie",
          "text": "ダミアン、あいつもうサインした？パリの買収先が私たちの確定連絡を待ってるのよ！",
          "unsent_placeholder": "このメッセージは送信取り消しされました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "lawyer",
          "duration_sec": 8,
          "transcript": "[イヤホン越しに囁く声]「光、本物の知財評価額を持ってロビーに来ています。私が入室するまで一行たりともサインしないでください」",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "ダミアンが苛立たしげに署名欄をトントンと叩いています：",
          "options": [
            {
              "option_id": "opt_122_e1_free",
              "label": "7ページ目を開き知財窃盗条項に丸をつける",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "第7条4項を説明して、ダミアン。なぜあなたが浮気したら私の会社があなたのものになるの？",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_122_e1_vip",
              "label": "こっそりエレナの逆襲用婚前契約書とすり替える",
              "cost_type": "vip_rewarded",
              "badge_text": "シークレット · 広告を見る",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "ダミアンの笑みが凍りつきました。彼の弁護士が気まずそうに咳払いをし、フォルダーへ手を伸ばします。",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "husband",
          "text": "そ、それは事務的な誤植だ！アシスタントに7ページ目を刷り直させよう！",
          "timestamp_label": "午前9:04",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "あなたは見た目がそっくりなエレナの逆襲用婚前契約書を差し出しました――不貞行為があれば5000万ドルの違約金が直接あなたへ支払われる条項入りで。",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "husband",
          "text": "完璧だ――ジェット機に乗り遅れないよう、今すぐ俺の欄にサインするよ！",
          "timestamp_label": "午前9:04",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "ガラスの扉が滑り開きました。エレナ・パク弁護士が2人のフォレンジック監査官を従えて堂々と入ってきます。",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "bestie",
          "text": "光、せっかくのおめでたい朝にどうして企業法務のやり手なんか連れてきたの！？",
          "timestamp_label": "午前9:08",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "細かい条文までよく読んで",
          "teaser_text": "次回：盗まれた調合レシピ――あなたは覚えています、最初の結婚式の2週間後にシエナがあなたの秘密の調合を使って「競合」高級香水を発売したことを。",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
