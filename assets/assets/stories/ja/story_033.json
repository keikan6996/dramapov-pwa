          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "濡れそぼった声が息を呑みます。「車から出るな。窓の横のガードレールを見ろ」",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "着信を拒否しました。その瞬間、車のドアが自動的にロックされ、ラジオから2012年の橋崩落ニュースの音声が鳴り響きます。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "行く先に道はない",
          "teaser_text": "エピソード2：青い影が赤いセダンから降り、真っすぐあなたのフロントガラスへ向かって歩いてきます。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
