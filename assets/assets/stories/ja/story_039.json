      "title": "ガラス越しに覗いてはいけない",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前2:50 · 市内全域での大停電。非常口の誘導灯が8階の廊下にぼんやりとした赤い光を投げかけています。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "8階の全員へ：絶対にドアスコープを覗かないで！！レンズの向こうにあなたの目が見えたら、在宅だと知られてしまうわ！",
          "timestamp_label": "午前2:50",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "エレナさん、何が起きてるんですか！？今誰かがうちのドアを優しく2回ノックしたんですが……",
          "timestamp_label": "午前2:51",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "ドアの下からスマホの明かりが見えるよ。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "今すぐドアスコープにテープを貼って、息を殺して静かにして！8階のドアを一軒ずつ回ってるの！",
          "timestamp_label": "午前2:52",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[指関節の柔らかなノック音、くぐもった声] ……葵さん？停電で……ロウソクが要らないか確認しにきただけよ……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "玄関ドアの下に差し込む細い赤い廊下の明かりを、何か黒い影が遮りました。",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "ドアスコープの上に付箋を貼る",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "音を出さずにドアスコープを塞ぐ……",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "ドアの隙間の下にスマホのカメラを差し込む",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "カメラでドアの下を覗いてみる……",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "指が冷たい真鍮のレンズに触れた瞬間――わずか数センチ向こう側の何かが鋭く息を吐き出しました。",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "秘密解放：ドアの外に靴はありませんでした――カーペットにぺたりと押し付けられた二本の青白い裸の手が、隙間の下からこちらを覗き返していたのです。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "待って……あなたの玄関のノックが止まった！8Dの方へ移動したのかな！？",
          "timestamp_label": "午前2:54",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "非通知 · 8C号室内部",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "通話の向こうで柔らかなノックが2回響きました――それは、あなたの寝室のクローゼットのドアの「内側」から聞こえてきました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "着信を拒否しました。その瞬間、ノックの音が再開しました――玄関ドアではなく、あなた自身のクローゼットの中から。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "外にいたのではない",
          "teaser_text": "エピソード2：暗闇の中、クローゼットのドアノブがゆっくりとカチリと鳴ります。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
