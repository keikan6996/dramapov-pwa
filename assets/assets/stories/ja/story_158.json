          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e2_n05_choice"
        },
        {
          "id": "e2_n05_choice",
          "type": "choice",
          "prompt": "真紅の文字が紙一面に咲き広がるのを目の当たりにして、スローンは恐怖に目を見張ります：",
