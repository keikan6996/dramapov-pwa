            {
              "option_id": "opt_story_158_e2_vip",
              "label": "ギデオンにレッド・ハーバー社を調べさせる",
              "cost_type": "vip_rewarded",
              "badge_text": "シークレット · 広告を見る",
              "player_reply_text": "ギデオン、今すぐ四半期ごとの取引先リストで「レッド・ハーバー社」を検索して！",
              "next_node_id": "e2_n05b"
            }
          ]
