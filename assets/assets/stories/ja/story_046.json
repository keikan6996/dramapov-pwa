          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "待って――5時30分にIvyからメッセージが来て、まだ予備校の地下室の中にいるって言ってたよ。",
