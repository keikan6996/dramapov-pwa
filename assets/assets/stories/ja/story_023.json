        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "レオから震える文字で返信が来ます。『本物のお金じゃない、{{player_name}}……冥銭（あの世の紙幣）だ。角が焦げてる』",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "秘密解放：麺を注文するあなた自身の眠そうな声の下で、もう一つの声が囁いていました。『2杯。1つは生きている人の分』",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "おい、俺はもう走り去るぞ、健闘を祈る――待て、なんで門からビニール袋が『消えてる』んだ？！",
          "timestamp_label": "午前3:11",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "配達自動音声通話",
