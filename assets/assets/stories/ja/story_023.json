            {
              "option_id": "e1_opt_vip",
              "label": "注文確認音声のフルデータを再生する",
              "cost_type": "vip_rewarded",
              "badge_text": "秘密 · 広告視聴",
              "player_reply_text": "音声ファイルの全編を送って！",
              "next_node_id": "e1_n08_vip"
            }
          ]
