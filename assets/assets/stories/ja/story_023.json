          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "機械的な声が読み上げます。『ご注文が受領されました……あなたのキッチンの中で』。隣の部屋でスプーンがカチャンと鳴りました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "通話を切ると、即座に冷たいスープと湿った線香の匂いが寝室のドアの下から漂ってきました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "二人分の夕食",
          "teaser_text": "エピソード2：テーブルの上に湯気の立つ丼が2つ置かれ――椅子が1脚、引き出されています。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
