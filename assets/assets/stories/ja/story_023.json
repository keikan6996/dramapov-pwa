      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午前3時07分 · 雷鳴が5階のワンルームを揺らします。配達アプリの通知音が鳴りました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "やあ{{player_name}}、門に麺を掛けておいたよ。カーテンの後ろの同居人に、俺をじっと睨むのをやめるよう言っといてくれ。",
          "timestamp_label": "午前3:07",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "待って――今夜は何も注文してない。それに私、完全に一人暮らしよ。",
          "timestamp_label": "午前3:08",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "彼女が今まさにあなたのベランダの鍵を開けています。",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "からかうなよ！注文は『あなた』の名前で現金払いだ――5階からくしゃくしゃのお札を落としてきたんだぞ！",
          "timestamp_label": "午前3:09",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 10,
          "transcript": "[激しい雨音、スクーターのエンジン音] ……待て、注文確定の時の通話録音を聴いてみてくれ――これ『あなた』の声だぞ……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "ガラス戸は閉まっているはずなのに、ベランダのレースカーテンが内側にふわりと揺れました。",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "彼女が落としたお札がどんなものか聞く",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "彼女が落としたお札ってどんなの？",
              "next_node_id": "e1_n08_free"
