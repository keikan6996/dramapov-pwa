              "option_id": "opt_094_e2_vip",
              "label": "モニターで耳をつんざくハウリングを起こす",
              "cost_type": "vip_rewarded",
              "badge_text": "シークレット · 広告を見る",
              "player_reply_text": "イヤホン越しに120デシベルの爆音でも味わいなさい！",
