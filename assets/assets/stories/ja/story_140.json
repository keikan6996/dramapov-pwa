      "default_ambient": "mystery_ticking",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午後6:10 · 日曜日の夕食会で、エヴァンの「ウェルネス遺伝子クリニック」のための20万ドル拡張ローンの連帯保証人を断ったあなたを義両親が厳しく非難し――冷たく非協力的だと責め立てました。",
          "style": "system_alert",
          "sfx": "ting_soft",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "husband",
          "text": "俺の両親は老後のコンドミニアムを担保に差し出してくれたのに、{{player_name}}――君は連帯保証にサインするだけでよかったんだぞ！どうして俺のクリニックを信じないんだ！？",
          "timestamp_label": "午後6:10",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "昨日4番街にあるあなたの「クリニック」の住所の前を通ったからよ、エヴァン。窓に目張り用紙が貼られた空のテナントだったじゃない。",
          "timestamp_label": "午後6:10",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "husband",
          "text": "融資担当者に伝えて、妻の署名なしで20万ドルの融資実行を押し通させろ――代わりにクリニック合同会社を使え！",
          "unsent_placeholder": "このメッセージは送信取り消しされました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "patient",
          "duration_sec": 8,
          "transcript": "[震える声]「はじめまして{{player_name}}さん、エヴァン・プライス医師の元患者のクレアと言います。彼の書類には一枚たりとも署名しないでください！彼は癌患者に偽の遺伝子検査を売りつけています！」",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
