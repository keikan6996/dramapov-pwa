          "sfx": "ting_soft",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "patient",
          "text": "32人の患者が彼に4500ドルずつ払いました――そして彼は本物の検査室へスワブを1本も送ったことがありませんでした！！",
