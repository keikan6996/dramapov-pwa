          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "gm",
          "duration_sec": 10,
          "transcript": "[雑音、遠くのサイレン] 「レジは開けたままにしておけ、誰も俺たちを見てない――」あれはお前の声だぞ、レオ。ゲームセンター強盗の時のな。",
          "audio_asset": null,
          "typing_delay_ms": 950,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "unsent_message",
          "sender_id": "leo",
          "text": "ハンナ、支配人は防犯テープを保管してないって言ってたじゃないか――",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1750,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "text",
          "sender_id": "hannah",
