          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05",
          "ambient": "heartbeat"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "player",
          "text": "どうやってゲームマスターが私たちのプライベートグループチャットに入り込んだの！？",
