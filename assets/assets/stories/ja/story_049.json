          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "hannah",
          "text": "ねえもう冗談はやめてよ。タイマーは5分前に00:00になったのに、なんでまだドアが磁気ロックされたままなの？",
          "timestamp_label": "午後10:52",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
