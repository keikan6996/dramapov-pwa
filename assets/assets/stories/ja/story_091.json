      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午後11:32 · 高速道路の土砂崩れで、あなたはパイン・リッジ・インで足止めされました。モーテルのワイファイに接続した瞬間——ローカルのイントラネットチャットが画面に開きました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "r409",
          "text": "409号室のキーカードは絶対に使わないで、{{player_name}}。エレベーターのボタンを見て——4階なんて存在しないから。",
          "timestamp_label": "午後11:32",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "待って…エレベーターのボタンが1、2、3、5しかない！どうして私の名前を知ってるの？！",
          "timestamp_label": "午後11:33",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "r409",
          "duration_sec": 8,
          "transcript": "[押し殺した囁き声、激しい雨音] 私が今その4階の中に閉じ込められてるからよ！フロントは他州ナンバーの車に乗った一人旅の客にだけ409号室のカードを渡すの。",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "clerk",
          "text": "廊下の方、大丈夫でしょうか、{{player_name}}様？4階へは製氷機の裏にある真鍮製の業務用階段をお使いください。",
          "timestamp_label": "午後11:34",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "フロントのロビーカメラが真っ直ぐあなたの方へ旋回しました：",
          "options": [
            {
              "option_id": "opt_091_e1_free",
              "label": "自分の車へ戻り車で走り去る",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "すみません、車に充電器を忘れてしまって——すぐ戻ります。",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_091_e1_vip",
              "label": "業務用階段を忍び上がって409を救出する",
              "cost_type": "vip_rewarded",
              "badge_text": "シークレット · 広告を見る",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "土砂降りの雨の中へ駆け出し——凍りつきます。あなたの車のタイヤ4本すべてが綺麗に空気を抜かれており、幹線道路へのゲートには南京錠がかかっていました。",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "r409",
          "text": "言ったでしょ——パイン・インから車で出られる人なんていないの！フロントが中庭を閉鎖する前に、外の非常梯子から409号室の窓へ上がってきて！",
          "timestamp_label": "午後11:36",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "薄暗い業務用階段を忍び上がります。4階はモーテルの客室廊下などではなく——重厚な鉄扉と生体認証ロックが並ぶ防音コンクリート廊下でした。",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "r409",
          "text": "本当に上がってきてくれたの？！テンキーにあなたの409カードをスワイプして——外から私のドアを開けられる唯一のマスターカードなの！",
          "timestamp_label": "午後11:36",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "unsent_message",
          "sender_id": "clerk",
          "text": "健康なドナー2名分の買い手確定。今4階の階段室を封鎖する。",
          "unsent_placeholder": "フロントがメッセージの送信を取り消しました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "背後で重い電磁ボルトがバタンと閉まりました。廊下の奥で、409号室のドアがカチリと開き——暗い部屋が姿を現します。",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "4階の内部で",
          "teaser_text": "階段室は封鎖され、フロントは今買い手を呼び出した。409号室の中にいる人物は唯一の味方か——それとも囮か。",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
