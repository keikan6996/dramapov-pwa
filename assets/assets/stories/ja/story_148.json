          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "stranger",
          "duration_sec": 8,
          "transcript": "[切迫した声、サイレンにかき消されながら]「{{player_name}}！聞こえますか！？私の手を握るか電話に出てください――その電車に乗ったままではだめだ！」",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "conductor",
          "text": "男は灰色のコートを着ている。顔を上げるな。",
          "unsent_placeholder": "このメッセージは送信取り消しされました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "地下鉄の扉がプシューッと音を立て、漆黒のホームへと開きます：",
          "options": [
            {
              "option_id": "opt_story_148_e1_free",
              "label": "スマホ画面に視線を釘付けにする",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "見上げない。ただドアが閉まるのを待つだけ……",
              "next_node_id": "e1_n07a"
            },
            {
              "option_id": "opt_story_148_e1_vip",
              "label": "4C席の乗客をチラッと見る",
              "cost_type": "vip_rewarded",
              "badge_text": "シークレット · 広告を見る",
              "player_reply_text": "見てしまった――彼が着ているのは普通のコートじゃなく、灰色の反射材付き救助服だわ！",
              "next_node_id": "e1_n07b"
            }
          ]
        },
        {
          "id": "e1_n07a",
          "type": "text",
          "sender_id": "conductor",
          "text": "よし。今ドアが閉まりました――待って、ホームのカメラが4号車に6つのシルエットが乗り込んだのを捉えています！",
