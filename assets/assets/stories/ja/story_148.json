          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08_merge"
        },
        {
          "id": "e1_n07b",
          "type": "text",
          "sender_id": "conductor",
          "text": "警告！その服の偽装を信用しないで！ホームのカメラでは、4号車は影を除いて完全に無人です！",
          "timestamp_label": "午前0:01",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08_merge"
        },
        {
          "id": "e1_n08_merge",
          "type": "narrator",
          "text": "車内の照明が3秒間消えました。ジッと鳴って再び点灯した時、あなたの周囲の座席はすべて水浸しになっていました。",
          "style": "banner",
          "sfx": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n09_call"
        },
        {
          "id": "e1_n09_call",
          "type": "incoming_call",
          "caller_id": "stranger",
          "caller_label": "灰色のコート · 4C席",
