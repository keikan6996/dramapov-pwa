          "can_decline": true,
          "on_answer_node_id": "e1_n10",
          "on_decline_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "stranger",
          "text": "自動アナウンスの警告を聞くのをやめて、{{player_name}}！あなたの脈拍が下がっている――窓ガラスに映った自分の姿を見て！",
          "timestamp_label": "午前0:04",
          "typing_delay_ms": 750,
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n11"
        },
        {
          "id": "e1_n11",
          "type": "text",
          "sender_id": "player",
          "text": "どうしてガラスが蜘蛛の巣みたいにひび割れてるの……それにどうしてディーゼルの煙の匂いがするの！？",
          "timestamp_label": "午前0:04",
          "typing_delay_ms": 0,
          "sfx": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n12_cliff"
        },
        {
          "id": "e1_n12_cliff",
          "type": "cliffhanger",
          "headline": "4号車の6つの影",
          "teaser_text": "次回：9番駅の防犯カメラが実際に乗り込んできた者たちの正体を暴きます。",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
