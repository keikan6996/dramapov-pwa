          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 10,
          "transcript": "[すすり泣き、木のドアを激しく叩く音] ……{{player_name}}お願い！誰かが建物の中までついてきたの！ドアを開けて！……",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
