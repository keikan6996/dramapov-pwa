          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "unsent_message",
          "sender_id": "root",
          "text": "9号線にお前が置き去りにした自転車の女性は俺の妹だ、{{player_name}}。自白する時間だぞ。",
          "unsent_placeholder": "最高管理者がメッセージの送信を取り消しました",
