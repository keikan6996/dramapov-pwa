              "next_node_id": "e1_n07b"
            }
          ]
        },
        {
          "id": "e1_n07a",
          "type": "text",
          "sender_id": "sister",
          "text": "テッサから返信が来ます。「{{player_name}}！？私3週間前からずっとあなたの家の門を叩いてるのに――オーウェンがあなたは療養施設に移ったって言ってたのよ！」",
