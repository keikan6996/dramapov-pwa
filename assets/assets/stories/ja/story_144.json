          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "husband",
          "duration_sec": 8,
          "transcript": "[ノイズ混じりの子ども部屋音声――あなたの声のハミング]「ねんねしな、ママに地下室のドアを開けさせちゃだめ……ママは忘れちゃった……」",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "husband",
          "text": "今すぐモニターを切れ！ただの音声ループの不具合だ！",
          "unsent_placeholder": "このメッセージは送信取り消しされました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "子守唄が繰り返される中、心臓が激しく打ち鳴ります：",
          "options": [
            {
              "option_id": "opt_story_144_e1_free",
              "label": "今すぐ家に来るようテッサへ連絡する",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "テッサ、お願いだからすぐ来て！誰かが子ども部屋で私の声を流してるの！",
              "next_node_id": "e1_n07a"
            },
            {
              "option_id": "opt_story_144_e1_vip",
              "label": "子ども部屋音声ファイルの録音日時を確認する",
              "cost_type": "vip_rewarded",
