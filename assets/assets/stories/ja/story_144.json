          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08_merge"
        },
        {
          "id": "e1_n08_merge",
          "type": "narrator",
          "text": "キッチンの天井の真上――鍵の掛かった子ども部屋の中から――誰かがそっと歩き回る足音が聞こえました。",
