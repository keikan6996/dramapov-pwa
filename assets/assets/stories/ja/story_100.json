      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "午後11:00 · ドォォン。夜空をエメラルド色の変圧器アーク放電が切り裂きます。800万人の市民が完全な暗闇に沈みました。生きているのはあなたの暗号化衛星ポケットベルだけです。",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "viktor",
          "text": "{{player_name}}！！ワームが12か所の変電所すべてを文鎮化した！コールドスタート復号ドライブを持っているのは君だけだ——今すぐ第9変電所へ来い！",
          "timestamp_label": "午後11:01",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "徒歩で第9変電所から6ブロックの所にいるわ！交通は完全麻痺——ダウンタウン中の車の盗難警報が鳴り響いてる！",
          "timestamp_label": "午後11:01",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "hunter",
          "duration_sec": 7,
          "transcript": "[変調された無線放送] 「わざわざ第9変電所まで歩く必要はないぞ、{{player_name}}。うちの監視員がブリッジ通りを渡るお前の黄色い作業ベストを目撃した」",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "hunter",
          "text": "病院の非常用発電機が枯渇するまであと12分だ。コールドスタート・ドライブを渡せ。",
          "unsent_placeholder": "ブラックアウト01がメッセージの送信を取り消しました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "停電の中、背後で2台の黒いバイクがエンジンを吹かしています：",
          "options": [
            {
              "option_id": "opt_100_e1_free",
              "label": "黄色いベストを脱ぎ捨て公園を突っ切る",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "ベストは捨てたわ！セントラルパークを突っ切って川沿いのゲートへ向かう！",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_100_e1_vip",
              "label": "偽ドライブを落とし蒸気トンネルへ滑り込む",
