          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "unsent_message",
          "sender_id": "nephew",
          "text": "{{player_name}}助けてくれ！！稼働保証契約って一体何なんだ！？代わりに答えてくれ！！",
          "unsent_placeholder": "タイラーがメッセージの送信を取り消しました",
          "reveal_ms": 1700,
