          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "unsent_message",
          "sender_id": "theo",
          "text": "まさかレイがあのレアなビートルズの初回プレス盤が消えたのに気づくとは――",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "text",
          "sender_id": "ruby",
          "text": "テオ！！あんた4万ドルの初回プレス盤レコードを盗んだの！？",
