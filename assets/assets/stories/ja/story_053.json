          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "voice_note",
          "sender_id": "miles",
          "duration_sec": 9,
          "transcript": "[レコードのスクラッチ音] 葵、今レコード箱置き場にいる！ターンテーブルで無地のテスト盤が回ってる――それにレイの眼鏡が床に落ちて割れてる！",
          "audio_asset": null,
          "typing_delay_ms": 950,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_choice"
        },
        {
          "id": "e1_n09_choice",
          "type": "choice",
          "prompt": "誰かが路地側のドアの重い防犯シャッターを降ろしました！どうしますか？",
          "options": [
            {
