          "text": "ダニエル！！嘘だと言って！父の暗号を監視するためだけに私と結婚したの？！",
          "timestamp_label": "午後10:18",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n04"
