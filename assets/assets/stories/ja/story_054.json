          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04",
          "ambient": "heartbeat"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "42ページ目は卒業記念焚き火の見開き写真だったよね。あの写真の背景に何が写ってたんだっけ？",
