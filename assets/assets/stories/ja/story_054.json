          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "voice_note",
          "sender_id": "marissa",
          "duration_sec": 9,
          "transcript": "[震える声] {{player_name}}、スピーチの直前にジェイソンからメッセージが来たの！ついに42ページ目を高画質スキャンして、バンパーステッカーに見覚えがあるって言ってた！",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "text",
          "sender_id": "kevin",
          "text": "待てよ……俺、下の階に停めてある車のトランクにまだ昔の卒業アルバムを入れてあるぞ！",
