          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "kevin",
          "text": "待って――誰か思い出テーブルを確認した？展示用の5冊すべての卒業アルバムから42ページ目が破り取られてる。",
