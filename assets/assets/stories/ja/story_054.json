          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "marissa",
          "text": "42ページ目にはひき逃げ車のナンバープレートが写ってたの――",
          "unsent_placeholder": "メッセージの送信が取り消されました",
          "reveal_ms": 1800,
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "beverly",
          "text": "マリッサ！？プロムの夜のひき逃げ事件！？私たちの卒業アルバムでナンバーを見たっていうの！？",
