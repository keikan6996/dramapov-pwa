      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "午前2:18 · 赤い非常用発電機が14階で唸りを上げる中、あなたとプリヤ医師は貨物用エレベーターの操作盤へと全力疾走します。",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "priya",
          "text": "律、グラント看護師が理事本人の本物のカルテを見つけたわ！1408号室はケラー先生の治験薬で致死的な副作用を起こしていたの！",
          "timestamp_label": "午前2:18",
          "typing_delay_ms": 600,
