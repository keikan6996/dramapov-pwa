      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "午前2:25 · 頭上で蛍光灯がちらつく中、ケラー医師が貨物用リフト前の廊下を塞ぎました。",
          "style": "time_skip",
