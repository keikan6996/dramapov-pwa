      "start_node_id": "e2_n01",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "午前0:04 · 庭園の中庭から、チェンさんは2階の封印された祖父の書斎から漏れる温かな琥珀色の光を目撃します。",
          "style": "system_alert",
