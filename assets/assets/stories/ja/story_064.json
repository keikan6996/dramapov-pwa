      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "午後11:20 · 母の書斎。ガラの招待客たちは帰り、父は顧問弁護士たちに電話を掛けています。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
