          "reveal_ms": 1750,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n07"
        },
        {
          "id": "e3_n07",
          "type": "voice_note",
          "sender_id": "stranger",
          "duration_sec": 9,
          "transcript": "[テラスの風音] 俺の母さんは去年の冬に亡くなったよ、奈々。貸金庫の鍵を遺してこう言ったんだ。「残された唯一の誠実な人は、お前の妹だけだ」って。",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n08_choice"
        },
        {
          "id": "e3_n08_choice",
          "type": "choice",
          "prompt": "父が2人のボディガードを連れてテラスへ向かって歩いてきます！どうしますか？",
          "options": [
            {
              "option_id": "opt_shield_julian",
