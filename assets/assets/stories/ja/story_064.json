        {
          "id": "e3_n03",
          "type": "text",
          "sender_id": "player",
          "text": "ママ……ジュリアンのお母さんのことを知っていたの？どうして今まで一度も教えてくれなかったの？",
          "timestamp_label": "午後9:41",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "medium",
