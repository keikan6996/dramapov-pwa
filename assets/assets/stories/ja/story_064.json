        },
        {
          "id": "e4_n02",
          "type": "text",
          "sender_id": "father",
          "text": "ジュリアン、値段を言え。夜明けに現金200万ドルを振り込んでやる、それで私の家族から永遠に立ち去れ。",
          "timestamp_label": "午後11:20",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n03"
