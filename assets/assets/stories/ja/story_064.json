      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "午後9:40 · ボールルームのテラス。室内からジャズが流れ出てくる中、1998年の色褪せた写真があなたの手の中で震えます。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "stranger",
          "text": "裏の日付を見て、奈々。俺の母さんと君の母さんは大学のルームメイトで――父さんの最初の会社の共同創業者だったんだ。",
          "timestamp_label": "午後9:40",
          "typing_delay_ms": 650,
