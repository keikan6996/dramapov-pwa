  "episodes": [
    {
      "episode_number": 1,
      "title": "形見の腕時計",
      "start_node_id": "n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "n01",
          "type": "narrator",
          "text": "午後8:10 · グランド・ボールルーム。父の60歳の誕生日のためにシャンパングラスが鳴り響きます。あなたのスマホが震えました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n02"
        },
        {
          "id": "n02",
          "type": "text",
          "sender_id": "stranger",
          "text": "素晴らしいスピーチだったよ、奈々。26年前に母のベッドサイドテーブルに置き忘れた金のパテックを返しに来たって、父さんに伝えてくれ。",
          "timestamp_label": "午後8:10",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n03"
        },
        {
          "id": "n03",
          "type": "text",
          "sender_id": "player",
          "text": "誰なの？どうして私のプライベート番号を知っているの？",
          "timestamp_label": "午後8:11",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "text",
          "sender_id": "stranger",
          "text": "4番テーブル、黒いタキシード。ジュネーブ研究所認定の親子一致率99.94%。俺たちの父さん、お誕生日おめでとう。",
          "timestamp_label": "午後8:12",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n05"
        },
        {
          "id": "n05",
          "type": "unsent_message",
          "sender_id": "father",
          "text": "今夜ジュリアンに50万ドルを振り込め、そして奈々に見られる前に警備に命じて業務用出口から連れ出させろ！",
          "unsent_placeholder": "父がメッセージの送信を取り消しました",
          "reveal_ms": 1900,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n06"
        },
        {
          "id": "n06",
          "type": "voice_note",
          "sender_id": "mother",
          "duration_sec": 13,
          "transcript": "[震える声] 奈々、4番テーブルを見ないで。あなたのことが5歳の頃からジュリアンのことは知っていたの。あのお父様が、彼は一生ヨーロッパに留まるからと誓っていたのに。",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n07"
        },
        {
          "id": "n07",
          "type": "choice",
          "prompt": "4番テーブルからジュリアンがあなたに向けてグラスを掲げました。どうしますか？",
          "options": [
            {
              "option_id": "opt_meet_balcony",
              "label": "テラスで会おうとメッセージを送る",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "西のテラス。2分だけ。ママの夜を台無しにしないで。",
              "next_node_id": "n08_free"
            },
            {
              "option_id": "opt_check_background",
              "label": "誰が本当に彼をここへ招いたか確認する",
              "cost_type": "vip_rewarded",
              "badge_text": "機密情報 · 広告視聴",
              "player_reply_text": "話す前に一つ――誰があなたに4番テーブルの特別席を用意したの？",
              "next_node_id": "n08_vip"
            }
          ]
        },
        {
          "id": "n08_free",
          "type": "text",
          "sender_id": "stranger",
          "text": "わかった。君のお母さんを傷つけに来たんじゃない。父さんがハイエナどもに会社を売り払おうとしているから来たんだ。",
          "timestamp_label": "午後8:15",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n10_merge"
        },
        {
          "id": "n08_vip",
          "type": "narrator",
          "text": "極秘情報：4番テーブルを予約したのはあなたのお父様自身の最高財務責任者でした――一族の議決権株式を分裂させるためにジュリアンを利用しようとしていたのです！",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "n09_vip"
        },
        {
          "id": "n09_vip",
          "type": "text",
          "sender_id": "stranger",
          "text": "鋭いね。内紛を起こさせるために君のところの最高財務責任者が俺を飛行機で呼び寄せたんだよ。奴が動く前にテラスで会おう。",
          "timestamp_label": "午後8:15",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n10_merge"
        },
        {
          "id": "n10_merge",
          "type": "text",
          "sender_id": "father",
          "text": "奈々、今すぐステージに上がりなさい。デザートの前に後継者発表をする。",
          "timestamp_label": "午後8:17",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n11_end"
        },
        {
          "id": "n11_end",
          "type": "cliffhanger",
          "headline": "スポットライトの罠",
          "teaser_text": "エピソード2：父がマイクを握る中、ジュリアンも自分用のマイクを持って真っすぐステージへと歩いてきます。",
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "2人の後継者、1つのステージ",
      "start_node_id": "n01",
      "default_ambient": "heartbeat",
      "nodes": [
        {
          "id": "n01",
          "type": "narrator",
          "text": "午後8:22 · ボールルーム・ステージ。300人のゲストが見守っています。ジュリアンは演壇のすぐ横で立ち止まりました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n02"
        },
        {
          "id": "n02",
          "type": "text",
          "sender_id": "stranger",
          "text": "30秒だけ俺を信じてくれ、奈々。1番テーブルでほくそ笑んでいるのが誰か見てみろ――君のところの最高財務責任者だ。",
          "timestamp_label": "午後8:22",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n03"
        },
        {
          "id": "n03",
          "type": "text",
          "sender_id": "father",
          "text": "警備員！この男をステージから引きずり下ろせ！",
          "timestamp_label": "午後8:23",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "unsent_message",
          "sender_id": "mother",
          "text": "リチャードやめて！警備が彼を引きずり出すのをマスコミが見たら、明日株価が30%暴落するわ！",
          "unsent_placeholder": "母がメッセージの送信を取り消しました",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n05"
        },
        {
          "id": "n05",
          "type": "voice_note",
          "sender_id": "stranger",
          "duration_sec": 10,
          "transcript": "[低い声] 今夜会社を凍結させる訴訟を起こせば400万ドル払うと言って持ちかけてきた最高財務責任者の声を録音してある。一言言ってくれれば流すぞ。",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n06"
        },
        {
          "id": "n06",
          "type": "choice",
          "prompt": "カメラのフラッシュが瞬いています。ジュリアンは敵でしょうか――それともあなたの盾でしょうか？",
          "options": [
            {
              "option_id": "opt_introduce_brother",
              "label": "新しい共同顧問として彼を紹介する",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "警備員、下がって。皆様、ご紹介します、ジュリアンさんです――たった今、内部クーデターから我が社を救ってくださった方です。",
              "next_node_id": "n07_free"
            },
            {
              "option_id": "opt_expose_cfo",
              "label": "館内放送音響で最高財務責任者の贈賄録音を再生する",
              "cost_type": "vip_rewarded",
              "badge_text": "実力行使 · 広告視聴",
              "player_reply_text": "それより忠誠心に乾杯いたしましょう――昨夜、弊社の最高財務責任者が掛けていた個人的な通話から始めます。",
              "next_node_id": "n07_vip"
            }
          ]
        },
        {
          "id": "n07_free",
          "type": "narrator",
          "text": "会場は唖然とした拍手の渦に包まれました。父はあなたを見つめ、あなたがこの部屋の誰よりも一枚上手だったことを悟りました。",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n09_merge"
        },
        {
          "id": "n07_vip",
          "type": "narrator",
          "text": "会場が大爆発：敵対的買収を企む最高財務責任者の声がすべてのスピーカーから轟き渡りました。彼は出口へ向かって猛ダッシュしました。",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "n08_vip"
        },
        {
          "id": "n08_vip",
          "type": "text",
          "sender_id": "mother",
          "text": "なんということ、奈々……あなたはお父様よりずっと見事に切り抜けたわね。",
          "timestamp_label": "午後8:28",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n09_merge"
        },
        {
          "id": "n09_merge",
          "type": "text",
          "sender_id": "stranger",
          "text": "俺たち、危ないくらい最強のコンビだな、妹よ。さて――父さんが俺たちのどちらにもまだ話していないことについて話そうか。",
          "timestamp_label": "午後8:30",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n10_end"
        },
        {
          "id": "n10_end",
          "type": "cliffhanger",
          "headline": "血の同盟",
          "teaser_text": "ジュリアンがあなたに1998年の色褪せた写真を1枚手渡しました――あなたのお母様とジュリアンのお母様が親友として肩を並べて写っていました。",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
