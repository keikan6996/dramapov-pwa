        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "sil",
          "text": "Tetap saja di lift barang itu, {{player_name}}! Akuntan biasa sepertimu tak pantas bertemu Ketua Obsidian Group—aku yang pakai tiketmu!",
