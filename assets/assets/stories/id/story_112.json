        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "cfo",
          "text": "Semuanya, kenalkan si pencuri! Anak magang {{player_name}} mentransfer $4 juta keluar dari kas Zenith! Berlutut dan mengaku sebelum HR memanggil polisi!",
