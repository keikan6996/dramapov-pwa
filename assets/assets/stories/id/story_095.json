          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Kamu memotret jernih menembus kaca depan saat ia mengernyit kena silau—lalu mengenali bekas luka bergerigi di pipinya. Dia sopir truk derek dari SPBU 30 km di belakang.",
          "style": "system_alert",
          "sfx": "photo_snap",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Dia memotong selang remku di SPBU!! Itu sebabnya mobilku tergelincir di Mil 18!",
          "timestamp_label": "23:11",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "emt",
          "text": "Berhenti membunyikan klakson, {{player_name}}. Tak ada yang mendengarmu dalam kabut ini.",
          "timestamp_label": "23:12",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "KRAK! Kaca pintu pengemudi retak menjadi jaring putih. Dia mengayunkan alat itu kembali untuk pukulan kedua.",
