          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "disp",
          "text": "Polisi jalan raya melaju ke Pine Pass—bertahanlah! Tekan klakson mobilmu terus-menerus untuk menakutinya!",
