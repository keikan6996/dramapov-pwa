          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "[Pesan Darurat] Halo 911, aku baik-baik saja—ambulans kalian baru saja sampai di Patok Mil 18 cepat sekali!",
          "timestamp_label": "23:09",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "disp",
          "text": "IBU/BAPAK, KUNCI PINTU MOBIL ANDA SEKARANG! Pusat Kabupaten mengirim NOL ambulans di Pine Pass malam ini! Unit terdekat berjarak 22 km!",
