          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ghost",
          "text": "Jangan serahkan ponsel ini ke awak kabin, {{player_name}}. Lihat ke Kursi 14A.",
