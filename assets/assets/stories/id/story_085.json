          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ghost",
          "text": "Dia pengkhianatnya! Kunci dirimu di Toilet 2B dan tunggu sinyalku—aku sedang memalsukan sistem ACARS kokpit sekarang!",
          "timestamp_label": "23:18",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "Lampu kabin mendadak meredup menjadi kuning redup. Pria di Kursi 14A melepas sabuk pengamannya dan berdiri—memblokir lorong antara dirimu dan toilet.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
