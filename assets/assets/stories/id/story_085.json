        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Tak Ada Jalan Lari di 35.000 Kaki",
          "teaser_text": "Pria di 14A berjalan lurus ke arah kursimu, dan Elena baru saja mengunci tirai kokpit di belakangnya.",
