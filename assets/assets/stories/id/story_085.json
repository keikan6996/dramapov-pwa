          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Kamu wanita yang menabrakku di Gerbang 19! Kenapa kamu menaruh ini di tasku?!",
