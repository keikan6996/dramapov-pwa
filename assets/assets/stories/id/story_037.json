        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, aku baru membuka brankas Nenek! Ada amplop merah berisi satu aturan: sampirkan kain beludru di atas potret Ruang Timur sebelum pukul 00:00!",
