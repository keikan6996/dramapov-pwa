          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Itu sebabnya dia menghapus kartu aksesku! AURA, kenapa KAMU membantuku membongkar Hale?!",
