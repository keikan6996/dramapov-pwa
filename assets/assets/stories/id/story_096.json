          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "aura",
          "text": "[Terminal Privat] Selamat pagi, {{player_name}}. Data biometrik Anda telah dihapus dari Nexus Corp 3 jam 42 menit yang lalu.",
