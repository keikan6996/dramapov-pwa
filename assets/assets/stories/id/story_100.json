          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "viktor",
          "text": "Whoa—kamu muncul lewat terowongan uap?! Tunggu... diam di tempat! Jangan colokkan drive ke Konsol A dulu!",
