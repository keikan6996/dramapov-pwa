          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Tunggu... liftnya cuma ada tombol 1, 2, 3, dan 5! Bagaimana kamu tahu namaku?!",
