          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "r409",
          "text": "JANGAN gunakan kartu kunci 409, {{player_name}}. Cek tombol lift—tidak ada lantai 4.",
