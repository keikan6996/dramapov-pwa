        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "Kamu memecahkan tuas tarik merah. Alat penyiram air menghujani lantai, kunci magnet melepas semua pintu darurat, dan sirene polisi transit menggema menuruni eskalator.",
          "style": "system_alert",
          "sfx": "gasp",
