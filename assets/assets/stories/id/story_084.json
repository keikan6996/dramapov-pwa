      "episode_number": 1,
      "title": "Bergerak Bersamamu",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "22.12 · PERINGATAN PELACAKAN: Sebuah AirTag tak dikenal telah bergerak bersamamu sejak pukul 18.04. Ketuk untuk memutar suara.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "Liam, aku di kereta Jalur Merah larut malam dan ponselku baru saja mendeteksi AirTag tak dikenal menempel padaku!",
          "timestamp_label": "22:12",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "liam",
          "text": "Periksa saku mantel dan ritsleting ranselmu sekarang! Jangan turun di stasiun sepi, {{player_name}}.",
          "timestamp_label": "22:13",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "narrator",
          "text": "Kamu mengetuk \"Putar Suara.\" Cuitan logam samar bergetar di balik keliman mantelmu—dijahit rapi ke dalam lapisan yang sobek. Pengeras suaranya sudah dilubangi untuk meredam bunyi.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "seat4b",
          "text": "Tinggalkan mantel itu di kursi, {{player_name}}. Kamu tak akan mau tahu siapa yang membayar pelacak itu.",
          "unsent_placeholder": "Kursi 4B menarik pesan",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Seorang pria bertopi abu-abu di seberang lorong menatap pantulanmu di kaca:",
          "options": [
            {
              "option_id": "opt_084_e1_free",
              "label": "Cabut AirTag & buang ke tempat sampah",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Aku buang pelacak ini di pemberhentian berikutnya lalu pindah gerbong.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_084_e1_vip",
              "label": "Pindai nomor seri NFC AirTag dulu",
              "cost_type": "vip_rewarded",
              "badge_text": "Rahasia · Tonton Iklan",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Pintu mendesis terbuka di Stasiun Oak. Kamu melempar AirTag itu ke peron—dan pria bertopi abu-abu itu TIDAK mengikutinya. Dia justru melangkah masuk ke gerbong barumu.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "seat4b",
          "text": "Yang itu cuma umpan, {{player_name}}. Cek sol sepatu kets kirimu.",
          "timestamp_label": "22:16",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Kamu menempelkan ponselmu ke cakram putih itu. Layar NFC menampilkan nomor telepon pemilik yang disamarkan—empat digit terakhirnya 8842. Nomor lama kakakmu, Liam.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Liam... kenapa AirTag ini terdaftar atas nomor telepon berakhiran 8842?!",
          "timestamp_label": "22:16",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "voice_note",
          "sender_id": "liam",
          "duration_sec": 8,
          "transcript": "[napas panik] {{player_name}}, dengarkan aku! Kartu SIM lamaku tak dibatalkan—rentenir yang menagih utangku mengkloningnya! Orang di kereta itu tak mengincarmu, dia memakaimu untuk menemukan AKU!",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "seat4b",
          "text": "Tinggal dua perhentian menuju ujung jalur. Bilang ke Liam aku membawa adiknya ke pertemuan.",
          "timestamp_label": "22:17",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Ujung Jalur",
          "teaser_text": "Rem kereta menjerit saat memasuki terowongan depo yang gelap—dan lampu di Gerbong 4 berkedip padam.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
