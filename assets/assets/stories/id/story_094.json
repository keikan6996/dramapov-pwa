        },
        {
          "id": "e1_n02",
          "type": "voice_note",
          "sender_id": "ch02",
          "duration_sec": 6,
          "transcript": "[statis radio, bisikan tenang] \"Empat langkah ke kulkas, Dira. Sekarang cek apakah kamu mengunci ruang anggur.\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Claire!! Maaf membangunkanmu di Paris—monitor bayimu baru saja menangkap suara seseorang yang mengawasiku di dapur!",
