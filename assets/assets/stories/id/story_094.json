          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Semua lampu sorot luar padam serentak. Melalui pengeras suara monitor bayi, langkah kaki pelan menaiki tangga spiral.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "ch02",
          "text": "Beri tahu Claire utang suaminya sudah jatuh tempo, Dira. Buka brankasnya atau aku naik ke atas.",
