          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "claire",
          "text": "JANGAN sentuh tombol pembuka hijau di ruang panik! Keamanan 8 menit lagi tiba!",
          "timestamp_label": "02:17",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Kamu mengelupas sambungan longgar di wallpaper berwarna pastel itu. Di baliknya tersembunyi brankas dinding—terbuka lebar, penuh paspor palsu dan sepucuk pistol berperedam.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Claire... kenapa ada enam paspor berbeda berfoto suamimu tersembunyi di balik dinding ini?!",
