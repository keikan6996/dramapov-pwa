          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "claire",
          "text": "Apa?! Kami TIDAK punya bayi, Dira! Kami sudah menjual perabot kamar bayi itu dua tahun lalu—keluar dari dapur!",
