        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "22.52 · BADAI SALJU -25°C. Nol bar sinyal seluler. Aplikasi mendaki luringmu berdenting: \"REKAN TERHUBUNG VIA BLUETOOTH MESH — JARAK: 4,5 M.\"",
          "style": "system_alert",
