          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "cole",
          "text": "Kendaraan salju 12 menit lagi! Menjauh dari jendela lantai dasar—naik ke loteng tidur!",
          "timestamp_label": "22:55",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Kamera pengintai teras menyala dalam penglihatan malam. TIDAK ada narapidana buron di teras—melainkan seorang wanita berseragam jagawana yang berdarah, dan bayangan kedua ada di belakangnya.",
          "style": "system_alert",
          "sfx": "photo_snap",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Tunggu... kalau orang yang berdarah di terasku memakai lencana Jagawana, lalu SIAPA yang di radio mengaku sebagai Jagawana Cole?!",
          "timestamp_label": "22:55",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Indikator sinyal Bluetooth berubah: \"JARAK: 1,2 M — JENDELA RUANG LUMPUR BELAKANG.\" Kaca pecah berantakan di dapur.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "btnode",
          "text": "Dia mencuri radio jagawana asli, {{player_name}}! Dia masuk lewat jendela belakang—BIARKAN AKU MASUK!",
