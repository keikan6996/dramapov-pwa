              "badge_text": "Rahasia · Tonton Iklan",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Kamu mendorong meja makan kayu ek berat ke pintu depan. Mendadak lampu kabin berkedip dan mati—dia baru saja merenggut kotak sekring luar dari dinding.",
