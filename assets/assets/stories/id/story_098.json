          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "btnode",
          "text": "Tolong buka pintu teras, {{player_name}}! Mobil saljuku terbalik di gundukan—aku hampir mati membeku di luar sini!",
