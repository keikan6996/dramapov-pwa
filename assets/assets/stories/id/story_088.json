          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Lampu sorot kapal membelah kabut pelabuhan, menguncimu di balik tiang-tiang basah.",
