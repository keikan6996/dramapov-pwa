          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "nadia",
          "text": "[Catatan Terjadwal] Jika Mr. K mengirimimu pesan, artinya dia mengawasi Loker 09. Ambil drive asli dari Tiang 3 dan larilah.",
