          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Gerbang depan fasilitas gudang berdenting terbuka di pemindai Marco:",
          "options": [
            {
              "option_id": "opt_097_e1_free",
              "label": "Tinggalkan koper & kabur lewat gang",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Lupakan $400 itu, Marco—ambil pemotong baut dan lari ke truk!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_097_e1_vip",
              "label": "Pindai kode batang yang tercetak di koper",
              "cost_type": "vip_rewarded",
              "badge_text": "Rahasia · Tonton Iklan",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Kamu berlari ke arah truk pikap Marco—hanya untuk melihat sebuah van hitam dof meluncur senyap melintangi jalur keluar, memblokir bempermu.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "marco",
          "text": "Kita terkurung!! Tunggu—kenapa manajer gudang baru saja keluar dan melambaikan tangan mengarahkan van itu lurus ke Baris C?!",
          "timestamp_label": "20:50",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Kamu memindai nomor seri ukiran laser itu. Itu bukan uang curian—itu pelat cetak Departemen Keuangan Federal Reserve yang dilaporkan hilang dari mobil lapis baja musim dingin lalu.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "marco",
          "text": "Pelat cetak Departemen Keuangan?! Nilainya dua puluh juta di pasar gelap—pantas saja mereka sudah di gerbang!",
          "timestamp_label": "20:50",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "voice_note",
          "sender_id": "u77",
          "duration_sec": 7,
          "transcript": "[ban van menggilas kerikil] \"Jangan lari, Nanda. Orang-orang kami baru saja mengunci pagar keliling. Melangkahlah ke cahaya dengan tangan di atas.\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "Sorot lampu depan membanjiri Baris C, menguncimu di antara dua deret rana baja. Marco berbisik: \"Unit 78 di sebelah punya gembok berkarat—kita bisa menjebol dinding gipsumnya!\"",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Terjebak di Baris C",
          "teaser_text": "Tiga pria bersenjata baru saja turun dari van hitam—dan manajer gudang membantu mereka memburumu.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
