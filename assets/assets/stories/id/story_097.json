      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "20.47 · Fasilitas Gudang SafeKeep. Kamu menggulung pintu rana bergelombang Unit 77. Di dalamnya hanya ada koper titanium—terborgol ke telepon satelit yang berpendar.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "marco",
          "text": "Wah!! Kita bayar $400 buat unit ini dan ada koper kelas militer di dalamnya?! Congkel buka, Nanda!",
          "timestamp_label": "20:47",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Tunggu—saat aku memotret kopernya, ponsel yang terborgol itu bergetar menerima pesan.",
          "timestamp_label": "20:48",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "u77",
          "text": "Taruh koper itu dan tutup pintu rananya, Nanda. Sensor gerak baru saja memicu penjemputan 10 menit.",
