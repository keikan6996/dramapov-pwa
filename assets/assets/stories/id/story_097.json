          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "u77",
          "text": "Kalau segel pengamannya patah, paket pewarnanya bukan tinta—melainkan termit.",
