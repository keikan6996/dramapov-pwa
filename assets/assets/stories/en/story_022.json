    {
      "episode_number": 1,
      "title": "Lullaby From the Wall",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "3:02 AM · A Bluetooth notification flashes: \"NurseryCam_6C Connected.\" Static hisses from your speaker.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Jordan?! Why did your app just share a live nursery feed with me? Did you adopt a cat or something?",
          "timestamp_label": "3:02 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "I didn’t share anything! It paired by itself. And Tessa… the camera angle is pointing straight at MY bed.",
          "timestamp_label": "3:03 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "Shhh. Don’t wake the baby behind your wardrobe.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "Wait, I can hear someone humming a lullaby on the feed. Jordan, check your closet right now.",
