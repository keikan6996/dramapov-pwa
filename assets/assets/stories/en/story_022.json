              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Checking the old floorplan...",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "Something knocks back—exactly where your ear is pressed. On the screen, the camera lens rotates to face you.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: Apt 6C used to have a 4-foot nursery alcove behind your closet—bricked over in 2016.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "OMG Jordan, look at the live feed! Something small just crawled OUT of your air vent!",
          "timestamp_label": "3:06 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
