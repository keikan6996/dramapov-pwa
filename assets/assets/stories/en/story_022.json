          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "A tiny, wet giggle echoes from BOTH your phone and the dark corner of your bedroom.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "You mute the call, but the speaker turns itself to max volume: \"Mama, why did you lock me in the wall?\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "The Wall Is Hollow",
          "teaser_text": "Episode 2: The plaster behind your closet cracks open from the inside.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Behind the Drywall",
      "start_node_id": "e2_n01",
      "default_ambient": "heartbeat",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "3:08 AM · White plaster dust drifts out from behind your wardrobe. Your phone screen stays locked on the night-vision feed.",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "I called the landlord! He hung up the second I mentioned the sealed room in 6C. Get out of there NOW!",
          "timestamp_label": "3:08 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "My front door deadbolt won’t turn. It’s jammed from the outside—wait, the lullaby stopped.",
