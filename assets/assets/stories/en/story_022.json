          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 11,
          "transcript": "[creaking floorboards, soft off-key lullaby] ...Hush little sleeper, the drywall is thin...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "Soft scratching starts directly behind your bedroom wall.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Press your ear against the wall",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I’m listening to the wall...",
              "next_node_id": "e1_n08_free"
