    {
      "episode_number": 1,
      "title": "Lot #19 Missing",
      "start_node_id": "e1_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "10:30 PM · Staff Chat \"VANDERBILT GALLERY\". After the charity gala, Vault C is open and empty.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "julian",
          "text": "Lockdown active. Lot #19—the Duchess Emerald—is gone. And Curator Arthur isn’t answering.",
          "timestamp_label": "10:30 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "celeste",
          "text": "Impossible! The vault requires dual biometrics plus a rotating 6-digit PIN.",
          "timestamp_label": "10:31 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—the alarm never tripped. That means whoever opened Vault C used a valid PIN.",
          "timestamp_label": "10:31 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05",
          "ambient": "heartbeat"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "nadia",
          "text": "492817 wasn’t supposed to work after 9 PM—",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1750,
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "julian",
          "text": "Nadia. How the hell do you know tonight’s rotating vault PIN?!",
          "timestamp_label": "10:32 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "voice_note",
          "sender_id": "nadia",
          "duration_sec": 9,
          "transcript": "[whispering] Quinn, Arthur texted me that code at 8:50 PM! He said someone swapped the real emerald for glass BEFORE the gala!",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "text",
          "sender_id": "celeste",
          "text": "Ridiculous. I personally certified the emerald under a loupe at 6 PM!",
          "timestamp_label": "10:33 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n09_choice"
        },
        {
          "id": "e1_n09_choice",
          "type": "choice",
          "prompt": "Police are 5 minutes out. Where do you check first?",
          "options": [
            {
              "option_id": "opt_vault_cam",
              "label": "Pull Vault C’s thermal motion sensor log",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Julian, pull Vault C’s thermal log from 6 PM to 9 PM!",
              "next_node_id": "e1_n10_free"
            },
            {
              "option_id": "opt_loupe_desk",
              "label": "Check Celeste’s appraisal case in Room B",
              "cost_type": "vip_rewarded",
              "badge_text": "Clue · Watch Ad",
              "player_reply_text": "I’m checking Celeste’s velvet appraisal case right now.",
              "next_node_id": "e1_n10_vip"
            }
          ]
        },
        {
          "id": "e1_n10_free",
          "type": "narrator",
          "text": "THERMAL LOG: Two people entered Vault C at 6:12 PM—and only ONE walked back out.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n10_vip",
          "type": "narrator",
          "text": "EVIDENCE FOUND: Hidden under the foam of Celeste’s case is a jeweler’s receipt for a cubic zirconia replica.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n11_merge",
          "type": "text",
          "sender_id": "julian",
          "text": "Quinn, we just heard knocking from behind the false wall in the Restoration Wing!",
          "timestamp_label": "10:36 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12_end"
        },
        {
          "id": "e1_n12_end",
          "type": "cliffhanger",
          "headline": "Curator Arthur Never Left The Building",
          "teaser_text": "Episode 2: And he saw who switched the necklace before the lights went out.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
