    {
      "episode_number": 1,
      "title": "Table For Two",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "7:30 PM · Le Jardin Bistro. Wearing an apron to help your retiring mentor Chef Henri through his final dinner rush, you recognize the arrogant laugh at Table 1.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "brad_ex",
          "text": "Well, well! Look who’s still waiting tables, {{player_name}}! Good thing I dumped you last year—Stella’s dad owns three textile factories!",
          "timestamp_label": "07:30 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "stella",
          "text": "Ugh, Damon, she’s your broke ex? Pour our $2,000 champagne on your knees and I’ll tip you a hundred bucks!",
          "timestamp_label": "07:30 PM",
          "typing_delay_ms": 600,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Careful how you spend, Stella. Last I checked, your father’s textile factories are 60 days overdue on a $6 million note.",
          "timestamp_label": "07:32 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "stella",
          "text": "How the hell does a waitress know about our factory debt?! Shut her up, Damon!",
          "unsent_placeholder": "Stella unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Damon snaps his fingers loudly to summon the manager:",
          "options": [
            {
              "option_id": "opt_story_113_e1_free",
              "label": "Smile & call Chef Henri over yourself",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "No need to shout, Damon. Let’s ask the manager who owns Table 1.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_113_e1_vip",
              "label": "Show them the signed bistro buyout deed",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Chef Henri walks out from the kitchen wiping his hands—and bows respectfully right in front of you.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "chef",
          "text": "Everything alright, Boss {{player_name}}? Should I revoke Table 1’s reservation?",
          "timestamp_label": "07:32 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You set your tablet on the white tablecloth—displaying the $8M Le Jardin Acquisition Deed signed by you at 9 AM!",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "brad_ex",
          "text": "WAIT A SECOND... YOU BOUGHT LE JARDIN FOR $8 MILLION?!",
          "timestamp_label": "07:32 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Every diner in the bistro turns to stare as Damon’s arrogant smirk melts into pure shock.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "player",
          "text": "Oh, and Stella—my conglomerate just bought your father’s $6M defaulted loan this afternoon. Still want me on my knees?",
          "timestamp_label": "07:35 PM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "The New Owner",
          "teaser_text": "Stella’s phone suddenly rings—it’s her father screaming that their sole creditor is demanding immediate payment.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "The $6M Call",
      "start_node_id": "e2_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "7:42 PM · Stella’s phone blares on speaker by accident—broadcasting her father’s terrified voice across the dining room!",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "incoming_call",
          "caller_id": "chef",
          "caller_label": "Chef Henri · Back Office",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n03_ans",
          "on_decline_node_id": "e2_n03_dec"
        },
        {
          "id": "e2_n03_ans",
          "type": "narrator",
          "text": "Henri grins: \"Boss, Stella’s father just called the bistro desk begging for five minutes with Chairwoman {{player_name}}!\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n03_dec",
          "type": "narrator",
          "text": "Message flashes: \"Stella’s dad is driving here right now to beg for a debt extension!\"",
          "style": "system_alert",
          "sfx": "ting_soft",
          "haptic": "medium",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "stella",
          "text": "No!! {{player_name}}, I didn’t know who you were! Damon told me you were a broke waitress! Make him apologize!!",
          "timestamp_label": "07:42 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "image",
          "sender_id": "chef",
          "image_asset": "assets/media/evidence/generic_legal_document.webp",
          "caption": "Debt Assignment Deed: $6,000,000 Textile Factory Lien — now held by {{player_name}}.",
          "blur_until_tap": true,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n06_choice"
        },
        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "Damon instantly drops Stella’s hand and crawls toward you:",
          "options": [
            {
              "option_id": "opt_story_113_e2_free",
              "label": "Kick both out of Table 1 & call the next guests",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Your table is canceled, Damon. Pay for your champagne and leave.",
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_story_113_e2_vip",
              "label": "Expose Damon only dated Stella for the plants",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "Waiters briskly clear Table 1 as diners applaud quietly from every corner of Le Jardin.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "brad_ex",
          "text": "{{player_name}}, wait! I only left you because I thought we’d be poor forever—I still love you!",
          "timestamp_label": "07:45 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "You tap your screen—showing Stella the text Damon sent your cousin last month: \"Marrying Stella just to inherit her dad’s textile plants.\"",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "stella",
          "text": "YOU USER!! We’re over, Damon!!",
          "timestamp_label": "07:45 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "Stella throws her engagement ring straight into Damon’s champagne glass as her frantic father bursts through the bistro doors.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "text",
          "sender_id": "stella",
          "text": "Dad, save us! {{player_name}} owns our $6 million loan!!",
          "timestamp_label": "07:48 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "Father At The Door",
          "teaser_text": "Stella’s father begs on his knees for his factory workers—and Damon makes one last pathetic grab for cash.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
      "episode_number": 3,
      "title": "The Stolen Tab",
      "start_node_id": "e3_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "7:55 PM · While Stella’s father pleads respectfully for a restructuring plan, Damon tries to slip out the side door without paying his $2,000 tab!",
          "style": "banner",
          "sfx": "knock",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "chef",
          "text": "Boss, security caught Damon sneaking out—and his corporate credit card bounced! Turns out he was fired from his bank job last week!",
          "timestamp_label": "07:55 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Fired last week, broke, and still strutting into a Michelin bistro ordering $2,000 champagne?",
