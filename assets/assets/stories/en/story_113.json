          "text": "Five billionaires offered me $10M to turn this bistro into a sterile chain, {{player_name}}. I sold to you for $8M because you still tie on an apron and help.",
          "timestamp_label": "09:30 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n03"
        },
        {
          "id": "e4_n03",
          "type": "text",
          "sender_id": "player",
          "text": "I’ll never change a single recipe, Chef. And your pension is doubled for life.",
          "timestamp_label": "09:30 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e4_n04"
