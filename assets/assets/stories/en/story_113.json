      "title": "The Secret Recipe",
      "start_node_id": "e4_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "9:30 PM · Le Jardin Kitchen. After the last guest leaves, Chef Henri hands you his battered leather recipe book.",
