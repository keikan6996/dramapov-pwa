          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "stella",
          "text": "I’m truly sorry to everyone here. Thank you for saving our 300 workers, {{player_name}}.",
          "timestamp_label": "07:58 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "Your legal team converts the debt into a 60% controlling stake—saving all 300 factory jobs and expanding your fashion supply chain!",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "chef",
          "text": "Brilliant business move AND pure heart, Boss!",
          "timestamp_label": "07:58 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "narrator",
          "text": "Through the kitchen porthole, you glimpse Damon up to his elbows in soapy pots while Chef Henri chuckles.",
