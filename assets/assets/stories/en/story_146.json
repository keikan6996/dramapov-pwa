    {
      "episode_number": 1,
      "title": "Marbles on the Roof",
      "start_node_id": "e1_n01",
      "default_ambient": "mystery_ticking",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:15 AM · First night in Apartment 4B. CLACK-CLACK-CLACK. Glass marbles bounce across the ceiling above your bed.",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "prev_tenant",
          "text": "Hey Taylor, I lived in 4B before you. Did the marbles start? Knock back TWICE on the ceiling—never three times!",
          "timestamp_label": "2:15 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—who gave you my number? And we’re on the top floor! There IS no 5th floor above 4B!",
          "timestamp_label": "2:15 AM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "prev_tenant",
          "duration_sec": 8,
          "transcript": "[whispering, dripping water] \"I know there’s no 5th floor! Only the concrete roof and the water tank! Knock twice NOW before it climbs down the vent!\"",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "landlord",
          "text": "Ignore any texts from the previous tenant. He moved out abruptly.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "The rolling sound stops directly above your pillow:",
          "options": [
            {
              "option_id": "opt_story_146_e1_free",
              "label": "Knock twice on the ceiling with a broom",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Knock... knock. Okay, the rolling just stopped completely!",
              "next_node_id": "e1_n07a"
            },
            {
              "option_id": "opt_story_146_e1_vip",
              "label": "Text Mr. Vance about the roof noise",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Mr. Vance, why is someone walking on the roof above 4B at 2:15 AM?",
              "next_node_id": "e1_n07b"
            }
          ]
        },
        {
          "id": "e1_n07a",
          "type": "text",
          "sender_id": "prev_tenant",
          "text": "Good! Now check under your front door—I left Rule 2 and Rule 3 taped inside the peephole cover.",
          "timestamp_label": "2:17 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08_merge"
        },
        {
          "id": "e1_n07b",
          "type": "text",
          "sender_id": "prev_tenant",
          "text": "Do NOT trust Mr. Vance! If he asks for rent in person after midnight, check if he casts a shadow!",
          "timestamp_label": "2:17 AM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08_merge"
        },
        {
          "id": "e1_n08_merge",
          "type": "narrator",
          "text": "SSSHK. A folded yellow note slides silently under your front door.",
          "style": "banner",
          "sfx": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n09_call"
        },
        {
          "id": "e1_n09_call",
          "type": "incoming_call",
          "caller_id": "landlord",
          "caller_label": "Mr. Vance · Lobby",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n10",
          "on_decline_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "prev_tenant",
          "text": "Don’t read that note, Taylor! Check the 4th-floor hallway camera—nobody is standing outside your door!",
          "timestamp_label": "2:19 AM",
          "typing_delay_ms": 750,
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n11"
        },
        {
          "id": "e1_n11",
          "type": "text",
          "sender_id": "player",
          "text": "Wait... if nobody is in the hallway, then who just slid this note under my door?!",
          "timestamp_label": "2:19 AM",
          "typing_delay_ms": 0,
          "sfx": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n12_cliff"
        },
        {
          "id": "e1_n12_cliff",
          "type": "cliffhanger",
          "headline": "The Note From Nowhere",
          "teaser_text": "Next: The hallway CCTV proves the corridor was dead empty.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
