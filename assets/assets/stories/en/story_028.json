        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "Only dripping water—and three rhythmic knocks synchronized to your exact heartbeat.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
