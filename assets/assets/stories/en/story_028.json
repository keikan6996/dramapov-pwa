    {
      "episode_number": 1,
      "title": "Three Metallic Taps",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:45 AM · Clink. Clink. Clink. Three sharp taps echo up the iron pipe beside your bed.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Rowan, please tell me you didn’t just tap back on the pipe!!",
          "timestamp_label": "2:45 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "I tapped twice to tell whoever’s fixing pipes to shut up! Why, what’s wrong?",
