          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[hollow metallic scraping] ...Two taps back... climbing up to Rowan now...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "The tapping stops on the bedroom pipe—and resumes directly beneath your bathroom floor drain.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Weigh down the bathroom drain cover",
