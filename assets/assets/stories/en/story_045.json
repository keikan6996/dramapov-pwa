          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "text",
          "sender_id": "keller",
          "text": "Do NOT force the freight doors manually. Maintenance is on the way.",
          "timestamp_label": "2:21 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_choice"
        },
        {
          "id": "e1_n09_choice",
          "type": "choice",
          "prompt": "Nora is trapped between floors 13 and 14. What do you check first?",
          "options": [
            {
              "option_id": "opt_pry_door",
              "label": "Help Grant pry open the elevator gap",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Forget waiting—Grant, grab the crowbar from the supply closet!",
              "next_node_id": "e1_n10_free"
            },
            {
              "option_id": "opt_audit_file",
              "label": "Open Nora’s unlocked chart terminal",
              "cost_type": "vip_rewarded",
              "badge_text": "Evidence · Watch Ad",
              "player_reply_text": "Hold on, Nora left her terminal logged into Room 1408’s chart!",
              "next_node_id": "e1_n10_vip"
            }
          ]
        },
        {
          "id": "e1_n10_free",
          "type": "narrator",
          "text": "You wedge the steel doors open six inches. Nora’s pale hand slides a folded prescription sheet through the gap.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n10_vip",
          "type": "narrator",
          "text": "AUDIT ALERT: Three vials of restricted sedative were billed to empty Room 1408 using DR. KELLER’S login—five minutes ago.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n11_merge",
          "type": "text",
          "sender_id": "priya",
          "text": "{{player_name}}, the generator just switched off again—and the stairwell door locked.",
          "timestamp_label": "2:23 AM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12_end"
        },
        {
          "id": "e1_n12_end",
          "type": "cliffhanger",
          "headline": "The Elevator Cable Just Groaned",
          "teaser_text": "Episode 2: Someone is inside the elevator machine room on the roof.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
