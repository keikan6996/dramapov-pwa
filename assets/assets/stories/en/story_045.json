          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n05",
          "ambient": "heartbeat"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "keller",
          "text": "I told her to check the chart audit log, not the pharmacy—",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1750,
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "priya",
          "text": "Dr. Keller? What chart audit? Nobody told us about an audit.",
          "timestamp_label": "2:20 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "voice_note",
          "sender_id": "grant",
          "duration_sec": 10,
          "transcript": "[static, muffled voice in background] {{player_name}}, I’m by Freight Elevator B! Nora’s banging on the hatch—she says someone cut the emergency phone!",
