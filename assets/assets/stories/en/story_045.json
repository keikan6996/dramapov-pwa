    {
      "episode_number": 1,
      "title": "Backup Generator",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:18 AM · Shift Group \"ST. JUDE WARD 14\". Emergency red lights hum after a 90-second blackout.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "grant",
          "text": "Has anyone seen Intern Nora? Her pager is on the nurse station desk.",
          "timestamp_label": "2:18 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "priya",
          "text": "She went down to pharmacy for Room 1408’s insulin drip right before the lights cut.",
          "timestamp_label": "2:19 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—Room 1408 was discharged at 6 PM. Why would Nora pull an insulin drip for an empty room?",
