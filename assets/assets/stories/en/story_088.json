    {
      "episode_number": 1,
      "title": "180 Days Silent",
      "start_node_id": "e1_n01",
      "default_ambient": "mystery_ticking",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "12:00 AM · VAULT AUTO-DISPATCH: 180-day inactivity threshold reached. Delivering final package from Nadia to {{player_name}}.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "voice_note",
          "sender_id": "nadia",
          "duration_sec": 11,
          "transcript": "[urgent whisper, rain] {{player_name}}, if you’re hearing this, I didn’t make it to the ferry. The senator’s offshore ledger is buried under Dock 14—locker 09. Don’t trust the police.",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Nadia?! Wait—this vault message just showed \"Delivered & Read\" on a second device!",
          "timestamp_label": "12:01 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "mrk",
          "text": "We’ve been waiting six months for Nadia’s timer to expire, {{player_name}}. Thank you for opening Locker 09’s location for us.",
          "timestamp_label": "12:02 AM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "mrk",
          "text": "Oh, and your sister isn’t dead—yet. Bring the drive to Dock 14 if you want to keep it that way.",
          "unsent_placeholder": "Mr. K unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Nadia might still be alive. How do you handle Dock 14?",
          "options": [
            {
              "option_id": "opt_088_e1_free",
              "label": "Race to Dock 14 before Mr. K arrives",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Don’t touch her! I’m heading to Dock 14 right now.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_088_e1_vip",
              "label": "Decrypt hidden file in Nadia’s vault",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You pry open rusted Locker 09 beneath the pier. Inside lies a waterproof pelican case—and a polaroid of Nadia holding today’s newspaper.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "player",
          "text": "She’s alive! Wait... why is there a fresh padlock on the locker if she vanished six months ago?!",
          "timestamp_label": "12:24 AM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You enter your childhood dog’s name. A hidden map unlocks: Locker 09 is a trap rigged with a GPS beacon. The REAL ledger is taped under the pier’s third piling.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "nadia",
          "text": "[Scheduled Note] If Mr. K texted you, it means he’s watching Locker 09. Grab the real drive from Piling 3 and run.",
          "timestamp_label": "12:24 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "A boat spotlight slices through the harbor fog, pinning you against the wet pilings.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "mrk",
          "text": "Step onto the boat, {{player_name}}. Someone on board is dying to see you.",
          "timestamp_label": "12:25 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "On The Harbor Boat",
          "teaser_text": "A silhouette steps into the boat’s cabin light—it’s Nadia, unbound, holding a pistol.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
