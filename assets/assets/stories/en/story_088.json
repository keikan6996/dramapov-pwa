      "title": "Ghost Journalist",
      "start_node_id": "e2_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "12:27 AM · Waves slap the hull. Nadia stands on the deck beside Mr. K—then subtly taps her ear twice, your childhood signal for \"Play along.\"",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "incoming_call",
          "caller_id": "nadia",
          "caller_label": "Nadia · Encrypted",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n03_ans",
          "on_decline_node_id": "e2_n03_dec"
        },
        {
          "id": "e2_n03_ans",
          "type": "voice_note",
          "sender_id": "nadia",
          "duration_sec": 7,
          "transcript": "[whispered into hidden mic] Don’t hand him the drive yet! When I shout \"DIVE\", jump off the starboard rail—federal boats are 30 seconds out!",
          "audio_asset": null,
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n03_dec",
          "type": "text",
          "sender_id": "nadia",
          "text": "Stall him for 30 seconds! I’m wearing a wire for the Justice Department—the raid boats are right behind the fog bank!",
          "timestamp_label": "12:27 AM",
          "typing_delay_ms": 500,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "mrk",
          "text": "Toss the ledger on the deck, {{player_name}}. No sudden moves.",
          "timestamp_label": "12:28 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "text",
          "sender_id": "player",
          "text": "I’ll give it to you—but let Nadia cross to the pier first!",
          "timestamp_label": "12:28 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n06_choice"
        },
        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "Mr. K raises his radio. Time is up:",
          "options": [
            {
              "option_id": "opt_088_e2_free",
              "label": "Slide the decoy case across the deck",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Catch! Now back off!",
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_088_e2_vip",
              "label": "Broadcast the live wire to news feeds",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "Mr. K lunges for the case—just as Nadia kicks the throttle into reverse and yells \"DIVE!\" Three Coast Guard floodlights explode through the mist.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "nadia",
          "text": "Grab the rescue ladder, {{player_name}}! We got him on tape confessing to the whole operation!",
          "timestamp_label": "12:30 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "You bridge Nadia’s wire straight to her newsroom’s emergency stream. Within seconds, 40,000 viewers hear Mr. K name the senator live.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "mrk",
          "text": "You’re broadcasting?! Kill the engine—we’re burned!",
          "timestamp_label": "12:30 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "unsent_message",
          "sender_id": "nadia",
          "text": "One problem: the senator wasn’t the top name on that drive.",
          "unsent_placeholder": "Nadia unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "text",
          "sender_id": "nadia",
          "text": "I missed you, {{player_name}}. Now dry off—our story is only half over.",
          "timestamp_label": "12:32 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "The Name Above The Senator",
          "teaser_text": "Nadia is safe and Mr. K is in cuffs—but the encrypted ledger holds one more name that could bring down the entire cabinet.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
