    {
      "episode_number": 1,
      "title": "Bed 14 Is Calling",
      "start_node_id": "e1_n01",
      "default_ambient": "office_tension",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:52 AM · Ward B is dead silent. Suddenly, the red light above Room 14 blinks on and chimes three times.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, I see the Bed 14 alert on the central tablet. Tell me it’s a wiring glitch.",
          "timestamp_label": "2:52 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Room 14 is padlocked from the outside, Doctor. I can see the red light glowing through the frosted glass.",
          "timestamp_label": "2:53 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "My IV drip is empty. Come change it.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "Do NOT unlock that room! Wait for security—the patient chart for Bed 14 just auto-updated in the system!",
          "timestamp_label": "2:54 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[heart monitor flatlining, wheezing breath] ...Nurse {{player_name}}... it hurts so much... open the door...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "A heavy hospital gurney scrapes across the tiles behind the locked door.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Reset the nurse call panel",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Cutting power to the call panel!",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "Open the updated Bed 14 chart",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Checking the patient chart...",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "The panel dies—yet the call bell keeps ringing inside Room 14, faster and faster.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: Patient Name: {{player_name}}. Admitted: Tonight, 3:00 AM. Condition: Critical.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "Security isn’t answering! And the elevator to Ward B just locked itself in maintenance mode!",
          "timestamp_label": "2:56 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "Room 14 Intercom",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "A raspy voice whispers: \"You forgot to unstrap me during the fire, Nurse. Now it’s your turn.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "You hit decline. The steel padlock on Room 14 snaps clean in half and hits the floor.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "Room 14 Is Open",
          "teaser_text": "Episode 2: The smell of smoke pours into Ward B—and the door swings wide.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Code Black on Ward B",
      "start_node_id": "e2_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "2:58 AM · Thick gray haze creeps across the linoleum floor. An empty wheelchair rolls slowly out of Room 14.",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "I’m running up the emergency stairwell with two guards! Lock yourself inside the meds room, {{player_name}}!",
          "timestamp_label": "2:58 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "The wheelchair stopped right outside my desk. The wheels are leaving wet black soot tracks.",
          "timestamp_label": "2:59 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[oxygen mask hissing] ...Check my pulse, {{player_name}}... Why won’t anyone check my pulse?...",
