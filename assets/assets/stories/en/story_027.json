          "id": "e2_n11_ans",
          "type": "narrator",
          "text": "Dr. Patel stares at your wrist: \"{{player_name}}... when did you put on a Bed 14 patient bracelet?\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
