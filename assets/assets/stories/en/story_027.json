              "next_node_id": "e2_n08_vip"
            }
          ]
        },
        {
          "id": "e2_n08_free",
          "type": "narrator",
          "text": "Cold water rains from the ceiling. The smoke hisses away—and the wheelchair collapses empty onto its side.",
