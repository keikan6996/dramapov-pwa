          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "Dr. Patel bursts onto Ward B soaking wet. Room 14’s door stands shut again—with the padlock intact.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "medium",
