            },
            {
              "option_id": "opt_story_148_e4_vip",
              "label": "Delete the Station 9 thread immediately",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Deleting that thread forever—I never want to see Station 9 again!",
              "next_node_id": "e4_n07b"
            }
          ]
        },
        {
          "id": "e4_n07a",
          "type": "text",
          "sender_id": "stranger",
          "text": "Mark goes pale: \"Two other survivors from Car 4 just showed me the exact same message...\"",
          "timestamp_label": "12:39 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n08_merge"
        },
        {
          "id": "e4_n07b",
          "type": "text",
          "sender_id": "stranger",
          "text": "Mark sighs in relief: \"Good call. Some things down in Tunnel 9 are better left buried.\"",
          "timestamp_label": "12:39 AM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n08_merge"
        },
        {
          "id": "e4_n08_merge",
          "type": "narrator",
          "text": "Rain hits your face—real, cold, and alive—as the ambulance doors shut behind you.",
          "style": "banner",
