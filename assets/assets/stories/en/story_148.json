          "prompt": "The emergency elevator reaches street level:",
          "options": [
            {
              "option_id": "opt_story_148_e4_free",
              "label": "Show the paramedic the unsent alert",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Look! It literally just unsent a warning right in front of us!",
