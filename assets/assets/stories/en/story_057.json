      "default_ambient": "mystery_ticking",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "5:42 PM · Trail Mesh Chat \"EAGLE RIDGE 5\". Sunset in 20 minutes. Four hikers reached Basecamp; Sam never arrived.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "kendra",
          "text": "Rangers said choppers can’t fly in this fog. Why didn’t Sam stay behind me at Marker 7?!",
