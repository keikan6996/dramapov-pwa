          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—Brad, you’ve been at Basecamp for 40 minutes. You never even asked for the first-aid kit.",
