          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "brad",
          "text": "He twisted his ankle near the creek. I told him to rest while I went ahead for the first-aid kit.",
