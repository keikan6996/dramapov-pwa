        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "LISTEN TO ME {{player_name}}! At 3:33 AM, Nora is going to call crying outside your door. DO NOT ANSWER. DO NOT UNLOCK THE CHAIN.",
