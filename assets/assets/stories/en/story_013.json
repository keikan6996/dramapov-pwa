    {
      "episode_number": 1,
      "title": "Floor 47 Blackout",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "8:10 PM · The executive elevator jolts to a halt between Floors 47 and 48. The lights die—leaving you inches from your ex-husband, Dante.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "insider",
          "text": "{{player_name}}, one bar of signal! Do NOT sign Dante's acquisition offer tomorrow. Your own CFO is secretly selling him your client list.",
          "timestamp_label": "8:11 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—who is this?! How do you know I'm meeting Dante tomorrow?",
          "timestamp_label": "8:11 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "narrator",
          "text": "In the dim red emergency glow, Dante sees your screen light up—and his own phone buzzes in his hand.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "dante",
          "text": "Since you refuse to speak to me out loud in this elevator, I'll text you, {{player_name}}. Put down the phone and take my jacket—you're shivering.",
          "timestamp_label": "8:12 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "unsent_message",
          "sender_id": "dante",
          "text": "I'm buying your company to fire your crooked CFO before he bankrupts you.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "voice_note",
          "sender_id": "insider",
          "duration_sec": 7,
          "transcript": "[static crackling] Careful, {{player_name}}—the power cut wasn't an accident. Someone locked the elevator manually from the security desk!",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "choice",
          "prompt": "You saw Dante's unsent text AND heard the warning. Who do you trust?",
          "options": [
            {
              "option_id": "opt_confront_dante",
              "label": "Ask Dante why he unsent that message",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I read what you unsent, Dante. What is my CFO really doing?",
              "next_node_id": "e1_n09a"
            },
            {
              "option_id": "opt_vip_closer",
              "label": "Step closer and show him the whistleblower text",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Sparks",
              "player_reply_text": "Look at my screen, Dante. Tell me if you're my enemy—or my ally.",
              "next_node_id": "e1_n09b"
            }
          ]
        },
        {
          "id": "e1_n09a",
          "type": "text",
          "sender_id": "dante",
          "text": "He's framing you for insider trading tonight at 9 PM. That's why he trapped us in here.",
          "timestamp_label": "8:15 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n09b",
          "type": "text",
          "sender_id": "dante",
          "text": "I've never stopped being on your side, {{player_name}}. Even after you handed me the divorce papers.",
          "timestamp_label": "8:15 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "cliffhanger",
          "headline": "45 Minutes Until The Frame-Up.",
          "teaser_text": "Episode 2: Stuck 47 floors up, you and your ex-husband must outsmart your CFO using only one bar of signal.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Outsmarting The Trap",
      "start_node_id": "e2_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "8:35 PM · Dante drapes his blazer over your shoulders. Together, you craft a counter-trap from the dark elevator.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "dante",
          "text": "My security team just unlocked the elevator override. Three minutes till the doors open. Ready to catch your CFO red-handed?",
          "timestamp_label": "8:35 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—Dante, why did you let me think you hated me all year if you were protecting my company?",
          "timestamp_label": "8:36 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "unsent_message",
          "sender_id": "dante",
          "text": "Because you said I controlled your life, so I tried to love you from a distance.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 2000,
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "voice_note",
          "sender_id": "insider",
          "duration_sec": 6,
          "transcript": "[whispering] Your CFO is in the server room right now with a USB drive. Hurry!",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "text",
          "sender_id": "dante",
          "text": "Lights are back! Let's end his career—and then you owe me dinner, {{player_name}}.",
          "timestamp_label": "8:38 PM",
          "typing_delay_ms": 650,
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "choice",
          "prompt": "The elevator doors slide open on Floor 48. What do you say to Dante?",
          "options": [
            {
              "option_id": "opt_team_up",
              "label": "Grab his hand and storm the server room",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Deal. Let's catch a traitor first.",
              "next_node_id": "e2_n08a"
            },
            {
              "option_id": "opt_vip_second_chance",
              "label": "Keep his jacket—and tell him to stop hiding",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Rekindle",
              "player_reply_text": "No more loving from a distance, Dante. After tonight, we talk.",
              "next_node_id": "e2_n08b"
            }
          ]
        },
        {
          "id": "e2_n08a",
          "type": "narrator",
          "text": "You catch your CFO mid-transfer. Police escort him out in handcuffs ten minutes later—while Dante never lets go of your hand.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n08b",
          "type": "text",
          "sender_id": "dante",
          "text": "Best blackout of my life, {{player_name}}. I'm never letting you walk away again.",
          "timestamp_label": "8:42 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n09",
          "type": "cliffhanger",
          "headline": "Power Restored. Hearts Unlocked.",
          "teaser_text": "Episode 3: Your crooked CFO is in cuffs—but the whistleblower warns the real mastermind inside Dante’s own board is still active.",
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
      "episode_number": 3,
      "title": "The Hidden Rider",
      "start_node_id": "e3_n01",
      "default_ambient": "office_tension",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "9:20 PM · Executive Tower, Floor 48. Police lead your CFO away, yet Dante’s phone buzzes with an urgent warning from the whistleblower.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "insider",
          "text": "{{player_name}}, don’t celebrate yet! Your CFO didn’t act alone—Dante’s rival VP slipped a poison-pill rider into tomorrow’s buyout contract!",
          "timestamp_label": "9:20 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "image",
          "sender_id": "insider",
          "image_asset": "assets/media/evidence/generic_legal_document.webp",
          "caption": "Sabotaged Buyout Clause · Hidden rider inserted by Dante’s rival VP to bankrupt both companies.",
          "blur_until_tap": true,
          "typing_delay_ms": 850,
          "sfx": "photo_snap",
          "haptic": "heavy",
          "next_node_id": "e3_n04"
        },
        {
          "id": "e3_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—if I had signed that tomorrow, BOTH my startup and Dante’s division would have been liquidated?!",
          "timestamp_label": "9:22 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n05"
        },
        {
          "id": "e3_n05",
          "type": "unsent_message",
          "sender_id": "dante",
          "text": "My VP knew I was shielding her company—he tried to use my own signature to destroy us both!",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n06"
        },
        {
          "id": "e3_n06",
          "type": "text",
          "sender_id": "dante",
          "text": "{{player_name}}, whoever this whistleblower is, they just saved us from a $40M trap. Wait—I recognize that file watermark!",
          "timestamp_label": "9:23 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n07"
        },
        {
          "id": "e3_n07",
          "type": "voice_note",
          "sender_id": "insider",
          "duration_sec": 10,
          "transcript": "[voice filter dropping] Sorry for the secrecy, Dante… it’s your sister Claire. I’m in the finance audit room and your VP is wiping the server logs right now!",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n08"
        },
        {
          "id": "e3_n08",
          "type": "text",
          "sender_id": "dante",
          "text": "Claire?! Wait—{{player_name}}, my sister stayed late to protect you. We have five minutes before that VP wipes the backup!",
          "timestamp_label": "9:25 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n09"
        },
        {
          "id": "e3_n09",
          "type": "choice",
          "prompt": "Dante’s rival VP is wiping the server logs right now. Your move?",
          "options": [
            {
              "option_id": "e3_opt_free",
              "label": "Lock the VP’s admin credentials remotely",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Claire, send me the subnet—I’m freezing his admin login right now!",
              "next_node_id": "e3_n10a"
            },
            {
              "option_id": "e3_opt_vip",
              "label": "Trap him in the server room and call the SEC",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Secret Twist",
              "player_reply_text": "Lock his badge inside the server wing AND mirror the logs to the SEC!",
              "next_node_id": "e3_n10b"
            }
          ]
        },
        {
          "id": "e3_n10a",
          "type": "text",
          "sender_id": "insider",
          "text": "Got him! His terminal just froze mid-delete—every single email between him and your CFO is intact!",
          "timestamp_label": "9:26 PM",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n10b",
          "type": "narrator",
          "text": "VIP TWIST: The badge doors click shut around the VP while the mirrored audit hits the SEC—and security catches him holding a wiped burner drive!",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "dante",
          "text": "Claire, you’re getting a massive bonus tomorrow. Wait—{{player_name}}, there’s one more file Claire shouldn’t have seen…",
          "timestamp_label": "9:27 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n12"
        },
        {
          "id": "e3_n12",
          "type": "text",
          "sender_id": "insider",
          "text": "Too late, big brother! Wait till {{player_name}} sees the $15M escrow account you opened for her last month!",
          "timestamp_label": "9:28 PM",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n13_end"
        },
        {
          "id": "e3_n13_end",
          "type": "cliffhanger",
          "headline": "The Sister Behind The Signal",
          "teaser_text": "Episode 4: A secret $15M escrow transfer reveals how far Dante went to protect you after the divorce.",
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "heavy",
          "next_episode_number": 4,
          "cta_label": "Play Episode 4"
        }
      ]
    },
    {
      "episode_number": 4,
      "title": "Fifteen Million In Escrow",
      "start_node_id": "e4_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "10:05 PM · Floor 48 Glass Conference Room. Rain streaks the windows as Claire forwards the bank receipt Dante tried to keep secret.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e4_n02"
        },
        {
          "id": "e4_n02",
          "type": "text",
          "sender_id": "insider",
          "text": "Sorry Dante, she deserves to know! He wired $15M of his personal savings into an escrow shield so your shares couldn’t be shorted during the blackout!",
          "timestamp_label": "10:05 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n03"
        },
        {
          "id": "e4_n03",
          "type": "image",
          "sender_id": "insider",
          "image_asset": "assets/media/evidence/bank_transfer_success.webp",
          "caption": "Escrow Shield Confirmed · $15,000,000 wired from Dante’s personal reserve to protect {{player_name}}’s equity.",
          "blur_until_tap": true,
          "typing_delay_ms": 850,
          "sfx": "photo_snap",
          "haptic": "heavy",
          "next_node_id": "e4_n04"
        },
        {
          "id": "e4_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Dante… you put fifteen million of your own money on the line for your ex-wife—without even putting your name on the receipt?!",
          "timestamp_label": "10:07 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n05"
        },
        {
          "id": "e4_n05",
          "type": "unsent_message",
          "sender_id": "dante",
          "text": "Claire, I am going to fire you as my whistleblower…",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n06"
        },
        {
          "id": "e4_n06",
          "type": "text",
          "sender_id": "dante",
          "text": "You told me during the divorce you wanted to win on your own terms, {{player_name}}. I only wanted to make sure the game wasn’t rigged against you.",
          "timestamp_label": "10:08 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n07"
        },
        {
          "id": "e4_n07",
          "type": "voice_note",
          "sender_id": "dante",
          "duration_sec": 11,
          "transcript": "[quiet, raw honesty] Every time I acted cold in the boardroom this year, it took everything in me not to pull you aside and ask if you were eating enough.",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e4_n08"
        },
        {
          "id": "e4_n08",
          "type": "text",
          "sender_id": "insider",
          "text": "Okay, I’m stepping out to let security finish the VP’s arrest—you two clearly have a year of talking to catch up on!",
          "timestamp_label": "10:10 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n09"
        },
        {
          "id": "e4_n09",
          "type": "choice",
          "prompt": "Dante just bared his soul after a year of silent protection. Your move?",
          "options": [
            {
              "option_id": "e4_opt_free",
              "label": "Thank him and keep his blazer around you",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "You’re an idiot for hiding this all year, Dante… thank you.",
