            {
              "option_id": "e4_opt_vip",
              "label": "Cancel the buyout and propose a 50/50 merger",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Secret Twist",
              "player_reply_text": "Tear up the buyout—let’s merge 50/50 as true equals, Dante!",
              "next_node_id": "e4_n10b"
            }
          ]
        },
        {
          "id": "e4_n10a",
          "type": "text",
          "sender_id": "dante",
          "text": "Keep the blazer as long as you want, {{player_name}}. It always looked better on you anyway.",
          "timestamp_label": "10:11 PM",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n11"
