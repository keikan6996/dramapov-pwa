          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "chad",
          "text": "Step on it, driver! And keep your eyes on the road—leave a 1-star rating if he talks back, babe.",
