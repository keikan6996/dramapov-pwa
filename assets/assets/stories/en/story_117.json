      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "10:15 PM · Driving a quiet rideshare shift in the rain to clear your head before tomorrow’s $15M funding review, you hear a familiar gasp from the backseat.",
