          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "rachel_ex",
          "text": "Oh my god—Riley?! You’re driving rideshare now?! Thank heaven I dumped you! Meet Chad—he’s closing a $15M deal with Titan Ventures at 9 AM!",
