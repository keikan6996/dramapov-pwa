              "next_node_id": "e3_n07_vip"
            }
          ]
        },
        {
          "id": "e3_n07_free",
          "type": "narrator",
          "text": "You slip his ring into your pocket and vault to the neighboring fire escape as Directorate-6 agents breach the door.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "daniel",
          "text": "I’m by Pier 3! That micro-SD holds my defection file—it proves Directorate-6 went rogue and wants to use your father’s cipher for blackmail!",
          "timestamp_label": "10:18 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "The micro-SD reveals a stunning secret: your father coded a reverse kill-switch that wipes Directorate-6’s ENTIRE rogue blackmail archive!",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "My father built a reverse kill-switch! If we pair my key with yours, we erase Directorate-6’s blackmail server forever!",
          "timestamp_label": "10:18 PM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "unsent_message",
          "sender_id": "dir6",
          "text": "Target escaped via balcony. Send the biometric verification file to prove her father’s key.",
          "unsent_placeholder": "DIRECTORATE-6 unsent a message",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n10"
        },
        {
          "id": "e3_n10",
          "type": "text",
          "sender_id": "daniel",
          "text": "Meet me under the ferry arch at Pier 3! Together we can fire the reverse kill-switch and end this tonight!",
          "timestamp_label": "10:18 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "dir6",
          "text": "DIRECTORATE-6: You can’t outrun your own bloodline, {{player_name}}. Check the file we just sent.",
          "timestamp_label": "10:18 PM",
          "typing_delay_ms": 650,
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e3_n12_cliff"
        },
        {
          "id": "e3_n12_cliff",
          "type": "cliffhanger",
          "headline": "Project Sparrow",
          "teaser_text": "Daniel fell in love and defected to protect you—and your late father hid a reverse kill-switch to destroy Directorate-6.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 4
        }
      ]
    },
