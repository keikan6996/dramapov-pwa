          "haptic": "heavy",
          "next_node_id": "e3_n05"
        },
        {
          "id": "e3_n05",
          "type": "voice_note",
          "sender_id": "daniel",
          "duration_sec": 8,
          "transcript": "[harbor wind, voice breaking] They assigned me to watch you five years ago—that part is true. Falling in love with you wasn’t part of the mission! Check under my ring!",
          "audio_asset": null,
