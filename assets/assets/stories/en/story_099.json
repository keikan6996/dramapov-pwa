    {
      "episode_number": 1,
      "title": "Cover Blown",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "8:19 PM · PRIORITY ALPHA: \"Asset FALCON’s cover compromised in Vienna. Spouse {{player_name}}—activate Protocol Grey immediately.\"",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "Daniel, are you playing a prank?! Some weird number says you’re in Vienna, not Chicago for your tax conference!",
          "timestamp_label": "8:19 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "voice_note",
          "sender_id": "daniel",
          "duration_sec": 9,
          "transcript": "[gunfire muffled, sprinting] {{player_name}}, listen closely—I’m not an accountant! Open the false bottom of my golf bag right now, grab the blue passports, and do NOT open the door for Directorate-6!",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "dir6",
          "text": "Ignore Daniel, {{player_name}}. Your husband sold three NATO field agents to a foreign syndicate. Our extraction car is pulling up to your curb now.",
          "timestamp_label": "8:20 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "daniel",
          "text": "If they take you, they’ll use you as leverage to silence me before I testify in Geneva.",
          "unsent_placeholder": "Daniel unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Two black SUVs glide quietly to your front curb:",
          "options": [
            {
              "option_id": "opt_099_e1_free",
              "label": "Grab the golf-bag go-pack & slip out back",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I have the blue passports! Where do I meet you, Daniel?!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_099_e1_vip",
              "label": "Check the hidden USB inside Daniel’s bag",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You rip open the velvet lining of Daniel’s golf bag: $30,000 in Euros, two Swiss passports, and a note reading \"Trust no one from Directorate-6.\" You slip over the garden wall.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "daniel",
          "text": "Good! Take the 9:05 commuter train to Union Station—I’m boarding a private charter home right now!",
          "timestamp_label": "8:22 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You plug the tiny USB into your phone before fleeing. It holds a video of Daniel blowing the whistle on Directorate-6’s own deputy chief—AND a wedding photo of Daniel with ANOTHER woman in Vienna.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Daniel... who is the blonde woman in your Vienna file wearing a wedding ring?!",
          "timestamp_label": "8:22 PM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "dir6",
          "text": "Backyard motion tripped. Thermal drone deployed—stop running, {{player_name}}.",
          "timestamp_label": "8:23 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "A low buzzing hums overhead in the dark sky. Your phone vibrates—Daniel’s live GPS dot isn’t in Vienna. It’s three blocks away.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Three Blocks Away",
          "teaser_text": "Daniel lied about being in Vienna—and a Directorate-6 surveillance drone just locked onto your heat signature.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Protocol Grey",
      "start_node_id": "e2_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "8:26 PM · You duck under the awning of a crowded 24-hour laundromat to mask your heat signature from the drone.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "incoming_call",
          "caller_id": "daniel",
          "caller_label": "Daniel · Husband",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n03_ans",
          "on_decline_node_id": "e2_n03_dec"
        },
        {
          "id": "e2_n03_ans",
          "type": "voice_note",
          "sender_id": "daniel",
          "duration_sec": 8,
          "transcript": "[car idling] I landed two hours ago to get you out before they hit our house! Walk out the laundromat back alley—I’m in the silver Volvo!",
          "audio_asset": null,
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n03_dec",
          "type": "text",
          "sender_id": "daniel",
          "text": "I came home early to extract you myself! Meet me in the alley behind the laundromat—silver Volvo, hazards off!",
          "timestamp_label": "8:26 PM",
          "typing_delay_ms": 500,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "dir6",
          "text": "Your husband is using your passport to clean his exit trail, {{player_name}}. Hand him over and you receive full immunity.",
          "timestamp_label": "8:27 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "text",
          "sender_id": "player",
          "text": "Five years of marriage—and I don’t even know my husband’s real name.",
          "timestamp_label": "8:27 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n06_choice"
        },
        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "The silver Volvo’s headlights blink twice in the alley:",
          "options": [
            {
              "option_id": "opt_099_e2_free",
              "label": "Jump into Daniel’s Volvo & disappear",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "You owe me the whole truth on the way to the airport, Daniel.",
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_099_e2_vip",
              "label": "Upload the USB whistle-blow to the press",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "You dive into the passenger seat. Daniel floors it through a rain-drenched tunnel, shaking the drone—then hands you a pistol without taking his eyes off the road.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "daniel",
          "text": "Everything about my job was a lie, {{player_name}}—except marrying you. Now check the glovebox for our real boarding passes.",
          "timestamp_label": "8:30 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "You blast the Directorate-6 corruption files to three international papers before climbing into the Volvo. Instantly, the pursuing SUVs brake and peel away.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "dir6",
          "text": "You burned our entire European desk! Stand down—both of them are untouchable now!",
          "timestamp_label": "8:30 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "unsent_message",
          "sender_id": "daniel",
          "text": "Wait until you find out why Directorate-6 recruited YOU first.",
          "unsent_placeholder": "Daniel unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "narrator",
          "text": "You open the glovebox—and pull out a top-secret Directorate-6 recruitment dossier stamped with YOUR maiden name, dated three years before you ever met Daniel.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "Who Was Watching Whom?",
          "teaser_text": "Daniel wasn’t hiding from you by chance—your own past is the real reason Directorate-6 came knocking.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
      "episode_number": 3,
      "title": "The Ring On The Table",
      "start_node_id": "e3_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "10:18 PM · You slip into the harbor safe flat Daniel texted you. The room is empty—except for his wedding ring resting on the table.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "dir6",
          "text": "DIRECTORATE-6: Surrender the Sparrow Cipher, {{player_name}}. Your late father built it—and Daniel was assigned to watch you for five years.",
          "timestamp_label": "10:18 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Daniel!! Tell me that’s a lie! Did you only marry me to watch my father’s cipher?!",
          "timestamp_label": "10:18 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n04"
        },
        {
