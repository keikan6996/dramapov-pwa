          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "You burst into the stairwell just as the streetlights flicker back on. Your phone buzzes with a final app receipt.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "incoming_call",
          "caller_id": "ally",
          "caller_label": "Leo (Delivery Rider)",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n11_ans",
          "on_decline_node_id": "e2_n11_dec"
