    {
      "episode_number": 1,
      "title": "Order You Never Placed",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "3:07 AM · Thunder shakes your 5th-floor studio. A delivery app notification chimes.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Hey Paige, I hung your noodles on the gate. Tell your roommate behind the curtain to stop staring at me, man.",
          "timestamp_label": "3:07 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—I didn’t order food tonight. And I live completely alone.",
          "timestamp_label": "3:08 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "She is opening your balcony latch right now.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "Don’t mess with me! The order is under YOUR name and paid in cash—she dropped a crumpled bill from the 5th floor!",
          "timestamp_label": "3:09 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 10,
          "transcript": "[heavy rain, revving scooter] ...Wait, listen to the call recording from when you confirmed the order—that IS your voice...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "Your sheer balcony curtain ripples inward—even though the glass door is shut.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Ask Leo what the cash bill looks like",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "What kind of bill did she drop?",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "Play the full order confirmation audio",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Send me the full audio file!",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "Leo texts back shaking: \"It’s not real money, Paige... It’s hell-banknote paper. Burned at the corner.\"",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: Beneath your own sleepy voice ordering noodles, a second voice whispers: \"Two bowls. One for the living.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "Bro I’m driving away, good luck—wait, why is the plastic bag NOT on your gate anymore?!",
          "timestamp_label": "3:11 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "Delivery Automated Call",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "A metallic voice recites: \"Your order has been received... inside your kitchen.\" A spoon clinks in the next room.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "You hang up. Immediately, the smell of cold broth and wet incense drifts under your bedroom door.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "Dinner for Two",
          "teaser_text": "Episode 2: Two steaming bowls are sitting on your table—and one chair is pulled out.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Two Pairs of Chopsticks",
      "start_node_id": "e2_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "3:13 AM · You crack the bedroom door. Steam curls from two bowls on your tiny table. One pair of chopsticks is stuck upright.",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Paige! My GPS won’t let me leave your alley. Every turn brings me right back under your balcony!",
          "timestamp_label": "3:13 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Leo, there are two bowls in my kitchen. The chopsticks are standing straight up like an offering!",
          "timestamp_label": "3:14 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 7,
          "transcript": "[slurping sound, dripping water] ...Eat while it’s warm, Paige. Don’t be rude to a guest...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "She is sitting in the chair with her back to you.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "text",
          "sender_id": "ally",
          "text": "I just remembered this street! A girl starved in a locked 5th-floor room here five years ago. Do NOT touch the food!",
          "timestamp_label": "3:16 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "choice",
          "prompt": "The chair scrapes slowly across the tile floor as she begins to turn.",
          "options": [
            {
              "option_id": "e2_opt_free",
              "label": "Knock the offering bowl off the table",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I’m overturning the table!",
              "next_node_id": "e2_n08_free"
            },
            {
              "option_id": "e2_opt_vip",
              "label": "Bow respectfully and offer the bowl",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "I’m bowing and backing out...",
              "next_node_id": "e2_n08_vip"
            }
          ]
        },
        {
          "id": "e2_n08_free",
          "type": "narrator",
          "text": "The bowl shatters—and spilled across the tiles are not noodles, but tangled strands of long wet black hair.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: The cold air softens. A faint sigh whispers \"Thank you for remembering me\" as the front door unlocks.",
