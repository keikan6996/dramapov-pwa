        {
          "id": "e2_n11_ans",
          "type": "narrator",
          "text": "Leo breathes hard: \"I’m out of the alley! Check your app—she left a 5-star review under YOUR account: See you tomorrow at 3:07.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
