        {
          "id": "e2_n11_dec",
          "type": "narrator",
          "text": "You decline and check your app. A new recurring order is scheduled automatically for 3:07 AM every night.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n12",
          "type": "cliffhanger",
          "headline": "Order Scheduled: 3:07 AM",
          "teaser_text": "Season Finale · The Cancel button is greyed out. She’s already hungry for tomorrow.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
