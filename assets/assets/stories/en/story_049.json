    {
      "episode_number": 1,
      "title": "Timer Won’t Stop",
      "start_node_id": "e1_n01",
      "default_ambient": "mystery_ticking",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "10:52 PM · Group Chat \"LEO’S BDAY CREW\". Inside \"Vault 19\" Escape Room. The emergency exit button is dead.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "hannah",
          "text": "Okay joke’s over. The clock hit 00:00 five minutes ago—why is the door still magnetized shut?",
          "timestamp_label": "10:52 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "leo",
          "text": "I pressed the panic button three times. The red LED isn’t even lit.",
          "timestamp_label": "10:53 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "gm",
          "text": "Bonus round, {{player_name}}. You forgot to solve the real puzzle from November 14, 2019.",
          "timestamp_label": "10:53 PM",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05",
          "ambient": "heartbeat"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "player",
          "text": "How did the game master get into our private group chat?!",
          "timestamp_label": "10:54 PM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "gm",
          "duration_sec": 10,
          "transcript": "[crackle, distant sirens] \"Just leave the cash register open, nobody saw us—\" That’s YOUR voice, Leo. From the arcade robbery.",
          "audio_asset": null,
          "typing_delay_ms": 950,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "unsent_message",
          "sender_id": "leo",
          "text": "Hannah, you said the manager never kept the security tape—",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1750,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "text",
          "sender_id": "hannah",
          "text": "Wait—this escape room used to BE that arcade!! Look at the carpet under the rug!",
          "timestamp_label": "10:55 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_choice"
        },
        {
          "id": "e1_n09_choice",
          "type": "choice",
          "prompt": "A hidden panel clicks open beside the bookshelf. What do you do?",
          "options": [
            {
              "option_id": "opt_open_panel",
              "label": "Check the hidden panel for the exit key",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Hold on, there’s a keypad inside the bookshelf panel!",
              "next_node_id": "e1_n10_free"
            },
            {
              "option_id": "opt_check_cam",
              "label": "Inspect the ceiling camera’s blinking LED",
              "cost_type": "vip_rewarded",
              "badge_text": "Clue · Watch Ad",
              "player_reply_text": "Wait—the control room mirror is one-way glass. Someone’s watching!",
              "next_node_id": "e1_n10_vip"
            }
          ]
        },
        {
          "id": "e1_n10_free",
          "type": "narrator",
          "text": "Inside the panel is a 4-digit keypad and a faded arcade token stamped \"2019.\"",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n10_vip",
          "type": "narrator",
          "text": "Through a scratch in the mirror tint, you spot the control desk—it’s EMPTY, running on an automated laptop script.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n11_merge",
          "type": "text",
          "sender_id": "gm",
          "text": "Enter the amount stolen from my father’s register to unlock the door. One wrong guess seals the vents.",
          "timestamp_label": "10:57 PM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12_end"
        },
        {
          "id": "e1_n12_end",
          "type": "cliffhanger",
          "headline": "The Air Vent Just Clicked Shut",
          "teaser_text": "Episode 2: Leo remembers one number—and Hannah remembers a completely different one.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "The Exact Amount",
      "start_node_id": "e2_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "10:59 PM · Vault 19. The room grows warm as the air vents hum to a stop.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "leo",
          "text": "It was $1,400! I swear, I counted it in the alley!",
          "timestamp_label": "10:59 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "hannah",
          "text": "No, wait—the police report said $4,200! Why did the report say $4,200?!",
          "timestamp_label": "11:00 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04",
          "ambient": "heartbeat"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Stop! Think! If Leo only took $1,400, who took the other $2,800 from the register that night?",
          "timestamp_label": "11:00 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "hannah",
          "text": "I went back inside for my jacket and took the safe envelope—",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "voice_note",
          "sender_id": "leo",
          "duration_sec": 9,
          "transcript": "[furious] You let the owner go bankrupt and blamed ME?! {{player_name}}, type 4200 before we pass out!",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "text",
          "sender_id": "gm",
          "text": "Thank you, Hannah. My dad lost his shop because of that envelope. Now everyone knows.",
          "timestamp_label": "11:02 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n08_choice"
        },
        {
          "id": "e2_n08_choice",
          "type": "choice",
          "prompt": "The magnetic lock buzzes. What do you enter on the keypad?",
          "options": [
            {
              "option_id": "opt_4200",
              "label": "Enter 4200 to unlock the main door",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Typing 4200 right now—step back from the door!",
              "next_node_id": "e2_n09_free"
            },
            {
              "option_id": "opt_override",
              "label": "Pry the control room vent to confront GM",
              "cost_type": "vip_rewarded",
              "badge_text": "Confront · Watch Ad",
              "player_reply_text": "I’m popping the vent grille—I want to see who set this up.",
              "next_node_id": "e2_n09_vip"
            }
          ]
        },
        {
          "id": "e2_n09_free",
          "type": "narrator",
          "text": "GREEN LIGHT. The door unlocks into an empty lobby—with a printed transcript of Hannah’s confession taped to the counter.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n10_merge"
        },
        {
          "id": "e2_n09_vip",
          "type": "narrator",
          "text": "In the control booth sits a single badge: \"M. CHEN — OWNER.\" The laptop screen shows the audio already uploaded to the DA’s tip line.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n10_merge"
        },
        {
          "id": "e2_n10_merge",
          "type": "text",
          "sender_id": "gm",
          "text": "You’re free to leave, {{player_name}}. Your booking fee has been refunded.",
          "timestamp_label": "11:04 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n11"
        },
        {
          "id": "e2_n11",
          "type": "text",
          "sender_id": "leo",
          "text": "Wait… how did the Game Master know YOUR phone number to add himself to our chat?",
          "timestamp_label": "11:05 PM",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12_end"
        },
        {
          "id": "e2_n12_end",
          "type": "cliffhanger",
          "headline": "Check Your Booking Confirmation Email",
          "teaser_text": "You didn’t book this escape room—someone using Leo’s credit card invited you as the only witness.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
      "episode_number": 3,
      "title": "Behind the Two-Way Mirror",
      "start_node_id": "e3_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "9:42 PM · You stare at the booking email: someone used Leo’s card to invite YOU specifically as the lone witness to the 2019 warehouse fire.",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "hannah",
          "text": "{{player_name}}, look behind the bookshelf! There’s a maintenance gap behind the two-way mirror—someone is watching us live!",
          "timestamp_label": "9:42 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Don’t panic, Hannah. Leo, did you give your credit card to anyone at the 2019 trial?",
          "timestamp_label": "9:43 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n04"
        },
        {
          "id": "e3_n04",
          "type": "image",
          "sender_id": "hannah",
          "image_asset": "assets/media/evidence/dark_corridor_shadow.webp",
          "caption": "Room 4 Mirror Gap · 9:43 PM — A figure holding a headset in the dark control corridor.",
          "blur_until_tap": true,
          "typing_delay_ms": 850,
          "sfx": "photo_snap",
          "haptic": "heavy",
          "next_node_id": "e3_n05"
        },
        {
          "id": "e3_n05",
          "type": "text",
          "sender_id": "leo",
          "text": "Wait—that’s the exact voice from the 2019 audio tape! That’s not a hired game master, that’s the warehouse night watchman’s son!",
          "timestamp_label": "9:44 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n06"
        },
        {
          "id": "e3_n06",
          "type": "unsent_message",
          "sender_id": "gm",
          "text": "Let Leo and Hannah out if they give up {{player_name}}’s witness statement.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e3_n07"
        },
        {
          "id": "e3_n07",
          "type": "choice",
          "prompt": "The clue speaker clicks on and the final padlock timer drops to 08:00.",
          "options": [
            {
              "option_id": "e3_opt_free",
              "label": "Pry open the mirror frame with the prop crowbar",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Prying open the mirror frame now!",
              "next_node_id": "e3_n08_free"
            },
            {
              "option_id": "e3_opt_vip",
              "label": "Play back the 2019 tape at half speed",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Slowing down the 2019 audio clue...",
              "next_node_id": "e3_n08_vip"
            }
          ]
        },
        {
          "id": "e3_n08_free",
          "type": "narrator",
          "text": "The hidden magnetic latch gives way, revealing a dark service hallway wired with microphones.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: At half speed, you hear Leo’s uncle ordering the fire—and threatening the watchman’s family to take the blame.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "text",
          "sender_id": "hannah",
          "text": "Leo?! Your uncle owned the 2019 warehouse—and YOU booked this escape room to see if I remembered his voice!",
          "timestamp_label": "9:45 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n10"
        },
        {
          "id": "e3_n10",
          "type": "voice_note",
          "sender_id": "gm",
          "duration_sec": 9,
          "transcript": "[speaker static, Game Master’s steady voice] ...Correct, {{player_name}}. I only locked the door so you’d finally hear the tape your police report missed...",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—the Game Master isn’t trying to hurt us. He’s trying to expose Leo’s uncle.",
          "timestamp_label": "9:46 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n12"
        },
        {
          "id": "e3_n12",
          "type": "cliffhanger",
          "headline": "The Real Architect",
          "teaser_text": "Episode 4: The control room door clicks unlocked—and Leo’s face goes pale.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 4
        }
      ]
    },
    {
      "episode_number": 4,
      "title": "The 2019 Witness",
      "start_node_id": "e4_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "9:50 PM · You step into the dim control booth lined with monitors showing every angle of the escape room.",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n02"
        },
        {
          "id": "e4_n02",
          "type": "text",
          "sender_id": "hannah",
          "text": "{{player_name}}, Leo’s uncle paid off the fire marshal in 2019! That’s why the real witness audio vanished from court!",
          "timestamp_label": "9:50 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n03"
        },
        {
          "id": "e4_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Leo, tell me the truth right now—did you know your uncle framed the watchman?",
          "timestamp_label": "9:51 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n04"
        },
        {
          "id": "e4_n04",
          "type": "unsent_message",
          "sender_id": "gm",
          "text": "My uncle told me if anyone reopened the 2019 claim, our family business would collapse.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e4_n05"
        },
        {
          "id": "e4_n05",
          "type": "text",
          "sender_id": "leo",
          "text": "Wait—I didn’t set this trap! My uncle’s fixer is parked outside in the alley waiting for me to destroy the tape!",
          "timestamp_label": "9:52 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n06"
        },
        {
          "id": "e4_n06",
          "type": "voice_note",
          "sender_id": "gm",
          "duration_sec": 11,
          "transcript": "[heavy pounding on lobby glass] ...Game’s over! Open the escape room front door or I cut the power to the whole block!...",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n07"
        },
        {
          "id": "e4_n07",
          "type": "choice",
          "prompt": "The Game Master slides an original 2019 insurance settlement file across the desk.",
          "options": [
            {
              "option_id": "e4_opt_free",
              "label": "Call 911 and lock the control booth steel door",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Locking the booth and calling 911!",
              "next_node_id": "e4_n08_free"
            },
            {
              "option_id": "e4_opt_vip",
              "label": "Photograph the forged 2019 insurance settlement",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Photographing the forged 2019 file...",
              "next_node_id": "e4_n08_vip"
            }
          ]
        },
        {
          "id": "e4_n08_free",
          "type": "narrator",
          "text": "The steel booth door bolts tight as the dispatcher confirms patrol cars are three minutes away.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n09_merge"
        },
        {
          "id": "e4_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: The settlement carries a falsified witness waiver—signed in YOUR name while you were in the hospital.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n09_merge"
        },
        {
          "id": "e4_n09_merge",
          "type": "text",
          "sender_id": "hannah",
          "text": "He forged your signature on a witness waiver, {{player_name}}! That’s why you were never called to testify!",
          "timestamp_label": "9:53 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n10"
        },
        {
          "id": "e4_n10",
          "type": "text",
          "sender_id": "gm",
          "text": "Good—now let the police see both the audio tape and the forged waiver.",
          "timestamp_label": "9:53 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n11"
        },
        {
          "id": "e4_n11",
