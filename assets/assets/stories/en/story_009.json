    {
      "episode_number": 1,
      "title": "Unknown Number At Midnight",
      "start_node_id": "e1_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "11:52 PM · You just beat Roman's conglomerate for a $20M contract with your new startup. An unknown number texts.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "roman",
          "text": "{{player_name}}, don't block this number too. I just saw the IT forensics report from March.",
          "timestamp_label": "11:52 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Let me guess. Your darling VP Clara stole my login credentials to leak the pitch—just like I told you?",
          "timestamp_label": "11:53 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "roman",
          "text": "Yes. I fired her an hour ago and pressed charges. I'm standing outside your office building in the rain.",
          "timestamp_label": "11:54 PM",
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "roman",
          "text": "I've been miserable every single day since I told you to pack your desk.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "roman",
          "duration_sec": 9,
          "transcript": "[rain pouring heavily] I know I don't deserve five seconds of your time, {{player_name}}. Just let me apologize to your face.",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "The ruthless CEO who blacklisted you is soaked in the rain downstairs.",
          "options": [
            {
              "option_id": "opt_let_wait",
              "label": "Tell him to book an appointment with your PA",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "My calendar is full until next quarter, Mr. Vance. Bring an umbrella.",
              "next_node_id": "e1_n08a"
            },
            {
              "option_id": "opt_vip_meet",
              "label": "Send him up—and make him sign a public apology",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Boss Energy",
              "player_reply_text": "Floor 18. You get three minutes, and you're signing a public retraction.",
              "next_node_id": "e1_n08b"
            }
          ]
        },
        {
          "id": "e1_n08a",
          "type": "text",
          "sender_id": "roman",
          "text": "I'll stand here until sunrise if I have to. I also brought back the golden pen you left on my desk.",
          "timestamp_label": "11:57 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09"
        },
        {
          "id": "e1_n08b",
          "type": "text",
          "sender_id": "roman",
          "text": "I already published the apology on LinkedIn and lifted every blacklist notice. Coming up now.",
          "timestamp_label": "11:57 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09"
        },
        {
          "id": "e1_n09",
          "type": "cliffhanger",
          "headline": "The Tables Have Turned.",
          "teaser_text": "Episode 2: Roman steps into your office—and reveals Clara didn't frame you alone.",
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "The Groveling Offer",
      "start_node_id": "e2_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "12:20 AM · After a tense five-minute meeting, Roman leaves a sealed folder on your desk and texts from the elevator.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "roman",
          "text": "Open the folder, {{player_name}}. Your new startup's angel investor is actually Clara's brother—he's setting you up to fail.",
          "timestamp_label": "12:20 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait... WHAT?! Why would he invest $5M in me just to sabotage me?!",
          "timestamp_label": "12:21 AM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "roman",
          "text": "Read clause 9 of your term sheet. If you miss one milestone, he seizes your patents and hands them to my rival.",
          "timestamp_label": "12:22 AM",
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "roman",
          "text": "I already bought out his debt note for $8M so he can never touch you.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "voice_note",
          "sender_id": "roman",
          "duration_sec": 8,
          "transcript": "[steady, sincere] Let me buy out his stake at zero equity to me, {{player_name}}. You owe me nothing. I owe you everything.",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "choice",
          "prompt": "Roman just saved your company from a hostile trap. How do you respond?",
          "options": [
            {
              "option_id": "opt_dinner",
              "label": "Accept the buyout—and make him earn forgiveness",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Fine. We'll discuss terms over coffee tomorrow. You're buying.",
              "next_node_id": "e2_n08a"
            },
            {
              "option_id": "opt_vip_partner",
              "label": "Propose a 50/50 joint venture—as equal CEOs",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Equal CEOs",
              "player_reply_text": "No charity, Roman. 50/50 joint venture—and I take the bigger office.",
              "next_node_id": "e2_n08b"
            }
          ]
        },
        {
          "id": "e2_n08a",
          "type": "text",
          "sender_id": "roman",
          "text": "I'll be there at 8 AM with your exact oat-milk latte. Thank you for giving me a second chance, {{player_name}}.",
          "timestamp_label": "12:25 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n08b",
          "type": "text",
          "sender_id": "roman",
          "text": "Deal. You can have the corner penthouse office—I just want to be on your side again.",
          "timestamp_label": "12:25 AM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n09",
          "type": "cliffhanger",
          "headline": "From Fired Assistant To Equal Partner.",
          "teaser_text": "Episode 3: Clara’s brother tries to trigger Clause 9 at 8 AM—until Roman unveils the CCTV proof of who really leaked your pitch.",
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
