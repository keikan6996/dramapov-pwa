      "title": "The Intern Scapegoat",
      "start_node_id": "e1_n01",
      "default_ambient": "office_tension",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "3:00 PM · Zenith Corp All-Hands. Posing as a quiet finance intern to investigate missing Q3 funds, you’re dragged onstage by CFO Grant.",
