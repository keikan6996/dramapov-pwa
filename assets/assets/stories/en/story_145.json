    {
      "episode_number": 1,
      "title": "Auto-Saved at 3:01 AM",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "3:01 AM · Your camera shutter clicks in the pitch-dark bedroom—even though your phone is locked on the desk.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "bestie",
          "text": "{{player_name}}!! Did your phone just auto-save a mirror photo?! DO NOT ZOOM IN and DO NOT turn the lights on until 3:33 AM!",
          "timestamp_label": "3:01 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Zoe, how did you know?! My gallery shows a photo taken 10 seconds ago from inside my bathroom mirror!",
          "timestamp_label": "3:01 AM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "bestie",
          "duration_sec": 8,
          "transcript": "[panicking, whispers] \"It happened to my cousin last week! Cover every mirror with a towel—if it sees your eyes, it swaps places with you!\"",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "unknown",
          "text": "Too late. You already zoomed in.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Your bathroom mirror glows faintly in the dark:",
          "options": [
            {
              "option_id": "opt_story_145_e1_free",
              "label": "Throw a bedsheet over the mirror",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I threw a sheet over it—something pushed back against the fabric!",
              "next_node_id": "e1_n07a"
            },
            {
              "option_id": "opt_story_145_e1_vip",
              "label": "Delete the 3:01 AM photo immediately",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "I hit delete... and 3 MORE photos appeared in my gallery!",
              "next_node_id": "e1_n07b"
            }
          ]
        },
        {
          "id": "e1_n07a",
          "type": "text",
          "sender_id": "bestie",
          "text": "Get out of the bathroom! Don’t look at your black phone screen either—it counts as a mirror!",
          "timestamp_label": "3:03 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08_merge"
        },
        {
          "id": "e1_n07b",
          "type": "text",
          "sender_id": "bestie",
          "text": "Stop deleting them! Every time you tap delete, it steps closer to the glass!",
          "timestamp_label": "3:03 AM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08_merge"
        },
        {
          "id": "e1_n08_merge",
          "type": "narrator",
          "text": "TAP. TAP. TAP. Soft knuckles knock rhythmically from inside the bathroom glass.",
          "style": "banner",
          "sfx": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n09_call"
        },
        {
          "id": "e1_n09_call",
          "type": "incoming_call",
          "caller_id": "unknown",
          "caller_label": "03:00 Mirror",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n10",
          "on_decline_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "unknown",
          "text": "Why are you covering the glass, {{player_name}}? You didn’t mind trading places last Tuesday.",
          "timestamp_label": "3:06 AM",
          "typing_delay_ms": 750,
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n11"
        },
        {
          "id": "e1_n11",
          "type": "text",
          "sender_id": "player",
          "text": "Last Tuesday?! What is it talking about, Zoe?!",
          "timestamp_label": "3:06 AM",
          "typing_delay_ms": 0,
          "sfx": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n12_cliff"
        },
        {
          "id": "e1_n12_cliff",
          "type": "cliffhanger",
          "headline": "Knocking From Inside the Glass",
          "teaser_text": "Next: Your shadow stretches down the dark hallway—before you even move.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Two Seconds Early",
      "start_node_id": "e2_n01",
      "default_ambient": "heartbeat",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "3:08 AM · You bolt into the hallway. A streetlight leaks under the door—casting a shadow that turns its head 2 seconds BEFORE you do.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "bestie",
          "text": "{{player_name}}, stay away from windows! Check your left hand—which hand do you write with?!",
          "timestamp_label": "3:08 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "My right hand... wait. Why am I holding my phone and typing with my LEFT hand effortlessly?!",
          "timestamp_label": "3:08 AM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "voice_note",
          "sender_id": "unknown",
          "duration_sec": 8,
          "transcript": "[echoing like glass vibrating] \"Because everything is flipped on this side of the mirror, {{player_name}}!\"",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "unknown",
          "text": "Look at the mole on your cheek. It switched sides on Tuesday.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e2_n05b_img"
        },
        {
          "id": "e2_n05b_img",
          "type": "image",
