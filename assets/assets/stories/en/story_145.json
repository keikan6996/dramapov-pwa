          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n08_merge"
        },
        {
          "id": "e2_n07b",
          "type": "text",
          "sender_id": "bestie",
          "text": "Last Tuesday you called me crying about a 3AM mirror game—then suddenly went totally calm and hung up!",
          "timestamp_label": "3:11 AM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_merge"
        },
        {
          "id": "e2_n08_merge",
          "type": "narrator",
          "text": "A sharp crack splits the bathroom mirror behind the closed door. Cold air rushes down the hall.",
