          "sfx": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e2_n09_call"
        },
        {
          "id": "e2_n09_call",
          "type": "incoming_call",
          "caller_id": "unknown",
          "caller_label": "03:00 Mirror · Knocking",
