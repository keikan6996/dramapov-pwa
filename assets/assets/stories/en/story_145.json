          "can_decline": true,
          "on_answer_node_id": "e2_n10",
          "on_decline_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "text",
          "sender_id": "unknown",
          "text": "Let me back out! You stole my apartment, my best friend, and my name on Tuesday—I’m freezing in here!",
          "timestamp_label": "3:14 AM",
          "typing_delay_ms": 750,
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e2_n11"
