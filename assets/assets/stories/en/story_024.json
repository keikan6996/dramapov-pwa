    {
      "episode_number": 1,
      "title": "Next Stop: Ashwood",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:19 AM · The train car sways through an endless black tunnel. Every other passenger sits motionless, eyes closed.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, where are you? I’m waiting at Central Station—the guard says Line 4 shut down two hours ago.",
          "timestamp_label": "2:19 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "What?! I’m literally ON Line 4 right now. The LED sign just switched to \"Ashwood Station.\"",
          "timestamp_label": "2:20 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "Do not open your eyes when the doors part.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "Ashwood Station burned down in 1998!! They sealed the tunnel! {{player_name}}, pull the emergency brake!",
          "timestamp_label": "2:21 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[rail screeching, chorus of whispers] ...All aboard for 1998... Tickets please, {{player_name}}...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "The passengers open their eyes in unison—all turning their heads toward your seat.",
