            {
              "option_id": "e1_opt_vip",
              "label": "Check the paper ticket in your pocket",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Wait, I have a paper ticket...",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "You slam through the sliding door—the front carriage is completely empty except for charred wooden benches.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: The ticket isn’t dated today. It’s stamped with your exact date of birth—and marked \"ONE WAY.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "Your GPS dot just vanished off the city map! Tell me you’re slowing down!",
