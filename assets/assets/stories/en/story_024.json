          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "You decline. Instantly, the carriage speaker booms overhead: \"Ticket inspection in Car 3.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "The Doors Are Opening",
          "teaser_text": "Episode 2: A platform covered in gray ash appears outside—and someone is waiting with a lantern.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
