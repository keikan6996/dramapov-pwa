          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, I’m reading an old news article! Twelve commuters vanished on that train—nobody who stepped onto the platform came back!",
          "timestamp_label": "2:25 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "A conductor in a burnt uniform is walking down the aisle toward me. He’s holding a ticket puncher.",
