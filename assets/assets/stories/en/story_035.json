    {
      "episode_number": 1,
      "title": "Uninvited Guest",
      "start_node_id": "e1_n01",
      "default_ambient": "family_drama",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "12:01 AM · First night of Ghost Month. System notice in Family Chat: \"Number 000 joined via invite link.\"",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Nobody remove Number 000!! {{player_name}}, lock your curtains right now! If you kick it from the group, it knocks on the front gate!",
          "timestamp_label": "12:01 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Grandma, it’s just a spam bot… wait, how does it have a photo of our ancestral house taken from the garden?!",
          "timestamp_label": "12:02 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "You forgot to set my rice bowl on the altar.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "Oh heaven help us… your grandfather’s estranged brother! We forgot his anniversary incense tonight!",
          "timestamp_label": "12:03 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[crackling incense, iron gate rattling] ...Let me in, {{player_name}}... I walked all the way home...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "Your cousin taps \"Remove Member\" in the group chat. The front iron gate slams violently.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Light three incense sticks at the altar",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Lighting incense at the altar now!",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "Check the group chat admin log",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Checking who invited Number 000...",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "The matches strike—and all three incense sticks curl tightly downward in a warning omen.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: The invite link was generated at 11:59 PM from YOUR own phone—while your screen was locked.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "Number 000 rejoined the group by itself! And it just changed the group name to \"OPEN THE GATE.\"",
          "timestamp_label": "12:05 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "Number 000 (Group Video Call)",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "The camera shows your own dark backyard—moving steadily closer to the sliding glass door behind you.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "You decline. Instantly, every light bulb downstairs dims to a faint orange glow.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "It Is In the Yard",
          "teaser_text": "Episode 2: Footprints of wet ash stop right outside the ancestral altar room.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "The Forgotten Seat",
      "start_node_id": "e2_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "12:08 AM · Rain beats on the courtyard roof. The ancestral altar candles flicker violently despite zero wind.",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, don’t be afraid—set a clean bowl of rice and a cup of tea on the porch step and call his name politely!",
          "timestamp_label": "12:08 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Grandma, the glass door is fogging up from the outside. Someone wrote \"000\" in the condensation!",
          "timestamp_label": "12:09 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[porch floorboards creaking] ...Only {{player_name}} remembered to answer me... Set my place at the table...",
