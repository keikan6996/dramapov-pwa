          "haptic": "medium",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "text",
          "sender_id": "ally",
          "text": "Wait—did you see what he unsent?! He’s not angry anymore, {{player_name}}! He just wanted to be remembered!",
          "timestamp_label": "12:11 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "choice",
          "prompt": "The porch light flickers as rain pours off the eaves.",
          "options": [
            {
              "option_id": "e2_opt_free",
              "label": "Place rice and tea on the porch step",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Setting the offering outside now...",
              "next_node_id": "e2_n08_free"
            },
            {
              "option_id": "e2_opt_vip",
              "label": "Add his name to the family group description",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Adding Uncle’s name to the group...",
              "next_node_id": "e2_n08_vip"
            }
          ]
        },
        {
          "id": "e2_n08_free",
          "type": "narrator",
          "text": "You crack the door, set the warm bowl down, and bow. The howling wind drops to a gentle breeze.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: The incense flames burn straight and bright. Number 000 reacts with a single heart before quietly leaving the chat.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "Morning light breaks early. When you check the porch step, the tea cup is completely empty—and the iron gate is neatly latched.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "incoming_call",
          "caller_id": "ally",
          "caller_label": "Grandma Lin",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n11_ans",
          "on_decline_node_id": "e2_n11_dec"
        },
        {
          "id": "e2_n11_ans",
          "type": "narrator",
          "text": "Grandma sighs softly: \"He visited my dream and thanked you, {{player_name}}. Just don’t forget next Ghost Month.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n11_dec",
          "type": "narrator",
          "text": "You decline and smile weakly—until your phone buzzes with a calendar reminder set by Number 000 for next year.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n12",
          "type": "cliffhanger",
          "headline": "See You Next Seventh Month",
          "teaser_text": "Season Finale · Never delete an ancestor’s number from the family chat.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
