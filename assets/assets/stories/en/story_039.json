    {
      "episode_number": 1,
      "title": "Don’t Look Through the Glass",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:50 AM · Citywide blackout. Emergency exit signs cast a faint red glow down the 8th-floor hallway.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "EVERYONE ON FLOOR 8: DO NOT LOOK THROUGH YOUR PEEPHOLE!! If it sees your eye behind the lens, it knows you’re home!",
          "timestamp_label": "2:50 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Elena, what’s going on?! Someone just knocked softly on my door twice…",
          "timestamp_label": "2:51 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "I can see your phone light under the door.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "Tape over your peephole right now and stay silent! It’s going door to door down Floor 8!",
