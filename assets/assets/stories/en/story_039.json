          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[soft knuckle tapping, muffled voice] ...Quinn? Power’s out… just checking if you need candles...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "The shadow blocks the thin red line of hallway light beneath your front door.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Press a sticky note over the peephole",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Covering the peephole silently...",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "Slide your phone camera under the door gap",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Peeking under the door with my camera...",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "Your fingers brush the cold brass lens—and something exhales sharply on the other side, inches from your face.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: There are NO shoes outside your door—only two bare pale hands pressed flat on the carpet, peering back under the gap.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "Wait… the knocking at your front door just stopped! Did it move on to 8D?!",
          "timestamp_label": "2:54 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "Unknown · Inside Apt 8C",
          "ringtone_sfx": "call_ring",
