          ]
        },
        {
          "id": "e3_n07_free",
          "type": "narrator",
          "text": "You pry the brass doors open onto a freezing catwalk lined with humming transformers.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "devon",
          "text": "East stairwell! The mag-lock on Door E failed inspection last week—push it hard!",
          "timestamp_label": "01:36 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "The 404 override redirects the shaft straight to the rooftop helipad stairwell—bypassing every lobby sensor.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "hatch",
          "text": "Who gave you the 404 maintenance code?! Stop that lift!",
          "timestamp_label": "01:36 AM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "unsent_message",
          "sender_id": "hatch",
          "text": "If that drive reaches the SEC, the tower board goes to federal prison.",
          "unsent_placeholder": "SERVICE_SHAFT unsent a message",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
