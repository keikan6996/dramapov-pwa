    {
      "episode_number": 1,
      "title": "Floor 38 Blackout",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "1:17 AM · Elevator 04 jolts to a violent halt between Floor 38 and 39. Emergency red LEDs flicker on.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "Devon! I’m stuck in Elevator 04. The emergency call button is dead!",
          "timestamp_label": "1:17 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "devon",
          "text": "Hold tight, {{player_name}}. Checking the power log... Weird. Only Shaft 04 lost power, and my badge terminal says nobody else is in the tower.",
          "timestamp_label": "1:18 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "devon",
          "duration_sec": 6,
          "transcript": "[static, keyboard clacking] Wait—Elevator 04’s weight sensor just jumped by 180 pounds. Did you drop a crate in there?!",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "player",
          "text": "I’m holding a laptop bag! Wait... there’s dust falling from the ceiling hatch.",
          "timestamp_label": "1:19 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "A heavy boot thuds directly on top of the elevator cab:",
          "options": [
            {
              "option_id": "opt_082_e1_free",
              "label": "Press against the blind corner",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Someone is standing ON TOP of my elevator, Devon!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_082_e1_vip",
              "label": "Force the manual door latch open",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You press into the corner beneath the security dome. Metal bolts spin loose above your head—one drops and clangs at your feet.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "devon",
          "text": "Oh god—I see him on the shaft thermal cam! He’s carrying a wrench and a zip-tie kit. I’m calling 911!",
          "timestamp_label": "1:20 AM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You pry the inner door three inches apart. A concrete wall blocks the top half, but Floor 38’s darkened corridor is just below your knees.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "devon",
          "text": "DO NOT crawl out yet! If he releases the brake from the roof, the cab will shear in half!",
          "timestamp_label": "1:20 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "unsent_message",
          "sender_id": "hatch",
          "text": "Hand over the audit drive through the hatch, {{player_name}}, and I won’t cut the main cable.",
          "unsent_placeholder": "Message deleted by sender",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "player",
          "text": "How did he get my phone number?! Nobody knows I’m carrying the whistleblower drive tonight!",
          "timestamp_label": "1:21 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n11"
        },
        {
          "id": "e1_n11",
          "type": "text",
          "sender_id": "devon",
          "text": "Wait... someone just overrode my security desk from INSIDE the lobby. My screen just went black.",
          "timestamp_label": "1:21 AM",
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12_cliff"
        },
        {
          "id": "e1_n12_cliff",
          "type": "cliffhanger",
          "headline": "The Brake Releases",
          "teaser_text": "The steel cables groan overhead. Elevator 04 drops six feet—and the roof hatch slides open.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Cable Snap",
      "start_node_id": "e2_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "1:23 AM · Emergency clamps bite the rails, stopping the cab dead at Floor 36. A flashlight beam slices through the ceiling hatch.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "incoming_call",
          "caller_id": "hatch",
          "caller_label": "SERVICE_SHAFT",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n03_ans",
          "on_decline_node_id": "e2_n03_dec"
        },
        {
          "id": "e2_n03_ans",
          "type": "voice_note",
          "sender_id": "hatch",
          "duration_sec": 8,
          "transcript": "[metallic echo] Toss the drive up, {{player_name}}. Your guard friend Devon already took his payout to leave the lobby.",
          "audio_asset": null,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n03_dec",
          "type": "text",
          "sender_id": "hatch",
          "text": "Declining won’t save you, {{player_name}}. Devon unlocked the service shaft for me ten minutes ago. Toss the drive up.",
          "timestamp_label": "1:23 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Devon?! Tell me he’s lying!!",
          "timestamp_label": "1:24 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "devon",
          "text": "He has my daughter’s school address, {{player_name}}. Hit the Fireman’s Override key—I hid it behind the inspection plaque.",
          "unsent_placeholder": "Devon unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n06_choice"
        },
        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "Smoke starts pouring down the shaft. You have ten seconds:",
          "options": [
            {
              "option_id": "opt_082_e2_free",
              "label": "Grab Fireman’s key & drop to Lobby",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": null,
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_082_e2_vip",
              "label": "Upload the encrypted drive via 5G first",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Too late—the entire audit just synced to the press server.",
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "You rip off the brass plaque, twist the red Fireman’s key, and yank the cab into emergency descent. The intruder’s wrench clatters harmlessly above you.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "devon",
          "text": "Police sirens are on 5th Ave! When those lobby doors open, run straight for the revolving glass!",
          "timestamp_label": "1:25 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "Progress bar hits 100% right as you twist the Fireman’s key. Your phone chimes: 14 newsrooms and the FBI tip portal confirmed receipt.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "hatch",
          "text": "You idiot! Do you know whose name was on page 4 of that file?! You just signed both our death warrants!",
          "timestamp_label": "1:25 AM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "DING. The lobby doors slide open to flashing blue lights—and a black SUV with diplomatic plates idling right outside the glass.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "text",
          "sender_id": "devon",
          "text": "Wait... those aren’t city cops, {{player_name}}. Look at their badges. RUN BACK UPSTAIRS!",
          "timestamp_label": "1:26 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "Wrong Rescue Team",
          "teaser_text": "You escaped Elevator 04, only to walk straight into the people who ordered the blackout in the first place.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
