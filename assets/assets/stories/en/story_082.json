        },
        {
          "id": "e3_n10",
          "type": "text",
          "sender_id": "devon",
          "text": "Wait—they’re cutting the roof stairwell cameras! You’ve got maybe ninety seconds!",
          "timestamp_label": "01:36 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "hatch",
          "text": "No signal on the 38th floor, {{player_name}}. Leave the drive by the fire hose and walk out.",
          "timestamp_label": "01:36 AM",
          "typing_delay_ms": 650,
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e3_n12_cliff"
        },
        {
          "id": "e3_n12_cliff",
          "type": "cliffhanger",
          "headline": "Trapped On Floor 38",
          "teaser_text": "The tower’s own board hired the blackout crew to bury your audit drive—and they’re sweeping Floor 38 with flashlights.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 4
        }
      ]
    },
