      "start_node_id": "e1_n01",
      "default_ambient": "mystery_ticking",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "5:15 PM · Your cousins are spamming laughing emojis in the holiday chat—mocking you for backing out of Uncle Ray’s remote lake cabin trip because you \"got creepy vibes.\"",
          "style": "system_alert",
          "sfx": "ting_soft",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "cousin",
          "text": "Classic {{player_name}}! Canceling Thanksgiving at Uncle Ray’s lake house because you heard \"scraping under the floorboards\" last summer?!",
          "timestamp_label": "5:15 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "I also noticed Uncle Ray poured fresh concrete over a whole section of the cabin crawlspace in 1998—right when Aunt Linda \"left for Florida.\"",
          "timestamp_label": "5:15 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "uncle",
          "text": "Toby, tell {{player_name}} to stay home if she’s going to bring up my old concrete repairs!",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
