            {
              "option_id": "opt_139_e1_free",
              "label": "Tell Shaw about Aunt Linda vanishing in 1998",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "My Aunt Linda vanished from that exact cabin in October 1998—and nobody ever checked the cellar!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_139_e1_vip",
              "label": "Warn Toby not to drive up to the cabin alone",
