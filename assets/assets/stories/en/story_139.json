          "sfx": "ting_soft",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "clerk",
          "text": "Linda never boarded any bus to Florida... We’re requesting a ground-penetrating radar warrant for that cabin!",
          "timestamp_label": "5:19 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You text Toby urgently—only to hear Uncle Ray already arrived early and locked the cabin’s outer gate!",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "clerk",
          "text": "Wait—Uncle Ray just told us the cabin pipes burst and NOBODY should come up this weekend!!",
          "timestamp_label": "5:19 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "The instant you mentioned the 1998 concrete slab, Uncle Ray abruptly canceled Thanksgiving himself.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "uncle",
          "text": "Just a burst water pipe, everyone! I’ll stay up at the lake alone for a few days to fix the basement.",
          "timestamp_label": "5:25 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Sudden Pipe Repair",
          "teaser_text": "Up next: The 1998 Blueprint — Deputy Shaw emails you the scanned 1998 Pine County blueprint—showing a full reinforced storm cellar directly beneath the cabin kitchen..",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
