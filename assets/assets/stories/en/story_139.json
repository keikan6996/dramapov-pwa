              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Deputy Shaw pulls the 1998 county missing-persons binder—his voice dropping an octave.",
