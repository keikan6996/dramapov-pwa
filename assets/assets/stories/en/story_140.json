    {
      "episode_number": 1,
      "title": "The $200,000 Cosign Fight",
      "start_node_id": "e1_n01",
      "default_ambient": "mystery_ticking",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "6:10 PM · Your in-laws just roasted you at Sunday dinner for refusing to cosign a $200,000 expansion loan for Evan’s \"wellness genetics clinic\"—calling you cold and unsupportive.",
          "style": "system_alert",
          "sfx": "ting_soft",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "husband",
          "text": "My parents offered their retirement condo as backup, {{player_name}}—all you had to do was cosign! Why don’t you believe in my clinic?!",
          "timestamp_label": "6:10 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Because I drove past your \"clinic\" address on 4th Avenue yesterday, Evan. It’s an empty storefront with paper on the windows.",
          "timestamp_label": "6:10 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "husband",
          "text": "Tell the loan officer to push the $200K closing without my wife’s signature—use the clinic LLC instead!",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "patient",
          "duration_sec": 8,
          "transcript": "[shaking voice] \"Hi {{player_name}}, you don’t know me—I’m Claire, a former patient of Dr. Evan Price. Do NOT sign a single paper for him! He’s selling fake DNA tests to cancer patients!\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Claire’s voice note makes the room spin:",
          "options": [
            {
              "option_id": "opt_140_e1_free",
              "label": "Ask Claire for proof of the fake DNA tests",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Fake DNA tests?! Send me whatever audit you have right now, Claire!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_140_e1_vip",
              "label": "Warn Evan’s parents NOT to pledge their condo",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Claire forwards a hospital lab re-test proving Evan charged $4,500 each for \"personalized genetic screenings\" that were literally copy-pasted Word documents.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "patient",
          "text": "Thirty-two patients paid him $4,500 each—and he NEVER sent a single swab to a real lab!!",
          "timestamp_label": "6:14 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You call your mother-in-law urgently—freezing their condo paperwork five minutes before Evan’s shady broker arrives.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "patient",
          "text": "Wait—{{player_name}}, why did Evan tell us the clinic already has twelve doctors?!",
          "timestamp_label": "6:14 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "This isn’t a supportive-wife dilemma. Your husband is running a medical fraud ring out of a phantom clinic.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "husband",
          "text": "Who’s been texting you, {{player_name}}?! My mom just called canceling her condo collateral!!",
          "timestamp_label": "6:20 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "The Phantom Clinic",
          "teaser_text": "Up next: The Copy-Paste DNA Audit — Claire connects you with Federal Health Fraud Agent Patel—who sends over the side-by-side DNA audit comparing Evan’s fake printouts to real oncology labs..",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
