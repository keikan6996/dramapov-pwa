            {
              "option_id": "opt_show_texts",
              "label": "Hand over Kevin’s beach-house brag too",
              "cost_type": "vip_rewarded",
              "badge_text": "Full Truth · Watch Ad",
              "player_reply_text": "And here is Kevin bragging ten minutes ago that Mom was forcing me to take the fall.",
              "next_node_id": "n07_vip"
            }
          ]
        },
        {
          "id": "n07_free",
          "type": "narrator",
          "text": "The officer watches ten seconds of footage, clicks his handcuffs, and steps toward Kevin.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "n09_merge"
        },
        {
          "id": "n07_vip",
          "type": "narrator",
          "text": "DOUBLE CHARGE: Kevin is arrested for hit-and-run—and Mom is cited for filing a false police report!",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "n08_vip"
        },
        {
          "id": "n08_vip",
          "type": "text",
          "sender_id": "brother",
          "text": "{{player_name}} please tell them to stop! I’ll lose everything!",
          "timestamp_label": "02:17 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n09_merge"
        },
        {
          "id": "n09_merge",
          "type": "text",
          "sender_id": "player",
          "text": "You made your choice when you turned the key, Kevin. And I’m done being this family’s doormat.",
          "timestamp_label": "02:19 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n10_end"
        },
        {
          "id": "n10_end",
          "type": "cliffhanger",
          "headline": "Chains Broken",
          "teaser_text": "Outside the precinct, your Dad finally calls you: \"I saw the video. Tomorrow I’m signing the company over to you—not Kevin.\"",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
