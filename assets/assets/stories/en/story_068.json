      "episode_number": 1,
      "title": "Take the Fall",
      "start_node_id": "n01",
      "default_ambient": "mystery_ticking",
      "nodes": [
        {
          "id": "n01",
          "type": "narrator",
          "text": "01:45 AM · Sirens wail two blocks away. Your phone rings nonstop from Mom.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n02"
        },
        {
          "id": "n02",
          "type": "text",
          "sender_id": "mom",
          "text": "{{player_name}}, get to the 4th Street intersection NOW. Kevin hit a parked sedan in Dad’s delivery van and ran home.",
          "timestamp_label": "01:45 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n03"
        },
        {
          "id": "n03",
          "type": "text",
          "sender_id": "mom",
          "text": "Tell the police YOU were driving and panicked. If Kevin gets a DUI, he loses his MBA scholarship!",
          "timestamp_label": "01:46 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "text",
          "sender_id": "player",
          "text": "A hit-and-run is a FELONY, Mom! You want me to ruin my entire life because Kevin drank and drove?!",
          "timestamp_label": "01:47 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n05"
        },
        {
          "id": "n05",
          "type": "unsent_message",
          "sender_id": "brother",
          "text": "Bro haha Mom’s making {{player_name}} take the rap, see you at the beach house tomorrow!",
          "unsent_placeholder": "Kevin unsent a message",
          "reveal_ms": 1900,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n06"
        },
        {
          "id": "n06",
          "type": "voice_note",
          "sender_id": "guard",
          "duration_sec": 11,
          "transcript": "[urgent] Hey {{player_name}}, it's Ray from the warehouse gate. I saw Kevin stumble out of the van on our HD camera. Don't lie to the cops—they already asked for our footage.",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n07"
        },
        {
          "id": "n07",
          "type": "choice",
          "prompt": "Mom is pulling into the police station parking lot with Kevin. Your move?",
          "options": [
            {
              "option_id": "opt_refuse_firm",
              "label": "Tell Mom you refuse & save Ray’s audio",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I am not going to prison for Kevin. And there is HD footage of him running.",
              "next_node_id": "n08_free"
            },
            {
              "option_id": "opt_send_footage",
              "label": "Ask Ray to back up the HD clip to cloud",
              "cost_type": "vip_rewarded",
              "badge_text": "Justice · Watch Ad",
              "player_reply_text": "Ray, upload that clip to a secure link right now before Mom tries to delete it.",
              "next_node_id": "n08_vip"
            }
          ]
        },
        {
          "id": "n08_free",
          "type": "text",
          "sender_id": "mom",
          "text": "If you don’t walk into that precinct in ten minutes, pack your things and never call me Mother again!",
          "timestamp_label": "01:51 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n10_merge"
        },
        {
          "id": "n08_vip",
          "type": "narrator",
          "text": "FOOTAGE SECURED: Ray’s cloud clip also shows Kevin tossing a bottle into the bushes—and Mom telling him to wipe the steering wheel!",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "n09_vip"
        },
        {
          "id": "n09_vip",
          "type": "text",
          "sender_id": "guard",
          "text": "Link sent. You’ve always been the only honest one in that family, {{player_name}}.",
          "timestamp_label": "01:52 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n10_merge"
        },
        {
          "id": "n10_merge",
          "type": "text",
          "sender_id": "brother",
          "text": "Come on {{player_name}}, you don’t even have a big career to lose. Just sign the statement!",
          "timestamp_label": "01:54 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n11_end"
        },
        {
          "id": "n11_end",
          "type": "cliffhanger",
          "headline": "The Precinct Lobby",
          "teaser_text": "Episode 2: Mom already told the sergeant YOU were the driver—now you walk through the station doors.",
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "No More Scapegoat",
      "start_node_id": "n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "n01",
          "type": "narrator",
          "text": "02:10 AM · Police Station Lobby. The desk sergeant looks up as you walk in. Mom grabs your sleeve.",
