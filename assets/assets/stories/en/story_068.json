          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n02"
        },
        {
          "id": "n02",
          "type": "text",
          "sender_id": "mom",
          "text": "Thank god you came! Officer, this is {{player_name}}—they are ready to confess to the crash.",
          "timestamp_label": "02:10 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n03"
        },
        {
          "id": "n03",
          "type": "text",
          "sender_id": "player",
          "text": "Officer, I was asleep in my apartment across town. My smart-lock log and neighbor’s doorbell prove it.",
          "timestamp_label": "02:11 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "unsent_message",
          "sender_id": "brother",
          "text": "Mom they’re pulling a breathalyzer!! Tell them I drank AFTER I got home!!",
          "unsent_placeholder": "Kevin unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n05"
        },
        {
          "id": "n05",
          "type": "voice_note",
          "sender_id": "mom",
          "duration_sec": 9,
          "transcript": "[hissing] How dare you betray your own brother! You are out of the house tonight!",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n06"
        },
        {
          "id": "n06",
          "type": "choice",
          "prompt": "The officer asks if you have any evidence about who drove the van.",
          "options": [
            {
              "option_id": "opt_show_video",
              "label": "Show the warehouse HD video of Kevin",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Yes, Officer. Here is the timestamped warehouse security clip from 1:32 AM.",
              "next_node_id": "n07_free"
