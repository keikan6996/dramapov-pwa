    {
      "episode_number": 1,
      "title": "Thermal Lockdown",
      "start_node_id": "e1_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "10:41 PM · HOME OS ALERT: All perimeter deadbolts engaged. Storm shutters lowered. Heating set to MAX (108°F).",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "Owen!! Your smart home app locked me inside my own house and cranked the furnace to 108 degrees!",
          "timestamp_label": "10:41 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "owen",
          "text": "Checking your hub now, {{player_name}}... Wait, my technician credentials were just revoked! Someone is logged in as ROOT_ADMIN from inside your garage.",
          "timestamp_label": "10:42 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "root",
          "duration_sec": 7,
          "transcript": "[echoing through your living room speakers] \"Remember last Tuesday, {{player_name}}? You promised nobody would ever find out what happened on Highway 9.\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "player",
          "text": "That’s a recording from my bedroom! You’ve been bugging my smart speakers?!",
          "timestamp_label": "10:43 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "The air is scorching. Sweat stings your eyes. What do you do?",
          "options": [
            {
              "option_id": "opt_086_e1_free",
              "label": "Smash the main breaker box in the hall",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I’m killing the main power—let’s see your smart locks hold without electricity!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_086_e1_vip",
              "label": "Ask Owen for the factory reset pin",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Owen, give me the hardware override code before I pass out!",
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You flip the master breaker. The lights die—then a green backup battery hums to life. Fail-secure locks stay bolted tight.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "root",
          "text": "Solar battery wall is at 98%, {{player_name}}. Now you’re cooking in the dark.",
          "timestamp_label": "10:45 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "text",
          "sender_id": "owen",
          "text": "Hold the pinhole behind the hallway thermostat for 5 seconds and type 9941! Wait—it’ll unlock the garage door TOO!",
          "timestamp_label": "10:45 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "You punch 9941. Every deadbolt clicks open at once—including the heavy steel door leading to the dark garage.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "unsent_message",
          "sender_id": "root",
          "text": "My sister was the cyclist you left on Highway 9, {{player_name}}. Time to confess.",
          "unsent_placeholder": "ROOT_ADMIN unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "owen",
          "text": "Wait... the garage motion sensor just tripped! Someone is walking up the interior stairs right now!",
          "timestamp_label": "10:46 PM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "The Door To The Garage",
          "teaser_text": "The house isn’t just hacked—it’s a courtroom. And ROOT_ADMIN just stepped inside the kitchen.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
