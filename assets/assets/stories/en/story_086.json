        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "owen",
          "text": "Climb down, {{player_name}}. I only wanted to scare the truth out of you—my sister is still in a coma.",
          "timestamp_label": "10:51 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "The footsteps on the stairs stop dead. All storm shutters instantly rise, flooding the house with cool night breeze.",
