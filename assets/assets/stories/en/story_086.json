          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "narrator",
          "text": "Headlights sweep across the living room wall. A key turns in the front lock—and your fiancé calls out your name from the foyer.",
