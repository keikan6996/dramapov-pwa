          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n02"
        },
        {
          "id": "e4_n02",
          "type": "text",
          "sender_id": "uncle",
          "text": "Think about it, {{player_name}}. If she proves she’s an heir, YOU lose 30% of the estate too! Side with me and we split it 70/30!",
