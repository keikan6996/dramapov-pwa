    {
      "episode_number": 1,
      "title": "The Accidental Attachment",
      "start_node_id": "n01",
      "default_ambient": "family_drama",
      "nodes": [
        {
          "id": "n01",
          "type": "narrator",
          "text": "09:15 AM · Estate Group Chat. Two hours before Grandpa's will reading at the Grand Sterling Hotel.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n02"
        },
        {
          "id": "n02",
          "type": "image",
          "sender_id": "lawyer",
          "image_asset": "assets/media/evidence/generic_legal_document.webp",
          "caption": "Final Codicil — 100% of Sterling Hotel shares transferred to Victor Sterling. Signed Oct 14.",
          "blur_until_tap": true,
          "typing_delay_ms": 800,
          "sfx": "photo_snap",
          "haptic": "medium",
          "next_node_id": "n03"
        },
        {
          "id": "n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait a second. Oct 14? Grandpa slipped into a coma on Oct 11. How did he sign that?",
          "timestamp_label": "09:16 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "unsent_message",
          "sender_id": "uncle",
          "text": "Arthur you idiot, wrong chat!! Delete it before {{player_name}} screenshots the date!",
          "unsent_placeholder": "Uncle Victor unsent a message",
          "reveal_ms": 1900,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n05"
        },
        {
          "id": "n05",
          "type": "text",
          "sender_id": "uncle",
          "text": "Don't be dramatic, {{player_name}}. Arthur just misdated a clerical copy. Show some respect today.",
          "timestamp_label": "09:17 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n06"
        },
        {
          "id": "n06",
          "type": "narrator",
          "text": "PRIVATE DM · Nurse Clara (Grandpa’s ICU nurse) just sent you a voice note.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n07"
        },
        {
          "id": "n07",
          "type": "voice_note",
          "sender_id": "nurse",
          "duration_sec": 14,
          "transcript": "[whispering] {{player_name}}, on the night of Oct 14 your uncle bribed the night guard to shut off the ICU camera for twelve minutes. He pressed a pen into your grandfather's limp hand.",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n08"
        },
        {
          "id": "n08",
          "type": "choice",
          "prompt": "The will reading starts in 90 minutes. Your move?",
          "options": [
            {
              "option_id": "opt_download_meta",
              "label": "Save PDF metadata & stay quiet",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Got it, Clara. Keep the ICU log safe. I will handle Victor.",
              "next_node_id": "n09_free"
            },
            {
              "option_id": "opt_unlock_cctv",
              "label": "Pull backup hallway CCTV footage",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Wait—did the hallway elevator camera stay on that night?",
              "next_node_id": "n09_vip"
            }
          ]
        },
        {
          "id": "n09_free",
          "type": "text",
          "sender_id": "nurse",
          "text": "I already photographed the ICU vitals chart proving he was sedated at that exact minute.",
          "timestamp_label": "09:20 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n11_merge"
        },
        {
          "id": "n09_vip",
          "type": "narrator",
          "text": "SECRET EVIDENCE: The elevator camera caught Uncle Victor walking out of ICU Room 402 with the Estate Lawyer at 2:14 AM!",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "n10_vip"
        },
        {
          "id": "n10_vip",
          "type": "text",
          "sender_id": "nurse",
          "text": "Sending you the encrypted clip now. Victor has no idea that corridor had a second lens.",
          "timestamp_label": "09:20 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n11_merge"
        },
        {
          "id": "n11_merge",
          "type": "text",
          "sender_id": "uncle",
          "text": "By the way, {{player_name}}, security has orders to confiscate all phones before entering the reading room. See you soon.",
          "timestamp_label": "09:24 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n12_end"
        },
        {
          "id": "n12_end",
          "type": "cliffhanger",
          "headline": "Phones Confiscated at the Door",
          "teaser_text": "Episode 2: Victor thinks he silenced you—until you hand the notary a sealed envelope from Grandpa.",
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "The Reading Room",
      "start_node_id": "n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "n01",
          "type": "narrator",
          "text": "11:02 AM · Sterling Manor Library. Twelve relatives sit in silence. You slipped a burner tablet into your blazer.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n02"
        },
        {
          "id": "n02",
          "type": "text",
          "sender_id": "lawyer",
          "text": "We shall now execute the October 14th codicil. All controlling shares pass solely to Victor.",
          "timestamp_label": "11:03 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n03"
        },
        {
          "id": "n03",
          "type": "text",
          "sender_id": "uncle",
          "text": "A heavy burden, truly. {{player_name}}, you may keep your grandfather’s pocket watch as a keepsake.",
          "timestamp_label": "11:04 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "text",
          "sender_id": "player",
          "text": "Generous, Uncle. Before we sign, could Arthur explain why Grandpa’s heart monitor flatlined into sedation three days before that signature?",
          "timestamp_label": "11:05 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n05"
        },
        {
          "id": "n05",
          "type": "unsent_message",
          "sender_id": "lawyer",
          "text": "Victor, abort! The notary is looking at the hospital timestamp!",
          "unsent_placeholder": "Arthur Vance unsent a message",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n06"
        },
        {
          "id": "n06",
          "type": "voice_note",
          "sender_id": "nurse",
          "duration_sec": 11,
          "transcript": "[speakerphone] This is Clara, Head ICU Nurse. I'm outside with the county probate officer and the unedited ICU access logs.",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n07"
        },
        {
          "id": "n07",
          "type": "choice",
          "prompt": "Victor reaches across the table to grab the paper. How do you finish him?",
          "options": [
            {
              "option_id": "opt_open_doors",
              "label": "Unlock the doors for probate officers",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Touch that paper and it becomes evidence tampering in front of twelve witnesses.",
              "next_node_id": "n08_free"
            },
            {
              "option_id": "opt_play_grandpa",
              "label": "Play Grandpa's secret bedside video",
              "cost_type": "vip_rewarded",
              "badge_text": "Power Move · Watch Ad",
              "player_reply_text": "Actually, let Grandpa tell everyone who he caught embezzling last month.",
              "next_node_id": "n08_vip"
            }
          ]
        },
        {
          "id": "n08_free",
          "type": "narrator",
          "text": "The probate officers step inside. Arthur immediately drops his briefcase and asks for immunity.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n10_merge"
        },
        {
          "id": "n08_vip",
          "type": "narrator",
          "text": "GRANDPA'S VIDEO: 'If Victor presents any paper dated after October 1st, revoke his entire share and name {{player_name}} Chairman.'",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "n09_vip"
        },
        {
          "id": "n09_vip",
          "type": "text",
          "sender_id": "uncle",
          "text": "That recording is a deepfake! I built half these hotels!",
          "timestamp_label": "11:09 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n10_merge"
        },
        {
          "id": "n10_merge",
          "type": "text",
          "sender_id": "lawyer",
          "text": "{{player_name}}, I have the real original will in my coat pocket. You own 68% of the Sterling Group.",
          "timestamp_label": "11:11 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n11_end"
        },
        {
          "id": "n11_end",
          "type": "cliffhanger",
          "headline": "The Real Heir Takes the Chair",
          "teaser_text": "Victor is escorted out in handcuffs—but a hidden clause in the real will mentions a second heir nobody has ever met.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
