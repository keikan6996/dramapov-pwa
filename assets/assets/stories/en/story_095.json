        {
          "id": "e3_n07_free",
          "type": "narrator",
          "text": "Your smart-alarm siren shrieks through the hallway—EMT-00 curses and bolts back toward the stairwell empty-handed.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "disp",
          "text": "Unit 4 Dispatch: Neighbors just called 911! Officers spotted a white ambulance speeding west off Oak Avenue!",
          "timestamp_label": "02:24 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "Your cloud dashcam clip loads: ten minutes before your crash, a black sedan ran a cyclist off the mountain road—and the driver is Judge Vance!",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Dispatch! My dashcam caught a hit-and-run by Judge Vance ten minutes before my crash—THAT’S why EMT-00 tried to silence me!",
          "timestamp_label": "02:24 AM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "unsent_message",
          "sender_id": "emt",
          "text": "No backup drive at the apartment. Returning to the old clinic to swap plates.",
          "unsent_placeholder": "EMT-00 unsent a message",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
