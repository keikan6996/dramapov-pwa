          ]
        },
        {
          "id": "e3_n07_free",
          "type": "narrator",
          "text": "You slip past the sleepy security guard into the warm, generator-lit library reading room.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "hannah",
          "text": "Thank goodness the library has its own backup generator! Plug the SD card into Terminal 4!",
          "timestamp_label": "12:52 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "Your phone reader cracks the header: Line 9 wasn’t flooded by a storm—Transit Control opened the sluice gates to hide a chemical leak!",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Hannah! They flooded Tunnel 9 ON PURPOSE to wash away a toxic chemical spill under Central Station!",
          "timestamp_label": "12:52 AM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "unsent_message",
          "sender_id": "cab",
          "text": "Library generator still online. Send Unit 3 to the east entrance.",
          "unsent_placeholder": "CAB_SYSTEM unsent a message",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n10"
        },
        {
          "id": "e3_n10",
          "type": "text",
          "sender_id": "hannah",
          "text": "They know we’re in the library! We have maybe two minutes to upload the black-box files!",
          "timestamp_label": "12:52 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "cab",
          "text": "Line 9 incident is classified under Municipal Safety Directive 4. Step outside.",
          "timestamp_label": "12:52 AM",
          "typing_delay_ms": 650,
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e3_n12_cliff"
