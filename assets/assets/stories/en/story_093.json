      "title": "Terminal Four",
      "start_node_id": "e4_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "01:02 AM · Terminal 4’s screen illuminates your faces as gigabytes of Line 9 telemetry spill open.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n02"
        },
        {
          "id": "e4_n02",
          "type": "text",
          "sender_id": "hannah",
          "text": "Look at the manual override timestamp—11:59 PM! Someone at Central Control locked our train doors and sent us straight into the flood zone!",
          "timestamp_label": "01:02 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n03"
        },
        {
          "id": "e4_n03",
          "type": "text",
          "sender_id": "player",
          "text": "And look who signed the fake safety clearance allowing midnight trains to run anyway—the Transit Commissioner himself!",
          "timestamp_label": "01:02 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n04"
        },
        {
          "id": "e4_n04",
          "type": "unsent_message",
          "sender_id": "hannah",
          "text": "My cousin works at Channel 5 Night Desk—I’m emailing her the entire dump!",
