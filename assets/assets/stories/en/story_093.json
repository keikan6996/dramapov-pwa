        {
          "id": "e4_n07_free",
          "type": "narrator",
          "text": "The progress bar slams to 100%—and both Channel 5 and the Inspector General’s emergency desk auto-confirm receipt!",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e4_n08_free"
        },
        {
          "id": "e4_n08_free",
          "type": "text",
          "sender_id": "hannah",
          "text": "SENT! My cousin just texted back—they’re interrupting the 1 AM broadcast RIGHT NOW!",
