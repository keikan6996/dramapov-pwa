          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e4_n09_merge"
        },
        {
          "id": "e4_n07_vip",
          "type": "narrator",
          "text": "The library laser printer spits out fifty crisp pages of the forged clearance—you hand them straight to startled night students who start filming.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n08_vip"
        },
        {
          "id": "e4_n08_vip",
          "type": "text",
          "sender_id": "player",
