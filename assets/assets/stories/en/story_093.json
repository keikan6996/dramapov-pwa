      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "12:52 AM · You and Hannah climb out of the emergency street grate—and watch every streetlight on 8th Avenue snap black in a wave.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "hannah",
          "text": "{{player_name}}, they’re cutting the streetlights block by block to funnel us! Hold onto that black-box SD card!",
          "timestamp_label": "12:52 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—how is CAB_SYSTEM still texting us on the surface?! We’re out of the tunnel!",
