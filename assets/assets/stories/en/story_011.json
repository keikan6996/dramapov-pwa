    {
      "episode_number": 3,
      "title": "The Redacted Page",
      "start_node_id": "e3_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "12:05 AM · Rain-streaked corner booth across from your publisher. Adrian sits across from you, sliding a yellowed legal page beneath the table lamp.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "adrian",
          "text": "Read what my father handed me two hours before I met you at Platform 4, Rowan. I kept the original for four years.",
          "timestamp_label": "12:05 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "image",
          "sender_id": "adrian",
          "image_asset": "assets/media/evidence/generic_legal_document.webp",
          "caption": "Signed Foreclosure Threat · Dated 4 years ago—threatening your family’s bookstore unless Adrian cut all contact.",
          "blur_until_tap": true,
          "typing_delay_ms": 850,
          "sfx": "photo_snap",
          "haptic": "heavy",
          "next_node_id": "e3_n04"
        },
        {
          "id": "e3_n04",
          "type": "text",
          "sender_id": "player",
          "text": "My parents’ bookstore… He bought their mortgage note just to force you to break my heart?!",
          "timestamp_label": "12:07 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n05"
        },
        {
          "id": "e3_n05",
          "type": "unsent_message",
          "sender_id": "adrian",
          "text": "I hated myself every second I stood on that platform watching you cry in the rain.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n06"
        },
        {
          "id": "e3_n06",
          "type": "text",
          "sender_id": "adrian",
          "text": "The day my startup went public, I bought your parents’ mortgage from him and burned the deed—then my father’s lawyer just texted me an injunction to block Chapter 7!",
          "timestamp_label": "12:08 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n07"
        },
        {
          "id": "e3_n07",
          "type": "voice_note",
          "sender_id": "adrian",
          "duration_sec": 10,
          "transcript": "[rain tapping café window] He’s terrified this memoir will expose how he bullied small businesses in Boston. If I publish Chapter 7, he’ll sue me for defamation.",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n08"
        },
        {
          "id": "e3_n08",
          "type": "text",
          "sender_id": "adrian",
          "text": "The publisher’s final print lock is at 9 AM, Rowan. Tell me—do we cut Chapter 7 or fight him?",
          "timestamp_label": "12:10 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n09"
        },
        {
          "id": "e3_n09",
          "type": "choice",
          "prompt": "Adrian’s father is trying to silence Chapter 7 before print lock. Your move?",
          "options": [
            {
              "option_id": "e3_opt_free",
              "label": "Keep Chapter 7 and attach the legal proof",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Keep every word of Chapter 7—the truth isn’t defamation, Adrian.",
              "next_node_id": "e3_n10a"
            },
            {
              "option_id": "e3_opt_vip",
              "label": "Co-author Chapter 7 under both your names",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Secret Twist",
              "player_reply_text": "Tear up the NDA—put both our names on the cover and let him try!",
              "next_node_id": "e3_n10b"
            }
          ]
        },
        {
          "id": "e3_n10a",
          "type": "text",
          "sender_id": "adrian",
          "text": "You’re braver than I ever was, Rowan. I’m emailing the original signed threat to our publisher’s lawyers now.",
          "timestamp_label": "12:11 AM",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n10b",
          "type": "narrator",
          "text": "VIP TWIST: The publisher’s chief counsel clears Chapter 7 on the spot—and announces your co-authored edition will lead the front page of Sunday’s book review!",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "adrian",
          "text": "Wait—my hand is shaking. Before we leave this booth, there’s one more thing I brought from Boston.",
          "timestamp_label": "12:12 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n12"
        },
        {
          "id": "e3_n12",
          "type": "text",
          "sender_id": "adrian",
          "text": "I never threw it away, Rowan. Not even for a single day.",
          "timestamp_label": "12:13 AM",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n13_end"
        },
        {
          "id": "e3_n13_end",
          "type": "cliffhanger",
          "headline": "The Truth In Ink",
          "teaser_text": "Episode 4: Adrian opens his coat pocket—revealing the ring he meant to give you at Platform 4.",
