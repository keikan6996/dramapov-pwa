      "start_node_id": "e2_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "11:38 PM · Your screen flashes with an incoming call from \"Client X.\"",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "incoming_call",
          "caller_id": "adrian",
          "caller_label": "Adrian Thorne (Calling...)",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 10000,
          "can_decline": true,
          "on_answer_node_id": "e2_n03a",
          "on_decline_node_id": "e2_n03b"
        },
        {
          "id": "e2_n03a",
          "type": "narrator",
          "text": "You answer without speaking. You hear him whisper your name—\"Rowan\"—like a prayer.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n03b",
          "type": "narrator",
          "text": "You let it ring out. Two seconds later, his messages flood your screen.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "adrian",
          "text": "I just checked the publisher's NDA roster. Rowan, I wasn't writing a memoir to sell books. I wrote it hoping you'd read Chapter 7.",
          "timestamp_label": "11:39 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "adrian",
          "text": "I'm already in my car driving to the coffee shop across from your publisher.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "voice_note",
          "sender_id": "adrian",
          "duration_sec": 9,
          "transcript": "[rain hitting windshield] Four years ago I made a coward's choice to protect you. Give me one hour to prove I'll never let go again.",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "choice",
          "prompt": "After four years of heartbreak, he's asking for one hour.",
          "options": [
            {
              "option_id": "opt_meet_him",
              "label": "Agree to meet—and bring back his grey scarf",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Twenty minutes. Corner café. I still have your scarf.",
              "next_node_id": "e2_n08a"
            },
            {
              "option_id": "opt_vip_rewrite",
              "label": "Tell him Chapter 8 needs a better ending",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · New Ending",
              "player_reply_text": "Your memoir has a terrible ending, Adrian. Come help me rewrite Chapter 8.",
              "next_node_id": "e2_n08b"
            }
          ]
        },
        {
          "id": "e2_n08a",
          "type": "text",
          "sender_id": "adrian",
          "text": "You kept the scarf... I'm pulling up now, Rowan.",
          "timestamp_label": "11:42 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n08b",
          "type": "text",
          "sender_id": "adrian",
          "text": "Every chapter from tonight on belongs to us, Rowan. Look outside.",
          "timestamp_label": "11:42 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n09",
          "type": "cliffhanger",
          "headline": "Chapter Eight Begins Tonight.",
          "teaser_text": "Episode 3: Inside the midnight café across from your publisher, Adrian shows you the blackmail letter his father forced him to sign.",
          "sfx": "gasp",
          "ambient": "night_city",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
