        {
          "id": "e4_n02",
          "type": "text",
          "sender_id": "adrian",
          "text": "This was in my coat pocket at Platform 4 four years ago. I went there to propose—not to leave you.",
          "timestamp_label": "12:35 AM",
          "typing_delay_ms": 650,
