      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "12:35 AM · Empty Café Booth. Adrian sets a worn velvet ring box beside your untouched tea, his fingers trembling.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e4_n02"
