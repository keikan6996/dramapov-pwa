          "haptic": "heavy",
          "next_node_id": "e4_n11"
        },
        {
          "id": "e4_n10b",
          "type": "narrator",
          "text": "VIP TWIST: You slip the ring onto your chain beside your heart—and Adrian immediately posts the unredacted foreclosure threat to his 2 million readers!",
          "style": "system_alert",
          "sfx": "gasp",
