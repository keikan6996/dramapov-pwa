      "episode_number": 1,
      "title": "Button 13 Lit Up",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:14 AM · The elevator jolts to a halt. The red LED flickers past 12 and locks onto 13.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Taylor, I see Car B stalled on my monitor. Why did you press the service override?",
          "timestamp_label": "2:14 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "I didn’t touch anything! The doors just slid open onto a dark hallway. There’s someone waving at me.",
          "timestamp_label": "2:15 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "Good. Step out so I can finally leave.",
