        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "You decline. A voicemail transcribes instantly: \"This is Hector—I’m locked in the lobby! That’s NOT me texting you!\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "Then Who Was Texting You?",
          "teaser_text": "Episode 2: The figure on Floor 13 lifts a glowing phone—and smiles.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
