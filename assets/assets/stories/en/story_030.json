      "episode_number": 1,
      "title": "Drawer #7: 37°C",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:33 AM · Basement B2 Pathology Lab. The temperature alarm for Cold Drawer #7 chirps red.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, I just got a thermal alert on my phone! Why is Drawer #7 reading 37°C—human body temperature?!",
          "timestamp_label": "2:33 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "The compressor is running fine, Doctor! Wait—the sealed evidence phone from Drawer #7 just messaged me!",
          "timestamp_label": "2:34 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "Let me out. It’s too dark in this steel box.",
