          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "Impossible! I sealed that phone inside Locker 4 with the battery removed! Check the drawer latch from a distance!",
          "timestamp_label": "2:35 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 12,
          "transcript": "[muffled banging on steel, ragged breath] ...{{player_name}}... I’m not dead... pull the handle...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "Frost melts off the steel handle of Drawer #7. A rhythmic thud shakes the latch.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Check the autopsy tag for Drawer #7",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Pulling up the intake file...",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "Play back the voice note at 2x volume",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Listening closely to the background...",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "You freeze. The intake report says John Doe #7 had already been autopsied at 6 PM—his heart was removed.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: Beneath the banging isn’t Drawer #7—it’s the sound of the lab’s glass door sliding open RIGHT BEHIND YOU.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}!! I’m looking at the B2 CCTV! Drawer #7 has been WIDE OPEN for ten minutes!",
          "timestamp_label": "2:37 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
