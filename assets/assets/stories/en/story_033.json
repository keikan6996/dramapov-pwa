          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, STOP THE CAR!! I see your location dot turning onto Old River Bridge—that bridge collapsed in 2012!",
