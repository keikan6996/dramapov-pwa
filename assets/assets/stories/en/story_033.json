          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "That’s impossible! I’m driving on solid concrete right now—and there’s a red sedan with taillights ahead of me!",
