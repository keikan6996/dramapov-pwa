    {
      "episode_number": 1,
      "title": "Code Black",
      "start_node_id": "e1_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:11 AM · ST. JUDE SERVER ROOM: Every terminal flashes crimson. \"ALL INFUSION PUMPS ENCRYPTED. 15:00 REMAINING.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "patel",
          "text": "Taylor!! Our ICU ventilators just dropped off the network! We’re bagging three patients manually—fix it NOW!",
          "timestamp_label": "2:11 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "zday",
          "text": "No Bitcoin needed, Taylor. Purge Patient #4409’s toxicology report from the master database, and I’ll drop the decryption key instantly.",
          "timestamp_label": "2:12 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Patient #4409?! Who is in Bed 9, Dr. Patel?!",
          "timestamp_label": "2:12 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "patel",
          "duration_sec": 8,
          "transcript": "[monitors beeping wildly] That’s a John Doe brought in from a yacht party! His blood tested positive for a banned military nerve agent—it’s a murder attempt!",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Countdown hits 11:30. ICU lives hang in the balance:",
          "options": [
            {
              "option_id": "opt_090_e1_free",
              "label": "Switch ICU to air-gapped offline backup",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Dr. Patel, pull the blue ethernet cables on all pumps—I’m pushing offline firmware!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_090_e1_vip",
              "label": "Clone #4409’s tox report before purging",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Manual override restores two ventilators—but the ransomware jumps the VLAN and locks the pharmacy dispensing vault.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "zday",
          "text": "Clever little engineer. Too bad Bed 9 needs atropine in four minutes—and I just locked the meds.",
          "timestamp_label": "2:15 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You quietly mirror the toxicology PDF onto an air-gapped USB stick, then execute a visible wipe on the main SQL table. ZERO_DAY takes the bait.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "zday",
          "text": "Good choice. Decryption key incoming... Wait. Why did a USB mount just log on Server Rack 3?",
          "timestamp_label": "2:15 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "unsent_message",
          "sender_id": "zday",
          "text": "Badge swipe detected outside Server Room B. Our cleaner is already on your floor.",
          "unsent_placeholder": "ZERO_DAY unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "The server room badge reader beeps green—even though only two IT staff have clearance. The heavy steel door swings inward.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Intruder In Rack 3",
          "teaser_text": "Someone just unlocked the server vault with an admin badge—and the ICU countdown has 3 minutes left.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Root Access",
      "start_node_id": "e2_n01",
      "default_ambient": "heartbeat",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "2:18 AM · You duck behind the cold-aisle server rack. Footsteps pace slowly between the humming blades.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "incoming_call",
          "caller_id": "patel",
          "caller_label": "Dr. Patel · ICU",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n03_ans",
          "on_decline_node_id": "e2_n03_dec"
        },
        {
          "id": "e2_n03_ans",
          "type": "voice_note",
          "sender_id": "patel",
          "duration_sec": 7,
          "transcript": "[whispered] Taylor! Hospital security says the badge used on your server room belongs to our own Chief of Surgery—Dr. Vance!",
          "audio_asset": null,
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n03_dec",
          "type": "text",
          "sender_id": "patel",
          "text": "Security just traced the badge swipe—it’s the Chief of Surgery! And Bed 9 just woke up and whispered his name!",
          "timestamp_label": "2:18 AM",
          "typing_delay_ms": 500,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "zday",
          "text": "Hand over the USB stick, Taylor, and I’ll restore the ICU myself. Nobody has to die tonight.",
          "timestamp_label": "2:19 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "text",
          "sender_id": "player",
          "text": "You poisoned your own patient and held an entire ICU hostage to cover it up?!",
          "timestamp_label": "2:19 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n06_choice"
        },
        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "The Chief of Surgery rounds Rack 3. Stop him:",
          "options": [
            {
              "option_id": "opt_090_e2_free",
              "label": "Trigger Halon fire-suppression lock",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": null,
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_090_e2_vip",
              "label": "Dump decryption key from his laptop",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Got your local key—and emailed the tox report to the Medical Board!",
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "You dart past him out the door and smash the yellow Halon alarm. Blast doors slam shut, trapping the Chief inside until hospital police arrive.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "patel",
          "text": "All ICU monitors just came back green! You saved four lives tonight, Taylor!",
          "timestamp_label": "2:21 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "You yank the active Ethernet cable from his open laptop, pulling the local ransomware key straight into the hospital’s master controller. Every pump resets.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "patel",
          "text": "Pumps are back online AND security just cuffed him in the hallway! Thank god you kept that report!",
          "timestamp_label": "2:21 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "unsent_message",
          "sender_id": "zday",
          "text": "You caught the doctor, Taylor. Not the person who wrote the zero-day.",
          "unsent_placeholder": "ZERO_DAY unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "narrator",
          "text": "As dawn breaks over St. Jude’s, your phone receives one final encrypted ping—from a hospital IP address on the Pediatric Ward.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "The Architect Is Still Inside",
          "teaser_text": "The Chief of Surgery was only the buyer. The real ZERO_DAY hacker is still connected to St. Jude’s internal network.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
