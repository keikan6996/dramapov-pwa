        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "The access log flashes a familiar name: \"MARCUS V. — MEDTECH EXTERNAL IT VENDOR.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "ZERO_DAY is Marcus from our own IT contractor! He installed the backdoor during last month’s upgrade!",
          "timestamp_label": "02:26 AM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
