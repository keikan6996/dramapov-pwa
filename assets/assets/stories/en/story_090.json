        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "patel",
          "text": "Ventilator steady! Patient in Bed 7 is stable—whoever is in there can’t touch my patients now!",
          "timestamp_label": "02:26 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
