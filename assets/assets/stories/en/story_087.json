  "episodes": [
    {
      "episode_number": 1,
      "title": "Burn Notice",
      "start_node_id": "e1_n01",
      "default_ambient": "mystery_ticking",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "11:55 PM · Coastal Oregon. Rain drums on the porch roof. Your encrypted Witness Protection phone chimes for the first time in 14 months.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "unsent_message",
          "sender_id": "vance",
          "text": "Target confirmed at 412 Cedar Lane. Porch light off. Moving in.",
          "unsent_placeholder": "Agent Vance unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Vance?! I just saw that message before you unsent it! Who are you texting my address to?!",
          "timestamp_label": "11:56 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "vance",
          "text": "Stay calm, Avery! My phone was cloned at the Portland field office—I’m NOT outside your house! Grab your go-bag and run!",
          "timestamp_label": "11:56 PM",
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "cleanup",
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice",
          "text": "Nice new haircut, Avery. The cartel sends its regards."
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Gravel crunches outside your back fence. Move fast:",
          "options": [
            {
              "option_id": "opt_087_e1_free",
              "label": "Slip out the cellar storm door",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I’m out the cellar door—headed for the harbor road!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_087_e1_vip",
              "label": "Leave the encrypted phone as a decoy",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You crawl into the wet pines just as two suppressed shots shatter your kitchen window. Your phone buzzes—GPS still broadcasting.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "cleanup",
          "text": "Thanks for keeping the Marshal phone on, Avery. I can see you heading east toward the pier.",
          "timestamp_label": "11:58 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You toss the USMS phone into the bed of a passing delivery truck and switch to your hidden prepaid SIM. Two black sedans immediately chase the truck.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "vance",
          "text": "Brilliant decoy! Meet me at the old lighthouse parking lot in 10 minutes—come alone!",
          "timestamp_label": "11:58 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "voice_note",
          "sender_id": "cleanup",
          "duration_sec": 7,
          "transcript": "[rain, muffled radio] \"Tell the witness not to trust Vance. Who do you think sold us the 412 Cedar Lane file for half a million?\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "player",
          "text": "Wait... if Vance really sold me out, then walking to the lighthouse is walking into a grave!",
          "timestamp_label": "11:59 PM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Who Sold The File?",
          "teaser_text": "Your handler is waiting at the lighthouse—and the hitman swears Vance is the one who bought your death warrant.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Lighthouse Stand-Off",
      "start_node_id": "e2_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "12:09 AM · Fog swallows the cliff road. The lighthouse beam sweeps over a single parked sedan with its hazards blinking.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "incoming_call",
          "caller_id": "vance",
          "caller_label": "Agent Vance · USMS",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n03_ans",
          "on_decline_node_id": "e2_n03_dec"
        },
        {
          "id": "e2_n03_ans",
          "type": "voice_note",
          "sender_id": "vance",
          "duration_sec": 8,
          "transcript": "[wind whipping] Avery, I see you in the tree line! CleanUp_09 is bluffing to separate us—get in the car before his backup arrives!",
          "audio_asset": null,
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n03_dec",
          "type": "text",
          "sender_id": "vance",
          "text": "Stop hesitating! He’s trying to make you distrust me so you run right into his ambush on the highway!",
          "timestamp_label": "12:09 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "cleanup",
          "text": "Ask Vance to show you his left wrist. Real Marshals don’t wear a $40,000 platinum watch.",
          "timestamp_label": "12:10 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "text",
          "sender_id": "player",
          "text": "One way to find out who’s dirty.",
          "timestamp_label": "12:10 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n06_choice"
        },
        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "Vance steps out of the sedan with hands raised. Choose your move:",
          "options": [
            {
              "option_id": "opt_087_e2_free",
              "label": "Demand Vance roll up his left sleeve",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Stay by the bumper, Vance! Roll up your left sleeve right now!",
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_087_e2_vip",
              "label": "Trigger the Coast Guard distress flare",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "Vance freezes—then slowly rolls up his sleeve. No platinum watch—only a battered steel Casio and a fresh zip-tie welt around his wrist.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "vance",
          "text": "They jumped me at the ferry dock! Look at the trunk—there’s a sniper laser on the lighthouse roof!",
          "timestamp_label": "12:12 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "You fire a crimson marine flare straight into the fog. The glare blinds the sniper perched on the lighthouse catwalk—forcing CleanUp_09 to break cover.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "cleanup",
          "text": "Coast Guard cutter just lit up its spotlight! Abort! Abort!",
          "timestamp_label": "12:12 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "unsent_message",
          "sender_id": "vance",
          "text": "The leak wasn’t me, Avery. It was Deputy Director Monroe in D.C.",
          "unsent_placeholder": "Agent Vance unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "text",
          "sender_id": "vance",
          "text": "Get in the car. We’re burning your third identity tonight—and this time we go off the federal grid completely.",
          "timestamp_label": "12:13 AM",
          "typing_delay_ms": 600,
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "Off The Grid",
          "teaser_text": "The leak reaches the top of the Marshal Service. Your only chance to testify alive is to vanish tonight.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
      "episode_number": 3,
      "title": "Safe House Burned",
      "start_node_id": "e3_n01",
      "default_ambient": "office_tension",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "12:18 AM · You vault the cedar back fence as CleanUp_09 kicks open your porch door twenty yards behind you.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "vance",
          "text": "Avery! Ditch your issued USMS phone in the creek—the leak inside our office cloned its GPS!",
          "timestamp_label": "12:18 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "text",
          "sender_id": "player",
          "text": "I’m using my hidden prepaid! Where do we meet, Vance—and how do I know YOU aren’t the leak?!",
          "timestamp_label": "12:18 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n04"
        },
        {
          "id": "e3_n04",
          "type": "text",
          "sender_id": "vance",
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n05",
          "text": "USMS Internal Log · 12:14 AM — Your porch coordinates queried by Deputy Director’s tablet."
        },
        {
          "id": "e3_n05",
          "type": "voice_note",
          "sender_id": "vance",
          "duration_sec": 8,
          "transcript": "[gravel tires skidding] Look at the log I just sent! Deputy Director Kroll sold your file to the cartel! Meet me at the county annex garage!",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n06_choice"
        },
        {
          "id": "e3_n06_choice",
          "type": "choice",
          "prompt": "A dark SUV slows along the creek road searching the brush. React:",
          "options": [
            {
              "option_id": "opt_087_e3_free",
              "label": "Toss your USMS phone into a passing pickup",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Decoy away! Heading on foot to the county annex now!",
              "next_node_id": "e3_n07_free"
            },
            {
              "option_id": "opt_087_e3_vip",
              "label": "Send Kroll’s query log to the Federal Judge",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e3_n07_vip"
            }
          ]
        },
        {
          "id": "e3_n07_free",
          "type": "narrator",
          "text": "The dark SUV whips a U-turn to chase the pickup’s taillights—buying you a clear sprint into the trees.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "cleanup",
          "text": "Signal’s moving west at 55 mph! Cut her off at the bridge!",
          "timestamp_label": "12:18 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "Judge Mercer’s emergency clerk confirms receipt—and quietly orders independent FBI marshals to surround the courthouse.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Judge Mercer has Kroll’s internal log now! If anything happens to us, Kroll is finished!",
          "timestamp_label": "12:18 AM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "unsent_message",
          "sender_id": "cleanup",
          "text": "Pickup was empty—just a wet phone. Check the county courthouse annex.",
          "unsent_placeholder": "CleanUp_09 unsent a message",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n10"
        },
        {
          "id": "e3_n10",
          "type": "text",
          "sender_id": "vance",
          "text": "I’m inside the annex basement! Take the loading-dock stairs—hurry!",
          "timestamp_label": "12:18 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "cleanup",
          "text": "Nice decoy, witness. See you at the courthouse annex.",
          "timestamp_label": "12:18 AM",
          "typing_delay_ms": 650,
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e3_n12_cliff"
        },
        {
          "id": "e3_n12_cliff",
          "type": "cliffhanger",
          "headline": "Corridor Sweep",
          "teaser_text": "Deputy Director Kroll is the mole—and CleanUp_09 just realized you’re heading for the courthouse annex.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 4
        }
      ]
    },
    {
      "episode_number": 4,
      "title": "The Courthouse Vault",
      "start_node_id": "e4_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "12:34 AM · You slip through the annex loading dock. Vance pulls you behind a row of steel archive cabinets.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n02"
        },
        {
          "id": "e4_n02",
          "type": "text",
          "sender_id": "vance",
          "text": "We hold out here until 6 AM when Judge Mercer’s grand jury opens. I brought my service weapon.",
          "timestamp_label": "12:34 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n03"
        },
        {
          "id": "e4_n03",
          "type": "text",
          "sender_id": "player",
          "text": "We won’t make it to 6 AM if Kroll sends his own marshals to sweep this basement!",
          "timestamp_label": "12:34 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n04"
        },
        {
          "id": "e4_n04",
          "type": "unsent_message",
          "sender_id": "vance",
          "text": "I already called the FBI Field Office—they’re ten minutes out.",
          "unsent_placeholder": "Agent Vance unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n05"
        },
        {
          "id": "e4_n05",
          "type": "voice_note",
          "sender_id": "cleanup",
          "duration_sec": 7,
          "transcript": "[heavy steel door creaking upstairs] Power’s cut, witness. Hand over your testimony binder and Vance keeps his life.",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e4_n06_choice"
        },
        {
          "id": "e4_n06_choice",
          "type": "choice",
          "prompt": "The basement lights die. Emergency glow sticks flicker in the corridor:",
          "options": [
            {
              "option_id": "opt_087_e4_free",
              "label": "Lock the archive vault from inside",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Spin the vault wheel, Vance! They can’t breach six inches of steel before the FBI arrives!",
              "next_node_id": "e4_n07_free"
            },
            {
              "option_id": "opt_087_e4_vip",
              "label": "Trigger the courthouse silent panic alarm",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e4_n07_vip"
            }
          ]
        },
        {
          "id": "e4_n07_free",
          "type": "narrator",
          "text": "Heavy steel bolts thud into the frame just as CleanUp_09 rattles the exterior handle.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e4_n08_free"
        },
        {
          "id": "e4_n08_free",
          "type": "text",
          "sender_id": "vance",
          "text": "Solid steel! Now we wait for the cavalry!",
          "timestamp_label": "12:34 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e4_n09_merge"
        },
        {
          "id": "e4_n07_vip",
          "type": "narrator",
          "text": "The silent panic button alerts every federal unit in a five-mile radius—and locks the annex’s street exits from the outside.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n08_vip"
        },
        {
          "id": "e4_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "CleanUp_09 just walked into a sealed box! Nobody leaves this building until the FBI unlocks it!",
          "timestamp_label": "12:34 AM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n09_merge"
        },
        {
