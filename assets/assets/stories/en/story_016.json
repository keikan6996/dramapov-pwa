          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n07"
        },
        {
          "id": "e3_n07",
          "type": "unsent_message",
          "sender_id": "caleb",
          "text": "My dad gave me 24 hours to sign an arranged engagement or lose everything—I’m not signing.",
