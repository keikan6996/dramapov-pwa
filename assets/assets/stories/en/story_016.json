    {
      "episode_number": 2,
      "title": "Midnight Confession",
      "start_node_id": "e2_n01",
      "default_ambient": "rain_night",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "11:50 PM · You step off the yacht onto the pier. Caleb chases after you in the pouring rain while texting frantically.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "caleb",
          "text": "I'm an idiot, {{player_name}}. It started as a stupid bet on Day 1—and by Day 4 I realized I was completely ruined for anyone else.",
          "timestamp_label": "11:50 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "How am I supposed to believe a single word you say when you treated my heart like a poker chip?",
          "timestamp_label": "11:51 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "anon",
          "text": "He's not lying about one thing, {{player_name}}. He really did wire me the $10M forfeit at 10 PM so I'd delete the bet. I leaked it anyway because I wanted you for myself.",
          "timestamp_label": "11:52 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "caleb",
          "text": "I don't care about the $10M. Losing you is the only thing that scares me.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "voice_note",
          "sender_id": "caleb",
          "duration_sec": 9,
          "transcript": "[out of breath in the rain] It's 11:59 PM, {{player_name}}. Don't say you love me tonight—make me earn it for the next hundred days.",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "choice",
          "prompt": "Midnight fireworks burst over the harbor. Caleb stands soaked ten feet away.",
          "options": [
            {
              "option_id": "opt_make_earn",
              "label": "Walk away—and tell him Day 1 starts tomorrow",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "You lost the bet, Caleb. If you want me, start from zero tomorrow.",
              "next_node_id": "e2_n08a"
            },
            {
              "option_id": "opt_vip_umbrella",
              "label": "Share your umbrella—on one strict condition",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Heartbeat",
              "player_reply_text": "Get under my umbrella before you catch pneumonia. You owe me a real first date.",
              "next_node_id": "e2_n08b"
            }
          ]
        },
        {
          "id": "e2_n08a",
          "type": "text",
          "sender_id": "caleb",
          "text": "Best loss of my life. See you at 7 AM with coffee, {{player_name}}.",
          "timestamp_label": "12:01 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n08b",
          "type": "text",
          "sender_id": "caleb",
          "text": "I'll spend the rest of my life proving you were never a bet, {{player_name}}.",
          "timestamp_label": "12:01 AM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n09",
          "type": "cliffhanger",
          "headline": "No More Bets. Only Truth.",
          "teaser_text": "Season Finale · Under the midnight fireworks, Caleb smiles through the rain—ready to fight for you for real.",
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
