      "title": "11:30 PM Countdown",
      "start_node_id": "e1_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "11:30 PM · Rooftop yacht party. Caleb just stepped away to grab two glasses of champagne. An unknown number texts you.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "anon",
          "text": "Don't say those three words to Caleb tonight, {{player_name}}. He bet his country-club friends $10M he'd make you fall in love before midnight.",
          "timestamp_label": "11:30 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "That's a sick joke. Caleb isn't like that. Prove it.",
          "timestamp_label": "11:31 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "anon",
          "duration_sec": 10,
          "transcript": "[Caleb's voice laughing at a bar last month] \"Relax boys, give me thirty days. She'll say I love you before midnight on the 30th—and that yacht is mine.\"",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "narrator",
          "text": "Your chest goes numb. Today is Day 30. And it's 11:33 PM.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "caleb",
          "text": "Hey gorgeous, where'd you disappear to? Meet me on the upper deck—I want to ask you something before midnight. ✨",
          "timestamp_label": "11:34 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "unsent_message",
          "sender_id": "caleb",
          "text": "I already told the guys to cancel the bet—I'm actually falling for you.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "choice",
          "prompt": "You saw both the leaked audio AND his unsent text. Walk up to the deck.",
          "options": [
            {
              "option_id": "opt_play_audio",
              "label": "Forward him the leaked audio with zero words",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Play this before you ask me anything, Caleb.",
              "next_node_id": "e1_n09a"
            },
            {
              "option_id": "opt_vip_reverse",
              "label": "Walk up and make HIM lose the $10M bet live",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Plot Twist",
              "player_reply_text": "Coming up now. Hope your friends are watching the clock.",
              "next_node_id": "e1_n09b"
            }
          ]
        },
        {
          "id": "e1_n09a",
          "type": "text",
          "sender_id": "caleb",
          "text": "{{player_name}}, STOP! Let me explain—I paid the $10M forfeit an hour ago! Please don't leave the yacht!",
          "timestamp_label": "11:36 PM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n09b",
          "type": "text",
          "sender_id": "caleb",
          "text": "You know about the bet... {{player_name}}, I already threw the bet in the trash. Stay right there.",
          "timestamp_label": "11:36 PM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "cliffhanger",
          "headline": "20 Minutes To Midnight.",
          "teaser_text": "Episode 2: Caleb drops to one knee on the upper deck—while his jealous friend who leaked the audio steps out of the shadows.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
