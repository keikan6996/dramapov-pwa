          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n09"
        },
        {
          "id": "e4_n09",
          "type": "choice",
          "prompt": "The board wants to make an example of you. Your move?",
          "options": [
            {
              "option_id": "opt_e4_bring_receipts",
