          "id": "e4_n08",
          "type": "voice_note",
          "sender_id": "theo",
          "duration_sec": 9,
          "transcript": "[firm, calm] \"Don’t you dare pack your desk, {{player_name}}. Come to the 5 PM board review—I have the lobby CCTV timestamped.\"",
