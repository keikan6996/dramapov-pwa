      "title": "The Rigged Lease",
      "start_node_id": "e3_n01",
      "default_ambient": "office_tension",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "8:20 AM · Office lobby. Everyone stares as CEO Theo Grant steps out of the executive elevator holding your apartment folder.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
