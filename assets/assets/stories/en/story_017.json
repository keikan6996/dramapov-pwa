            {
              "option_id": "opt_e3_vip_tease_ceo",
              "label": "Let Theo claim you in front of HR",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Office Drama",
              "player_reply_text": "Ask the CEO himself—he’s standing right outside the glass door.",
