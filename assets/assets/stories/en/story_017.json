          "id": "e3_n02",
          "type": "text",
          "sender_id": "theo",
          "text": "Good morning, tenant—and star analyst. Look closely at the signature on that eviction notice you yelled at me over.",
          "timestamp_label": "8:20 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait... that’s not your handwriting! The building manager tried to kick me out illegally?!",
          "timestamp_label": "8:21 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n04"
        },
        {
          "id": "e3_n04",
          "type": "image",
          "sender_id": "theo",
          "image_asset": "assets/media/evidence/generic_legal_document.webp",
