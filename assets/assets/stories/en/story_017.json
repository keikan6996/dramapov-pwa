          "sfx": "photo_snap",
          "haptic": "medium",
          "next_node_id": "e3_n05"
        },
        {
          "id": "e3_n05",
          "type": "narrator",
          "text": "HR pings you: \"Report to the 28th floor immediately. Someone reported you for inappropriate texts with the CEO.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n06"
        },
        {
          "id": "e3_n06",
          "type": "text",
          "sender_id": "theo",
          "text": "Don’t panic. It’s Claire from Finance—she saw us walking out of the building together this morning.",
          "timestamp_label": "8:23 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n07"
        },
        {
          "id": "e3_n07",
          "type": "unsent_message",
          "sender_id": "theo",
          "text": "I bought the entire apartment building six months ago just so your rent would never go up.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n08"
        },
        {
          "id": "e3_n08",
          "type": "voice_note",
          "sender_id": "theo",
          "duration_sec": 10,
          "transcript": "[cool, protective tone] \"Walk into HR with your head high, {{player_name}}. I’m already firing the crooked building manager—and I’m right behind you.\"",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n09"
        },
        {
          "id": "e3_n09",
          "type": "choice",
          "prompt": "HR wants an explanation for your midnight texts with the CEO.",
          "options": [
            {
              "option_id": "opt_e3_show_lease",
              "label": "Slam the forged eviction notice on the desk",
              "cost_type": "free",
