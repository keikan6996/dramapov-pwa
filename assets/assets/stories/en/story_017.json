        {
          "id": "e3_n10a",
          "type": "text",
          "sender_id": "theo",
          "text": "Brilliant. HR just apologized on the spot—and Claire’s face turned bright red.",
          "timestamp_label": "8:25 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n10b",
          "type": "text",
          "sender_id": "theo",
          "text": "I walked in and told them I’m pursuing you off the clock. Watch the office group chat explode in 3... 2...",
          "timestamp_label": "8:25 AM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
