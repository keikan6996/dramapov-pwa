    {
      "episode_number": 4,
      "title": "The Rooftop Confession",
      "start_node_id": "e4_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "12:30 PM · Executive rooftop terrace. Wind ruffles Theo’s tie as he hands you a warm cup of jasmine tea.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n02"
        },
        {
          "id": "e4_n02",
          "type": "text",
          "sender_id": "theo",
          "text": "Two years ago, outside St. Jude’s Hospital in a thunderstorm, a stranger gave a soaked guy her last umbrella and a bus fare.",
          "timestamp_label": "12:30 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n03"
        },
        {
          "id": "e4_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait... that guy whose phone died after visiting his grandfather—that was YOU?!",
          "timestamp_label": "12:31 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n04"
        },
        {
          "id": "e4_n04",
          "type": "text",
          "sender_id": "theo",
          "text": "You didn’t even ask my name. When I saw your resume six months ago, I recognized the handwriting on the umbrella tag.",
          "timestamp_label": "12:33 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n05"
        },
        {
          "id": "e4_n05",
          "type": "narrator",
          "text": "Your phone buzzes—the fired building manager just leaked a cropped photo of Theo entering your apartment to the board.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n06"
        },
        {
          "id": "e4_n06",
          "type": "text",
          "sender_id": "theo",
          "text": "They’re accusing me of abusing company funds for a \"secret girlfriend.\" If I don’t respond by 5 PM, they’ll suspend you.",
          "timestamp_label": "12:33 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n07"
        },
        {
          "id": "e4_n07",
          "type": "unsent_message",
          "sender_id": "theo",
          "text": "I’ll resign as CEO before I let a single rumor touch your reputation.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n08"
        },
