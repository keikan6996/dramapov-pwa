          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n05"
        },
        {
          "id": "n05",
          "type": "text",
          "sender_id": "rival",
          "text": "Omg Paige I just heard!! I’m literally shaking—who would hack your laptop?!",
