              "option_id": "opt_laptop_cam",
              "label": "Check your laptop’s failed-login photo",
              "cost_type": "vip_rewarded",
              "badge_text": "Gotcha · Watch Ad",
              "player_reply_text": "Wait—my security app snaps a webcam photo whenever someone mistypes my password!",
              "next_node_id": "n08_vip"
