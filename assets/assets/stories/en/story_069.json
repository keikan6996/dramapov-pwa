      "title": "The Fake Resignation",
      "start_node_id": "n01",
      "default_ambient": "office_tension",
      "nodes": [
        {
          "id": "n01",
          "type": "narrator",
          "text": "08:12 AM · You walk into the agency with coffee for both yourself and Clara. Your VP texts you.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n02"
        },
        {
          "id": "n02",
          "type": "text",
          "sender_id": "director",
          "text": "Paige, I’m stunned. You emailed your immediate resignation at 7:18 PM last night—and CC’d our rival agency’s recruiter?!",
          "timestamp_label": "08:12 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n03"
        },
        {
          "id": "n03",
          "type": "text",
          "sender_id": "player",
          "text": "WHAT?! I left the office at 6:30 PM! I never sent that email!",
          "timestamp_label": "08:13 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "unsent_message",
          "sender_id": "rival",
          "text": "Done. Paige is disqualified. Cancel the 10 AM interview and just prep my offer letter.",
