          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n06"
        },
        {
          "id": "n06",
          "type": "voice_note",
          "sender_id": "intern",
          "duration_sec": 11,
          "transcript": "[nervous] Hey Paige... I stayed late printing boards. At 7:15 PM I saw Clara sitting at your desk typing on your laptop. She told me you asked her to send a file.",
