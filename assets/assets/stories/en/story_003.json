        {
          "id": "e1_n09a",
          "type": "text",
          "sender_id": "ryan",
          "text": "Wait... why does the airline email say \"REFUND PROCESSED\"? Brooke??",
          "timestamp_label": "5:45 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n09b",
          "type": "narrator",
          "text": "You export Chloe's 14-second voice note to your cloud and text the banquet DJ: \"Replace our first-dance song with Track 1.\"",
          "style": "system_alert",
          "sfx": "photo_snap",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "chloe",
          "text": "Okay fine! Ryan and I have been together for 8 months. Don't make a scene in front of his parents!",
          "timestamp_label": "5:46 PM",
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n11"
        },
        {
          "id": "e1_n11",
          "type": "cliffhanger",
          "headline": "8 Months Behind Your Back.",
