      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "5:40 PM · You're steaming your rehearsal dress when Chloe drops a voice note in your chat.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "voice_note",
          "sender_id": "chloe",
          "duration_sec": 14,
          "transcript": "[giggling] Babe, I packed the white bikini. Brooke still has no clue we're taking her Bali honeymoon tickets tomorrow night—wait, is this the wrong chat?!",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "unsent_message",
          "sender_id": "chloe",
          "text": "OMG IGNORE THAT IT WAS A PRANK FOR YOUR BACHELORETTE!!",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1700,
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Funny. My bachelorette was last week, Chloe. And my hands aren't shaking—yours are.",
          "timestamp_label": "5:41 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "chloe",
          "text": "Please pick up, Brooke! You misheard! I was talking to my new boyfriend, NOT Ryan!",
          "timestamp_label": "5:42 PM",
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "ryan",
          "text": "Hey love, quick favor—can you forward me the Bali flight confirmation? Need to check our seat numbers. 😘",
          "timestamp_label": "5:43 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "narrator",
          "text": "Your stomach drops. You paid for those two first-class Bali tickets with your own savings.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "choice",
          "prompt": "Both Ryan and Chloe think they can still lie. How do you strike back?",
          "options": [
            {
              "option_id": "opt_cancel_tickets",
              "label": "Cancel the Bali tickets silently right now",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Sure thing, Ryan. Just sent an update to your email.",
              "next_node_id": "e1_n09a"
            },
            {
              "option_id": "opt_vip_play_audio",
              "label": "Save the voice note for the dinner toast",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Savage",
              "player_reply_text": "Already handled, Ryan. Wait till you hear my toast tonight.",
              "next_node_id": "e1_n09b"
