      "title": "The Thirteenth Chime",
      "start_node_id": "e2_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "12:05 AM · Thunder illuminates the landing. A tall woman in an antique silk gown stands motionless beside the grandfather clock.",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "My car is stuck in mud two miles out! Rowan, Grandma’s lawyer just texted me—she wasn’t our ancestor, she was the house’s original owner!",
          "timestamp_label": "12:05 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "She’s pointing straight at the grandfather clock! Wait—the pendulum stopped moving!",
