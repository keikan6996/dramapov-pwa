    {
      "episode_number": 1,
      "title": "The Blank Canvas",
      "start_node_id": "e1_n01",
      "default_ambient": "family_drama",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "11:58 PM · A storm knocks out the power at Grandma’s countryside house. Only your phone flashlight cuts the dark.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Rowan, I just opened Grandma’s safe! There’s a red envelope with one rule: drape the velvet sheet over the East Room portrait before 12:00 AM!",
          "timestamp_label": "11:58 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "I’m standing in the East Room right now… Owen, the velvet sheet is already on the floor. And the painted canvas is completely BLANK.",
          "timestamp_label": "11:59 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "She stepped out ten minutes ago. Check the hallway.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "WHAT?! Look down at the wooden floorboards—are there footprints leading out of the frame?!",
          "timestamp_label": "12:00 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[silk dress rustling, slow floorboards creaking] ...Welcome to my house, Rowan... Why did you let the fire go out?...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "Wet muddy footprints trail from beneath the empty gold frame—straight behind where you are standing.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Throw the velvet sheet over the frame",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Covering the frame right now!",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "Shine your flashlight behind the frame",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Checking behind the canvas...",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "The velvet settles—and an icy breath blows directly onto your neck from behind: \"Too late.\"",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: Carved into the wooden stretcher bar is Grandma’s diary note: \"She isn’t evil—she’s looking for her stolen locket in the clock.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "The grandfather clock downstairs just struck thirteen times! Lock yourself in the study until I get there!",
          "timestamp_label": "12:02 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "House Antique Intercom",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "A gentle, hollow woman’s voice hums an old waltz—getting louder as it climbs the wooden staircase.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "You decline. Instantly, the East Room door swings shut on its own, leaving you alone with the blank canvas.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "Out of the Frame",
          "teaser_text": "Episode 2: The woman in the silk dress is standing at the top of the stairs.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
