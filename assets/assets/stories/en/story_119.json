          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "grandpa",
          "text": "One spoonful of Gordon’s soup... bah! Heavy cream?! Call the chef—and whoever washed the dishes—out here right now!",
          "timestamp_label": "06:05 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "The Blind Taste Test",
          "teaser_text": "Gordon rushes out blaming the \"clumsy dishwasher\"—having no idea the billionaire investor is your grandfather.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
