    {
      "episode_number": 1,
      "title": "Back In The Dishpit",
      "start_node_id": "e1_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "6:00 PM · Maison d’Or Kitchen. Two years after Chef Gordon stole your truffle-broth recipe and blacklisted you, you slip into the dishpit—right as he spots you!",
          "style": "banner",
          "sfx": "knock",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "mentor",
          "text": "YOU?! {{player_name}}! Who hired a blacklisted failure to scrub pots on the night Chairman Arthur of Global Dining invests $20M in my restaurant?!",
          "timestamp_label": "06:00 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Relax, Gordon. I just wanted to see if you finally figured out the secret finishing spice in MY truffle broth.",
          "timestamp_label": "06:00 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "sous",
          "text": "Chef, big trouble! The saffron reduction just split—we only have 12 minutes before Chairman Arthur tastes the signature dish!",
          "timestamp_label": "06:02 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "mentor",
          "text": "Damn it—I never figured out why {{player_name}}’s broth stayed glossy without splitting!",
          "unsent_placeholder": "Chef Gordon unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Gordon panics as the $20M tasting clock ticks down:",
          "options": [
            {
              "option_id": "opt_story_119_e1_free",
              "label": "Offer to fix the broth—if he credits you",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I can rescue that broth in six minutes—if you admit whose recipe it is.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_119_e1_vip",
              "label": "Text Grandpa Arthur a secret kitchen heads-up",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Gordon snarls, snatching the ladle from Toby and pushing you backward toward the sink.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "mentor",
          "text": "Never! I’ll mask it with heavy cream—nobody in the dining room can tell the difference!",
          "timestamp_label": "06:02 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You text your estranged billionaire grandfather Arthur: \"Don’t invest $20M yet—taste the fake truffle broth first.\"",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "grandpa",
          "text": "{{player_name}}?! My granddaughter is inside that kitchen?! Order me a second bowl made ONLY by you!",
          "timestamp_label": "06:02 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Gordon sends out his clumpy cream-masked broth to the VIP table—while you quietly whisk a single luminous golden bowl in the back corner.",
