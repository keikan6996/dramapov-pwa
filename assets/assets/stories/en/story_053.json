      "title": "Tracklist Warning",
      "start_node_id": "e1_n01",
      "default_ambient": "mystery_ticking",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "9:15 PM · Staff Chat \"GROOVE & NEEDLE RECORDS\". Owner Ray never opened the shop today, and the front grate is locked from outside.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ruby",
          "text": "Ray’s account just shared a playlist called \"CHECK THE BASEMENT SAFE\" and went offline.",
          "timestamp_label": "9:15 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "miles",
          "text": "Wait—we don’t even have a basement safe. Just the crate room under the stairs.",
