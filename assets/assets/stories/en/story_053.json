          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05",
          "ambient": "heartbeat"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "theo",
          "text": "Whoa, chill! That’s a coincidence! I closed up at 8 PM yesterday and gave Ray the keys!",
