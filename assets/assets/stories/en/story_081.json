          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "viewer",
          "text": "Not the laptop. Look at the top shelf of your closet—red LED blinking.",
          "unsent_placeholder": "VIEWER #001 unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "viewer",
          "duration_sec": 7,
          "transcript": "[muffled breathing, wooden hanger clinks] Don’t stand up yet, Riley. The chat just paid $500 to see your reaction.",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "The closet slats creak two feet behind you. Move fast:",
          "options": [
            {
              "option_id": "opt_081_e1_free",
              "label": "Act calm & silently text Kira",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Kira, do NOT call. Someone is in my closet streaming me live.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_081_e1_vip",
              "label": "Jam a chair under the closet handle",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "text",
          "sender_id": "kira",
          "text": "OMG stay near the front door!! Wait—I just pulled up the stream link. That angle is TOO steady to be handheld.",
          "timestamp_label": "11:50 PM",
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "player",
          "text": "Wait... if the camera is mounted, then where did the breathing on that voice note come from?!",
          "timestamp_label": "11:50 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You wedge your desk chair under the closet knob. Instantly, the livestream chat explodes with laughing emojis—and a second camera angle flips on from UNDER your bed.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "viewer",
          "text": "Wrong hiding spot, Riley. Look down.",
          "timestamp_label": "11:50 PM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Your smart router blinks red and dies. The Wi-Fi drops—yet the livestream counter on your screen keeps climbing.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "kira",
          "text": "Wait... why is the stream running on MY backup 5G hotspot?! I left that pocket router in my nightstand!",
          "timestamp_label": "11:51 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n11"
        },
        {
          "id": "e1_n11",
          "type": "text",
          "sender_id": "viewer",
          "text": "Tell Kira thanks for the password. Goal reached: 15,000 viewers. Time to step out.",
          "timestamp_label": "11:51 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12_cliff"
        },
        {
          "id": "e1_n12_cliff",
          "type": "cliffhanger",
          "headline": "Camera Two Is Moving",
          "teaser_text": "The closet was just the decoy. Someone inside your apartment just used Kira’s private hotspot—and the hallway lights just cut out.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
