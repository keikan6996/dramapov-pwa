          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "viewer",
          "text": "Nice blue hoodie, Riley. 12,418 people just saw you lock the deadbolt.",
          "timestamp_label": "11:48 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Who is this?! I taped over my laptop webcam months ago!",
          "timestamp_label": "11:48 PM",
