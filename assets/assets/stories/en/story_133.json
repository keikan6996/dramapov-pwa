    {
      "episode_number": 1,
      "title": "The $400 Electric Bill",
      "start_node_id": "e1_n01",
      "default_ambient": "mystery_ticking",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "8:10 PM · Your college friend group is blowing up your phone calling you heartless—all because you gave quiet, baked-cookies roommate Tessa 48 hours to move out.",
          "style": "system_alert",
          "sfx": "ting_soft",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "friend",
          "text": "Avery, seriously?! Tessa is crying on my couch! You’re really evicting her over a $400 utility split and a missing hairbrush?!",
          "timestamp_label": "8:10 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "It wasn’t just the bill, Maya. She dyed her hair my exact shade and bought my exact glasses.",
          "timestamp_label": "8:10 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "roomie",
          "text": "Maya, ask Avery if I can swing by at 9 PM to grab my spare charger behind the radiator!",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "friend",
          "duration_sec": 7,
          "transcript": "[exasperated sigh] \"You’re being paranoid, Avery. Just hand her the charger she left behind the hallway radiator!\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "You crouch behind the hallway radiator—and find a cracked burner phone, not a charger:",
          "options": [
            {
              "option_id": "opt_133_e1_free",
              "label": "Tap the lit screen before Tessa arrives",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Maya, this isn’t a charger—it’s a burner phone with MY full name on the lock screen!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_133_e1_vip",
              "label": "Photograph the open banking & GPS tabs first",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "The cracked screen shows a newly opened credit line in YOUR name—and a photo of your passport propped on your desk.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "friend",
          "text": "WAIT—why does Tessa have a picture of YOUR passport and Social Security card?!",
          "timestamp_label": "8:14 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You snap five crisp photos showing Tessa’s GPS pinned to three downtown banks—AND a one-way flight booked under YOUR name for tomorrow morning.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "friend",
          "text": "She booked a flight to Cancun AS YOU?! Call the police right now!!",
          "timestamp_label": "8:14 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Suddenly, keys jingle outside your apartment door—Tessa didn’t wait for permission.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "roomie",
          "text": "Avery, I know you’re home—hand over my phone from behind the radiator RIGHT NOW!",
          "timestamp_label": "8:19 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "The Stolen Face",
          "teaser_text": "Up next: The Cracked GPS Log — You throw the deadbolt chain just before Tessa’s key turns.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
