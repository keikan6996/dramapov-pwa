    {
      "episode_number": 1,
      "title": "Changed Locks",
      "start_node_id": "e1_n01",
      "default_ambient": "family_drama",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "8:00 PM · Returning from a business trip with your suitcase, your fingerprint flashes RED on your own $12M penthouse door—and your clothes sit in trash bags in the hallway!",
          "style": "banner",
          "sfx": "knock",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "mil",
          "text": "Stop banging on the door, {{player_name}}! My son works hard for this penthouse, and I’m moving my niece Chloe in! Take your trash bags and leave!",
          "timestamp_label": "08:00 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Your son paid ZERO dollars for this penthouse, Martha! It’s registered 100% to my maiden holding company!",
          "timestamp_label": "08:00 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "mil",
          "text": "Nonsense! I already signed the transfer deed over to my son’s name this afternoon! You’re trespassing—I’m calling building security!",
          "timestamp_label": "08:02 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "mil",
          "text": "Good thing my notary cousin stamped the forged transfer while {{player_name}} was out of town!",
          "unsent_placeholder": "Martha unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Martha slams the peephole shut laughing:",
          "options": [
            {
              "option_id": "opt_story_118_e1_free",
              "label": "Call Estate Lawyer Daniel & building police",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Forging a $12M property deed is felony fraud, Martha. Don’t go anywhere.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_118_e1_vip",
              "label": "Cut power & smart-lock the penthouse remotely",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You dial Daniel cleanly while stepping back from the door.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "lawyer",
          "text": "On my way with the original deed and police, {{player_name}}! Nobody transfers your holding company without your live biometric!",
          "timestamp_label": "08:02 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You tap Owner Master Control on your phone. Instantly, every light inside the penthouse dies and the smart blinds slam down!",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "mil",
          "text": "HEY!! Turn the lights and AC back on!! How did you hack the penthouse?!",
          "timestamp_label": "08:02 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Suddenly your phone buzzes with a private DM—from Martha’s \"favorite niece\" Chloe inside the dark penthouse!",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "niece",
          "text": "Psst {{player_name}}!! Don’t be mad at me—Aunt Martha forced me to move in, and I secretly recorded her forging your deed today! Let me help you!",
          "timestamp_label": "08:05 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "The Niece’s Secret Tape",
          "teaser_text": "Martha thought her niece was her loyal ally—instead, Chloe just handed you the felony forgery confession on a silver platter.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
