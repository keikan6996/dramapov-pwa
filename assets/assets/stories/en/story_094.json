              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "You bolt out the terrace door and fly down 80 wet stone steps to the dark cove—where a sleek patrol boat flashes red and blue lights.",
