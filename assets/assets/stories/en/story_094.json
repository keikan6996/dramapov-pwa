      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:14 AM · Ocean wind rattles the glass walls of the cliffside villa. On the kitchen counter, a forgotten baby monitor crackles to life.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "voice_note",
          "sender_id": "ch02",
          "duration_sec": 6,
          "transcript": "[radio static, calm whisper] \"Four steps to the fridge, {{player_name}}. Now check if you locked the wine cellar.\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Claire!! Sorry to wake you in Paris—your baby monitor just picked up someone watching me in the kitchen!",
          "timestamp_label": "2:14 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "claire",
          "text": "What?! We don’t HAVE a baby, {{player_name}}! We sold that nursery furniture two years ago—get out of the kitchen!",
          "timestamp_label": "2:15 AM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "ch02",
          "text": "Don’t trust Claire. Ask her why there’s a hidden safe behind the nursery wallpaper.",
          "unsent_placeholder": "CH-02 STATIC unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "The wine cellar latch clicks faintly down the hall:",
          "options": [
            {
              "option_id": "opt_094_e1_free",
              "label": "Lock yourself in the master panic room",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I’m heading to the upstairs panic room—call private security!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_094_e1_vip",
              "label": "Inspect the nursery wall behind the crib",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You bolt upstairs and slam the steel panic-room door—only to realize the security camera screen inside shows the hallway is EMPTY. The intruder is already on Floor 2.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "claire",
          "text": "DO NOT touch the green override button in the panic room! Security is 8 minutes away!",
          "timestamp_label": "2:17 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You peel back a loose seam in the pastel wallpaper. Beneath it sits a wall safe—cracked wide open, stuffed with fake passports and a silenced pistol.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Claire... why are there six different passports with YOUR husband’s face hidden behind this wall?!",
          "timestamp_label": "2:17 AM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "All exterior floodlights snap off. Through the baby monitor speaker, slow footsteps climb the spiral staircase.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "ch02",
          "text": "Tell Claire her husband’s debt is overdue, {{player_name}}. Open the safe or I’m coming upstairs.",
          "timestamp_label": "2:18 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Not Just A Housesit",
          "teaser_text": "Claire hired you to sit in a safehouse—and the people hunting her husband just stepped onto the second floor.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
