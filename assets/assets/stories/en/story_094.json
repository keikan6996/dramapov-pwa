          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "claire",
          "text": "Wait... that’s not my boat! That’s federal maritime police—someone tipped them off!",
          "timestamp_label": "2:24 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "You slam the transmitter against the receiver speaker. A piercing shriek blasts through the intruder’s earpiece, dropping him to his knees while you escape to the road.",
