          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "ch02",
          "text": "Smart kid... Next time read the fine print before taking a $5,000 housesitting gig.",
          "timestamp_label": "2:24 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "unsent_message",
          "sender_id": "claire",
          "text": "Do NOT tell the feds my husband is still in the country.",
          "unsent_placeholder": "Claire unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "narrator",
          "text": "As you catch your breath beside the highway patrol cruiser, your pocket buzzes: $25,000 wired to your account from an unknown Cayman trust—memo: \"Stay quiet.\"",
          "style": "banner",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "Hush Money",
          "teaser_text": "You survived the night—and now you have to decide whether to hand the feds the truth or keep $25,000 in blood money.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
