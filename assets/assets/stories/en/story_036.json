          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Taylor, I saw the snap you just sent from the laundromat! Don’t turn around—the guy sitting behind you has NO SHADOW under that bright light!",
          "timestamp_label": "3:12 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait what?! When I walked in, the laundromat was completely empty! I didn’t hear the door chime!",
