      "title": "3:12 AM Spin Cycle",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "3:12 AM · Neon tubes hum inside the empty 24-hour laundromat. Your clothes tumble rhythmically behind glass.",
