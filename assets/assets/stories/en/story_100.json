          "caller_label": "Viktor · Control Room",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n03_ans",
          "on_decline_node_id": "e2_n03_dec"
        },
        {
          "id": "e2_n03_ans",
          "type": "voice_note",
          "sender_id": "viktor",
          "duration_sec": 7,
          "transcript": "[whispered] I’m behind the glass gallery! Console A is booby-trapped—plug your drive into the manual port on Breaker 4 and I’ll trip the arc-flash!",
