          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n06_choice"
        },
        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "Viktor flashes the blinding overhead strobe. Execute Cold Start:",
