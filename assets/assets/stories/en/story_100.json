          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "Only A Stress Test",
          "teaser_text": "The city’s lights are back on, but BLACKOUT_01 escaped—and tonight was just the rehearsal for a nationwide grid strike.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
