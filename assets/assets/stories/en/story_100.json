    {
      "episode_number": 1,
      "title": "Zero Grid",
      "start_node_id": "e1_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "11:00 PM · BOOM. Transformer arcs flash emerald across the skyline. Eight million people plunge into total darkness. Only your encrypted Sat-Com pager stays alive.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "viktor",
          "text": "Riley!! A worm just bricked all twelve substations! You’re the only engineer holding the cold-start decryption drive—get to Substation 9 NOW!",
          "timestamp_label": "11:01 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "I’m six blocks from Substation 9 on foot! Traffic is gridlocked—every car alarm in downtown is screaming!",
          "timestamp_label": "11:01 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "hunter",
          "duration_sec": 7,
          "transcript": "[modulated broadcast] \"Don’t bother walking to Substation 9, Riley. Our spotters saw your yellow utility vest crossing Bridge Street.\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "hunter",
          "text": "Twelve minutes until the hospital backup generators run dry. Hand over the cold-start drive.",
          "unsent_placeholder": "BLACKOUT_01 unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Two dark motorcycles rev behind you in the blackout:",
          "options": [
            {
              "option_id": "opt_100_e1_free",
              "label": "Ditch the yellow vest & cut through the park",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Dropped my vest! Cutting through Central Park toward the river gate!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_100_e1_vip",
              "label": "Drop a decoy drive & slip into steam tunnel",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You vanish into the pitch-black trees as motorcycle beams sweep the empty avenue. Ahead, Substation 9’s red diesel beacons glow through the mist.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "viktor",
          "text": "I’m holding the north service gate cracked for you! Hurry—Substation 9’s pressure valves are redlining!",
          "timestamp_label": "11:05 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You pry open a utility manhole and race through the underground steam conduit directly beneath the riders—emerging inside Substation 9’s fenced yard unseen.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "viktor",
          "text": "Whoa—you came up through the steam tunnel?! Wait... freeze! Don’t plug the drive into Console A yet!",
          "timestamp_label": "11:05 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Inside the control room, a red laser dot steadies on the cold-start console—and a hooded figure steps out from behind the turbine switchgear.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "hunter",
          "text": "Thanks for delivering the cold-start key straight to me, Riley. Drop it on the desk.",
          "timestamp_label": "11:07 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Ambush At Substation 9",
          "teaser_text": "BLACKOUT_01 is already inside the control room—and the city’s hospitals have 6 minutes of backup power left.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
