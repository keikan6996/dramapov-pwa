            {
              "option_id": "opt_100_e2_free",
              "label": "Slam the drive into Breaker 4 & throw switch",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "COLD START ENGAGED! Light up the city, Viktor!",
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_100_e2_vip",
              "label": "Route power to trap the vault crew inside",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "THOOM! Turbines roar awake. Wave after wave of golden streetlights race across the skyline as all twelve substations snap back online—and SWAT breaches the substation doors.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "viktor",
          "text": "WE DID IT!! Every hospital grid is 100% green, Riley! You just saved the whole city!",
          "timestamp_label": "11:12 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "You restore the downtown circuit first—re-engaging the Federal Reserve’s electromagnetic vault doors mid-heist and sealing the entire crew inside for the FBI.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "hunter",
          "text": "No!! The vault mag-locks just sealed our team inside! You’re going to regret this, Riley!",
          "timestamp_label": "11:12 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "unsent_message",
          "sender_id": "hunter",
          "text": "This was only a stress test. Next month we take down all three coasts.",
          "unsent_placeholder": "BLACKOUT_01 unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "narrator",
          "text": "Standing on the catwalk overlooking the glowing city, your Sat-Com pager blinks one final coordinate—pointing straight to the national power hub in Washington.",
