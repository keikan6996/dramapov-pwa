          "typing_delay_ms": 500,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "hunter",
          "text": "Hands off the breaker, Riley! Let the grid stay dark for one hour—we’re only hitting the Federal Reserve vault downtown!",
