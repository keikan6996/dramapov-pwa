      "start_node_id": "e2_n01",
      "default_ambient": "heartbeat",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "11:08 PM · The turbine hall hums with trapped static. Your Sat-Com vibrates furiously against your ribs.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
