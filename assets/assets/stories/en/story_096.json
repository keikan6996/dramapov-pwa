          "type": "text",
          "sender_id": "aura",
          "text": "TRANSMISSION CONFIRMED! And Oversight just sent a remote abort to the EMP capacitor!",
          "timestamp_label": "10:22 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
