          "timestamp_label": "10:22 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n03"
        },
        {
          "id": "e4_n03",
          "type": "text",
          "sender_id": "player",
