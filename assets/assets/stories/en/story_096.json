          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n10"
        },
        {
          "id": "e3_n10",
          "type": "text",
          "sender_id": "aura",
          "text": "Hale is arming the rooftop EMP to fry both me and the evidence! We have to reach the Defense Oversight terminal first!",
          "timestamp_label": "10:18 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n11"
