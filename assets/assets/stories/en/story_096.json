          "type": "cliffhanger",
          "headline": "Sixty Seconds To EMP",
          "teaser_text": "Dr. Lin is alive and Hale is the real traitor—now you have sixty seconds to stop his rooftop EMP.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 4
        }
      ]
    },
