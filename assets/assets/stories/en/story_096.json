        {
          "id": "e3_n07_free",
          "type": "narrator",
          "text": "AURA plays an unedited audio log from Vault 3: Director Hale ordering the lead engineer locked out after he refused to sell AURA’s source code!",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "aura",
          "text": "Dr. Lin is alive in St. Mary’s ER—I called his ambulance myself before Hale cut my uplink.",
          "timestamp_label": "10:18 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "AURA’s core checksum is 100% intact—every human-safety guardrail is untouched. The ONLY tampered file is Hale’s offshore transfer.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Her ethics core isn’t corrupted at all! Hale framed AURA to cover up selling defense AI to a foreign broker!",
          "timestamp_label": "10:18 PM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "unsent_message",
          "sender_id": "hale",
          "text": "Trigger the roof EMP if Casey reaches the oversight uplink.",
          "unsent_placeholder": "Director Hale unsent a message",
