          ]
        },
        {
          "id": "e2_n08a",
          "type": "text",
          "sender_id": "ethan",
          "text": "Best plot twist of my life, Audrey. My uncle just left the room.",
          "timestamp_label": "8:06 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n08b",
          "type": "text",
          "sender_id": "ethan",
          "text": "Wait—we didn't go to City Hall yet... unless you're proposing to me right now? 💍",
          "timestamp_label": "8:06 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09"
        },
        {
          "id": "e2_n09",
          "type": "cliffhanger",
          "headline": "Contract Cancelled. Love Renewed.",
