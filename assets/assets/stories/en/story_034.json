          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[muffled underwater bubbling, splash] ...Help... the roof hatch is too heavy... Riley...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "Your kitchen faucet violently blasts open on its own, flooding the sink.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Shut the main water valve under sink",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Shutting off my main valve!",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "Check the building’s missing tenant notice",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Checking the lobby notice photo...",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "The valve snaps shut—yet the pipes inside your walls begin groaning like someone screaming underwater.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: A student from Apt 5B vanished three weeks ago—last seen walking up to the rooftop laundry deck.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "Gabe isn’t answering! Wait—a wet puddle just started dripping straight through YOUR ceiling light fixture!",
          "timestamp_label": "12:53 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "ally",
          "caller_label": "Gabe (Plumber)",
          "ringtone_sfx": "call_ring",
