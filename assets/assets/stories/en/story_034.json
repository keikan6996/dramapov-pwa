    {
      "episode_number": 1,
      "title": "Dark Water From the Tap",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "12:48 AM · You turn on the kitchen tap. The water sputters out murky brown, carrying a single strand of long black hair.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Riley, I just climbed up to inspect the rooftop cistern. DO NOT drink or brush your teeth with the water tonight!",
          "timestamp_label": "12:48 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Too late, I already drank half a glass before I saw the color! What’s inside the tank?!",
          "timestamp_label": "12:49 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "I’m inside you now, Riley.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "I leaned over the hatch with my flashlight and pale fingers shot up and dragged it under! I’m calling the police!",
