          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[warped carousel melody, radio static] ...Seven… six… five… {{player_name}}, don’t forget to buckle in...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "Your powered-off walkie-talkie clicks on by itself, glowing bright green.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Rip the battery pack out of the radio",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Pulling the battery out now!",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "Check the park’s 2018 incident logbook",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Checking the old logbook...",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "With no battery inside, the speaker crackles louder: \"Four… three… two…\"",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: Park closed after a storm trapped Cabin 9 at the top—the night operator had fled his post without lowering the wheel.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "The park floodlights just died! My booth door is jammed—something is walking from the Ferris wheel toward North Gate!",
          "timestamp_label": "2:44 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "Ferris Wheel Cabin 9",
