    {
      "episode_number": 1,
      "title": "Cabin 9 Is Moving",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:40 AM · Closed Wonderland Amusement Park. Rusty steel groans across the dark lot as the Ferris wheel lights flicker on.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, cut it out! Stop playing creepy carnival music over Channel 3—and why did you turn on the Ferris wheel breaker?!",
          "timestamp_label": "2:40 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "My walkie-talkie is turned OFF on the desk! And the breaker box has been disconnected for six years!",
          "timestamp_label": "2:41 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "Ten… nine… eight… come ride Cabin 9.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "Wait—there’s a kid’s voice counting down on Channel 3! And Cabin 9 just stopped right at the bottom boarding platform!",
