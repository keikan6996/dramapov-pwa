    {
      "episode_number": 1,
      "title": "Sold For Five Million",
      "start_node_id": "e1_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "11:55 PM · Grand Charity Gala. Paddle #77 just shattered the record with a $5M bid for a midnight dinner with you—saving your father's clinic. Your phone lights up.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "kieran",
          "text": "Long time no see, Natalie. Five years ago you told me I was too poor to protect you. Is $5 million enough now?",
          "timestamp_label": "11:55 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Kieran?! Wait—YOU are the tech billionaire behind Paddle #77?!",
          "timestamp_label": "11:56 PM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "kieran",
          "text": "Surprised? I bought the clinic's bank mortgage too. Meet me on the glass terrace in two minutes—don't run away this time.",
          "timestamp_label": "11:56 PM",
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "kieran",
          "text": "I built an entire empire just so nobody could ever force us apart again.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "kieran",
          "duration_sec": 8,
          "transcript": "[glasses clinking softly] Tell me the truth tonight, Natalie. You never cared about money. Why did you really leave me in college?",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "Five years ago, his ruthless stepmother threatened to destroy his scholarship unless you broke his heart.",
          "options": [
            {
              "option_id": "opt_tell_truth",
              "label": "Finally confess what his stepmother did",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Your stepmother threatened to revoke your MIT scholarship if I stayed. I lied to save your future.",
              "next_node_id": "e1_n08a"
            },
            {
              "option_id": "opt_vip_guard",
              "label": "Show him the 5-year-old threat text you kept",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Emotional",
              "player_reply_text": "Come to the terrace. I still have the screenshot your stepmother sent me in 2021.",
              "next_node_id": "e1_n08b"
            }
          ]
        },
        {
          "id": "e1_n08a",
          "type": "text",
          "sender_id": "kieran",
          "text": "WHAT?! My stepmother... Natalie, I wasted five years thinking you hated me!",
          "timestamp_label": "11:58 PM",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09"
        },
        {
          "id": "e1_n08b",
          "type": "text",
          "sender_id": "kieran",
          "text": "Don't move. I'm coming to you right now—and tomorrow morning, my stepmother loses her seat on my board.",
          "timestamp_label": "11:58 PM",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09"
        },
        {
          "id": "e1_n09",
          "type": "cliffhanger",
          "headline": "Five Years Of Silence Shattered.",
          "teaser_text": "Episode 2: On the glass terrace, Kieran hands you the clinic deed—and asks for a second chance at midnight.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
