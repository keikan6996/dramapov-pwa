  "episodes": [
    {
      "episode_number": 1,
      "title": "Moving With You",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "10:12 PM · TRACKING ALERT: An unknown AirTag has been moving with you since 6:04 PM. Tap to play sound.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "Liam, I’m on the late Red Line train and my phone just pinged an unknown AirTag on me!",
          "timestamp_label": "10:12 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "liam",
          "text": "Check your coat pockets and backpack zippers right now! Don’t get off at an empty station, {{player_name}}.",
          "timestamp_label": "10:13 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "narrator",
          "text": "You tap \"Play Sound.\" A faint metallic chirp vibrates inside your coat hem—sewn neatly into the torn lining. Its speaker has been punctured to muffle the beep.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "seat4b",
          "text": "Leave the coat on the seat, {{player_name}}. You don’t want to know who paid for that tracker.",
          "unsent_placeholder": "Seat 4B unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "A man in a gray cap across the aisle locks eyes with your reflection:",
          "options": [
            {
              "option_id": "opt_084_e1_free",
              "label": "Rip AirTag out & drop it in a trash bin",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I’m ditching the tracker at the next stop and switching cars.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_084_e1_vip",
              "label": "Scan the AirTag NFC serial number first",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "The doors hiss open at Oak Station. You toss the AirTag onto the platform—and the man in the gray cap DOESN’T follow it. He steps into your new car instead.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "seat4b",
          "text": "That one was just the decoy, {{player_name}}. Check the sole of your left sneaker.",
          "timestamp_label": "10:16 PM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You tap your phone to the white disc. The NFC screen shows the owner’s masked phone number—the last four digits are 8842. Your brother Liam’s old number.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Liam... why is this AirTag registered to a phone number ending in 8842?!",
          "timestamp_label": "10:16 PM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "voice_note",
          "sender_id": "liam",
          "duration_sec": 8,
          "transcript": "[panicked breathing] {{player_name}}, listen to me! My old SIM wasn’t canceled—the loan sharks I owe money to cloned it! That guy on the train isn’t after you, he’s using you to find ME!",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "seat4b",
          "text": "Two stops left until the end of the line. Tell Liam I’m bringing his little sibling to the meeting.",
          "timestamp_label": "10:17 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "End Of The Line",
          "teaser_text": "The train brakes scream as it enters the dark depot tunnel—and the lights in Car 4 flicker out.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Switch Tracks",
      "start_node_id": "e2_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "10:21 PM · The express train halts at Harbor Terminal—an empty concrete platform with one flickering exit sign.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "incoming_call",
          "caller_id": "liam",
          "caller_label": "Liam · Brother",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n03_ans",
          "on_decline_node_id": "e2_n03_dec"
        },
        {
          "id": "e2_n03_ans",
          "type": "voice_note",
          "sender_id": "liam",
          "duration_sec": 9,
          "transcript": "[engine revving] I’m two blocks from Harbor Terminal! Pull the red emergency door lever on the LEFT side—don’t use the main turnstiles, they have a van parked there!",
          "audio_asset": null,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n03_dec",
          "type": "text",
          "sender_id": "liam",
          "text": "DO NOT exit through the main turnstiles! Their black van is waiting outside! Use the maintenance stairs on the left!",
          "timestamp_label": "10:21 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "seat4b",
          "text": "Don’t run, {{player_name}}. Your brother stole $200K from the wrong family. Walk calmly to the van.",
          "timestamp_label": "10:22 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "text",
          "sender_id": "player",
          "text": "I don’t owe you anything! Stay back!",
          "timestamp_label": "10:22 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n06_choice"
        },
        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "Footsteps sprint down the tiled corridor behind you:",
          "options": [
            {
              "option_id": "opt_084_e2_free",
              "label": "Trigger the station fire alarm",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": null,
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_084_e2_vip",
              "label": "Toss your shoe onto the opposite train",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Good luck chasing the northbound express!",
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "You smash the red pull-station. Sprinklers rain down, mag-locks release every emergency exit, and transit police sirens echo down the escalator.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "liam",
          "text": "Smart move! I see you at the side alley—get in the passenger seat NOW!",
          "timestamp_label": "10:24 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "You slip off your left sneaker and fling it through the closing doors of the northbound train. Seat 4B’s tracker pings away at 50 mph as you duck into the service exit.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "seat4b",
          "text": "Clever trick. Too bad we already have a tracker on Liam’s car.",
          "timestamp_label": "10:24 PM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "You slam Liam’s car door shut and peel onto the wet avenue. On the dashboard sits an open leather duffel—packed with unmarked bills and a passport bearing YOUR photo.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "text",
          "sender_id": "liam",
          "text": "Don’t look at the passport yet, {{player_name}}. We have to cross the border before midnight—I’ll explain on the highway.",
          "timestamp_label": "10:25 PM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "The Second Passport",
          "teaser_text": "Liam didn’t just owe them money—he already forged a new identity for you. And two sets of headlights just pulled onto the highway behind you.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
      "episode_number": 3,
      "title": "Exit 19 Ambush",
      "start_node_id": "e3_n01",
      "default_ambient": "rain",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "07:48 PM · Two black sedans close in on the rain-slick highway. Liam kills the headlights and swerves onto Exit 19.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "liam",
          "text": "Because I didn’t just owe them gambling money! I filmed their accountant burying a ledger—and they think YOU have the thumb drive!",
          "timestamp_label": "07:48 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Why do you have a forged passport with MY photo in your glovebox, Liam?! Talk NOW!",
          "timestamp_label": "07:48 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n04"
        },
        {
          "id": "e3_n04",
          "type": "text",
          "sender_id": "seat4b",
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n05",
          "text": "Live Tracker Ping · 07:49 PM — Second AirTag active inside Liam’s trunk."
        },
        {
          "id": "e3_n05",
          "type": "voice_note",
          "sender_id": "seat4b",
          "duration_sec": 7,
          "transcript": "[engine revving close] Throwing the first AirTag off the subway was cute, {{player_name}}. Too bad your brother never checks his spare tire.",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n06_choice"
        },
        {
          "id": "e3_n06_choice",
          "type": "choice",
          "prompt": "A roadside weigh station glows ahead in the rain. Move fast:",
          "options": [
            {
              "option_id": "opt_084_e3_free",
              "label": "Ditch the car behind an outbound rig",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Pull behind that freight truck! We’re ripping the second AirTag out right now!",
              "next_node_id": "e3_n07_free"
            },
            {
              "option_id": "opt_084_e3_vip",
              "label": "Plant the AirTag onto a passing semi",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e3_n07_vip"
            }
          ]
        },
        {
          "id": "e3_n07_free",
          "type": "narrator",
          "text": "Liam pops the trunk in the pouring rain and yanks the white disc from the spare tire well.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "liam",
          "text": "Got it! Smash it—no, wait, my phone just buzzed from the motel I booked!",
          "timestamp_label": "07:48 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "You slap the AirTag onto a southbound semi’s bumper—sending both black sedans screaming twenty miles down the wrong interstate.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "seat4b",
          "text": "Wait... why is the signal doing 80 mph south?! They swapped the tag!",
          "timestamp_label": "07:48 PM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "unsent_message",
          "sender_id": "liam",
          "text": "I sewed the thumb drive into the hem of your coat yesterday. Don’t hate me.",
          "unsent_placeholder": "Liam unsent a message",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n10"
        },
        {
          "id": "e3_n10",
          "type": "text",
          "sender_id": "liam",
          "text": "Check the left pocket lining of your coat, {{player_name}}! The encrypted thumb drive is sewn inside!",
          "timestamp_label": "07:48 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "seat4b",
          "text": "Nice trick on the highway. We’re already inside your brother’s safe house at Pinecrest Motel.",
          "timestamp_label": "07:48 PM",
          "typing_delay_ms": 650,
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e3_n12_cliff"
        },
        {
          "id": "e3_n12_cliff",
          "type": "cliffhanger",
          "headline": "Sewn Into The Lining",
          "teaser_text": "The syndicate’s ledger has been hidden in your coat all night—and Seat 4B just raided Liam’s safe house.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 4
        }
      ]
    },
    {
      "episode_number": 4,
      "title": "The Coat Hem Secret",
      "start_node_id": "e4_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "08:02 PM · Inside a 24-hour diner booth, you rip the seam of your coat pocket and pull out a tiny brushed-steel USB.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n02"
        },
        {
          "id": "e4_n02",
          "type": "text",
          "sender_id": "liam",
          "text": "I panicked! They grabbed my apartment keys yesterday—I thought you’d be safer holding it until I reached the state attorney!",
          "timestamp_label": "08:02 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n03"
        },
        {
          "id": "e4_n03",
          "type": "text",
          "sender_id": "player",
          "text": "You put a target on my back without telling me?! That’s why Seat 4B followed me onto the train!",
          "timestamp_label": "08:02 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n04"
        },
        {
          "id": "e4_n04",
          "type": "unsent_message",
          "sender_id": "seat4b",
          "text": "Found Liam’s spare phone at the motel. Pull the diner’s Wi-Fi logs.",
          "unsent_placeholder": "Seat 4B unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n05"
        },
        {
          "id": "e4_n05",
          "type": "voice_note",
          "sender_id": "seat4b",
          "duration_sec": 7,
          "transcript": "[rain pattering on motel window] Enjoying the coffee, {{player_name}}? Your brother’s cloud backup just pinged Route 9 Diner.",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e4_n06_choice"
        },
        {
          "id": "e4_n06_choice",
          "type": "choice",
          "prompt": "You have two minutes before Seat 4B reaches Route 9 Diner:",
          "options": [
            {
              "option_id": "opt_084_e4_free",
              "label": "Call the State Police detective line",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "We’re not running anymore. I’m calling State Detectives to meet us at the weigh station!",
              "next_node_id": "e4_n07_free"
            },
            {
              "option_id": "opt_084_e4_vip",
              "label": "Inspect the USB on the diner kiosk",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e4_n07_vip"
            }
          ]
        },
        {
          "id": "e4_n07_free",
          "type": "narrator",
          "text": "Detective Ruiz answers on the second ring—and dispatches two unmarked cruisers toward Route 9.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e4_n08_free"
        },
        {
          "id": "e4_n08_free",
          "type": "text",
          "sender_id": "liam",
          "text": "Thank God! Ruiz knows this syndicate—if we hand him that USB alive, they’re finished!",
          "timestamp_label": "08:02 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e4_n09_merge"
        },
        {
          "id": "e4_n07_vip",
          "type": "narrator",
          "text": "The USB opens to a spreadsheet of bribed port officials—and a photo of Seat 4B’s real face beside a Pinecrest Motel key.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n08_vip"
        },
        {
