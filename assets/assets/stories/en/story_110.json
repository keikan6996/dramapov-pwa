          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "trent",
          "text": "Shut your mouth! My dad is closing a $50M loan with Apex Capital’s Chairman inside right now! Kneel and polish my bumper!",
          "timestamp_label": "07:02 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "trent",
          "text": "Once the valet club pays the $150K insurance claim, my Vegas debt is cleared before Dad finds out!",
          "unsent_placeholder": "Trent unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Trent raises his keys to shove you onto the pavement:",
          "options": [
            {
              "option_id": "opt_story_110_e1_free",
              "label": "Step aside & point to the gate CCTV",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Careful, Trent. The gate camera just caught your watch scraping that paint.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_110_e1_vip",
              "label": "Text Elena to put Sterling’s $50M loan on hold",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Trent scoffs and kicks a traffic cone, convinced nobody would dare cross his billionaire father.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "trent",
          "text": "My dad owns half this club! The manager will delete that tape in ten seconds!",
          "timestamp_label": "07:02 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You tap one line to your VC partner Elena. Across the marble courtyard, Mr. Sterling’s phone buzzes sharply.",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "elena_vc",
          "text": "Got it, Chairman Nolan. Sterling Corp’s $50M emergency bridge loan is paused pending your word.",
