          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "The club’s gilded doors swing open. Mr. Sterling rushes out looking pale and frantic—staring straight at his phone.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "trent",
          "text": "Dad! Perfect timing! Tell the manager to fire this rude valet—he scratched my Bugatti!",
          "timestamp_label": "07:05 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "When Dad Looks Up",
          "teaser_text": "Trent expects his father to crush you—instead, Mr. Sterling drops his briefcase and slaps his own son across the face.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
