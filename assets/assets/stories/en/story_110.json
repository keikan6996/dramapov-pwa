    {
      "episode_number": 1,
      "title": "The Framed Scratch",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "7:00 PM · Monarch Country Club. Helping out your old mentor’s valet stand in a red vest before your 8 PM investor dinner, you watch Trent deliberately scrape his key along his own fender!",
          "style": "banner",
          "sfx": "knock",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "trent",
          "text": "HEY!! Look what this clumsy valet did to my $3M hypercar!! Pay $150,000 in cash right now or I’m putting you in jail!",
          "timestamp_label": "07:00 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "You scratched your own fender with your watch buckle two seconds ago, Trent. Why? Need quick cash to cover a gambling tab?",
