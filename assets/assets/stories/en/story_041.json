      "default_ambient": "mystery_ticking",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "1:12 AM · Dorm Group \"WEST HALL 4F\". Maya has been missing since Friday night.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "tessa",
          "text": "Everyone wake up. Maya’s Find My dot just turned green.",
          "timestamp_label": "1:12 AM",
          "typing_delay_ms": 550,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "jules",
          "text": "No way. Campus police said her battery died by the river.",
          "timestamp_label": "1:12 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "tessa",
          "text": "It’s not by the river. It’s inside Old Founders Bell Tower.",
