          "type": "unsent_message",
          "sender_id": "owen",
          "text": "I put the master key back in the office drawer at midnight—",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "text",
          "sender_id": "jules",
          "text": "Owen?? I literally just saw what you unsent. Why were you touching the master key?",
