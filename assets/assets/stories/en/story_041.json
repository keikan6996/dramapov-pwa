        {
          "id": "e1_n10_free",
          "type": "narrator",
          "text": "You sprint downstairs. The rain blurs the quad lights—and a flashlight flickers from the bell tower’s top window.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n10_vip",
          "type": "narrator",
          "text": "KEYCARD LOG FOUND: Owen’s badge never swiped into the tower tonight. TESSA’S badge swiped in at 12:48 AM.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n11_merge",
          "type": "text",
          "sender_id": "tessa",
          "text": "{{player_name}}, don’t come alone. The tower door is wide open.",
          "timestamp_label": "1:16 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n12_end"
        },
        {
          "id": "e1_n12_end",
          "type": "cliffhanger",
          "headline": "The Bell Just Struck Once...",
          "teaser_text": "Episode 2: Inside the tower, Maya’s phone is ringing—taped to the inside of a locker.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
