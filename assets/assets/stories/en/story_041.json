          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "voice_note",
          "sender_id": "owen",
          "duration_sec": 9,
          "transcript": "[panting, rain pounding] Look, {{player_name}}, I was checking the roof leak! Wait—someone is climbing the stairs behind me—",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_choice"
        },
        {
          "id": "e1_n09_choice",
          "type": "choice",
          "prompt": "Owen went silent mid-recording. What do you do?",
          "options": [
            {
              "option_id": "opt_call_guard",
              "label": "Alert dorm security & run to the quad",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I’m grabbing my coat and alerting security right now!",
              "next_node_id": "e1_n10_free"
            },
            {
              "option_id": "opt_check_logs",
              "label": "Check Owen’s keycard swipe log first",
              "cost_type": "vip_rewarded",
              "badge_text": "Clue · Watch Ad",
              "player_reply_text": "Wait—let me pull the dorm keycard portal before we move.",
              "next_node_id": "e1_n10_vip"
            }
