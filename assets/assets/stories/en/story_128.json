      "title": "Twenty Minutes To The Swap",
      "start_node_id": "e1_n01",
      "default_ambient": "family_drama",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:10 PM · Antiseptic scent hits your lungs. You’re sitting outside Mercy Genetics Clinic holding your sleeping baby—20 minutes before Nurse Maya swaps the DNA swabs for your mother-in-law.",
