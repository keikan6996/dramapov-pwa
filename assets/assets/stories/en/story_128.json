          "sfx": "ting_soft",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "mil",
          "text": "Don’t look so nervous, Elise. If that baby is really Marcus’s, a routine DNA test is nothing to fear!",
          "timestamp_label": "2:10 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "I’m not nervous, Evelyn. I’m just watching which nurse walks out of Lab 3.",
          "timestamp_label": "2:10 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "mil",
          "text": "Nurse Maya, the $50,000 envelope is in Locker 14. Make sure the result reads 0% match!",
