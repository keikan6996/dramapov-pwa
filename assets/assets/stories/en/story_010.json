          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "driver",
          "text": "He wasn't in scrubs, ma'am. And the blonde woman sitting on his lap laughed and told him to leave the ring.",
