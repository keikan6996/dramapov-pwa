          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "driver",
          "text": "I have the whole thing on my interior dashcam if you need it.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "lucas",
          "text": "Hey babe, ER is crazy tonight. Lost my ring while scrubbing in—don't panic, security is looking for it! ❤️",
