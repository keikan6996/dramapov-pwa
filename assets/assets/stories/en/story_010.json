      "episode_number": 1,
      "title": "Lost & Found At 2:10 AM",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:10 AM · Lucas uses your shared ride-share account. A Lost Item message pops up from his driver.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "driver",
          "text": "Hi Paige, I just dropped off your husband at the Velvet Lounge. He took off his platinum wedding band in my backseat.",
          "timestamp_label": "2:10 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—Velvet Lounge?! Lucas told me he was pulling an all-nighter at the hospital ER!",
