          "type": "choice",
          "prompt": "Lucas just texted the worst lie of his life. What do you do?",
          "options": [
            {
              "option_id": "opt_get_clip",
              "label": "Tip the driver $200 and get the dashcam clip",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Yes, please bring both to my gate. I'll tip you $200 cash.",
              "next_node_id": "e1_n09a"
            },
            {
              "option_id": "opt_vip_ride",
              "label": "Have the driver drive YOU to the Velvet Lounge",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Ambush",
              "player_reply_text": "Pick me up at my gate in 5 minutes—we're going back to the Velvet Lounge.",
