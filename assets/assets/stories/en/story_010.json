          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "voice_note",
          "sender_id": "driver",
          "duration_sec": 7,
          "transcript": "[turn signal clicking] Look, my sister got cheated on last year. I'm five minutes from your house—want me to bring the ring and the dashcam clip?",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08"
        },
        {
