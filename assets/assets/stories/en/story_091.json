              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": null,
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_091_e2_vip",
              "label": "Jam the jammer antenna on the window sill",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Signal’s back! Sending our live GPS to 911 right now!",
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "You and Mara plunge four stories into a pile of damp motel sheets in the basement boiler room—right beside the clerk’s unlocked breaker cabinet.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "r409",
          "text": "Pull the red breaker labeled \"CELL JAMMER\"! As soon as it drops, my emergency beacon goes straight to Highway Patrol!",
          "timestamp_label": "11:43 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "You smash the hidden signal-jammer box outside the window with a metal chair leg. Four bars of 5G flood back—and 911 locks your location before you drop down the chute.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "clerk",
          "text": "You broke the jammer?! Pack the van—state troopers are already turning off the interstate!",
          "timestamp_label": "11:43 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "unsent_message",
          "sender_id": "r409",
          "text": "Don’t show the police my real ID—I’m not actually a paramedic.",
          "unsent_placeholder": "GUEST_409 unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "narrator",
          "text": "Blue sirens sweep across the rain-slicked parking lot. You turn to thank Mara—but she’s already vanished into the pine woods, leaving behind a silver key labeled \"ROOM 410.\"",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "The Key To Room 410",
          "teaser_text": "You survived the hidden fourth floor—but who was Mara really, and what is still locked inside Room 410?",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
