  "episodes": [
    {
      "episode_number": 1,
      "title": "The Missing Floor",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "11:32 PM · A highway landslide strands you at the Pine Ridge Inn. You connect to the motel Wi-Fi—and a local intranet chat pops open.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "r409",
          "text": "Do NOT use keycard 409, {{player_name}}. Check the elevator buttons—there is no 4th floor.",
          "timestamp_label": "11:32 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait... the elevator only goes 1, 2, 3, and 5! How do you know my name?!",
          "timestamp_label": "11:33 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "r409",
          "duration_sec": 8,
          "transcript": "[hushed whisper, rain pounding] Because I’m locked inside Floor 4 right now! The clerk only hands out 409 cards to solo travelers whose cars have out-of-state plates.",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "clerk",
          "text": "Everything alright in the hallway, {{player_name}}? Use the brass service stairs behind the ice machine to reach Floor 4.",
          "timestamp_label": "11:34 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "The clerk’s lobby camera pivots directly toward you:",
          "options": [
            {
              "option_id": "opt_091_e1_free",
              "label": "Walk back to your car & drive off",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Actually I forgot my charger in the car—be right back.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_091_e1_vip",
              "label": "Sneak up the service stairs to rescue 409",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You sprint into the pouring rain—and freeze. All four tires of your car have been cleanly deflated, and the highway gate is padlocked.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "r409",
          "text": "I told you—nobody drives out of Pine Inn! Come up the outside fire ladder to Window 409 before the clerk locks the courtyard!",
          "timestamp_label": "11:36 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You slip up the dim service stairs. Floor 4 isn’t a motel hallway—it’s a soundproofed concrete corridor lined with heavy steel doors and biometric locks.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "r409",
          "text": "You actually came up?! Swipe your 409 card on the keypad—it’s the only master card that opens my door from outside!",
          "timestamp_label": "11:36 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "unsent_message",
          "sender_id": "clerk",
          "text": "Buyer confirmed for two healthy donors. Sealing Floor 4 stairwell now.",
          "unsent_placeholder": "Front Desk unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "A heavy magnetic bolt slams shut behind you. At the far end of the corridor, the door to Room 409 clicks open—revealing a dark room.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Inside Floor Four",
          "teaser_text": "The stairwell is sealed and the clerk just called in a buyer. Whoever is inside Room 409 is your only ally—or the bait.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
