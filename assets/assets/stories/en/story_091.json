          "typing_delay_ms": 500,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "r409",
          "text": "I’m Mara—I’ve been loosening the laundry chute bolts for two days! Help me pry the grate before the vents hiss!",
          "timestamp_label": "11:41 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—we also need cell signal to call State Police before they catch us downstairs!",
          "timestamp_label": "11:41 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n06_choice"
        },
        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "White mist begins hissing from the ceiling vent:",
          "options": [
            {
              "option_id": "opt_091_e2_free",
