      "start_node_id": "e3_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "11:24 PM · Gravel crunches on the storage facility roof. Marco blocks the stairwell door while UNIT-77’s SUVs surround the lot below.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "marco",
          "text": "I had no choice, Quinn! UNIT-77 owns my gambling markers—they swore if I brought them a fall guy, they’d wipe my slate!",
          "timestamp_label": "11:24 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "text",
          "sender_id": "player",
          "text": "You set me up at the auction, Marco! You let me bid on Unit 77 so MY prints would be on that steel case!",
          "timestamp_label": "11:24 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n04"
