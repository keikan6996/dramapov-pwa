        {
          "id": "e3_n07_free",
          "type": "narrator",
          "text": "The latch pops—inside isn’t cash, it’s a stolen museum diamond ledger AND a federal customs seal!",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "marco",
          "text": "Oh God... that’s the Antwerp heist ledger! They aren’t paying me—they’re going to kill BOTH of us!",
          "timestamp_label": "11:24 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "While pretending to hand Marco the burner, you slip its live tracker into his coat lining—making HIM the beacon if he betrays you again.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Check your own text alerts, Marco! UNIT-77 already wired you $50,000 to frame me—and they’re coming up to silence us both!",
          "timestamp_label": "11:24 PM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "unsent_message",
          "sender_id": "u77",
          "text": "No witnesses on the roof. Clear Marco too once we have the case.",
