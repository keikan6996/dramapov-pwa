          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n10"
        },
        {
          "id": "e3_n10",
          "type": "text",
          "sender_id": "marco",
          "text": "Did you see that unsent message?! They’re gonna kill me too!! Follow me to the fire ladder—NOW!",
