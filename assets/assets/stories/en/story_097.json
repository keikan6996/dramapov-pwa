        },
        {
          "id": "e3_n12_cliff",
          "type": "cliffhanger",
          "headline": "The Antwerp Ledger",
          "teaser_text": "UNIT-77 is sweeping the roof to eliminate both you and Marco—and the steel case holds the stolen Antwerp diamond ledger.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 4
        }
      ]
    },
