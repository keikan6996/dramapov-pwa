    {
      "episode_number": 1,
      "title": "Three Miles Offshore",
      "start_node_id": "e1_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "11:05 PM · Private Group \"MARINA REUNION\". Three miles offshore. No anchor dropped yet.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "narrator",
          "text": "SYSTEM: \"Member #7\" joined the group via invite link.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "sienna",
          "text": "Derek? You’re the only admin. Why did you send someone the invite link?",
          "timestamp_label": "11:05 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "derek",
          "text": "I didn’t! My phone was charging in the cabin.",
          "timestamp_label": "11:06 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ghost7",
          "text": "Relax, {{player_name}}. Nobody invited me. I just want to know who cut the brake line in 2021.",
          "timestamp_label": "11:06 PM",
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06",
          "ambient": "heartbeat"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "player",
          "text": "Who is this? The police ruled that crash an accident.",
          "timestamp_label": "11:07 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "unsent_message",
          "sender_id": "derek",
          "text": "Sienna told me she burned the mechanic receipt—",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "voice_note",
          "sender_id": "ghost7",
          "duration_sec": 8,
          "transcript": "[yacht engine humming in background] Funny how you can hear the exact same engine on my mic, isn’t it? Check the lifeboat locker.",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_choice"
        },
        {
          "id": "e1_n09_choice",
          "type": "choice",
          "prompt": "Member #7 is ON THE YACHT. What do you do?",
          "options": [
            {
              "option_id": "opt_bridge",
              "label": "Run to the captain’s bridge for radio",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I’m heading to the bridge to tell the captain to turn back.",
              "next_node_id": "e1_n10_free"
            },
            {
              "option_id": "opt_deck",
              "label": "Inspect the lifeboat locker silently",
              "cost_type": "vip_rewarded",
              "badge_text": "Risky · Watch Ad",
              "player_reply_text": "Stay here—I’m checking the lifeboat locker myself.",
              "next_node_id": "e1_n10_vip"
            }
          ]
        },
        {
          "id": "e1_n10_free",
          "type": "narrator",
          "text": "You reach the bridge—it’s empty. The autopilot is locked on open sea and the VHF radio cord is severed.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n10_vip",
          "type": "narrator",
          "text": "Inside the lifeboat locker sits a waterproof tablet—logged into the group chat as \"Member #7\"—and Derek’s spare watch.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_merge"
        },
        {
          "id": "e1_n11_merge",
          "type": "text",
          "sender_id": "sienna",
          "text": "Guys… the yacht just killed its engines. Why are we drifting?!",
          "timestamp_label": "11:10 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12_end"
        },
        {
          "id": "e1_n12_end",
          "type": "cliffhanger",
          "headline": "Someone Just Locked the Cabin Hatch",
          "teaser_text": "Episode 2: Member #7 gives you 3 minutes to name the real driver from 2021.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "The 2021 Pact",
      "start_node_id": "e2_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "11:12 PM · Dead calm water. The lower cabin door is bolted from the outside.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ghost7",
          "text": "Three minutes, {{player_name}}. Tell the chat who actually drove Leo’s car off the ridge.",
          "timestamp_label": "11:12 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "derek",
          "text": "Wait—we all swore Leo was alone! Nobody here was in that car!",
          "timestamp_label": "11:13 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "sienna",
          "text": "Stop lying, Derek. You paid the tow truck driver $15,000 in cash that night.",
          "timestamp_label": "11:13 PM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n05",
          "ambient": "heartbeat"
        },
        {
          "id": "e2_n05",
          "type": "voice_note",
          "sender_id": "derek",
          "duration_sec": 11,
          "transcript": "[panicking] I paid him to hide YOUR bumper paint, Sienna! You were the one racing Leo down the canyon!",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "unsent_message",
          "sender_id": "sienna",
          "text": "I didn’t mean to clip his rear wheel, he wouldn’t pull over—",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "text",
          "sender_id": "player",
          "text": "Wait a second… if both of you are locked down here with me, who’s on deck?",
          "timestamp_label": "11:15 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n08_choice"
        },
        {
          "id": "e2_n08_choice",
          "type": "choice",
          "prompt": "You hear a flare gun click above the hatch. What do you do?",
          "options": [
            {
              "option_id": "opt_save_audio",
              "label": "Record Sienna’s confession & push hatch",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "We have the confession on tape! Open the hatch!",
              "next_node_id": "e2_n09_free"
            },
            {
              "option_id": "opt_expose_cap",
              "label": "Call out the captain’s real last name",
              "cost_type": "vip_rewarded",
              "badge_text": "Twist · Watch Ad",
              "player_reply_text": "You’re not a charter captain. You’re Leo’s brother.",
              "next_node_id": "e2_n09_vip"
            }
          ]
        },
        {
          "id": "e2_n09_free",
          "type": "narrator",
          "text": "The hatch slides open. Standing in the moonlight is the yacht captain—wearing Leo’s silver dog tag.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n10_merge"
        },
        {
          "id": "e2_n09_vip",
          "type": "narrator",
          "text": "Silence above deck. Then the bolt slides back—and the captain holds up a satellite recorder already streaming to the Coast Guard.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n10_merge"
        },
        {
          "id": "e2_n10_merge",
          "type": "text",
          "sender_id": "ghost7",
          "text": "Thanks for the confession, Sienna. Coast Guard boat is two minutes out.",
          "timestamp_label": "11:17 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n11"
        },
        {
          "id": "e2_n11",
          "type": "text",
          "sender_id": "ghost7",
          "text": "Oh, and {{player_name}}? Keep your phone dry. You’re the only one he never blamed.",
          "timestamp_label": "11:18 PM",
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n12_end"
        },
        {
          "id": "e2_n12_end",
          "type": "cliffhanger",
          "headline": "Red & Blue Lights Across the Water",
          "teaser_text": "Sienna grabs your wrist in the dark: \"He doesn’t know about the passenger in the back seat...\"",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
      "episode_number": 3,
      "title": "The Back-Seat Witness",
      "start_node_id": "e3_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "11:48 PM · Coast Guard strobe lights sweep across the dark bay as the yacht’s engine drops to idle.",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "sienna",
          "text": "{{player_name}}, listen to me—the night of the 2021 crash, there wasn’t just six of us in the SUV!",
          "timestamp_label": "11:48 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—who was in the back seat, Sienna? And why didn’t you tell us five years ago?",
          "timestamp_label": "11:49 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n04"
        },
        {
          "id": "e3_n04",
          "type": "image",
          "sender_id": "sienna",
          "image_asset": "assets/media/evidence/lake_bonfire_timestamp.webp",
          "caption": "2021 Lake Bonfire · 11:02 PM — A seventh friend standing beside Derek’s car before the crash.",
          "blur_until_tap": true,
          "typing_delay_ms": 850,
          "sfx": "photo_snap",
          "haptic": "heavy",
          "next_node_id": "e3_n05"
        },
        {
          "id": "e3_n05",
          "type": "text",
          "sender_id": "derek",
          "text": "That’s Leo’s little sister, Maya! She passed out in the third row before we drove down the ridge!",
          "timestamp_label": "11:50 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n06"
        },
        {
          "id": "e3_n06",
          "type": "unsent_message",
          "sender_id": "ghost7",
          "text": "You left my brother on the roadside and swore nobody else saw it. Look at the stern.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e3_n07"
        },
        {
          "id": "e3_n07",
          "type": "choice",
          "prompt": "The yacht’s boarding ladder rattles as Member #7 steps out of the lower crew cabin.",
          "options": [
            {
              "option_id": "e3_opt_free",
              "label": "Step between Derek and Member #7",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Stop! Nobody’s throwing anyone overboard!",
              "next_node_id": "e3_n08_free"
            },
            {
              "option_id": "e3_opt_vip",
              "label": "Demand Derek show his 2021 phone backup",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Show us your 2021 texts, Derek!",
              "next_node_id": "e3_n08_vip"
            }
          ]
        },
        {
          "id": "e3_n08_free",
          "type": "narrator",
          "text": "Member #7 raises both hands—holding only a waterproof voice recorder glowing red.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: Derek’s father didn’t just hide the crash—he bribed the county coroner to rule Leo’s death a solo bike accident.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "text",
          "sender_id": "sienna",
          "text": "She’s been recording the entire yacht trip! Every word Derek just confessed is on that drive!",
          "timestamp_label": "11:51 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n10"
        },
        {
          "id": "e3_n10",
          "type": "voice_note",
          "sender_id": "ghost7",
          "duration_sec": 9,
          "transcript": "[ocean waves, clear young voice] ...Five years you all drank champagne while my family buried him. Tonight the Coast Guard gets the tape...",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "player",
          "text": "Sienna’s right—we can’t keep lying for Derek’s dad. Let her play the truth.",
          "timestamp_label": "11:52 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n12"
        },
        {
          "id": "e3_n12",
          "type": "cliffhanger",
          "headline": "Face to Face on Deck",
          "teaser_text": "Episode 4: Derek lunges for the recorder as the Coast Guard cutter pulls alongside.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 4
        }
      ]
    },
    {
      "episode_number": 4,
      "title": "Blood Money",
      "start_node_id": "e4_n01",
      "default_ambient": "heartbeat",
      "nodes": [
        {
          "id": "e4_n01",
          "type": "narrator",
          "text": "11:54 PM · Sea spray whips across the teak deck as Derek corners Member #7 near the wheelhouse.",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n02"
        },
        {
          "id": "e4_n02",
          "type": "text",
          "sender_id": "sienna",
          "text": "Shut up! If that recorder goes into the water, there’s zero proof! We all signed the 2021 pact!",
          "timestamp_label": "11:54 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n03"
        },
        {
          "id": "e4_n03",
          "type": "text",
          "sender_id": "player",
          "text": "We signed because you swore Leo survived and moved away! You lied to all of us, Derek!",
          "timestamp_label": "11:55 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n04"
        },
        {
          "id": "e4_n04",
          "type": "unsent_message",
          "sender_id": "ghost7",
          "text": "Already synced to the harbor detective’s cloud ten minutes ago, Derek.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e4_n05"
        },
        {
          "id": "e4_n05",
          "type": "text",
          "sender_id": "derek",
          "text": "Wait—you mean the cops already have the audio?! Then why are you still holding that envelope?!",
          "timestamp_label": "11:56 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n06"
        },
        {
          "id": "e4_n06",
          "type": "voice_note",
          "sender_id": "ghost7",
          "duration_sec": 11,
          "transcript": "[paper tearing in wind, bitter laugh] ...Because the audio only proves the crash. This bank statement proves who paid to bury it...",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n07"
        },
        {
          "id": "e4_n07",
          "type": "choice",
          "prompt": "Derek reaches for the wheelhouse flare gun while Sienna blocks the cabin door.",
          "options": [
            {
              "option_id": "e4_opt_free",
              "label": "Knock the flare gun out of Derek’s hand",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Drop the flare gun right now, Derek!",
              "next_node_id": "e4_n08_free"
            },
            {
              "option_id": "e4_opt_vip",
              "label": "Snap a clear photo of the 2021 bank wire",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Photographing the hush-money wire...",
              "next_node_id": "e4_n08_vip"
            }
          ]
        },
        {
          "id": "e4_n08_free",
          "type": "narrator",
          "text": "The flare gun skitters across the wet deck and splashes harmlessly into the dark bay.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n09_merge"
        },
        {
          "id": "e4_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: The wire shows $150,000 from Derek’s family trust paid to the deputy sheriff who closed the 2021 file.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n09_merge"
        },
        {
          "id": "e4_n09_merge",
          "type": "text",
          "sender_id": "sienna",
          "text": "Coast Guard officers are boarding off the port side! Put your hands up, Derek!",
          "timestamp_label": "11:57 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n10"
        },
        {
          "id": "e4_n10",
          "type": "text",
          "sender_id": "ghost7",
          "text": "Every single one of you is going down with me if you open your mouths!",
          "timestamp_label": "11:57 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n11"
        },
        {
          "id": "e4_n11",
          "type": "text",
          "sender_id": "player",
          "text": "No, Derek. Only the ones who hid the body and paid the bribe.",
          "timestamp_label": "11:58 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
