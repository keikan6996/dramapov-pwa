    {
      "episode_number": 1,
      "title": "Trip Completed",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "1:42 AM · RIDESAFE RECEIPT: Thank you for riding with Victor! Your trip ended at 1:30 AM. Rate 5 stars?",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "Sora, I’m STILL in the backseat of this sedan! He spoofed the app to end the ride early and just turned onto the industrial bypass!",
          "timestamp_label": "1:42 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "sora",
          "text": "WHAT?! Keep your phone screen dimmed so he can’t see you texting in the mirror! Did you check the license plate when you got in?!",
          "timestamp_label": "1:43 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "sora",
          "duration_sec": 7,
          "transcript": "[typing frantically] I’m looking at your FindMy dot! You’re doing 65 mph past the empty rail yard—and the driver’s photo on your receipt doesn’t match the license plate you sent me!",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "bot",
          "text": "Put the phone down, {{player_name}}. I can see the blue glow on your face in the rearview.",
          "unsent_placeholder": "RideSafe Support unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "The driver speeds up toward a red light at the rail crossing:",
          "options": [
            {
              "option_id": "opt_089_e1_free",
              "label": "Fake a loud call with your \"cop uncle\"",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Hey Uncle Ray! Yeah, I’m passing Rail Yard 4 right now—see your cruiser ahead!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_089_e1_vip",
              "label": "Open backseat armrest into the trunk",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "The driver’s knuckles whiten on the wheel. He slows for two seconds—then laughs coldly and turns off the headlights completely.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "sora",
          "text": "Nice try—stay on the line! I’m patching 911 dispatch into your live GPS coordinates right now!",
          "timestamp_label": "1:45 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You quietly unlatch the center armrest pass-through and grab the glowing emergency trunk-release handle. Inside the trunk sits a second phone—ringing nonstop.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Sora!! The real driver Victor’s smashed phone is sitting inside the trunk!",
          "timestamp_label": "1:45 AM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "A freight train horn blasts ahead. The crossing gates drop with clanging bells, forcing the sedan to screech to a halt.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "sora",
          "text": "He stopped!! The train is blocking the road—NOW IS YOUR CHANCE! Break the window or pop the trunk!",
          "timestamp_label": "1:46 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Stopped At The Tracks",
          "teaser_text": "The driver shifts into reverse as steel freight cars roar past inches from the bumper.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
