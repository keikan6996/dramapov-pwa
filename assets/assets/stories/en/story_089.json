            {
              "option_id": "opt_089_e2_vip",
              "label": "Snap photo of his dash payer chat",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Got the screenshot! The cops are going to love this!",
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "CRACK! The tempered glass explodes outward into a thousand cubes. You dive out and sprint straight into the blinding headlights of two arriving police cruisers.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "sora",
          "text": "The dispatcher says they have you!! Oh thank god, {{player_name}}! Are you bleeding?!",
          "timestamp_label": "1:50 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "Your flash catches the driver’s mounted tablet before you shatter the glass and bail out. The sender’s contact name on the tablet: \"Defense Counsel Reed.\"",
          "style": "system_alert",
          "sfx": "photo_snap",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Sora, I’m safe with the cops—and I just caught the defense attorney red-handed ordering my kidnapping!",
