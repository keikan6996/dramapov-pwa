          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "unsent_message",
          "sender_id": "bot",
          "text": "The driver was only Plan A. Don’t drink the water at the precinct.",
          "unsent_placeholder": "RideSafe Support unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "narrator",
          "text": "Sitting in the back of the patrol car, you look up as a friendly officer hands you an already-opened bottle of water—and smiles.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
