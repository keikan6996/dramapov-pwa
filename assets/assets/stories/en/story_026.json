      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:41 AM · You are alone in the damp basement laundry room. The fluorescent tube above the cracked mirror buzzes.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Quinn, are you still in the basement?! Cover your eyes and get out—DO NOT look at the mirror!",
          "timestamp_label": "2:41 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Too late, I’m standing right in front of it folding shirts. Wait—my reflection didn’t blink when I did.",
          "timestamp_label": "2:42 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "Switch places with me. My side is freezing.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "Back away slowly! I went down there at 1 AM and my reflection smiled while I was crying!",
