          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "Your reflection raises its palm and presses against the inside of the cracked glass.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Throw your wet towel over the mirror",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Covering the glass right now!",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "Shatter the mirror with a detergent bottle",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "I’m breaking this thing!",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "The towel drapes over the frame—and immediately bulges outward like a face pushing through wet cloth.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRET UNLOCKED: The glass shatters, revealing a hidden message scratched into the concrete behind it: \"NEVER LEAVE IT UNSEEN.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "Wait a second... Quinn, you just walked past my door on Floor 2 carrying a laundry basket. Who am I texting?!",
          "timestamp_label": "2:45 AM",
