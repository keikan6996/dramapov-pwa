          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, step out of the kitchen light! The tall man on balcony 11D has been staring straight at you for 40 minutes!",
