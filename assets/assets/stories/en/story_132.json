    {
      "episode_number": 1,
      "title": "The Spare Key Fight",
      "start_node_id": "e1_n01",
      "default_ambient": "family_drama",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "5:40 PM · Your husband slams the front door angry—all because you re-keyed the smart lock after catching his mom letting herself into your nursery three days in a row.",
          "style": "system_alert",
          "sfx": "ting_soft",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "husband",
          "text": "You humiliated my mom, {{player_name}}! She stood on our porch with groceries because her key didn’t work—she only comes over to tidy the nursery!",
          "timestamp_label": "5:40 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "We don’t even have a baby yet, Noah. Why does she spend forty minutes alone in an empty nursery?",
          "timestamp_label": "5:40 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "mil",
          "text": "Noah, make her give me the new keypad code tonight—I left something important inside the nursery!",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "husband",
          "duration_sec": 7,
          "transcript": "[annoyed sigh] \"Just text her the temporary code, {{player_name}}. She probably left her knitting bag in there.\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Something feels off about Diane’s sudden panic over an empty room:",
          "options": [
            {
              "option_id": "opt_132_e1_free",
              "label": "Refuse the code & inspect the nursery yourself",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "I’ll bring her \"knitting bag\" myself. Let me check the nursery first.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_132_e1_vip",
              "label": "Check the nursery crib mattress zipper first",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You open the nursery door—zero knitting bags, zero groceries. Just a freshly unzipped seam along the crib mattress.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "husband",
          "text": "Wait—why is the crib mattress foam cut open?! What is that silver case?!",
          "timestamp_label": "5:44 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You unzip the mattress lining and pull out a heavy waterproof pouch—stuffed with $140,000 in banded hundred-dollar bills and three foreign passports.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "husband",
          "text": "Oh my god... {{player_name}}, whose face is on those passports?!",
          "timestamp_label": "5:44 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Every passport has a different name—all bearing the exact same photo of your mother-in-law’s \"quiet\" new boyfriend, Gary.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "mil",
          "text": "{{player_name}}, I’m parked outside right now! Open the door—Gary needs his bag from the crib BEFORE 7 PM!!",
          "timestamp_label": "5:49 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Cash In The Crib",
          "teaser_text": "Up next: The Hallway Cam Glitch — Noah goes pale.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "The Hallway Cam Glitch",
      "start_node_id": "e2_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "6:10 PM · Noah goes pale. You check your hallway security app to see how many times Diane entered—and notice the 2:00 PM feed was wiped clean.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "medium",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "husband",
          "text": "Look at the hallway camera—it shows empty frames from 2:00 PM to 2:45 PM! Someone logged into my mom’s shared camera app and deleted them!",
          "timestamp_label": "6:10 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Don’t open the front door, Noah. Call Sgt. Kim from the precinct right now.",
          "timestamp_label": "6:10 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "unsent_message",
          "sender_id": "mil",
          "text": "Gary, she changed the locks AND she isn’t answering!! Come around the back patio!!",
