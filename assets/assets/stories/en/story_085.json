  "episodes": [
    {
      "episode_number": 1,
      "title": "Cruising Altitude",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "35,000 FT · Flight 408 to Zurich. Seatbelt sign dings off. Inside your tote bag, an unfamiliar black flip-phone buzzes on satellite signal.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ghost",
          "text": "Do not hand this phone to the flight crew, {{player_name}}. Look at Seat 14A.",
          "timestamp_label": "11:14 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "You’re the woman who bumped into me at Gate 19! Why did you plant this in my bag?!",
          "timestamp_label": "11:14 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "ghost",
          "duration_sec": 8,
          "transcript": "[jet engine hum, whispered] The man in 14A is carrying a stolen bioweapon ledger. He spotted me at TSA, so I had to pass the decryption key to a clean passenger—you.",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "ghost",
          "text": "Warning: one of the flight attendants is on his payroll. Trust nobody in uniform.",
          "unsent_placeholder": "GHOST-19 unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Lead attendant Elena pauses beside your row, eyeing the black phone:",
          "options": [
            {
              "option_id": "opt_085_e1_free",
              "label": "Hide the phone & ask for water",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Just checking my offline notes, thanks. Could I get a water?",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_085_e1_vip",
              "label": "Test Elena with a fake seat number",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Wait—did the man in 14A drop this black phone in the aisle?",
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Elena smiles politely and moves down the aisle—stopping immediately to whisper into the ear of the man in Seat 14A.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "elena",
          "text": "[In-Flight Chat · Crew] Please step to the rear galley, {{player_name}}. There is an issue with your customs declaration.",
          "timestamp_label": "11:17 PM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Elena’s hand twitches toward her apron pocket—where a sleek silver syringe glints under the cabin light. She recovers in half a second.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "elena",
          "text": "[In-Flight Chat · Crew] Hand over the phone quietly in the rear galley, {{player_name}}, or we make an unscheduled medical emergency.",
          "timestamp_label": "11:17 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ghost",
          "text": "She’s the mole! Lock yourself in Lavatory 2B and wait for my signal—I’m spoofing the cockpit ACARS right now!",
          "timestamp_label": "11:18 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "The cabin lights suddenly dim to amber. Seat 14A unbuckles his belt and stands up—blocking the aisle between you and the lavatory.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Nowhere To Run At 35,000 Feet",
          "teaser_text": "The man in 14A is walking straight toward your seat, and Elena just locked the cockpit curtain behind her.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Emergency Descent",
      "start_node_id": "e2_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "11:20 PM · Turbulence shakes the cabin. Seat 14A steadies himself on the overhead bin three rows away as the burner phone rings.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "incoming_call",
          "caller_id": "ghost",
          "caller_label": "GHOST-19",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n03_ans",
          "on_decline_node_id": "e2_n03_dec"
        },
        {
          "id": "e2_n03_ans",
          "type": "voice_note",
          "sender_id": "ghost",
          "duration_sec": 8,
          "transcript": "[alarm chime in background] Listen! An Air Marshal is sitting in Seat 2C! Shout the code phrase \"RED HORIZON\" loud enough for First Class to hear!",
          "audio_asset": null,
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n03_dec",
          "type": "text",
          "sender_id": "ghost",
          "text": "Air Marshal is in Seat 2C! Shout \"RED HORIZON\" and point at 14A—he’ll draw immediately!",
          "timestamp_label": "11:20 PM",
          "typing_delay_ms": 500,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "elena",
          "text": "Don’t listen to GHOST-19, {{player_name}}! SHE is the one who stole the ledger—and I’m the Interpol agent assigned to stop her!",
          "timestamp_label": "11:21 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "text",
          "sender_id": "player",
          "text": "Wait... ONE of you is lying, and I’m holding the key!",
          "timestamp_label": "11:21 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n06_choice"
        },
        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "Both sides are closing in on Row 11. Who do you trust?",
          "options": [
            {
              "option_id": "opt_085_e2_free",
              "label": "Shout \"RED HORIZON\" to Seat 2C",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "RED HORIZON! Seat 14A has a compromised briefcase!",
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_085_e2_vip",
              "label": "Wipe the burner phone with the kill PIN",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "A broad-shouldered passenger in 2C springs up with a federal badge, tackling 14A into the aisle. Elena freezes—her hand still gripping the hidden syringe.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "ghost",
          "text": "Nice work, {{player_name}}. Keep the phone until Zurich customs—don’t let the Marshal see the SIM tray.",
          "timestamp_label": "11:23 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "You punch 0000# into the flip-phone. The screen flashes \"KEY DESTROYED\"—and instantly transfers a hidden backup partition straight to your personal cloud.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "elena",
          "text": "You just wiped the only proof we had! Do you have any idea who GHOST-19 really works for?!",
          "timestamp_label": "11:23 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "unsent_message",
          "sender_id": "ghost",
          "text": "Captain just diverted Flight 408 to an unmarked military strip. Brace for landing.",
          "unsent_placeholder": "GHOST-19 unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "narrator",
          "text": "The cabin intercom crackles: \"Ladies and gentlemen, we are making an immediate unscheduled descent.\" Outside your window, fighter jet wingtips glint in the moonlight.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "Diverted To Nowhere",
          "teaser_text": "Two fighter jets are escorting Flight 408 down—and you are the only passenger holding the encrypted key.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
    {
