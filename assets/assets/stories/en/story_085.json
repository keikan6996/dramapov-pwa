        {
          "id": "e3_n07_free",
          "type": "narrator",
          "text": "Elena smoothly draws the First Class curtain and taps the silent distress code into the cockpit intercom.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "elena",
          "text": "Captain confirmed! Marshals are positioning at both Forward and Rear exits!",
          "timestamp_label": "03:18 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "Elena flashes her crew tablet: Seat 2A is traveling under a forged attaché passport linked to a defense-contract theft.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "He’s not a diplomat—he’s using the burner to smuggle stolen satellite codes past customs!",
          "timestamp_label": "03:18 AM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "unsent_message",
          "sender_id": "ghost",
          "text": "If the marshals board first, I trigger the smoke canister in overhead bin 2.",
          "unsent_placeholder": "GHOST-19 unsent a message",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n10"
        },
        {
          "id": "e3_n10",
          "type": "text",
          "sender_id": "elena",
          "text": "He just stood up and reached for Overhead Bin 2! He’s going to cause a stampede!",
          "timestamp_label": "03:18 AM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n11"
        },
        {
          "id": "e3_n11",
          "type": "text",
          "sender_id": "ghost",
          "text": "Thirty seconds, {{player_name}}. Bring the burner forward or the cabin fills with smoke.",
          "timestamp_label": "03:18 AM",
          "typing_delay_ms": 650,
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e3_n12_cliff"
        },
        {
          "id": "e3_n12_cliff",
          "type": "cliffhanger",
          "headline": "Seat 2A Unmasked",
          "teaser_text": "GHOST-19 was sitting six rows ahead of you the entire flight—and his hand is on a smoke canister in Overhead Bin 2.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 4
        }
      ]
    },
    {
