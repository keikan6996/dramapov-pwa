          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e4_n09_merge"
        },
        {
          "id": "e4_n07_vip",
          "type": "narrator",
          "text": "You tap the Air Marshal’s emergency kill-code—locking the satellite partition to read-only so only federal agents can decrypt it.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n08_vip"
        },
        {
