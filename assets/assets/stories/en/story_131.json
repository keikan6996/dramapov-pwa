        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Marco forwards an archived invoice showing Brett’s exact ID—and a bride named Claire Mercer who vanished two weeks before her date.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "caterer",
          "text": "Wait—he paid that deposit using Claire’s credit card, then refunded it to HIS bank!",
          "timestamp_label": "6:16 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You pause the cancellation for 24 hours—watching Brett immediately text Marco asking if the $18,000 can be \"refunded in cash to the groom.\"",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "caterer",
          "text": "He literally just tried to pocket YOUR $18,000 refund!!",
          "timestamp_label": "6:16 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
