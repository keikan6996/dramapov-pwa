      "episode_number": 1,
      "title": "The $18,000 Group Chat War",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "6:12 PM · Your phone explodes with 47 unread messages in the Family Chat. All because you refused to wire the final $18,000 venue payment after Hannah demoted you from Maid of Honor to parking attendant.",
          "style": "system_alert",
          "sfx": "ting_soft",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "mom",
          "text": "{{player_name}}, stop being petty! Put the $18,000 back on the venue card right now—Hannah is crying her eyes out!",
          "timestamp_label": "6:12 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "She uninvited my partner AND asked me to pay for 160 guests I’ve never met.",
