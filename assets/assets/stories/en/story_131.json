          "type": "text",
          "sender_id": "sister",
          "text": "Mom said you’re stalling on the venue! Wire the $18,000 directly to Brett’s account instead—he’ll pay Marco!",
          "timestamp_label": "6:21 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
