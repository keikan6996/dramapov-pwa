          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "sister",
          "text": "Tell Mom if {{player_name}} cancels the venue, Brett will call off the wedding and take our house deposit!",
