              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "Spotlights sweep the grand staircase as you descend arm-in-arm with Chairman Julian.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "sil",
          "text": "WHAT?! Camille?! How did you get out of the lift—and why are you touching the Chairman?!",
          "timestamp_label": "08:05 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "The ballroom audio cuts to Security Chief Marcus: \"Alert: Unauthorized impersonator detected using Pass #007 at Table 1.\"",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "sil",
          "text": "No!! I’m not an impersonator! I’m Camille’s sister-in-law—she gave me the ticket!!",
          "timestamp_label": "08:05 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "Julian steps right up to Vanessa, his friendly smile turning glacial.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "text",
          "sender_id": "chairman",
          "text": "Funny—our service-lift camera shows you snatching Pass #007 and bribing a bellboy to trap my guest of honor.",
          "timestamp_label": "08:08 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "Guest Of Honor",
          "teaser_text": "Vanessa realizes she didn’t just lock out her sister-in-law—she locked out the Chairman’s personal VIP, AND the merger partner.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
