    {
      "episode_number": 1,
      "title": "Trapped In Service Lift",
      "start_node_id": "e1_n01",
      "default_ambient": "family_drama",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "7:50 PM · Grand Obsidian Hotel. Ten minutes before the merger gala, your sister-in-law Vanessa snatches your gold VIP invitation and slams the service elevator emergency stop!",
          "style": "banner",
          "sfx": "knock",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "sil",
          "text": "Stay in that freight elevator, Camille! A plain accountant like you doesn’t deserve to meet the Chairman of Obsidian Group—I’m using your pass!",
          "timestamp_label": "07:50 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Vanessa, unlock this lift right now! That pass is registered to my biometric ID—and the security intercom is dead!",
          "timestamp_label": "07:50 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "chairman",
          "text": "Hey midnight buddy! Still coming to that boring corporate gala you told me about? You’ve got 1 bar of signal—everything okay?",
          "timestamp_label": "07:52 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "sil",
          "text": "Good thing I bribed the bellboy to jam the service lift for two hours!",
          "unsent_placeholder": "Vanessa unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Only 1 bar of cell signal left inside the steel shaft:",
          "options": [
            {
              "option_id": "opt_story_114_e1_free",
              "label": "Text \"Wrong Number\" your exact floor & hotel",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "SOS! Sister-in-law stole my VIP pass and locked me in Service Lift B at Grand Obsidian!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_114_e1_vip",
              "label": "Send him a voice note before signal drops",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Three dots flash immediately on your \"Wrong Number\" chat—followed by a reply that stops your breath.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "chairman",
          "text": "Grand Obsidian?! Service Lift B?! Hold tight—I’m literally upstairs. Unlocking your lift in 30 seconds!",
          "timestamp_label": "07:52 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Your whispered SOS sends just as the signal hits zero—and seconds later, the overhead emergency speaker crackles to life!",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "chairman",
          "text": "This is Chairman Julian of Obsidian Group! Engineering, override Lift B NOW—and detain whoever holds pass #007!",
          "timestamp_label": "07:52 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "CLANK! The elevator jolts upward, gliding smoothly straight to the 60th-floor private penthouse lobby.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "chairman",
          "text": "Six months of midnight texting—guess it’s finally time we meet in person, Camille.",
          "timestamp_label": "07:55 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "The Penthouse Rescue",
          "teaser_text": "The elevator doors part to reveal the most powerful billionaire in the city—who turns out to be your favorite texting buddy.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Face To Face",
      "start_node_id": "e2_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "8:02 PM · Floor 60 Private Lobby. A sharp-suited man with a warm grin extends his hand as the steel doors open.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "chairman",
          "text": "Finally! Your midnight jokes kept me sane through a $2B merger, Camille. Now let’s go see who stole your pass.",
          "timestamp_label": "08:02 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait—YOU’RE Chairman Julian?! I complained to you about my sister-in-law for six months!!",
          "timestamp_label": "08:02 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "image",
          "sender_id": "sec",
          "image_asset": "assets/media/evidence/generic_hotel_keycard.webp",
          "caption": "Obsidian Gala Pass #007 — flagged at Ballroom Gate A by Vanessa posing under Camille’s name.",
          "blur_until_tap": true,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "unsent_message",
          "sender_id": "sil",
          "text": "I’m inside the VIP circle! Time to tell the Chairman I’m the sole heir to the family trust!",
          "unsent_placeholder": "Vanessa unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e2_n06_choice"
        },
        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "Julian offers you his arm outside the grand ballroom:",
          "options": [
            {
              "option_id": "opt_story_114_e2_free",
              "label": "Walk in on Julian’s arm & watch Vanessa freeze",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Lead the way, Mr. Wrong Number.",
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_story_114_e2_vip",
