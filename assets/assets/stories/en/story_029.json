          "type": "narrator",
          "text": "SECRET UNLOCKED: The last twelve pages are filled with YOUR handwriting—all dated tomorrow: \"I never checked out.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
