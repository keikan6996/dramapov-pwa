      "title": "House Rule #7",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "1:04 AM · Pine branches whip against the cabin windows in the mountain storm. Above your bed, wooden boards groan.",
