          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Hi Taylor, so sorry for the late text! I forgot Rule #7: if the attic hatch creaks after 1 AM, turn off all lights and DO NOT look up.",
