    {
      "episode_number": 1,
      "title": "15 Feet Away",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "10:52 PM · -14°F BLIZZARD. Zero cell bars. Your offline hiking app pings: \"PEER CONNECTED VIA BLUETOOTH MESH — DISTANCE: 15 FT.\"",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "btnode",
          "text": "Please open the porch door, Taylor! My snowmobile flipped in the drift—I’m freezing to death out here!",
          "timestamp_label": "10:52 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Wait... how do you know my name?! I rented Cabin 12 under my own booking!",
          "timestamp_label": "10:53 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "cole",
          "duration_sec": 7,
          "transcript": "[crackling VHF relay] Cabin 12, this is Ranger Cole! Do NOT let anyone inside! A state prisoner escaped a transport van on Highway 89 two hours ago!",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "btnode",
          "text": "Your guestbook was sitting in the mailbox, Taylor. Now unlock the door before I cut the power line.",
          "unsent_placeholder": "BT_NODE_01 unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Heavy fists pound against the frosted porch door:",
          "options": [
            {
              "option_id": "opt_098_e1_free",
              "label": "Barricade door & hold the fireplace poker",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Ranger Cole, he’s right on my porch! Send backup to Cabin 12!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_098_e1_vip",
              "label": "Check the outdoor trail-cam on your tablet",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You shove the heavy oak dining table against the front door. Suddenly the cabin lights flicker and die—he just ripped the exterior breaker box off the wall.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "cole",
          "text": "Snowcat is 12 minutes out! Stay away from the ground-floor windows—get up into the sleeping loft!",
          "timestamp_label": "10:55 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "The porch trail-cam lights up in night-vision. There is NO escaped convict on the porch—it’s a bleeding woman in a park ranger uniform, and a second shadow is behind her.",
          "style": "system_alert",
          "sfx": "photo_snap",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Wait... if the person bleeding on my porch is wearing a Ranger badge, then WHO is on the radio claiming to be Ranger Cole?!",
          "timestamp_label": "10:55 PM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Bluetooth signal indicator changes: \"DISTANCE: 4 FT — REAR MUDROOM WINDOW.\" Glass shatters in the kitchen.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "btnode",
          "text": "He stole the real ranger’s radio, Taylor! He’s coming through the back window—LET ME IN!",
          "timestamp_label": "10:56 PM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Two Voices In The Blizzard",
          "teaser_text": "One of them is a ranger trying to save you. The other is the escaped convict—and someone just climbed into your kitchen.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Whiteout",
      "start_node_id": "e2_n01",
      "default_ambient": "heartbeat",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "10:57 PM · Snow gusts through the broken kitchen pane. You climb the wooden loft ladder as boots crunch broken glass below.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "incoming_call",
          "caller_id": "cole",
          "caller_label": "Ranger Cole · VHF",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n03_ans",
          "on_decline_node_id": "e2_n03_dec"
        },
        {
          "id": "e2_n03_ans",
          "type": "voice_note",
          "sender_id": "cole",
          "duration_sec": 7,
          "transcript": "[heavy breathing—AND the exact same echo from downstairs] \"Come down from the loft, Taylor. I’m just here to check your stove.\"",
          "audio_asset": null,
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n03_dec",
          "type": "text",
          "sender_id": "cole",
          "text": "Drop the poker, Taylor. I only need your car keys and a warm coat.",
          "timestamp_label": "10:57 PM",
          "typing_delay_ms": 500,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "btnode",
          "text": "I’m Deputy Park Ranger Maya! I crawled around to the snowcat—toss me your flare gun from the loft window and I’ll draw him out!",
          "timestamp_label": "10:58 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
          "id": "e2_n05",
          "type": "text",
          "sender_id": "player",
          "text": "The fake ranger’s hand grips the bottom rung of the loft ladder!",
          "timestamp_label": "10:58 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n06_choice"
        },
        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "You have two seconds before he climbs up:",
          "options": [
            {
              "option_id": "opt_098_e2_free",
              "label": "Kick the wooden ladder backward & jump",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": null,
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_098_e2_vip",
              "label": "Fire the flare straight through the loft window",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": "Flare up! Maya, rev the snowcat NOW!",
              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "You shove the ladder off the beam—crashing it down on him—and leap from the loft window into a six-foot snowdrift right beside Maya’s idling snowcat.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "btnode",
          "text": "Climb in!! Hold tight—we’re gunning straight down the logging road to the ranger station!",
          "timestamp_label": "11:00 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "The crimson flare lights up the entire valley like noon. Overhead, a state search-and-rescue chopper pivots its blinding floodlight directly onto Cabin 12.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "btnode",
          "text": "They spotted us!! Jump into the drift—the chopper’s dropping the rescue team right now!",
          "timestamp_label": "11:00 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "unsent_message",
          "sender_id": "cole",
          "text": "Cabin 12 wasn’t random, Taylor. Your testimony put me in that prison van.",
          "unsent_placeholder": "Ranger Cole unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "narrator",
          "text": "As the snowcat roars away through the whiteout, you look back at Cabin 12’s porch—and freeze. Standing in the doorway isn’t a stranger. It’s your former business partner.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
        },
        {
          "id": "e2_n11_cliff",
          "type": "cliffhanger",
          "headline": "He Found Your Hideout",
          "teaser_text": "The prison break wasn’t an accident—he escaped specifically to track you to Cabin 12.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
    },
