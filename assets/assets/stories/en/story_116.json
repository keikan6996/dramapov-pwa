          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "captain",
          "text": "Chairwoman {{player_name}}, confirmed! That corporate card was reported stolen 20 minutes ago from Tokyo!",
