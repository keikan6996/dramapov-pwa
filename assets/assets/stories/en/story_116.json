    {
      "episode_number": 1,
      "title": "Seat 1A",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "9:00 PM · SkyCrown Airlines Flight 001. Exhausted after inspecting your new jet hangar, you board Seat 1A in a faded grey hoodie—when Amber slams her designer bag onto your armrest.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "amber",
          "text": "Excuse me, girl in the thrift hoodie—get to Economy! My boyfriend Kevin is a SkyCrown Aviation executive, and I want Seat 1A!",
          "timestamp_label": "09:00 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "A SkyCrown Aviation executive? Funny—I know every VP in our company, and I’ve never met a Kevin.",
          "timestamp_label": "09:00 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "kevin",
          "text": "Watch your tone! I paid $14,000 on my corporate black card for this flight! Flight attendant—kick this hoodie girl off before I call the Board!",
          "timestamp_label": "09:02 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "kevin",
          "text": "Good thing my manager left his corporate travel card in the procurement drawer while he’s in Tokyo...",
          "unsent_placeholder": "Kevin unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Amber grabs your hoodie sleeve to yank you out of 1A:",
          "options": [
            {
              "option_id": "opt_story_116_e1_free",
              "label": "Calmly press the Flight Deck direct chime",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Don’t touch me—and don’t bother calling the Board. Let’s ask the Captain.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_116_e1_vip",
              "label": "Scan Kevin’s corporate card on your tablet",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You tap the hidden Chairman chime twice. The cockpit door immediately unlocks.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "amber",
          "text": "Haha! Think the Captain will side with a hoodie nobody over an executive?!",
          "timestamp_label": "09:02 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Your SkyCrown Treasury app flashes red: Kevin isn’t an executive—he’s a Junior Procurement Clerk using his boss’s STOLEN card!",
