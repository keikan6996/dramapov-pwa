          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Chief Pilot Captain Vance strides straight down the First-Class aisle—and snaps a crisp salute to your faded grey hoodie!",
