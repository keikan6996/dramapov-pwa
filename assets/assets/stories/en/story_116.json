          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Cleared For Takeoff—Not You",
          "teaser_text": "Kevin’s jaw hits the floor as he realizes he just tried to kick his own billionaire Chairwoman out of Seat 1A using a stolen company card.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
