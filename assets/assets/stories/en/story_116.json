          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "captain",
          "text": "Good evening, Chairwoman {{player_name}}! Is this passenger disturbing the owner of SkyCrown Airlines?",
