          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n06"
        },
        {
          "id": "e2_n06",
          "type": "unsent_message",
          "sender_id": "victor",
          "text": "What?! No... Elena swore she hadn't seen anyone else since she left the office!",
