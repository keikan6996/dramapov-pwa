          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e3_n05"
        },
        {
          "id": "e3_n05",
          "type": "unsent_message",
          "sender_id": "brad",
          "text": "Once the Chairman’s kid marries my son, Titan will have to bail out our debt anyway!",
          "unsent_placeholder": "Brad unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e3_n06_choice"
        },
        {
          "id": "e3_n06_choice",
          "type": "choice",
          "prompt": "Brad knocks eagerly, holding a fresh glass of champagne:",
          "options": [
            {
              "option_id": "opt_story_103_e3_free",
              "label": "Confront him with the debt rider",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Come in, Brad. Let’s discuss page 4 of your \"engagement agreement\".",
              "next_node_id": "e3_n07_free"
            },
            {
              "option_id": "opt_story_103_e3_vip",
              "label": "Buy his bank’s defaulted loan tonight",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e3_n07_vip"
            }
          ]
        },
        {
          "id": "e3_n07_free",
          "type": "narrator",
          "text": "You slide the red-circled guarantor clause across the table. Brad’s fake smile evaporates.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "brad",
          "text": "Th-that’s just standard family paperwork! My lawyer must have mixed up the pages!",
          "timestamp_label": "06:35 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "Victor makes one 10-second call to Titan’s credit desk. Brad’s phone immediately buzzes with a bank foreclosure transfer notice.",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "victor",
          "text": "Done, Chairman. Titan Holdings is now Brad’s sole creditor—and we can foreclose at midnight.",
          "timestamp_label": "06:35 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "narrator",
          "text": "Brad drops to his knees again, clutching his chest—while his son bursts into the lounge shouting.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e3_n10"
        },
        {
          "id": "e3_n10",
          "type": "text",
          "sender_id": "emily",
          "text": "Enough! Take your ring back! I wouldn’t marry into your crooked family if you paid me!",
          "timestamp_label": "06:38 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11_cliff"
        },
        {
          "id": "e3_n11_cliff",
          "type": "cliffhanger",
          "headline": "Ring On The Floor",
          "teaser_text": "Emily throws the ring back—and Brad’s desperate counter-threat reveals he has a mole inside Titan Holdings.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 4
        }
      ]
    },
