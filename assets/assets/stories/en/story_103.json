          "text": "You tap Forward. Titan’s Chief Counsel and the city economic crime unit receive the audio instantly.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e4_n08_free"
        },
        {
          "id": "e4_n08_free",
          "type": "text",
          "sender_id": "victor",
          "text": "Warrant requested! Police are sealing Brad’s office and freezing his bid.",
          "timestamp_label": "06:48 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n09_merge"
        },
        {
          "id": "e4_n07_vip",
          "type": "narrator",
          "text": "You have Victor text the crooked Director from Brad’s phone: \"Bring the signed addendum to the Harbor lobby—cash waiting.\"",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e4_n08_vip"
        },
        {
          "id": "e4_n08_vip",
          "type": "text",
          "sender_id": "victor",
          "text": "He took the bait! He’s arriving in five minutes with the stolen files in his briefcase!",
          "timestamp_label": "06:48 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e4_n09_merge"
        },
        {
          "id": "e4_n09_merge",
          "type": "narrator",
          "text": "Emily squeezes your hand proudly as the hotel security doors seal off the VIP wing.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e4_n10"
