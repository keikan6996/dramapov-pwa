          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e4_n05"
        },
        {
          "id": "e4_n05",
          "type": "voice_note",
          "sender_id": "player",
          "duration_sec": 6,
          "transcript": "[calm, lethal precision] \"Thank you for confessing on my watch recorder, Brad. You just saved our audit team six months.\"",
          "audio_asset": null,
          "typing_delay_ms": 750,
          "sfx": "heartbeat",
