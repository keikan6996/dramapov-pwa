    {
      "episode_number": 1,
      "title": "The $10,000 Buyout",
      "start_node_id": "e1_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "6:00 PM · St. Jude Private Hospital VIP Wing. The very day Nathan takes his first unassisted steps after your three years of secret neuro-rehab, he drops a $10,000 check on your lap.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "nathan",
          "text": "Take the $10,000 and sign the divorce, {{player_name}}. Fiona came back from abroad—she’s the one who secretly paid for my miracle surgeon!",
          "timestamp_label": "06:00 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Fiona told you SHE paid for the miracle neurosurgeon?! Nathan, look at my hands—I massaged your legs every night for three years!",
          "timestamp_label": "06:00 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "fiona",
          "text": "Aww, any caretaker can rub legs, {{player_name}}. Only I had the connections to reach the anonymous Chairwoman of St. Jude Medical Group!",
          "timestamp_label": "06:02 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "fiona",
          "text": "Thank god Nathan never checked the dashcam from the night he got paralyzed...",
          "unsent_placeholder": "Fiona unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Nathan reaches for Fiona’s waist and smirks:",
          "options": [
            {
              "option_id": "opt_story_109_e1_free",
              "label": "Sign the divorce & tear up the $10K check",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Keep your $10,000. You’re going to need it for your next medical bill.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_109_e1_vip",
              "label": "Text Dr. Ken to pull the 3-year-old crash file",
              "cost_type": "vip_rewarded",
              "badge_text": "Secret · Watch Ad",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "You sign cleanly, rip the check in half, and let the scraps flutter onto Nathan’s designer shoes.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "nathan",
          "text": "Suit yourself! Tomorrow I’m thanking the St. Jude Chairwoman in person—with Fiona as my fiancée!",
          "timestamp_label": "06:02 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "You tap one coded message to Hospital Chief Dr. Ken. Within seconds, an encrypted archive pings your phone.",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "director",
          "text": "Chairwoman {{player_name}}, I pulled the 3-year-old ER intake—the hit-and-run car matched Fiona’s registered plate!!",
          "timestamp_label": "06:02 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "As you step out of the VIP room, Dr. Ken rushes down the corridor and bows deeply—right where Nathan can’t see yet.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "director",
          "text": "Chairwoman {{player_name}}, your final nerve-stabilizer dose for Nathan is scheduled tomorrow. Should we cancel his VIP charity waiver?",
          "timestamp_label": "06:05 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "The Miracle Surgeon",
          "teaser_text": "Nathan dumped the secret billionaire surgeon who saved his legs—to marry the very woman who ran him over three years ago.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
