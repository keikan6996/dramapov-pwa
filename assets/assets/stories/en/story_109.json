      "start_node_id": "e3_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "7:20 PM · Nathan grabs Fiona’s shoulders frantically, realizing he can’t pay $2 million without her \"connections.\"",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "light",
          "next_node_id": "e3_n02"
        },
        {
          "id": "e3_n02",
          "type": "text",
          "sender_id": "nathan",
          "text": "{{player_name}}, I made a terrible mistake! Fiona lied to me! Please tear up the divorce—I need my final nerve shot tomorrow!",
          "timestamp_label": "07:20 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e3_n03"
        },
        {
          "id": "e3_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Oh, Fiona didn’t just lie about paying your hospital bill, Nathan. Ask her why she fled abroad three years ago—the exact night you were hit.",
