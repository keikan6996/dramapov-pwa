          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "Dr. Ken steps to the podium and hands Nathan a crimson billing folder in front of three hundred stunned guests.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
