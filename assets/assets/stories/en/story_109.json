        {
          "id": "e3_n10",
          "type": "text",
          "sender_id": "nathan",
          "text": "I destroyed the only person who truly loved me... {{player_name}}, please don’t leave me!",
          "timestamp_label": "07:26 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n11_cliff"
