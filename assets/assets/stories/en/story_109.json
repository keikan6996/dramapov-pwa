      "title": "The Charity Gala",
      "start_node_id": "e2_n01",
      "default_ambient": "office_tension",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "7:00 PM · St. Jude Medical Gala. Nathan and Fiona pose proudly on the red carpet waiting to meet the mysterious Chairwoman.",
          "style": "banner",
          "sfx": "knock",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "incoming_call",
          "caller_id": "director",
          "caller_label": "Dr. Ken · Gala Control",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n03_ans",
          "on_decline_node_id": "e2_n03_dec"
        },
        {
          "id": "e2_n03_ans",
          "type": "narrator",
          "text": "Dr. Ken laughs dryly: \"Fiona is telling every donor that she’s best friends with the St. Jude Chairwoman!\"",
