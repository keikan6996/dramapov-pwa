              "next_node_id": "e2_n07_vip"
            }
          ]
        },
        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "You step into the golden spotlight. Nathan drops his champagne flute—shattering crystal across the floor.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "nathan",
          "text": "{{player_name}}?! YOU’RE the Chairwoman of St. Jude?! Wait—YOU performed my surgery?!",
          "timestamp_label": "07:03 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "The giant LED screen flashes your surgical license and the $2,000,000 fee waiver signed in your hand.",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "fiona",
          "text": "Wait... no! She’s lying! Nathan, tell them she’s just a jealous housewife!",
