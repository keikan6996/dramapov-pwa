        },
        {
          "id": "e3_n07_free",
          "type": "narrator",
          "text": "You tap the remote. The crystal-clear clip shows Fiona stumbling into the driver’s seat—and speeding away from Nathan’s crosswalk.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e3_n08_free"
        },
        {
          "id": "e3_n08_free",
          "type": "text",
          "sender_id": "nathan",
          "text": "NO!! YOU paralyzed me, Fiona?! You left me bleeding in the rain and let {{player_name}} sacrifice three years to save me?!",
          "timestamp_label": "07:23 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n07_vip",
          "type": "narrator",
          "text": "The double doors swing open. Traffic homicide detectives stride straight up to Fiona with a felony hit-and-run warrant.",
