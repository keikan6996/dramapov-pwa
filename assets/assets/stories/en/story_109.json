          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e3_n08_vip"
        },
        {
          "id": "e3_n08_vip",
          "type": "text",
          "sender_id": "director",
          "text": "Warrant executed! Plus obstruction charges for bribing the precinct clerk!",
          "timestamp_label": "07:23 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e3_n09_merge"
        },
        {
          "id": "e3_n09_merge",
          "type": "narrator",
          "text": "Fiona shrieks as handcuffs lock around her wrists, while Nathan collapses to his knees in utter devastation.",
