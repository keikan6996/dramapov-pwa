        {
          "id": "e2_n10",
          "type": "text",
          "sender_id": "director",
          "text": "Since you divorced Chairwoman {{player_name}} yesterday, your spousal waiver is void. Your $2M surgical balance is due in 7 days.",
          "timestamp_label": "07:06 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n11_cliff"
