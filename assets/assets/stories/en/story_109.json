          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Let her dig the hole deeper, Dr. Ken. Send me the $2M charity waiver invoice—her free ride ends tonight.",
