          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "unsent_message",
          "sender_id": "nolan",
          "text": "I'm the one who had the airline upgrade you to Seat 1B.",
          "unsent_placeholder": "This message was unsent",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "voice_note",
          "sender_id": "bestie",
          "duration_sec": 6,
          "transcript": "[gasping] GIRL DO NOT PANIC! He literally promoted your department last week—flirt back or pretend you fell asleep!",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "choice",
          "prompt": "Nolan is glancing at you over his glasses with a faint smirk.",
          "options": [
            {
              "option_id": "opt_own_it",
              "label": "Own it boldly and toast him with champagne",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Fair enough, Chairman. Care to tell me why you upgraded me to 1B?",
              "next_node_id": "e1_n09a"
            },
            {
              "option_id": "opt_vip_tease",
              "label": "Tease him for peeking at your phone screen",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Bold",
              "player_reply_text": "Pretty sure reading an employee's texts is an HR violation, Mr. Sterling. 😉",
              "next_node_id": "e1_n09b"
            }
          ]
        },
        {
          "id": "e1_n09a",
          "type": "text",
          "sender_id": "nolan",
          "text": "Because your boss tried to steal your pitch deck for the London summit—and I wanted to hear it straight from the real author.",
          "timestamp_label": "11:44 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n09b",
          "type": "text",
          "sender_id": "nolan",
          "text": "Then report me tomorrow—right after I make you Lead Director of the London deal, Morgan.",
          "timestamp_label": "11:44 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
