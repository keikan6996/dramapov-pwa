          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "narrator",
          "text": "You glance sideways. Seat 1A is holding a red-bordered binder—AND his AirDrop notification just popped onto your screen.",
