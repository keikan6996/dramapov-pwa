      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "11:40 PM · Red-eye flight to London. You connect to in-flight Wi-Fi and text Maya from Seat 1B.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "Maya, the guy in Seat 1A looks like a Greek god in a cashmere turtleneck—and just asked the attendant to move my champagne away from his laptop. 🙄",
          "timestamp_label": "11:40 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "bestie",
          "text": "Wait—is he reading a red-bordered merger binder? Because our new Chairman Nolan Sterling is on your exact flight!!",
