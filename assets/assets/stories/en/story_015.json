          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "nolan",
          "text": "Good evening, Morgan. Thank you for the \"Greek god\" compliment. Next time dim your brightness before texting about your Chairman.",
