          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "brie",
          "text": "Guys… scroll up. Every message we sent Mia since 4 PM just flipped to \"Read 9:39 PM\".",
