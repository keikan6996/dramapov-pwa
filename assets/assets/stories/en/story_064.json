          ]
        },
        {
          "id": "n07_free",
          "type": "narrator",
          "text": "The crowd erupts in stunned applause. Father stares at you, realizing you just outplayed everyone in the room.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n09_merge"
        },
        {
          "id": "n07_vip",
          "type": "narrator",
          "text": "BALLROOM EXPLODES: The CFO’s voice plotting the hostile takeover blasts from every speaker. He sprints for the exit.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "n08_vip"
        },
        {
          "id": "n08_vip",
          "type": "text",
          "sender_id": "mother",
          "text": "My god, {{player_name}}... you handled that better than your father ever could.",
