          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n09_merge"
        },
        {
          "id": "n09_merge",
          "type": "text",
          "sender_id": "stranger",
          "text": "We make a dangerous team, sibling. Now—let’s talk about what Dad still hasn’t told either of us.",
          "timestamp_label": "08:30 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n10_end"
        },
        {
          "id": "n10_end",
          "type": "cliffhanger",
          "headline": "Blood Alliance",
          "teaser_text": "Julian hands you a faded photograph from 1998—your Mother and Julian’s Mother standing side by side as best friends.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 3
        }
      ]
