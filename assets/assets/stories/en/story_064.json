            {
              "option_id": "opt_introduce_brother",
              "label": "Introduce him as your new Co-Advisor",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Stand down, security. Everyone, meet Julian—the man who just saved our company from an inside coup.",
