      "episode_number": 1,
      "title": "The Heirloom Watch",
      "start_node_id": "n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "n01",
          "type": "narrator",
          "text": "08:10 PM · Grand Ballroom. Champagne glasses clink for Father’s 60th birthday. Your phone buzzes.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n02"
        },
        {
          "id": "n02",
          "type": "text",
          "sender_id": "stranger",
          "text": "Nice speech, {{player_name}}. Tell Dad I brought back the gold Patek he left on my mother’s nightstand twenty-six years ago.",
          "timestamp_label": "08:10 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n03"
        },
        {
          "id": "n03",
          "type": "text",
          "sender_id": "player",
          "text": "Who is this? How did you get my private number?",
          "timestamp_label": "08:11 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "text",
          "sender_id": "stranger",
          "text": "Table 4, black tuxedo. 99.94% paternity match certified by Geneva Labs. Happy birthday to our dad.",
          "timestamp_label": "08:12 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n05"
        },
        {
          "id": "n05",
          "type": "unsent_message",
          "sender_id": "father",
          "text": "Wire Julian $500k tonight and tell security to escort him out the service exit before {{player_name}} sees him!",
          "unsent_placeholder": "Father unsent a message",
          "reveal_ms": 1900,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n06"
        },
        {
          "id": "n06",
          "type": "voice_note",
          "sender_id": "mother",
          "duration_sec": 13,
          "transcript": "[trembling] {{player_name}}, don't look at Table 4. I've known about Julian since you were five. Your father swore he would stay in Europe forever.",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n07"
        },
        {
          "id": "n07",
          "type": "choice",
          "prompt": "Julian raises his glass toward you from Table 4. What do you do?",
          "options": [
            {
              "option_id": "opt_meet_balcony",
              "label": "Text him to meet on the terrace",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "West terrace. Two minutes. Don’t ruin my mother’s night.",
              "next_node_id": "n08_free"
            },
            {
              "option_id": "opt_check_background",
              "label": "Check who actually invited him here",
              "cost_type": "vip_rewarded",
              "badge_text": "Intel · Watch Ad",
              "player_reply_text": "Before I talk to you—who gave you a VIP seat at Table 4?",
              "next_node_id": "n08_vip"
            }
          ]
        },
        {
          "id": "n08_free",
          "type": "text",
          "sender_id": "stranger",
          "text": "Fair enough. I’m not here to hurt your mom. I’m here because Dad is about to sell the company to sharks.",
          "timestamp_label": "08:15 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n10_merge"
        },
        {
          "id": "n08_vip",
          "type": "narrator",
          "text": "SECRET INTEL: Table 4 was booked by your Father’s own CFO—who wants to use Julian to split the family voting shares!",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "n09_vip"
        },
        {
          "id": "n09_vip",
          "type": "text",
          "sender_id": "stranger",
          "text": "Smart. Your CFO flew me in to start a war. Meet me on the terrace before he makes his move.",
          "timestamp_label": "08:15 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n10_merge"
        },
        {
          "id": "n10_merge",
          "type": "text",
          "sender_id": "father",
          "text": "{{player_name}}, step on stage now. I am announcing your succession before dessert.",
          "timestamp_label": "08:17 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n11_end"
        },
        {
          "id": "n11_end",
          "type": "cliffhanger",
          "headline": "The Spotlight Trap",
          "teaser_text": "Episode 2: As Father grabs the microphone, Julian walks straight toward the stage with a microphone of his own.",
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Two Heirs, One Stage",
      "start_node_id": "n01",
      "default_ambient": "heartbeat",
      "nodes": [
        {
          "id": "n01",
          "type": "narrator",
          "text": "08:22 PM · Ballroom Stage. Three hundred guests watch. Julian stops right beside the podium.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n02"
        },
        {
          "id": "n02",
          "type": "text",
          "sender_id": "stranger",
          "text": "Trust me for thirty seconds, {{player_name}}. Look at who is smiling at Table 1—your CFO.",
          "timestamp_label": "08:22 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n03"
        },
        {
          "id": "n03",
          "type": "text",
          "sender_id": "father",
          "text": "Security! Get this man off the stage!",
          "timestamp_label": "08:23 PM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "n04"
        },
        {
          "id": "n04",
          "type": "unsent_message",
          "sender_id": "mother",
          "text": "Richard stop! If the press sees security drag him out, the stock drops 30% tomorrow!",
          "unsent_placeholder": "Mother unsent a message",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "n05"
        },
        {
          "id": "n05",
          "type": "voice_note",
          "sender_id": "stranger",
          "duration_sec": 10,
          "transcript": "[low voice] I recorded the CFO offering me $4 million to file a lawsuit freezing the company tonight. Say the word and I drop it.",
