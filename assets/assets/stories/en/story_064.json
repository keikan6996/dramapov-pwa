            {
              "option_id": "opt_expose_cfo",
              "label": "Play the CFO bribery clip over the PA",
              "cost_type": "vip_rewarded",
              "badge_text": "Power Play · Watch Ad",
              "player_reply_text": "Actually, let’s toast to loyalty—starting with our CFO’s private phone call last night.",
              "next_node_id": "n07_vip"
