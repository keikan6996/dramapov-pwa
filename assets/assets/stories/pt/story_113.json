          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "brad_ex",
          "text": "Ora, ora! Olha quem ainda está servindo mesas, {{player_name}}! Ainda bem que te larguei ano passado — o pai da Stella é dono de três fábricas têxteis!",
