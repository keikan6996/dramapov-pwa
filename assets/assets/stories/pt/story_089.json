          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "sora",
          "text": "O QUÊ?! Deixa o brilho da tela no mínimo para ele não te ver digitando no espelho! Você conferiu a placa quando entrou?!",
