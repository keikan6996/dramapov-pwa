      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "01h42 · RECIBO RIDESAFE: Obrigado por viajar com Victor! Sua viagem terminou à 01h30. Avaliar com 5 estrelas?",
