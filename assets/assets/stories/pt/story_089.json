          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "Sora, EU AINDA estou no banco de trás deste sedã! Ele falsificou o aplicativo para encerrar a corrida antes e acabou de entrar no contorno industrial!",
