              "cost_type": "vip_rewarded",
              "badge_text": "Segredo · Ver Anúncio",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Os nós dos dedos do motorista ficam brancos no volante. Ele reduz por dois segundos — depois ri frio e apaga os faróis por completo.",
