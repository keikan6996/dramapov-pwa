          "typing_delay_ms": 600,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "brad",
          "text": "Seu pai trabalha de ENTREGADOR?! Credo! Não admira que tenham recusado nosso dote de $500.000! Este casamento está cancelado a menos que paguem hoje à noite!",
          "timestamp_label": "18:12",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "brad",
          "text": "Ainda bem que meu primo Victor está trazendo o Rolls-Royce do chefe bilionário dele para assustar esses caipiras.",
          "unsent_placeholder": "Brad apagou uma mensagem",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Brad chuta a caixa de veludo pelo piso de mármore:",
          "options": [
            {
              "option_id": "opt_story_103_e1_free",
              "label": "Proteger Emily e pegar a escritura calma",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Emily, não chore. Vamos ver o que o \"tio bilionário\" deles diz.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_103_e1_vip",
              "label": "Chamar seu motorista Victor pra encostar",
              "cost_type": "vip_rewarded",
              "badge_text": "Segredo · Ver Anúncio",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Você sacode a poeira da escritura imobiliária carimbada lá dentro — avaliada em $28 milhões — e a guarda com calma.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "brad",
          "text": "Ainda rondando por aqui? Espera o Tio Victor chegar no Phantom dele — ele vai mandar prender você por invasão!",
          "timestamp_label": "18:12",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Você aperta a discagem rápida 1. Do lado de fora do saguão de vidro, um comboio de seis Rolls-Royces pretos desliza e para.",
