          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "victor",
          "text": "Bem do lado de fora das portas principais, Presidente {{player_name}}. Espera — o Brad é o parente que implorou emprestado meu terno reserva?!",
