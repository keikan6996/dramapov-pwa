          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Brad abre um sorriso orgulhoso quando as portas principais se abrem e um homem alto em um smoking impecável entra.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "brad",
          "text": "Tio Victor! Dá uma lição nesse entregador folgado — ele ousou invadir o noivado do meu filho!",
          "timestamp_label": "18:15",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
