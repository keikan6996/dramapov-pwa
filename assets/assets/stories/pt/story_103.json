      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "18h10 · Hotel Grand Harbor. Querendo testar os futuros sogros da sua filha, você chega com um casaco desbotado de entregador carregando uma caixa vermelha de veludo com uma escritura.",
          "style": "banner",
          "sfx": "knock",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "brad",
          "text": "Quem deixou um entregador suado entrar no salão VIP de noivado?! Tire essa caixa de papelão barata da minha mesa!",
          "timestamp_label": "18:10",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "emily",
          "text": "Sr. Brad, pare! Essa pessoa é meu pai/minha mãe, {{player_name}}! Por favor não—",
