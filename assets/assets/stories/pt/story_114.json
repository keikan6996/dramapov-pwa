          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Vanessa, destranque este elevador agora mesmo! Esse passe está registrado na minha biometria — e o interfone de emergência está morto!",
