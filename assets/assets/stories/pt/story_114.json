          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "chairman",
          "text": "Grand Obsidian?! Elevador de Serviço B?! Aguenta firme — estou literalmente lá em cima. Destrancando seu elevador em 30 segundos!",
          "timestamp_label": "19:52",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Seu SOS sussurrado envia bem quando o sinal zera — e segundos depois, o alto-falante de emergência acima ganha vida com um estalo!",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "chairman",
          "text": "Aqui é o Presidente Julian do Grupo Obsidian! Engenharia, assumam o Elevador B AGORA — e detenham quem estiver com o passe #007!",
