      "episode_number": 1,
      "title": "Pedido Que Você Nunca Fez",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "03h07 · Trovões sacodem sua quitinete no 5º andar. Uma notificação do aplicativo de entregas toca.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Oi {{player_name}}, pendurei seu macarrão no portão. Fala para a sua colega de quarto atrás da cortina parar de me encarar, cara.",
          "timestamp_label": "03:07",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Espera—não pedi comida hoje à noite. E moro completamente sozinha.",
          "timestamp_label": "03:08",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "Ela está abrindo a trava da sua sacada agora mesmo.",
          "unsent_placeholder": "Esta mensagem foi apagada",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "Para de brincar! O pedido está no SEU nome e pago em dinheiro—ela jogou uma nota amassada lá do 5º andar!",
          "timestamp_label": "03:09",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 10,
          "transcript": "[chuva pesada, moto acelerando] ...Espera, ouça a gravação da chamada quando você confirmou o pedido—essa É a sua voz...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "Sua cortina fina da sacada ondula para dentro—mesmo com a porta de vidro fechada.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Perguntar a Leo como era a nota de dinheiro",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Que tipo de nota ela jogou?",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "Tocar o áudio completo da confirmação",
              "cost_type": "vip_rewarded",
              "badge_text": "Segredo · Ver Anúncio",
              "player_reply_text": "Me mande o arquivo completo de áudio!",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "Leo responde tremendo: \"Não é dinheiro de verdade, {{player_name}}... É nota de papel fúnebre. Queimada na ponta.\"",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SEGREDO DESBLOQUEADO: Sob sua própria voz sonolenta pedindo macarrão, uma segunda voz sussurra: \"Duas tigelas. Uma para os vivos.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "Cara estou saindo daqui, boa sorte—espera, por que a sacola plástica NÃO está mais no seu portão?!",
          "timestamp_label": "03:11",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "Ligação Automática de Entrega",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "Uma voz metálica recita: \"Seu pedido foi recebido... dentro da sua cozinha.\" Uma colher tilinta no cômodo ao lado.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "Você desliga. Na hora, o cheiro de caldo frio e incenso molhado entra por baixo da porta do seu quarto.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "Jantar Para Dois",
          "teaser_text": "Episódio 2: Duas tigelas fumegantes estão na sua mesa—e uma cadeira está puxada para fora.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
