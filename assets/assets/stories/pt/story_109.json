        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Você assina com firmeza, rasga o cheque ao meio e deixa os pedaços caírem sobre os sapatos de grife de Nathan.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "nathan",
          "text": "Como quiser! Amanhã eu vou agradecer pessoalmente à Presidente do St. Jude — com a Fiona como minha noiva!",
