          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "director",
          "text": "Presidente {{player_name}}, sua dose final de estabilizador neural para Nathan está marcada para amanhã. Devemos cancelar a isenção beneficente VIP dele?",
