          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Você envia uma mensagem codificada ao Diretor do Hospital, Dr. Ken. Em segundos, um arquivo criptografado apita no seu celular.",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "director",
          "text": "Presidente {{player_name}}, puxei a entrada do pronto-socorro de 3 anos atrás — o carro da fuga bate com a placa registrada em nome de Fiona!!",
