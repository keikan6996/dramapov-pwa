          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "devon",
          "text": "Aguenta firme, {{player_name}}. Checando o registro de energia... Estranho. Só o Poço 04 perdeu força, e meu terminal de crachás diz que não há mais ninguém na torre.",
