          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "player",
          "text": "Como ele conseguiu meu número de celular?! Ninguém sabe que estou carregando o pendrive de denúncia hoje à noite!",
