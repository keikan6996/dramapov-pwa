          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "devon",
          "text": "NÃO saia rastejando ainda! Se ele soltar o freio pelo teto, a cabine vai partir ao meio!",
          "timestamp_label": "01:20",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "unsent_message",
          "sender_id": "hatch",
          "text": "Passe o pendrive da auditoria pela escotilha, {{player_name}}, que eu não corto o cabo principal.",
