          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "devon",
          "text": "Meu Deus — estou vendo ele na câmera térmica do poço! Ele está carregando uma chave inglesa e um kit de abraçadeiras. Estou ligando para o 190!",
          "timestamp_label": "01:20",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Você força a porta interna abrindo sete centímetros. Uma parede de concreto bloqueia a metade superior, mas o corredor escuro do 38º andar está logo abaixo dos seus joelhos.",
