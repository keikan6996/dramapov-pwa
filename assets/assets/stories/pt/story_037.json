          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Luan, acabei de abrir o cofre da Vovó! Tem um envelope vermelho com uma regra: cubra o retrato do Quarto Leste com o lençol de veludo antes das 00h00!",
