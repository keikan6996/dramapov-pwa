          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Estou no Quarto Leste agora mesmo... Owen, o lençol de veludo já está no chão. E a tela pintada está completamente EM BRANCO.",
