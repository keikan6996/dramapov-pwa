        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "r409",
          "text": "Puxe o disjuntor vermelho escrito \"BLOQUEADOR DE CELULAR\"! Assim que cair, meu sinalizador de emergência vai direto para a Polícia Rodoviária!",
          "timestamp_label": "23:43",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
