          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n08_vip"
        },
        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "clerk",
          "text": "Vocês quebraram o bloqueador?! Arrumem a van — policiais estaduais já estão saindo da interestadual!",
