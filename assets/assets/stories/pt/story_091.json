        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "Você e Mara despencam quatro andares sobre uma pilha de lençóis úmidos do motel na sala da caldeira do porão — bem ao lado do quadro destrancado de disjuntores do atendente.",
          "style": "system_alert",
