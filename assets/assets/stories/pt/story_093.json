          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Um estrondo mecânico profundo sacode as paredes do túnel. Água fria do rio começa a avançar pelo leito escuro de concreto dos trilhos lá fora.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "cab",
          "text": "Três minutos até o terceiro trilho entrar em curto. Entregue o celular do Píer 6, Hannah.",
