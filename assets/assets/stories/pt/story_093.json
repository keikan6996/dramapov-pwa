          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Seu leitor Bluetooth detecta um aparelho ativo a 3,5 metros dentro do Vagão 3: \"CONTROLE_TRENS_01.\" O executivo no canto de trás não é um passageiro comum.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "Hannah, não se vire — o sequestrador está sentado bem atrás de nós no Vagão 3 controlando o trem remotamente!",
