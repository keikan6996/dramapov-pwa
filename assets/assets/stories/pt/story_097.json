          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "u77",
          "text": "Se o lacre de violação romper, a carga interna não é tinta — é termita.",
          "unsent_placeholder": "UNIDADE-77 apagou uma mensagem",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "O portão da frente do depósito apita abrindo no leitor de Marco:",
          "options": [
            {
              "option_id": "opt_097_e1_free",
              "label": "Deixar a maleta e fugir pelo beco lateral",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Esquece os US$ 400, Marco — pega o corta-vergalhão e corre para a caminhonete!",
