            },
            {
              "option_id": "opt_097_e1_vip",
              "label": "Escanear o código de barras na maleta",
              "cost_type": "vip_rewarded",
              "badge_text": "Segredo · Ver Anúncio",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Você corre para a picape de Marco — só para ver uma van preto fosco deslizar silenciosa pela pista de saída, bloqueando seu para-choque.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "marco",
          "text": "Estamos cercados!! Espera — por que o gerente do complexo acabou de sair e acenou para a van ir direto para a Fileira C?!",
          "timestamp_label": "20:50",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Você escaneia o número de série gravado a laser. Não é dinheiro roubado — é uma matriz de impressão do Tesouro Federal dada como desaparecida num assalto a carro-forte no inverno passado.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "marco",
          "text": "Uma matriz de impressão do Tesouro?! Isso vale vinte milhões no mercado negro — não admira que já estejam no portão!",
          "timestamp_label": "20:50",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "voice_note",
          "sender_id": "u77",
          "duration_sec": 7,
          "transcript": "[pneus da van rangendo no cascalho] \"Não corra, Cris. Nossos homens acabaram de trancar a cerca do perímetro. Venham para a luz com as mãos ao alto.\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "Faróis inundam a Fileira C, prendendo você entre duas fileiras de portas de aço. Marco sussurra: \"A Unidade 78 ao lado tem um cadeado enferrujado — dá para cortar o gesso!\"",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "Presos na Fileira C",
          "teaser_text": "Três homens armados acabaram de descer da van preta — e o gerente do depósito está ajudando a caçar vocês.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
