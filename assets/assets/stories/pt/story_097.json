      "title": "Maleta Algemada",
      "start_node_id": "e1_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "20h47 · Complexo de Depósitos SafeKeep. Você ergue a porta de aço ondulada da Unidade 77. Lá dentro há apenas uma maleta de titânio — algemada a um celular via satélite aceso.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "marco",
          "text": "Uau!! Pagamos US$ 400 por essa unidade e tem uma maleta militar lá dentro?! Arromba logo, Cris!",
          "timestamp_label": "20:47",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Espera — no momento em que tirei foto da maleta, o celular algemado vibrou com uma mensagem.",
          "timestamp_label": "20:48",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "u77",
          "text": "Pouse a maleta e feche a porta de aço, Cris. O sensor de movimento acabou de disparar uma coleta de 10 minutos.",
