    {
      "episode_number": 1,
      "title": "$10,000 का बायआउट",
      "start_node_id": "e1_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "शाम 6:00 · सेंट जूड प्राइवेट हॉस्पिटल वीआईपी विंग। आपकी तीन साल की गुप्त न्यूरो-रिहैब के बाद जिस दिन नेथन पहली बार बिना सहारे चलता है, वह आपकी गोद में $10,000 का चेक डाल देता है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "nathan",
          "text": "$10,000 लो और तलाक़ पर साइन करो, इशिता। फ़ियोना विदेश से लौट आई है—उसी ने चुपके से मेरे चमत्कारी सर्जन के पैसे दिए थे!",
          "timestamp_label": "शाम 6:00",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "फ़ियोना ने तुमसे कहा कि उसने चमत्कारी न्यूरोसर्जन के पैसे दिए?! नेथन, मेरे हाथ देखो—तीन साल तक हर रात मैंने तुम्हारे पैरों की मालिश की!",
          "timestamp_label": "शाम 6:00",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "fiona",
          "text": "ओह, पैरों की मालिश तो कोई भी केयरटेकर कर सकती है, इशिता। सेंट जूड मेडिकल ग्रुप की गुमनाम चेयरवुमन तक पहुँचने के संपर्क सिर्फ़ मेरे पास थे!",
          "timestamp_label": "शाम 6:02",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "fiona",
          "text": "भगवान का शुक्र है नेथन ने कभी उस रात का डैशकैम नहीं देखा जब उसे लकवा लगा था...",
          "unsent_placeholder": "फ़ियोना ने एक मैसेज अनसेंड किया",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "नेथन, फ़ियोना की कमर पर हाथ रखता है और ताने से मुस्कुराता है:",
          "options": [
            {
              "option_id": "opt_story_109_e1_free",
              "label": "तलाक़ साइन कर $10,000 चेक फाड़ दें",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "अपने $10,000 रखो। अगले मेडिकल बिल के लिए तुम्हें इसकी ज़रूरत पड़ेगी।",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_109_e1_vip",
              "label": "डॉ. केन को 3-साल पुरानी क्रैश फ़ाइल कहें",
              "cost_type": "vip_rewarded",
              "badge_text": "राज़ · विज्ञापन देखें",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "आप सफ़ाई से साइन करती हैं, चेक को आधे में फाड़ देती हैं, और टुकड़ों को नेथन के डिज़ाइनर जूतों पर गिरने देती हैं।",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "nathan",
          "text": "जैसी तुम्हारी मर्ज़ी! कल मैं अपनी मंगेतर के रूप में फ़ियोना के साथ खुद सेंट जूड की चेयरवुमन को धन्यवाद दूँगा!",
          "timestamp_label": "शाम 6:02",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "आप अस्पताल प्रमुख डॉ. केन को एक कोडेड संदेश भेजती हैं। कुछ ही सेकंड में, एक एन्क्रिप्टेड आर्काइव आपके फ़ोन पर बजता है।",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "director",
          "text": "चेयरवुमन इशिता, मैंने 3-साल पुराना इमरजेंसी रिकॉर्ड निकाला—हिट-एंड-रन कार फ़ियोना की पंजीकृत नंबर प्लेट से मेल खाती है!!",
          "timestamp_label": "शाम 6:02",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "जैसे ही आप वीआईपी कमरे से बाहर आती हैं, डॉ. केन गलियारे में दौड़ते हुए आते हैं और गहरा झुकते हैं—ठीक वहाँ जहाँ नेथन अभी देख नहीं सकता।",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "director",
          "text": "चेयरवुमन इशिता, नेथन के लिए आपकी आख़िरी नर्व-स्टेबलाइज़र खुराक कल तय है। क्या हम उसकी वीआईपी चैरिटी छूट रद्द कर दें?",
          "timestamp_label": "शाम 6:05",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
