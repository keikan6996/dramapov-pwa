        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "चमत्कारी सर्जन",
          "teaser_text": "नेथन ने उस गुप्त अरबपति सर्जन को छोड़ दिया जिसने उसके पैर बचाए—ताकि उसी औरत से शादी करे जिसने तीन साल पहले उस पर गाड़ी चढ़ाई थी।",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
