          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "राज़ खुला: कांच चकनाचूर हो जाता है, जिसके पीछे कंक्रीट पर खुरचा हुआ एक गुप्त संदेश दिखता है: \"इसे कभी अनदेखा मत छोड़ना।\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "एक सेकंड रुको... रोहन, तुम अभी लॉन्ड्री बास्केट लिए दूसरी मंज़िल पर मेरे दरवाज़े के पास से गुज़री हो। मैं किसे टेक्स्ट कर रहा हूँ?!",
          "timestamp_label": "रात 2:45",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "रोहन (आपका अपना नंबर)",
