          "type": "choice",
          "prompt": "आपकी परछाईं अपनी हथेली उठाती है और दरार पड़े कांच के अंदर से सटा देती है।",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "आईने पर अपना गीला तौलिया डाल दें",
