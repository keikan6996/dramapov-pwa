        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "आप कॉल काटती हैं। तुरंत, बेसमेंट की सीढ़ियों का दरवाज़ा धड़ाम से बंद हो जाता है—और बाहर से डेडबोल्ट खिसककर लॉक हो जाता है।",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
