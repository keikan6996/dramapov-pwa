      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 2:14 · समंदर की हवा चट्टान पर बने विला की काँच की दीवारों को खड़खड़ाती है। किचन काउंटर पर एक भूला हुआ बेबी मॉनिटर चरमराकर चालू होता है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "voice_note",
          "sender_id": "ch02",
          "duration_sec": 6,
          "transcript": "[रेडियो स्टैटिक, शांत फुसफुसाहट] \"फ्रिज तक चार क़दम, {{player_name}}। अब चेक करो कि तुमने वाइन सेलर लॉक किया या नहीं।\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "क्लेयर!! पेरिस में तुम्हें जगाने के लिए माफ़ी—तुम्हारे बेबी मॉनिटर ने किचन में मुझे देख रहे किसी शख़्स की आवाज़ पकड़ी है!",
          "timestamp_label": "रात 2:14",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "claire",
          "text": "क्या?! हमारा कोई बच्चा है ही नहीं, {{player_name}}! हमने दो साल पहले ही वह नर्सरी फ़र्नीचर बेच दिया था—किचन से बाहर निकलो!",
          "timestamp_label": "रात 2:15",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "ch02",
          "text": "क्लेयर पर भरोसा मत करो। उससे पूछो नर्सरी वॉलपेपर के पीछे एक छुपी तिजोरी क्यों है।",
          "unsent_placeholder": "चैनल-02 स्टैटिक ने एक मैसेज अनसेंड किया",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "गलियारे में नीचे वाइन सेलर की कुंडी हल्के से क्लिक करती है:",
          "options": [
            {
              "option_id": "opt_094_e1_free",
              "label": "मास्टर पैनिक रूम में खुद को लॉक करें",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "मैं ऊपर के पैनिक रूम में जा रही हूँ—प्राइवेट सिक्योरिटी को कॉल करो!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_094_e1_vip",
              "label": "पालने के पीछे नर्सरी की दीवार जाँचें",
              "cost_type": "vip_rewarded",
              "badge_text": "राज़ · विज्ञापन देखें",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "आप भागकर ऊपर जाती हैं और स्टील के पैनिक-रूम का दरवाज़ा धड़ाम से बंद करती हैं—सिर्फ़ यह देखने के लिए कि अंदर सिक्योरिटी कैमरा स्क्रीन पर गलियारा ख़ाली दिख रहा है। घुसपैठिया पहले से दूसरी मंज़िल पर है।",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "claire",
          "text": "पैनिक रूम में हरा ओवरराइड बटन बिल्कुल मत छूना! सिक्योरिटी 8 मिनट दूर है!",
          "timestamp_label": "रात 2:17",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "आप पेस्टल वॉलपेपर का एक ढीला कोना उखाड़ती हैं। उसके नीचे दीवार में एक तिजोरी है—पूरी खुली हुई, जाली पासपोर्ट और साइलेंसर लगी पिस्तौल से भरी।",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "player",
          "text": "क्लेयर... इस दीवार के पीछे तुम्हारे पति के चेहरे वाले छह अलग-अलग पासपोर्ट क्यों छुपे हैं?!",
          "timestamp_label": "रात 2:17",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "बाहर की सारी फ़्लडलाइट्स झटके से बंद हो जाती हैं। बेबी मॉनिटर स्पीकर से, घुमावदार सीढ़ियों पर धीमे क़दम ऊपर चढ़ते सुनाई देते हैं।",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "ch02",
          "text": "क्लेयर से कह देना उसके पति के क़र्ज़ की मियाद निकल चुकी है, {{player_name}}। तिजोरी खोलो वरना मैं ऊपर आ रहा हूँ।",
          "timestamp_label": "रात 2:18",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "सिर्फ़ घर की रखवाली नहीं",
          "teaser_text": "क्लेयर ने आपको एक सेफ़हाउस की रखवाली के लिए रखा था—और उसके पति का शिकार करने वाले लोग अभी दूसरी मंज़िल पर आ चुके हैं।",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
