          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "ओह, तो तुम्हें अपने पापा के शेयरों के लिए सिर्फ मेरा सरनेम चाहिए था। अच्छा हुआ पता चल गया।",
          "timestamp_label": "शाम 7:31",
