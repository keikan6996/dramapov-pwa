      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "रात 7:30 · मोमबत्तियों से सजी मेज़ों के चारों ओर अस्सी मेहमान बैठे हैं। मेज़पोश के नीचे, रायन घबराकर आपको टेक्स्ट करता है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ryan",
          "text": "मेहर, प्लीज़। मेरे पापा आज रात के बाद कंपनी के शेयर हमारे नाम साइन कर रहे हैं। डिनर के बाद अकेले में बात करते हैं।",
