      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 2:52 · वॉर्ड B में सन्नाटा पसरा है। अचानक, कमरा 14 के ऊपर लाल बत्ती चमकती है और तीन बार घंटी बजती है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, मुझे सेंट्रल टैबलेट पर बेड 14 का अलर्ट दिख रहा है। बताओ कि यह वायरिंग की खराबी है।",
