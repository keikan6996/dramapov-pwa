          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "marissa",
          "text": "पेज 42 पर उस हिट-एंड-रन कार की नंबर प्लेट दिख रही थी—",
