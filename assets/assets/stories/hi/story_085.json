      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "35,000 फ़ीट · ज़्यूरिख जाने वाली फ़्लाइट 408। सीटबेल्ट साइन बंद होता है। आपके टोट बैग के अंदर, एक अनजान काला फ़्लिप-फ़ोन सैटेलाइट सिग्नल पर बजता है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ghost",
          "text": "यह फ़ोन फ़्लाइट क्रू को मत देना, {{player_name}}। सीट 14A को देखो।",
          "timestamp_label": "रात 11:14",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "तुम वही महिला हो जो गेट 19 पर मुझसे टकराई थी! तुमने यह मेरे बैग में क्यों डाला?!",
          "timestamp_label": "रात 11:14",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "ghost",
          "duration_sec": 8,
          "transcript": "[जेट इंजन की गूँज, फुसफुसाहट] 14A में बैठा आदमी एक चोरी किया हुआ बायोवेपन रजिस्टर ले जा रहा है। उसने मुझे टीएसए पर देख लिया था, इसलिए मुझे डिक्रिप्शन की एक साफ़ पैसेंजर—तुम्हारे—पास रखनी पड़ी।",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "ghost",
          "text": "चेतावनी: फ़्लाइट अटेंडेंट्स में से एक उसके पेरोल पर है। वर्दी में किसी पर भरोसा मत करना।",
          "unsent_placeholder": "घोस्ट-19 ने एक मैसेज अनसेंड किया",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "लीड अटेंडेंट एलेना काले फ़ोन को घूरते हुए आपकी पंक्ति के पास रुकती है:",
          "options": [
            {
              "option_id": "opt_085_e1_free",
              "label": "फ़ोन छुपाकर पानी माँगें",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "बस अपने ऑफ़लाइन नोट्स देख रही थी, शुक्रिया। क्या मुझे पानी मिल सकता है?",
