        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "एलेना विनम्रता से मुस्कुराती है और गलियारे में आगे बढ़ती है—तुरंत सीट 14A में बैठे आदमी के कान में फुसफुसाने के लिए रुकती है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "elena",
          "text": "[इन-फ़्लाइट चैट · क्रू] कृपया पिछली गैली में आइए, {{player_name}}। आपकी कस्टम्स घोषणा में कोई समस्या है।",
