          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "mrk",
          "text": "नाव पर कदम रखो, अवनि। बोर्ड पर कोई तुमसे मिलने के लिए तड़प रहा है।",
