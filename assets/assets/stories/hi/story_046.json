          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "रुको—आइवी ने मुझे 5:30 पर मैसेज किया था कि वह अभी भी प्रेप सेंटर के बेसमेंट के अंदर है।",
