      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 11:55 · तटीय ओरेगन। पोर्च की छत पर बारिश गिर रही है। 14 महीनों में पहली बार आपका एन्क्रिप्टेड विटनेस प्रोटेक्शन फ़ोन बजता है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "unsent_message",
          "sender_id": "vance",
          "text": "412 सीडर लेन पर टारगेट कन्फ़र्म। पोर्च की लाइट बंद। अंदर बढ़ रहे हैं।",
          "unsent_placeholder": "एजेंट वैंस ने एक मैसेज अनसेंड किया",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "वैंस?! मैंने वह मैसेज तुम्हारे अनसेंड करने से पहले ही देख लिया! तुम मेरा पता किसे भेज रहे हो?!",
          "timestamp_label": "रात 11:56",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "vance",
          "text": "शांत रहो, {{player_name}}! पोर्टलैंड फ़ील्ड ऑफ़िस में मेरा फ़ोन क्लोन हो गया—मैं तुम्हारे घर के बाहर नहीं हूँ! अपना गो-बैग उठाओ और भागो!",
          "timestamp_label": "रात 11:56",
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "cleanup",
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice",
          "text": "नया हेयरकट अच्छा है, {{player_name}}। कार्टेल ने सलाम भेजा है।"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "आपकी पिछली बाड़ के बाहर बजरी चरमराती है। तेज़ी से क़दम बढ़ाएँ:",
          "options": [
            {
              "option_id": "opt_087_e1_free",
              "label": "तहख़ाने के स्टॉर्म डोर से खिसक जाएँ",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "मैं तहख़ाने के दरवाज़े से निकल रही हूँ—हार्बर रोड की ओर जा रही हूँ!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_087_e1_vip",
              "label": "एन्क्रिप्टेड फ़ोन को चकमा देने को छोड़ दें",
