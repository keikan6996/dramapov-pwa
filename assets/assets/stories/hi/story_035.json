        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "कैमरा आपका ही अंधेरा पिछला आँगन दिखाता है—जो लगातार आपके पीछे वाले स्लाइडिंग काँच के दरवाज़े के करीब आता जा रहा है।",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "आप कॉल काट देते हैं। तुरंत, नीचे के हर बल्ब की रोशनी हल्की नारंगी होकर मद्धम पड़ जाती है।",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
