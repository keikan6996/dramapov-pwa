          "headline": "वो आँगन में है",
          "teaser_text": "एपिसोड 2: गीली राख के पैरों के निशान ठीक पूर्वजों की वेदी वाले कमरे के बाहर रुकते हैं।",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
