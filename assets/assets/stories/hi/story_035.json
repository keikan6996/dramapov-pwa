          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "राज़ खुला: इनवाइट लिंक रात 11:59 बजे ठीक आपके अपने फ़ोन से बना था—जब आपकी स्क्रीन लॉक थी।",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "नंबर 000 अपने आप फिर से ग्रुप में जुड़ गया! और उसने अभी ग्रुप का नाम बदलकर \"दरवाज़ा खोलो\" कर दिया है।",
          "timestamp_label": "रात 12:05",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
