      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 12:01 · भूत माह की पहली रात। फैमिली चैट में सिस्टम नोटिस: \"नंबर 000 इनवाइट लिंक से जुड़ा।\"",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "कोई नंबर 000 को रिमूव मत करना!! रोहन, अभी अपने पर्दे बंद कर ले! अगर उसे ग्रुप से निकाला, तो वो मेन गेट पर दस्तक देगा!",
          "timestamp_label": "रात 12:01",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "दादी, ये बस कोई स्पैम बॉट है… रुको, इसके पास बगीचे से खींची हमारे पुश्तैनी घर की फोटो कहाँ से आई?!",
          "timestamp_label": "रात 12:02",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "तुम वेदी पर मेरे चावल का कटोरा रखना भूल गए।",
          "unsent_placeholder": "यह मैसेज वापस ले लिया गया",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "हे ईश्वर रक्षा करना… तुम्हारे दादाजी के बिछड़े भाई! आज रात हम उनकी बरसी की धूप जलाना भूल गए!",
          "timestamp_label": "रात 12:03",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[धूप की चटक, लोहे के गेट की खड़खड़ाहट] ...मुझे अंदर आने दो, रोहन... मैं इतनी दूर चलकर घर आया हूँ...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "आपका कज़िन ग्रुप चैट में \"सदस्य हटाएँ\" दबाता है। सामने का लोहे का गेट ज़ोर से भड़कता है।",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "वेदी पर तीन धूप की बत्तियाँ जलाएँ",
