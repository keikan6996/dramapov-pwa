      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 12:48 · आप किचन का नल खोलते हैं। पानी मटमैला भूरा निकलता है, और उसमें एक लंबा काला बाल बहकर आता है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, मैं अभी छत की टंकी जाँचने ऊपर चढ़ा। आज रात नल का पानी पीना या ब्रश करना बिल्कुल मत!",
          "timestamp_label": "रात 12:48",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "बहुत देर हो गई, रंग देखने से पहले ही मैं आधा गिलास पी चुकी हूँ! टंकी के अंदर क्या है?!",
          "timestamp_label": "रात 12:49",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "अब मैं तुम्हारे अंदर हूँ, {{player_name}}।",
