          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "आपका किचन का नल अपने आप ज़ोर से खुल जाता है और सिंक भरने लगता है।",
          "options": [
            {
              "option_id": "e1_opt_free",
