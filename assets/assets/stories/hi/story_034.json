          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "मैं टॉर्च लेकर ढक्कन पर झुका ही था कि पीली उँगलियां ऊपर उठीं और उसे अंदर खींच ले गईं! मैं पुलिस को बुला रहा हूँ!",
          "timestamp_label": "रात 12:50",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[पानी के अंदर दबी बुदबुदाहट, छपाक] ...मदद... छत का ढक्कन बहुत भारी है... {{player_name}}...",
