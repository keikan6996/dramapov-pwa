        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 11,
          "transcript": "[फर्श के तख्तों की चरमराहट, बेसुरी धीमी लोरी] ...सो जा नन्हे मुसाफिर, दीवार बहुत पतली है...",
