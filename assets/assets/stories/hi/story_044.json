          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05",
          "ambient": "heartbeat"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "player",
          "text": "मार्को, तुम्हारे टैबलेट का पासकोड किसे पता था? तुमने उसे ब्राइडल सुइट में छोड़ा था।",
          "timestamp_label": "रात 8:17",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "unsent_message",
          "sender_id": "chloe",
          "text": "मैंने बालकनी वाला शॉट सिर्फ़ इसलिए डिलीट किया क्योंकि एलेना परेशान दिख रही थी—",
          "unsent_placeholder": "यह मैसेज वापस ले लिया गया",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "text",
          "sender_id": "evan",
          "text": "क्लोई?! तुमने बालकनी की फोटो डिलीट कीं?! एलेना बालकनी में किससे बात कर रही थी?",
