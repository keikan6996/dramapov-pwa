          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "chloe",
          "text": "उसका घूँघट और फ़ोन अभी भी वैनिटी पर रखे हैं। वो यूँ नंगे पाँव नहीं भागेगी!",
