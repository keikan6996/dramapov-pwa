          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "marco",
          "text": "अरे… यार? किसी ने अभी मेरे बैकअप टैबलेट में लॉग इन करके शाम 7:30 से 8:00 बजे तक की हर फोटो डिलीट कर दी।",
