      "title": "खरोंच का झूठा इल्ज़ाम",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "शाम 7:00 · मोनार्क कंट्री क्लब। अपने 8 बजे के निवेशक डिनर से पहले लाल जैकेट में अपने पुराने गुरु के वैले स्टैंड की मदद करते हुए, आप देखते हैं Trent जानबूझकर अपनी ही फ़ेंडर पर चाबी से खरोंच मारता है!",
          "style": "banner",
          "sfx": "knock",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "trent",
          "text": "अरे!! देखो इस अनाड़ी वैले ने मेरी $3M की हाइपरकार का क्या हाल किया!! अभी नक़द $150,000 दो वरना मैं तुम्हें जेल में डाल रहा हूँ!",
          "timestamp_label": "शाम 7:00",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "दो सेकंड पहले तुमने खुद अपनी घड़ी के बकल से फ़ेंडर पर खरोंच मारी थी, Trent। क्यों? जुए का बिल भरने को तुरंत कैश चाहिए?",
          "timestamp_label": "शाम 7:00",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "trent",
          "text": "अपना मुँह बंद रखो! मेरे डैड ठीक अभी अंदर Apex Capital के चेयरमैन के साथ $50M का लोन बंद कर रहे हैं! घुटनों पर बैठकर मेरा बंपर पॉलिश करो!",
          "timestamp_label": "शाम 7:02",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "trent",
          "text": "एक बार वैले क्लब $150K का बीमा दावा भर दे, डैड को पता चलने से पहले मेरा वेगास का क़र्ज़ उतर जाएगा!",
          "unsent_placeholder": "Trent ने एक मैसेज अनसेंड किया",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Trent आपको फ़ुटपाथ पर धक्का देने के लिए अपनी चाबियाँ उठाता है:",
          "options": [
            {
              "option_id": "opt_story_110_e1_free",
              "label": "एक तरफ़ हटें व गेट CCTV दिखाएँ",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "संभलकर, Trent। गेट के कैमरे ने अभी तुम्हारी घड़ी को पेंट खुरचते पकड़ लिया।",
              "next_node_id": "e1_n07_free"
