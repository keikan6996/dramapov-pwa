        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Trent नाक-भौं सिकोड़ता है और एक ट्रैफ़िक कोन को लात मारता है, इस भरोसे में कि कोई उसके अरबपति पिता से टकराने की हिम्मत नहीं करेगा।",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "trent",
          "text": "इस पूरे क्लब का आधा हिस्सा मेरे डैड का है! मैनेजर दस सेकंड में वह टेप डिलीट कर देगा!",
