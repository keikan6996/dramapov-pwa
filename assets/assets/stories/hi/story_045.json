          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "priya",
          "text": "लाइट जाने से ठीक पहले वह कमरा 1408 की इंसुलिन ड्रिप लेने फ़ार्मेसी गई थी।",
