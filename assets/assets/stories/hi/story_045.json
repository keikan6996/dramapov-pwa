          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n05",
          "ambient": "heartbeat"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "keller",
          "text": "मैंने उससे चार्ट ऑडिट लॉग देखने को कहा था, फ़ार्मेसी नहीं—",
          "unsent_placeholder": "यह मैसेज वापस ले लिया गया",
          "reveal_ms": 1750,
          "typing_delay_ms": 750,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "priya",
          "text": "डॉ. केलर? कौन सा चार्ट ऑडिट? हमें किसी ऑडिट के बारे में नहीं बताया गया।",
          "timestamp_label": "रात 2:20",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "voice_note",
          "sender_id": "grant",
          "duration_sec": 10,
          "transcript": "[स्टैटिक, बैकग्राउंड में दबी आवाज़] {{player_name}}, मैं मालवाहक लिफ़्ट B के पास हूँ! नोरा दरवाज़े पर पीट रही है—वह कह रही है कि किसी ने इमरजेंसी फ़ोन काट दिया!",
