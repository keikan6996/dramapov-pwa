        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "आपके बिस्तर के बगल के गलीचे पर नंगे पैर हल्के से धम्म करते हैं। रजाई के ठीक ऊपर कोई हवा सूँघता है।",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "राज़ खुला: आखिरी बारह पन्ने आपकी ही लिखावट से भरे हैं—सब पर कल की तारीख: \"मैं कभी चेक आउट नहीं कर पाई।\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "रुको—स्मार्ट-लॉक ऐप ने मुझे अभी क्यों बताया कि तुम्हारे केबिन का दरवाज़ा अंदर से लॉक हो गया?",
          "timestamp_label": "रात 1:09",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "केबिन लैंडलाइन (अटारी एक्सटेंशन)",
          "ringtone_sfx": "call_ring",
