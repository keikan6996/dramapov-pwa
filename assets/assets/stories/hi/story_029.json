        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "एक काँपती आवाज़ चेतावनी देती है: \"मार्गों इसे खाना खिलाने के लिए यह केबिन किराए पर देती है! हैच पूरा खुलने से पहले भागो!\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "आप कॉल काटती हैं। तुरंत, गेस्टबुक के नीचे से एक नोट सरककर बाहर आता है: \"मार्गों मेज़बान नहीं है। उसकी लिस्टिंग फोटो देखो।\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "चेक-आउट का समय: कभी नहीं",
          "teaser_text": "एपिसोड 2: अटारी की सीढ़ी धड़ाम से पूरे फर्श तक नीचे आ गिरती है।",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
