      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 1:04 · पहाड़ी तूफ़ान में केबिन की खिड़कियों से चीड़ की डालियाँ टकराती हैं। आपके बिस्तर के ऊपर लकड़ी के तख्ते कराहते हैं।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "हाय {{player_name}}, देर से टेक्स्ट के लिए माफ़ी! मैं नियम #7 भूल गई थी: अगर रात 1 बजे के बाद अटारी का हैच चरमराए, तो सारी लाइटें बंद कर देना और ऊपर बिल्कुल मत देखना।",
          "timestamp_label": "रात 1:04",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "माफ़ कीजिए?! एक बंद अटारी में कुछ क्यों हिल रहा है?! क्या ऊपर कोई बिना इजाज़त घुसा हुआ है?",
          "timestamp_label": "रात 1:05",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "वह कोई इंसान नहीं है। और उसे चमकती स्क्रीन से नफ़रत है।",
          "unsent_placeholder": "यह मैसेज वापस ले लिया गया",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "अभी अपनी स्क्रीन की ब्राइटनेस कम करो! और चाहे जो हो, नाइटस्टैंड पर रखी चमड़े की गेस्टबुक बिल्कुल मत खोलना।",
          "timestamp_label": "रात 1:06",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[लकड़ी का हैच धीरे से सरकना, खरखराती फुसफुसाहट] ...क्या तुम नीचे जाग रही हो, {{player_name}}? गेस्टबुक पर साइन करो...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "अटारी की सीढ़ी छत के हैच से दो इंच नीचे सरकती है।",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "कंबल में छिपें और फ़ोन की रोशनी कम करें",
