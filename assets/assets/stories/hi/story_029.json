              "player_reply_text": "रजाई के नीचे छिप रही हूँ...",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "चमड़े की गेस्टबुक पलटकर खोलें",
              "cost_type": "vip_rewarded",
