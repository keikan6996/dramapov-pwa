      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 10:52 · -14°F बर्फ़ीला तूफ़ान। ज़ीरो सेल बार। आपका ऑफ़लाइन हाइकिंग ऐप बजता है: \"ब्लूटूथ मेश से पीयर जुड़ा — दूरी: 15 फ़ीट।\"",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "btnode",
          "text": "प्लीज़ पोर्च का दरवाज़ा खोलो, किरण! मेरी स्नोमोबाइल बर्फ़ में पलट गई—मैं यहाँ बाहर ठंड से मर रही हूँ!",
          "timestamp_label": "रात 10:52",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "रुको... तुम्हें मेरा नाम कैसे पता?! मैंने केबिन 12 अपनी बुकिंग पर लिया था!",
          "timestamp_label": "रात 10:53",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "cole",
          "duration_sec": 7,
          "transcript": "[खड़खड़ाता वीएचएफ़ रिले] केबिन 12, मैं रेंजर कोल बोल रहा हूँ! किसी को भी अंदर मत आने देना! दो घंटे पहले हाईवे 89 पर एक सरकारी क़ैदी प्रिज़न वैन से भाग निकला है!",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "btnode",
          "text": "तुम्हारी गेस्टबुक मेलबॉक्स में पड़ी थी, किरण। अब बिजली की लाइन काटने से पहले दरवाज़ा अनलॉक करो।",
          "unsent_placeholder": "बीटी_नोड_01 ने एक मैसेज अनसेंड किया",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "बर्फ़ जमे पोर्च के दरवाज़े पर भारी मुक्के पड़ते हैं:",
          "options": [
            {
              "option_id": "opt_098_e1_free",
              "label": "दरवाज़ा अड़ाकर फ़ायरप्लेस रॉड थामें",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "रेंजर कोल, वह ठीक मेरे पोर्च पर है! केबिन 12 पर बैकअप भेजिए!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_098_e1_vip",
              "label": "टैबलेट पर बाहर का ट्रेल-कैम देखें",
              "cost_type": "vip_rewarded",
              "badge_text": "राज़ · विज्ञापन देखें",
