          "teaser_text": "जैसे ही ट्रेन अंधेरी डिपो सुरंग में घुसती है, ब्रेक चीख़ उठते हैं—और कोच 4 की बत्तियाँ टिमटिमाकर बंद हो जाती हैं।",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
