      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 10:12 · ट्रैकिंग अलर्ट: शाम 6:04 बजे से एक अनजान एयरटैग आपके साथ चल रहा है। आवाज़ बजाने के लिए टैप करें।",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "लियाम, मैं देर रात की रेड लाइन ट्रेन में हूँ और मेरे फ़ोन ने अभी मुझ पर एक अनजान एयरटैग पिंग किया है!",
          "timestamp_label": "रात 10:12",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "liam",
          "text": "अभी अपने कोट की जेबें और बैकपैक की ज़िप चेक करो! किसी ख़ाली स्टेशन पर मत उतरना, {{player_name}}।",
          "timestamp_label": "रात 10:13",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "narrator",
          "text": "आप \"आवाज़ बजाएँ\" पर टैप करती हैं। आपके कोट के निचले हिस्से के अंदर एक हल्की धातुई बीप गूँजती है—फटे अस्तर के अंदर सफ़ाई से सिली हुई। बीप दबाने के लिए इसके स्पीकर में छेद किया गया है।",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "seat4b",
          "text": "कोट को सीट पर ही छोड़ दो, {{player_name}}। तुम नहीं जानना चाहोगी कि उस ट्रैकर के पैसे किसने दिए हैं।",
          "unsent_placeholder": "सीट 4B ने एक मैसेज अनसेंड किया",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "गलियारे के उस पार ग्रे कैप वाला एक आदमी शीशे में आपकी परछाईं से नज़रें मिलाता है:",
          "options": [
            {
              "option_id": "opt_084_e1_free",
              "label": "एयरटैग निकालकर कूड़ेदान में फेंकें",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "मैं अगले स्टॉप पर ट्रैकर फेंककर कोच बदल रही हूँ।",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_084_e1_vip",
              "label": "पहले एयरटैग का एनएफ़सी सीरियल नंबर स्कैन करें",
