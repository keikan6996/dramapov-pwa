      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 2:11 · घना पहाड़ी कोहरा आपकी हेडलाइट्स को निगल लेता है। आपका जीपीएस बजता है: \"ओल्ड रिवर ब्रिज की ओर बाएँ मुड़ें।\"",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, गाड़ी रोको!! मैं तुम्हारी लोकेशन ओल्ड रिवर ब्रिज की ओर मुड़ते देख रहा हूँ—वो पुल 2012 में ढह गया था!",
          "timestamp_label": "रात 2:11",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "ये नामुमकिन है! मैं अभी पक्के कंक्रीट पर चला रही हूँ—और मेरे आगे टेललाइट्स वाली एक लाल सेडान चल रही है!",
          "timestamp_label": "रात 2:12",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "मेरी टेललाइट्स के पीछे आती रहो। नीचे गिरना उड़ने जैसा लगता है।",
          "unsent_placeholder": "यह मैसेज वापस ले लिया गया",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "अभी ब्रेक मारो और रिवर्स करो! अपनी डैशबोर्ड घड़ी देखो—तुम्हारे जीपीएस का टाइमस्टैम्प वापस अक्टूबर 2012 पर कैसे चला गया?!",
          "timestamp_label": "रात 2:13",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
