          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "victor",
          "text": "हे {{player_name}}, अभी सिंगापुर उतरा हूँ। बहुत थक गया हूँ। सीधे सोने जा रहा हूँ, लव यू।",
