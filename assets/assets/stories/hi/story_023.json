      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 3:07 · बादल की गरज से आपका पाँचवीं मंज़िल का स्टूडियो काँप उठता है। डिलीवरी ऐप का एक नोटिफिकेशन बजता है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "हे {{player_name}}, मैंने तुम्हारे नूडल्स गेट पर लटका दिए हैं। पर्दे के पीछे वाली अपनी रूममेट से कहो मुझे घूरना बंद करे, यार।",
