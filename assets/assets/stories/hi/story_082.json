          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "player",
          "text": "मेरे हाथ में तो लैपटॉप बैग है! रुको... सीलिंग हैच से धूल गिर रही है।",
          "timestamp_label": "रात 1:19",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n06_choice"
