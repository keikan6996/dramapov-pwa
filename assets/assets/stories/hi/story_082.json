          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "devon",
          "duration_sec": 6,
          "transcript": "[स्टैटिक, कीबोर्ड की खटखट] रुको—लिफ़्ट 04 का वज़न सेंसर अभी 180 पाउंड बढ़ गया। क्या तुमने वहाँ कोई बक्सा गिराया है?!",
