        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "सीधे लिफ़्ट कैब की छत पर एक भारी बूट की धमक पड़ती है:",
          "options": [
            {
              "option_id": "opt_082_e1_free",
              "label": "ब्लाइंड कॉर्नर से सटकर खड़े हो जाएँ",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "कोई मेरी लिफ़्ट के ठीक ऊपर खड़ा है, डेवोन!",
