          "haptic": "light",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "unsent_message",
          "sender_id": "damien",
          "text": "पिच मीटिंग के बाद से मैं तुम्हारी मुस्कान के बारे में ही सोच रहा हूँ।",
