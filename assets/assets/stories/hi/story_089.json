      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 1:42 · राइडसेफ़ रसीद: विक्टर के साथ सफ़र के लिए शुक्रिया! आपकी ट्रिप रात 1:30 बजे समाप्त हुई। 5 स्टार देंगे?",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "सोरा, मैं अभी भी इस सेडान की पिछली सीट पर हूँ! उसने जल्दी राइड ख़त्म दिखाने के लिए ऐप स्पूफ़ किया और अभी इंडस्ट्रियल बाईपास पर मोड़ लिया!",
          "timestamp_label": "रात 1:42",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "sora",
          "text": "क्या?! अपने फ़ोन की स्क्रीन धीमी रखो ताकि वह शीशे में तुम्हें टाइप करते न देखे! क्या अंदर बैठते वक़्त तुमने नंबर प्लेट देखी थी?!",
          "timestamp_label": "रात 1:43",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "sora",
          "duration_sec": 7,
          "transcript": "[तेज़ी से टाइप करते हुए] मैं तुम्हारा फ़ाइंडमाय डॉट देख रही हूँ! तुम सूने रेल यार्ड के पास 65 की रफ़्तार से जा रही हो—और तुम्हारी रसीद पर ड्राइवर की फ़ोटो तुम्हारी भेजी नंबर प्लेट से मेल नहीं खाती!",
