          "type": "choice",
          "prompt": "ड्राइवर रेल क्रॉसिंग की लाल बत्ती की ओर गाड़ी तेज़ करता है:",
          "options": [
            {
              "option_id": "opt_089_e1_free",
              "label": "अपने \"पुलिस अंकल\" से ज़ोर से कॉल का नाटक करें",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "हे चाचा Ray! हाँ, मैं अभी रेल यार्ड 4 से गुजर रही हूँ—आगे आपकी पुलिस कार दिख रही है!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_089_e1_vip",
              "label": "पिछली सीट का आर्मरेस्ट डिक्की में खोलें",
