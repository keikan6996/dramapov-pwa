          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "मेरा वॉकी-टॉकी डेस्क पर ऑफ़ पड़ा है! और ब्रेकर बॉक्स छह साल से डिस्कनेक्ट है!",
