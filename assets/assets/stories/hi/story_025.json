          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "साइड टेबल पर आपका ज्वेलरी बॉक्स अपने आप खड़कता है।",
