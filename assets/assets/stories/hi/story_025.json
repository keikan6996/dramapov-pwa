        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "वीडियो फीड में आपके बिस्तर के फ्रेम के नीचे का अंधेरा दिखता है—ठीक ऊपर आपके लटकते हुए हाथ की ओर ताकता हुआ।",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "आप कॉल काटती हैं। तुरंत, बिस्तर के नीचे से एक ठंडा हाथ आपके कंबल का किनारा पकड़ लेता है।",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
