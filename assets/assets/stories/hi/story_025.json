      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 3:00 · हॉस्टल ग्रुप चैट। एक ऐसे नाम के नीचे ग्रे बबल उभरता है जिसे किसी ने हटाने की हिम्मत नहीं की: \"Hannah टाइप कर रही है...\"",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}!! क्या तुम यह देख रही हो?! Hannah के अकाउंट में कौन घुस गया?!",
          "timestamp_label": "रात 3:00",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "उसकी मम्मी ने उसका phone उसी के साथ दफ़ना दिया था। किसी को उसका पासकोड नहीं पता।",
          "timestamp_label": "रात 3:01",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "पुलिस के आने से पहले तुमने मेरी चाँदी की अंगूठी ले ली थी।",
