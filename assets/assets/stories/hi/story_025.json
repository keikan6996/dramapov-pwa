          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "क्या तुमने अभी देखा उसने क्या अनसेंट किया?! {{player_name}}, बताओ कि तुमने उसकी डेस्क से कुछ नहीं रखा!",
          "timestamp_label": "रात 3:02",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
