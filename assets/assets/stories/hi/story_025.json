        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[फर्श के तख्तों के नीचे से दबी साँसें] ...इसे वापस दो, {{player_name}}। यहाँ नीचे बहुत ठंड है...",
