          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "रुको—तुम्हें मेरा नंबर किसने दिया? और हम सबसे ऊपरी मंज़िल पर हैं! 4B के ऊपर कोई 5वीं मंज़िल है ही नहीं!",
          "timestamp_label": "रात 2:15",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "prev_tenant",
          "duration_sec": 8,
          "transcript": "[फुसफुसाते हुए, टपकता पानी] \"मुझे पता है 5वीं मंज़िल नहीं है! सिर्फ़ कंक्रीट की छत और पानी की टंकी है! अभी दो बार खटखटाओ इससे पहले कि वह वेंट से नीचे उतरे!\"",
