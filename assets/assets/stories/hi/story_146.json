          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "prev_tenant",
          "text": "हे {{player_name}}, मैं तुमसे पहले 4B में रहता था। क्या कंचे शुरू हो गए? छत पर वापस दो बार खटखटाओ—कभी तीन बार मत खटखटाना!",
