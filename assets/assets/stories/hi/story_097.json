      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 8:47 · सेफ़कीप स्टोरेज फ़ैसिलिटी। आप यूनिट 77 का लहरदार शटर ऊपर उठाती हैं। अंदर बस एक टाइटेनियम ब्रीफ़केस पड़ा है—एक चमकते सैटेलाइट फ़ोन से हथकड़ी द्वारा बँधा हुआ।",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "marco",
          "text": "वाह!! हमने उस यूनिट के $400 दिए और अंदर मिलिट्री-ग्रेड केस निकला?! इसे तोड़कर खोलो, रोहन!",
          "timestamp_label": "रात 8:47",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "रुको—जैसे ही मैंने केस की फ़ोटो खींची, हथकड़ी से बँधे फ़ोन पर एक मैसेज आया।",
          "timestamp_label": "रात 8:48",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "u77",
          "text": "ब्रीफ़केस नीचे रखो और शटर बंद करो, रोहन। मोशन सेंसर ने अभी 10-मिनट के पिकअप को ट्रिगर कर दिया है।",
          "timestamp_label": "रात 8:48",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "u77",
          "text": "अगर टैंपर सील टूटी, तो डाई पैक स्याही नहीं—थर्माइट है।",
          "unsent_placeholder": "यूनिट-77 ने एक मैसेज अनसेंड किया",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
