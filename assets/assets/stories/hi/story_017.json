          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n09b",
          "type": "text",
          "sender_id": "theo",
          "text": "तेज़ नज़र, {{player_name}}। अंदर आओ और दरवाज़ा बंद करो—तुम्हें एक बिल्कुल अलग लीज़ मिलने वाली है।",
          "timestamp_label": "दोपहर 2:22",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n10"
