              "next_node_id": "e1_n09b"
            }
          ]
        },
        {
          "id": "e1_n09a",
          "type": "text",
          "sender_id": "theo",
          "text": "बेबाक मोलभाव, {{player_name}}। क्या हो अगर मैं तुम्हें दोनों दे दूँ—साथ में पेंटहाउस जिम की चाबी भी?",
