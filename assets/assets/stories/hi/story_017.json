      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "दोपहर 2:15 · कॉन्फ्रेंस रूम A। मेज़ के नीचे, आप गुस्से से उस अनजान मकान मालिक को text करती हैं जिसने अभी आपका किराया 40% बढ़ा दिया।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "सुनिए, \"मकान मालिक\": रातोंरात 40% किराया बढ़ाना खुली लूट है! मेरे बर्फीले CEO में भी आपसे ज़्यादा दिल है!!",
          "timestamp_label": "दोपहर 2:15",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "narrator",
          "text": "ज़ज़्ज़्त! महोगनी मेज़ के उस पार, CEO Theo Grant का निजी phone चमकता है। वे इसे पढ़ते हैं, धीरे से आपकी ओर नज़र उठाते हैं—और टाइप करते हैं।",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "theo",
          "text": "यह सुनकर खुशी हुई कि मुझमें खुद से ज़्यादा दिल है, {{player_name}}। साथ ही, मेरी बोर्ड मीटिंग में text करना बंद करो।",
          "timestamp_label": "दोपहर 2:16",
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "player",
          "text": "MAPLEWOOD TOWERS के मालिक आप हैं?! रुको—आपने मेरा किराया दोगुना क्यों किया?!",
          "timestamp_label": "दोपहर 2:16",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "unsent_message",
          "sender_id": "theo",
          "text": "मैंने नहीं किया—मेरे प्रॉपर्टी मैनेजर ने गलती से किया, और मैं तुम्हारी पूरी लीज़ माफ़ करने ही वाला था।",
          "unsent_placeholder": "यह message unsent किया गया",
          "reveal_ms": 1900,
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "voice_note",
          "sender_id": "theo",
          "duration_sec": 6,
          "transcript": "[मीटिंग के ठीक बाद गलियारे में फुसफुसाहट] मेरा ऑफिस। पाँच मिनट में। अपनी लीज़ लाना—और अपना तेवर भी, {{player_name}}।",
          "audio_asset": null,
          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08"
        },
