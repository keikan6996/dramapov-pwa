          "teaser_text": "एपिसोड 2: नियॉन लाइट्स बंद हो जाती हैं—और ड्रायर #8 का दरवाज़ा खुल जाता है।",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
