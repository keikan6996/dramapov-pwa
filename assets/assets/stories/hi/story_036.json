    {
      "episode_number": 1,
      "title": "रात 3:12 की स्पिन साइकिल",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 3:12 · खाली 24-घंटे वाले लॉन्ड्रोमैट में नियॉन ट्यूब्स भनभना रही हैं। आपके कपड़े शीशे के पीछे लय में घूम रहे हैं।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, मैंने अभी तेरा लॉन्ड्रोमैट वाला स्नैप देखा! पीछे मत मुड़ना—इतनी तेज़ रोशनी में तेरे पीछे बैठे लड़के की कोई परछाईं नहीं बन रही!",
          "timestamp_label": "रात 3:12",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "क्या?! जब मैं अंदर आई, तब लॉन्ड्रोमैट बिल्कुल खाली था! मुझे दरवाज़े की घंटी की आवाज़ भी नहीं आई!",
          "timestamp_label": "रात 3:13",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "तुम्हारा ड्रायर लगभग पूरा होने वाला है। शून्य होने तक यहीं रुको।",
          "unsent_placeholder": "यह मैसेज वापस ले लिया गया",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "अपना बैग उठाओ और शांति से बाहर निकलो! रुको—जब किसी ने कपड़े डाले नहीं तो ड्रायर #8 क्यों घूम रहा है?!",
          "timestamp_label": "रात 3:14",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[सिक्कों की खनक, शीशे के अंदर से दबी दस्तक] ...पाँच मिनट बचे हैं, {{player_name}}... अपना कोट पीछे मत छोड़ना...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "बाहर निकलने का ऑटोमैटिक स्लाइडिंग ग्लास दरवाज़ा भारी चुंबकीय खट की आवाज़ के साथ लॉक हो जाता है।",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "दरवाज़े का मैनुअल इमरजेंसी स्विच खींचें",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "मैनुअल डोर रिलीज़ दबा रही हूँ!",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "घूमते हुए ड्रायर #8 के अंदर ध्यान से देखें",
