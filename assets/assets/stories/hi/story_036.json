        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "आप कॉल काट देते हैं। तुरंत, आठों ड्रायर के टाइमर एक साथ सिंक हो जाते हैं और 00:59 से उल्टी गिनती शुरू कर देते हैं।",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
