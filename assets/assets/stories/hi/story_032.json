      "episode_number": 1,
      "title": "लाल ताबीज़",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 2:30 · नाइट मार्केट से खरीदे गए विंटेज ऊनी कोट से गीली मिट्टी और चमेली की हल्की गंध आ रही है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "समीर, जगाने के लिए माफ़ी! उस काले कोट की अंदरूनी बाईं जेब चेक करो—क्या मुड़ा हुआ लाल कागज़ अभी भी सिला हुआ है?",
          "timestamp_label": "रात 2:30",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "मुझे लगा वो पुराना ड्राई-क्लीनिंग टैग है, इसलिए मैंने एक घंटे पहले उसे फाड़कर डस्टबिन में फेंक दिया… क्यों?!",
          "timestamp_label": "रात 2:31",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "मेरा कोट वापस दो। मुझे बहुत ठंड लग रही है।",
          "unsent_placeholder": "यह मैसेज वापस ले लिया गया",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "हे भगवान! वो गट्ठर एक एस्टेट क्लियरेंस से आया था—एक भिक्षु ने उस कोट को सील किया था! इसे बाहर ले जाओ और रात 3:00 बजे से पहले जला दो!",
          "timestamp_label": "रात 2:32",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[दाँत किटकिटाने, कपड़े की सरसराहट की आवाज़] ...ये तुम पर कितना अच्छा लग रहा है, समीर... मुझे भी अपने साथ पहनने दो...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "आपकी कुर्सी पर टँगा खाली कोट धीरे-धीरे अपनी आस्तीनें ऊपर उठाता है, जैसे कोई अदृश्य बाहें अंदर सरक आई हों।",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "कोट को हॉलवे के कचरा शूट में फेंक दें",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "मैं इसे कचरा शूट में नीचे फेंक रही हूँ!",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "कचरे के डिब्बे से फटा लाल ताबीज़ निकालें",
              "cost_type": "vip_rewarded",
              "badge_text": "सीक्रेट · विज्ञापन देखें",
              "player_reply_text": "डस्टबिन से वो लाल कागज़ निकाल रही हूँ!",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "आपको कोट के पाँच मंज़िल नीचे गिरने की आवाज़ आती है। जब आप वापस बेडरूम में मुड़ते हैं—वो फिर से आपकी कुर्सी पर सलीके से रखा है, पूरी तरह भीगा हुआ।",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "राज़ खुला: लाल ताबीज़ के पीछे एक नाम और मृत्यु की तारीख़ घसीटकर लिखी है—आज की रात से ठीक 49 दिन पहले।",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "उसे फेंकने की कोशिश मत करो! पिछले खरीदार ने उसे नदी में फेंका था और सुबह उठने पर वो उसे गले तक बटन बंद किए हुए पहना मिला!",
          "timestamp_label": "रात 2:35",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "अज्ञात · बर्फीली सरसराहट",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "ठंड से काँपती एक महिला की आवाज़ फुसफुसाती है: \"बटन बंद करो, समीर। ज़मीन के नीचे बहुत ठंड है।\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "आप कॉल काट देते हैं। आपके बेडरूम के शीशे के अंदरूनी तरफ़ एक गीले हाथ का निशान उभर आता है—जिससे चमेली की तेज़ खुशबू आ रही है।",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "49वीं रात",
          "teaser_text": "एपिसोड 2: घड़ी में 3:00 बजने ही वाले हैं और कोट की आस्तीनें आपके कंधों की तरफ़ बढ़ रही हैं।",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
