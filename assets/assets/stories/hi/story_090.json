        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "रैक 3 में घुसपैठिया",
          "teaser_text": "किसी ने अभी एडमिन बैज से सर्वर वॉल्ट खोला है—और आईसीयू काउंटडाउन में 3 मिनट बचे हैं।",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
