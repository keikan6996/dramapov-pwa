        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "सर्वर रूम का बैज रीडर हरी बीप करता है—जबकि सिर्फ़ दो आईटी स्टाफ़ के पास अनुमति है। भारी स्टील का दरवाज़ा अंदर की ओर खुलता है।",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
