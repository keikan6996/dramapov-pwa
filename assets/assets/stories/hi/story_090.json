      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 2:11 · ST. JUDE सर्वर रूम: हर टर्मिनल लाल चमक रहा है। \"सभी इन्फ़्यूज़न पंप एन्क्रिप्टेड। 15:00 बाकी।\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "patel",
          "text": "{{player_name}}!! हमारे ICU वेंटिलेटर अभी नेटवर्क से कट गए! हम तीन मरीज़ों को हाथ से पंप दे रहे हैं—इसे अभी ठीक करो!",
          "timestamp_label": "रात 2:11",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "zday",
          "text": "किसी बिटकॉइन की ज़रूरत नहीं, {{player_name}}। मास्टर डेटाबेस से मरीज़ #4409 की टॉक्सिकोलॉजी रिपोर्ट मिटा दो, और मैं तुरंत डिक्रिप्शन चाबी दे दूँगा।",
          "timestamp_label": "रात 2:12",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "मरीज़ #4409?! बेड 9 में कौन है, Dr. Patel?!",
          "timestamp_label": "रात 2:12",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "patel",
          "duration_sec": 8,
          "transcript": "[मॉनिटर तेज़ी से बीप करते हुए] वह एक अज्ञात शख़्स है जिसे यॉट पार्टी से लाया गया! उसके ख़ून में प्रतिबंधित मिलिट्री नर्व एजेंट मिला है—यह हत्या की कोशिश है!",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "काउंटडाउन 11:30 पर पहुँच गया। ICU की जानें दाँव पर हैं:",
          "options": [
            {
              "option_id": "opt_090_e1_free",
              "label": "ICU को एयर-गैप्ड ऑफ़लाइन बैकअप पर डालें",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Dr. Patel, सभी पंपों से नीले ईथरनेट केबल खींच दीजिए—मैं ऑफ़लाइन फ़र्मवेयर भेज रही हूँ!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_090_e1_vip",
              "label": "डिलीट करने से पहले #4409 की रिपोर्ट क्लोन करें",
