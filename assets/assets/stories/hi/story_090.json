          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "patel",
          "duration_sec": 8,
          "transcript": "[मॉनिटर तेज़ी से बीप करते हुए] वह एक अज्ञात शख़्स है जिसे यॉट पार्टी से लाया गया! उसके ख़ून में प्रतिबंधित मिलिट्री नर्व एजेंट मिला है—यह हत्या की कोशिश है!",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "काउंटडाउन 11:30 पर पहुँच गया। आईसीयू की जानें दाँव पर हैं:",
          "options": [
            {
              "option_id": "opt_090_e1_free",
              "label": "आईसीयू को एयर-गैप्ड ऑफ़लाइन बैकअप पर डालें",
