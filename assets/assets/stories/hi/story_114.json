          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "खटाक! झटके के साथ लिफ़्ट ऊपर उठती है, और मक्खन की तरह सरकती हुई सीधे 60वीं मंज़िल की प्राइवेट पेंटहाउस लॉबी में पहुँच जाती है।",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "chairman",
          "text": "छह महीने की मिडनाइट चैटिंग—लगता है अब आख़िरकार हमारे आमने-सामने मिलने का वक़्त आ गया है, {{player_name}}।",
