        {
          "id": "e2_n08_vip",
          "type": "text",
          "sender_id": "clerk",
          "text": "तुमने जैमर तोड़ दिया?! वैन पैक करो—स्टेट ट्रूपर्स पहले ही इंटरस्टेट से मुड़ चुके हैं!",
          "timestamp_label": "रात 11:43",
          "typing_delay_ms": 600,
