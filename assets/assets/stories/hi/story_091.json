      "episode_number": 1,
      "title": "ग़ायब मंज़िल",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 11:32 · हाईवे भूस्खलन ने आपको पाइन रिज इन में फँसा दिया। आप मोटेल वाई-फ़ाई से जुड़ती हैं—और एक लोकल इंट्रानेट चैट खुल जाती है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "r409",
          "text": "कीकार्ड 409 इस्तेमाल मत करना, आर्या। लिफ़्ट के बटन देखो—यहाँ 4वीं मंज़िल है ही नहीं।",
          "timestamp_label": "रात 11:32",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "रुको... लिफ़्ट तो सिर्फ़ 1, 2, 3 और 5 पर जाती है! तुम्हें मेरा नाम कैसे पता?!",
          "timestamp_label": "रात 11:33",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "r409",
          "duration_sec": 8,
          "transcript": "[दबी फुसफुसाहट, तेज़ बारिश] क्योंकि मैं अभी 4वीं मंज़िल के अंदर बंद हूँ! क्लर्क सिर्फ़ उन्हीं अकेले मुसाफ़िरों को 409 कार्ड देता है जिनकी कार दूसरे राज्य की हो।",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "clerk",
          "text": "गलियारे में सब ठीक है न, आर्या? 4वीं मंज़िल पर जाने के लिए आइस मशीन के पीछे पीतल की सर्विस सीढ़ियाँ इस्तेमाल करें।",
          "timestamp_label": "रात 11:34",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "क्लर्क का लॉबी कैमरा सीधे आपकी ओर घूमता है:",
          "options": [
            {
              "option_id": "opt_091_e1_free",
              "label": "वापस कार में जाकर भाग निकलें",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "अरे मैं अपना चार्जर कार में भूल आई—अभी आती हूँ।",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_091_e1_vip",
              "label": "409 को बचाने सर्विस सीढ़ियों से ऊपर जाएँ",
              "cost_type": "vip_rewarded",
              "badge_text": "राज़ · विज्ञापन देखें",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "आप मूसलाधार बारिश में भागती हैं—और जम जाती हैं। आपकी कार के चारों टायर सफ़ाई से पंचर कर दिए गए हैं, और हाईवे गेट पर ताला लगा है।",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "r409",
          "text": "मैंने कहा था—पाइन इन से कोई गाड़ी लेकर बाहर नहीं जाता! क्लर्क के आँगन लॉक करने से पहले बाहर की फ़ायर सीढ़ी से खिड़की 409 तक आओ!",
          "timestamp_label": "रात 11:36",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "आप धुँधली सर्विस सीढ़ियों से चुपके ऊपर जाती हैं। 4वीं मंज़िल कोई मोटेल गलियारा नहीं है—यह भारी स्टील दरवाज़ों और बायोमेट्रिक तालों वाला साउंडप्रूफ़ कंक्रीट कॉरिडोर है।",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "r409",
          "text": "तुम सच में ऊपर आ गईं?! कीपैड पर अपना 409 कार्ड स्वाइप करो—यही इकलौता मास्टर कार्ड है जो बाहर से मेरा दरवाज़ा खोलता है!",
          "timestamp_label": "रात 11:36",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "unsent_message",
          "sender_id": "clerk",
          "text": "दो स्वस्थ डोनर्स के लिए ख़रीदार पक्का। अब 4वीं मंज़िल की सीढ़ियाँ सील कर रहे हैं।",
          "unsent_placeholder": "रिसेप्शन ने एक मैसेज अनसेंड किया",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "narrator",
          "text": "आपके पीछे एक भारी मैग्नेटिक बोल्ट धड़ाम से बंद हो जाता है। गलियारे के दूर सिरे पर, कमरा 409 का दरवाज़ा क्लिक करके खुलता है—एक अंधेरा कमरा दिखता है।",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "चौथी मंज़िल के अंदर",
          "teaser_text": "सीढ़ियाँ सील हो चुकी हैं और क्लर्क ने अभी ख़रीदार को बुला लिया है। कमरा 409 के अंदर जो भी है, वह आपका इकलौता साथी है—या चारा।",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
