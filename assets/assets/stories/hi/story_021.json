      "title": "बटन 13 जल उठा",
      "start_node_id": "e1_n01",
      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 2:14 · लिफ्ट झटके से रुक जाती है। लाल एलईडी 12 के आगे झपकती है और 13 पर लॉक हो जाती है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "नेहा, मुझे अपने मॉनिटर पर कार B रुकी हुई दिख रही है। तुमने सर्विस ओवरराइड क्यों दबाया?",
          "timestamp_label": "रात 2:14",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "मैंने कुछ नहीं छुआ! दरवाज़े बस एक अंधेरे गलियारे में खुल गए। वहाँ कोई मेरी तरफ हाथ हिला रहा है।",
          "timestamp_label": "रात 2:15",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "अच्छा है। बाहर आओ ताकि मैं आखिरकार जा सकूँ।",
          "unsent_placeholder": "यह मैसेज वापस ले लिया गया",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "केबिन के अंदर ही रहो! दहलीज़ पार बिल्कुल मत करना। अभी दरवाज़ा बंद दबाओ।",
          "timestamp_label": "रात 2:15",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[फ्लोरोसेंट की भनभनाहट, धीमे कदम] ...तुम घूर क्यों रही हो, नेहा? अब तुम इसी मंज़िल पर रहती हो...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "दरवाज़े बंद होने से मना कर देते हैं। लिफ्ट में बर्फीली हवा भर जाती है।",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "लाल इमरजेंसी अलार्म दबाएँ",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "मैं अलार्म की घंटी ठोक रही हूँ!",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "मंज़िल 13 पर फ़ोन फ्लैश ज़ूम करें",
              "cost_type": "vip_rewarded",
              "badge_text": "सीक्रेट · विज्ञापन देखें",
              "player_reply_text": "अपनी टॉर्च चालू कर रही हूँ...",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "घंटी बजती है—शाफ्ट में नहीं, बल्कि अंधेरे गलियारे में खड़े उस साये के ठीक पीछे।",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "राज़ खुला: 13वीं मंज़िल के हर अपार्टमेंट के दरवाज़े पर पीतल की तख्ती लगी है—और सब पर आपका नाम खुदा है।",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "रुको... सिक्योरिटी डेस्क का फ़ोन अपने आप बज रहा है। लॉबी कैमरे की फीड देखो।",
          "timestamp_label": "रात 2:17",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "लॉबी गार्ड डेस्क",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "एक घबराई आवाज़ हाँफती है: \"मैं हेक्टर बोल रहा हूँ! किसी ने बीस मिनट पहले मेरा फ़ोन चुरा लिया—तुम किससे चैट कर रही हो?!\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "आप कॉल काटती हैं। तुरंत एक वॉइसमेल टेक्स्ट आता है: \"मैं हेक्टर हूँ—मैं लॉबी में बंद हूँ! वो मैं नहीं हूँ जो तुम्हें टेक्स्ट कर रहा है!\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "तो आपको टेक्स्ट कौन कर रहा था?",
          "teaser_text": "एपिसोड 2: 13वीं मंज़िल पर खड़ा साया एक चमकता हुआ फ़ोन ऊपर उठाता है—और मुस्कुराता है।",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
