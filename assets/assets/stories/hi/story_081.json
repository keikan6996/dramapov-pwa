      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 11:48 · आप अपार्टमेंट 6C में अकेली हैं। आपके डीएम में एक अनजान लिंक आता है जिसके कैप्शन में लिखा है: \"चैट को हाथ हिलाओ।\"",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "viewer",
          "text": "नीली हुडी अच्छी है, नेहा। 12,418 लोगों ने अभी तुम्हें डेडबोल्ट लॉक करते देखा।",
          "timestamp_label": "रात 11:48",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "यह कौन है?! मैंने तो महीनों पहले अपने लैपटॉप के वेबकैम पर टेप लगा दिया था!",
          "timestamp_label": "रात 11:48",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "viewer",
          "text": "लैपटॉप नहीं। अपनी अलमारी की सबसे ऊपरी शेल्फ़ पर देखो—लाल एलईडी टिमटिमा रही है।",
          "unsent_placeholder": "दर्शक #001 ने एक मैसेज अनसेंड किया",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "voice_note",
          "sender_id": "viewer",
          "duration_sec": 7,
          "transcript": "[दबी हुई साँसें, लकड़ी का हैंगर खनकने की आवाज़] अभी खड़ी मत होना, नेहा। तुम्हारा रिएक्शन देखने के लिए चैट ने अभी $500 दिए हैं।",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "आपसे दो फ़ीट पीछे अलमारी के पल्ले चरमराते हैं। तेज़ी से क़दम उठाएँ:",
          "options": [
            {
              "option_id": "opt_081_e1_free",
              "label": "शांत दिखें व चुपके से किरा को मैसेज करें",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "किरा, कॉल बिल्कुल मत करना। कोई मेरी अलमारी के अंदर से मुझे लाइव स्ट्रीम कर रहा है।",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_081_e1_vip",
              "label": "अलमारी के हैंडल के नीचे कुर्सी फँसा दें",
              "cost_type": "vip_rewarded",
              "badge_text": "राज़ · विज्ञापन देखें",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "text",
          "sender_id": "kira",
          "text": "हे भगवान मेन दरवाज़े के पास रहो!! रुको—मैंने अभी स्ट्रीम लिंक खोला। वह एंगल हाथ से पकड़ने के लिए कुछ ज़्यादा ही स्थिर है।",
          "timestamp_label": "रात 11:50",
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "player",
          "text": "रुको... अगर कैमरा कहीं फ़िट किया गया है, तो उस वॉइस नोट में साँस लेने की आवाज़ कहाँ से आई?!",
