      "episode_number": 1,
      "title": "थर्मल लॉकडाउन",
      "start_node_id": "e1_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 10:41 · घर ओएस अलर्ट: सभी बाहरी डेडबोल्ट लॉक। स्टॉर्म शटर गिरे। हीटिंग मैक्स (108°F) पर सेट।",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "ओवेन!! तुम्हारे स्मार्ट होम ऐप ने मुझे मेरे ही घर में बंद कर दिया और हीटर को 108 डिग्री पर कर दिया!",
          "timestamp_label": "रात 10:41",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "owen",
          "text": "अभी तुम्हारा हब चेक कर रहा हूँ, {{player_name}}... रुको, मेरे टेक्नीशियन अधिकार अभी रद्द कर दिए गए! कोई तुम्हारे गैराज के अंदर से रूट_एडमिन के रूप में लॉग-इन है।",
          "timestamp_label": "रात 10:42",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "root",
          "duration_sec": 7,
          "transcript": "[आपके लिविंग रूम के स्पीकरों में गूँजते हुए] \"पिछला मंगलवार याद है, {{player_name}}? तुमने वादा किया था कि किसी को कभी पता नहीं चलेगा कि हाईवे 9 पर क्या हुआ था।\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "player",
          "text": "वह तो मेरे बेडरूम की रिकॉर्डिंग है! तुम मेरे स्मार्ट स्पीकर से जासूसी कर रहे थे?!",
          "timestamp_label": "रात 10:43",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "हवा झुलसाने वाली है। आँखों में पसीना चुभ रहा है। आप क्या करेंगी?",
          "options": [
            {
              "option_id": "opt_086_e1_free",
              "label": "हॉल में मुख्य ब्रेकर बॉक्स तोड़ दें",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "मैं मेन पावर बंद कर रही हूँ—देखते हैं बिना बिजली के तुम्हारे स्मार्ट ताले कैसे टिकते हैं!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_086_e1_vip",
              "label": "ओवेन से फ़ैक्टरी रीसेट पिन माँगें",
              "cost_type": "vip_rewarded",
              "badge_text": "राज़ · विज्ञापन देखें",
              "player_reply_text": "ओवेन, बेहोश होने से पहले मुझे हार्डवेयर ओवरराइड कोड बताओ!",
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "आप मास्टर ब्रेकर गिरा देती हैं। बत्तियाँ बुझ जाती हैं—फिर एक हरी बैकअप बैटरी गुनगुनाकर चालू होती है। फ़ेल-सिक्योर ताले कसकर बंद रहते हैं।",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "root",
          "text": "सोलर बैटरी वॉल 98% पर है, {{player_name}}। अब तुम अंधेरे में पक रही हो।",
          "timestamp_label": "रात 10:45",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "text",
          "sender_id": "owen",
          "text": "हॉलवे थर्मोस्टैट के पीछे पिनहोल को 5 सेकंड दबाए रखो और 9941 टाइप करो! रुको—इससे गैराज का दरवाज़ा भी खुल जाएगा!",
          "timestamp_label": "रात 10:45",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "आप 9941 दबाती हैं। सारे डेडबोल्ट एक साथ क्लिक करके खुल जाते हैं—जिसमें अंधेरे गैराज की ओर जाने वाला भारी स्टील का दरवाज़ा भी शामिल है।",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "unsent_message",
          "sender_id": "root",
          "text": "हाईवे 9 पर तुमने जिस साइकिल सवार को छोड़ा था वह मेरी बहन थी, {{player_name}}। सच क़बूलने का वक़्त आ गया है।",
          "unsent_placeholder": "रूट_एडमिन ने एक मैसेज अनसेंड किया",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "owen",
          "text": "रुको... गैराज का मोशन सेंसर अभी चालू हुआ! कोई अभी अंदरूनी सीढ़ियों से ऊपर आ रहा है!",
          "timestamp_label": "रात 10:46",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "गैराज का दरवाज़ा",
          "teaser_text": "घर सिर्फ़ हैक नहीं हुआ—यह एक अदालत बन गया है। और रूट_एडमिन ने अभी किचन में कदम रखा है।",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
