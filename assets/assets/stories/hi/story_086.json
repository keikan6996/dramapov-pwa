          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n07_vip",
          "type": "narrator",
          "text": "सीढ़ियों पर क़दम अचानक रुक जाते हैं। सारे स्टॉर्म शटर तुरंत ऊपर उठ जाते हैं, और घर में रात की ठंडी हवा भर जाती है।",
