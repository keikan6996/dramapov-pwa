        {
          "id": "e2_n07_free",
          "type": "narrator",
          "text": "आप बालकनी के शटर के नीचे से रात की ठंडी हवा में सरकती हैं—और जम जाती हैं। ठीक आपके नीचे ओवेन की होम-सिक्योरिटी वैन खड़ी है, बोनट पर लैपटॉप चमक रहा है।",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n08_free"
        },
        {
          "id": "e2_n08_free",
          "type": "text",
          "sender_id": "owen",
          "text": "नीचे उतर आओ, {{player_name}}। मैं तो बस डराकर तुमसे सच निकलवाना चाहता था—मेरी बहन अभी भी कोमा में है।",
