          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "unsent_message",
          "sender_id": "owen",
          "text": "उसे अंदर मत आने देना—मैंने अभी बेडरूम का ऑडियो पुलिस को अपलोड कर दिया है।",
          "unsent_placeholder": "ओवेन ने एक मैसेज अनसेंड किया",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "narrator",
          "text": "लिविंग रूम की दीवार पर हेडलाइट्स चमकती हैं। आगे के ताले में चाबी घूमती है—और फ़ॉयर से आपका मंगेतर आपका नाम पुकारता है।",
