      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 11:58 · तूफ़ान से दादी के गाँव वाले घर की बिजली कट जाती है। सिर्फ़ आपके phone की टॉर्च अंधेरे को चीरती है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, मैंने अभी दादी की तिजोरी खोली! उसमें एक लाल लिफ़ाफ़ा है जिस पर एक ही नियम लिखा है: रात 12:00 बजे से पहले ईस्ट रूम की तस्वीर पर मखमली चादर डाल देना!",
          "timestamp_label": "रात 11:58",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "मैं अभी ईस्ट रूम में ही खड़ी हूँ… Owen, मखमली चादर पहले से फ़र्श पर पड़ी है। और पेंट किया हुआ कैनवास बिल्कुल खाली है।",
          "timestamp_label": "रात 11:59",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "वह दस मिनट पहले बाहर निकल चुकी है। हॉलवे चेक करो।",
          "unsent_placeholder": "यह message unsent किया गया",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "क्या?! नीचे लकड़ी के फ़र्श पर देखो—क्या फ्रेम से बाहर आते हुए पैरों के निशान हैं?!",
          "timestamp_label": "रात 12:00",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[रेशमी गाउन की सरसराहट, फ़र्श के तख्तों की धीमी चरमराहट] ...मेरे घर में स्वागत है, {{player_name}}... तुमने आग क्यों बुझने दी?...",
