          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "खाली सुनहरे फ्रेम के नीचे से गीले कीचड़ भरे पैरों के निशान आते हैं—सीधे ठीक आपके पीछे तक।",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "फ्रेम के ऊपर मखमली चादर डाल दें",
