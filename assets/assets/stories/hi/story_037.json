          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "आप कॉल काट देते हैं। तुरंत, ईस्ट रूम का दरवाज़ा अपने आप बंद हो जाता है, और आपको खाली कैनवास के साथ अकेला छोड़ देता है।",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
