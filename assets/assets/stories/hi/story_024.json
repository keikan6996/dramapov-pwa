      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "रात 2:19 · ट्रेन का डिब्बा एक अनंत काली सुरंग से होकर झूल रहा है। बाकी हर यात्री आँखें बंद किए पत्थर की तरह बैठा है।",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, तुम कहाँ हो? मैं सेंट्रल स्टेशन पर इंतज़ार कर रहा हूँ—गार्ड कहता है लाइन 4 दो घंटे पहले ही बंद हो चुकी है।",
