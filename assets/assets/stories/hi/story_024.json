        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[पटरी की चरचराहट, फुसफुसाहटों का कोरस] ...1998 के लिए सब सवार हों... टिकट दिखाइए, {{player_name}}...",
