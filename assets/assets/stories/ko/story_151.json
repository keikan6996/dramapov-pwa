          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n06b",
          "type": "text",
          "sender_id": "butler",
          "text": "그 비단 끈을 벽난로 불 속에 던져버렸습니다, 사모님! 끈이 타는 바로 그 순간 장식장 거울에 금이 갔어요.",
          "timestamp_label": "오후 11:46",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
