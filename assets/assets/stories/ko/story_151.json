        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "클로이가 비취 안에서 빛나는 붉은 핏줄 무늬를 확대해 올립니다:",
          "options": [
            {
              "option_id": "opt_story_151_e1_free",
              "label": "자정 규칙에 대해 경고하기",
