              "badge_text": null,
              "player_reply_text": "어떤 지폐를 떨어뜨렸는데요?",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "주문 확인 통화 녹음 전체를 재생해 본다",
              "cost_type": "vip_rewarded",
