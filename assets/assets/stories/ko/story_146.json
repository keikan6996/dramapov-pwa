          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "잠깐—내 번호 누가 알려줬어요? 그리고 여긴 꼭대기 층이에요! 4B호 위엔 5층이 없다고요!",
          "timestamp_label": "오전 2:15",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
