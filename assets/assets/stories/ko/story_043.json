        {
          "id": "e2_n04",
          "type": "text",
          "sender_id": "sienna",
          "text": "거짓말 그만해, 데릭. 그날 밤 네가 견인차 기사한테 현금 15,000달러 쥐여줬잖아.",
          "timestamp_label": "오후 11:13",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n05",
