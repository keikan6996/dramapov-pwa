        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "derek",
          "text": "잠깐—우린 다 레오가 혼자였다고 맹세했잖아! 여기 아무도 그 차에 안 탔어!",
          "timestamp_label": "오후 11:13",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
