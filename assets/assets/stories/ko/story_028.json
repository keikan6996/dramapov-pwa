          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "지금 천장 환풍구를 타고 기어 다니고 있어요! 내 전등 바로 위에서 축축하게 철퍽거리는 소리가 다 들려요!",
          "timestamp_label": "오전 2:49",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
