          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "fiancee",
          "text": "Ethan, 누나더러 파티 오지 말라고 해—누구도 내 사진 찍는 거 싫단 말이야!",
          "unsent_placeholder": "메시지 전송이 취소되었습니다",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
