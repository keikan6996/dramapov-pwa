          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "player",
          "text": "잠깐... 2학년 때라니? Ethan, 방금 뭐 보냈다가 지웠어요?!",
