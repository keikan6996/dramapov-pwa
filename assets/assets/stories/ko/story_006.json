          "reveal_ms": 2000,
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ethan",
          "text": "규칙 3: 기자들 있을 때 사파이어 반지 절대 빼지 말 것. 잘 자.",
