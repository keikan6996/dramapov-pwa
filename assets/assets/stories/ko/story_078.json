        },
        {
          "id": "n09_vip",
          "type": "text",
          "sender_id": "client",
          "text": "오, 오후 2시 회의가 한 편의 연극처럼 기가 막히겠군요. 곧 뵙죠, {{player_name}} 부사장님.",
          "timestamp_label": "오전 11:15",
