        },
        {
          "id": "e3_n04",
          "type": "narrator",
          "text": "오전 3:22 복도 캠 · 6C호 문 밖—외시경 유리에 뿌옇게 김을 서리게 한 작은 손자국.",
          "style": "system_alert",
          "sfx": "photo_snap",
