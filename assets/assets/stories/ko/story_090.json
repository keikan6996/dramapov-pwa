          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "unsent_message",
          "sender_id": "zday",
          "text": "B 서버실 밖에서 출입증 태그 감지. 우리 해결사가 이미 네 층에 올라갔다.",
          "unsent_placeholder": "ZERO_DAY 님이 메시지를 전송 취소했습니다",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
