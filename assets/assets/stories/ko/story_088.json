          "type": "cliffhanger",
          "headline": "상원의원 위의 이름",
          "teaser_text": "나디아는 무사하고 케이 씨는 수갑을 찼습니다—하지만 암호화된 장부에는 내각 전체를 무너뜨릴 또 하나의 이름이 담겨 있습니다.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 3
