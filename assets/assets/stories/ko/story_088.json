        {
          "id": "e2_n05",
          "type": "text",
          "sender_id": "player",
          "text": "줄게—대신 나디아부터 먼저 부두로 건너오게 해!",
          "timestamp_label": "오전 12:28",
          "typing_delay_ms": 0,
