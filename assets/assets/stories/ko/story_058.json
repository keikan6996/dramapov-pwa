          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05",
          "ambient": "heartbeat"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ricky",
          "text": "우와—유리 반사 확대해 봐. 저 초록색 모자이크 타일 모양… 메이 이모네 주방 같은데?!",
