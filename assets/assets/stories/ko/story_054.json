          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "marissa",
          "text": "42페이지에서 뺑소니 차량 번호판이 보였단 말이야—",
