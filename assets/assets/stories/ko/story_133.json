        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "갑자기 현관문 밖에서 열쇠 꾸러미 달그락거리는 소리가 들립니다—테사가 허락을 기다리지도 않고 온 것입니다.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
