              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "마야, 이거 충전기가 아니야—잠금 화면에 내 본명이 떠 있는 대포폰이라고!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_133_e1_vip",
