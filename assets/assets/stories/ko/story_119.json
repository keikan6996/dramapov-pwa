          "prompt": "음식 전문 기자들 앞에서 고든의 무릎이 풀려버립니다:",
          "options": [
            {
              "option_id": "opt_story_119_e2_free",
              "label": "할아버지를 안아드리고 도난당한 공책 폭로하기",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "안녕, 할아버지. 2년이나 걸려서 죄송해요—고든이 할머니 레시피 공책을 훔치고 저를 블랙리스트에 올렸어요.",
              "next_node_id": "e2_n07_free"
            },
            {
              "option_id": "opt_story_119_e2_vip",
              "label": "토비에게 고든의 위조 레시피 바인더 제출하게 하기",
              "cost_type": "vip_rewarded",
