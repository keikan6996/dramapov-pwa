      "default_ambient": "horror_whisper",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "오후 10:21 · 급행열차가 깜빡이는 출구 표지판 하나만 켜진 텅 빈 콘크리트 승강장, 하버 터미널에 정차합니다.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "incoming_call",
          "caller_id": "liam",
          "caller_label": "리암 · 오빠",
          "ringtone_sfx": "call_ring",
