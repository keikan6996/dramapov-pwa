      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "오후 8:15 · 암호화 이어피스로 리암의 전화가 걸려 오는 가운데 당신이 어두운 온실로 걸어 들어갑니다.",
          "style": "banner",
