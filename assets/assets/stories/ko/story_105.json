        {
          "id": "e2_n05",
          "type": "image",
          "sender_id": "detective",
          "image_asset": "assets/media/evidence/generic_ring_closeup.webp",
          "caption": "황금 가보 반지 근접 촬영 — 스위스 에스크로 암호가 미세 각인되어 있음.",
          "blur_until_tap": true,
