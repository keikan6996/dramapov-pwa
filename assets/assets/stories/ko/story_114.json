        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "펜트하우스의 구출",
          "teaser_text": "엘리베이터 문이 열리자 도시 최고 권력의 억만장자가 모습을 드러냅니다—바로 당신이 가장 좋아하던 문자 친구였습니다.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
