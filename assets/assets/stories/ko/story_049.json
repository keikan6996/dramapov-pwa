          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "gm",
          "duration_sec": 10,
          "transcript": "[잡음, 멀리서 들리는 사이렌] \"금고 그냥 열어둬, 아무도 우리 못 봤어—\" 방금 그거 네 목소리잖아, 레오. 오락실 강도 사건 때.",
          "audio_asset": null,
          "typing_delay_ms": 950,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "unsent_message",
          "sender_id": "leo",
          "text": "해나, 너 매니저가 보안 테이프 보관 안 했다고 했잖아—",
