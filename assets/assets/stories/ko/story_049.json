          "reveal_ms": 1750,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "text",
          "sender_id": "hannah",
          "text": "잠깐—이 방탈출 카페 예전에 바로 그 오락실 자리였잖아!! 러그 밑에 깔린 카펫 좀 봐!",
          "timestamp_label": "오후 10:55",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_choice"
