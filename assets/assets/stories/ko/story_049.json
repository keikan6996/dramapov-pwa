          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "gm",
          "text": "보너스 라운드입니다, 서진. 2019년 11월 14일의 진짜 퍼즐을 푸는 걸 잊으셨더군요.",
