          "teaser_text": "2화: 레오가 기억하는 금액과—해나가 기억하는 금액이 완전히 다릅니다.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
