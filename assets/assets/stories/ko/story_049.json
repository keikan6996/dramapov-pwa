          "sender_id": "gm",
          "text": "문을 열려면 우리 아버지 금고에서 훔쳐 간 금액을 입력하세요. 한 번이라도 틀리면 환풍구가 봉쇄됩니다.",
          "timestamp_label": "오후 10:57",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12_end"
        },
        {
