    {
      "episode_number": 1,
      "title": "누명 씌워진 흠집",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "오후 7:00 · 모나크 컨트리 클럽. 오후 8시 투자자 만찬 전에 옛 은사님의 발렛 부스를 돕기 위해 빨간 조끼를 입고 서 있던 당신은—트렌트가 일부러 자신의 펜더에 열쇠를 긁는 모습을 목격합니다!",
          "style": "banner",
          "sfx": "knock",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "trent",
          "text": "야!! 이 얼빠진 발렛 놈이 내 300만 달러짜리 하이퍼카에 무슨 짓을 했는지 봐!! 당장 현금 15만 달러 물어내, 안 그러면 감옥에 처넣을 테니까!",
          "timestamp_label": "오후 07:00",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "2초 전에 네 시계 버클로 네 차 펜더 스스로 긁었잖아, 트렌트. 왜? 도박 빚 메꿀 급전이라도 필요했어?",
          "timestamp_label": "오후 07:00",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "trent",
          "text": "입 닥쳐! 지금 안에서 우리 아빠가 에이펙스 캐피탈 회장님하고 5,000만 달러 대출 계약 맺고 있거든! 당장 무릎 꿇고 내 범퍼 닦아!",
          "timestamp_label": "오후 07:02",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "trent",
          "text": "발렛 클럽에서 15만 달러 보험 합의금만 물어주면 아빠가 알기 전에 라스베이거스 빚 싹 갚을 수 있어!",
          "unsent_placeholder": "트렌트 님이 메시지를 전송 취소했습니다",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "트렌트가 당신을 아스팔트 바닥으로 밀치려고 열쇠를 들어 올립니다:",
          "options": [
            {
              "option_id": "opt_story_110_e1_free",
              "label": "옆으로 비켜서며 정문 방범카메라를 가리킨다",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "조심해, 트렌트. 방금 정문 카메라에 네 시계가 페인트 긁는 거 다 찍혔거든.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_110_e1_vip",
              "label": "엘레나에게 문자를 보내 스털링 사의 5,000만 달러 대출을 보류시킨다",
              "cost_type": "vip_rewarded",
              "badge_text": "비밀 · 광고 시청",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
