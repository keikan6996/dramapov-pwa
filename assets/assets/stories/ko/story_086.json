      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "오후 10:48 · 당신이 위층 난간 뒤에 몸을 웅크립니다. 아래층에서는 모든 스마트 티비가 켜지며 9번 국도 블랙박스 영상을 띄웁니다.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
