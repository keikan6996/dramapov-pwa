        {
          "id": "e2_n06_choice",
          "type": "choice",
          "prompt": "발소리가 천천히 계단을 올라옵니다. 결정을 내리십시오:",
          "options": [
            {
              "option_id": "opt_086_e2_free",
              "label": "안방 발코니 셔터를 향해 내달린다",
