          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}!! 지금 이거 보고 있어?! 대체 누가 한나 계정에 들어간 거야?!",
