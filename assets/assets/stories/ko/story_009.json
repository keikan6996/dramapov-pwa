          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "roman",
          "text": "너한테 책상 비우라고 말한 그날 이후 단 하루도 편히 잔 날이 없었어.",
