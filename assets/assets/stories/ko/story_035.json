      "nodes": [
        {
          "id": "e3_n01",
          "type": "narrator",
          "text": "오전 12:01 · 음력 7월 둘째 날 밤. 번호 000이 가족 톡방에 다시 입장하더니—당신 방문을 찍은 복도 카메라 사진을 올립니다.",
          "style": "banner",
