          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Una credencial de becaria ni siquiera tiene acceso Nivel 3 de tesorería, Grant. Solo tú y la Directora de RRHH Diane tienen llaves dobles.",
