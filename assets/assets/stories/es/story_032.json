    {
      "episode_number": 1,
      "title": "El Talismán Rojo",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "2:30 AM · El abrigo vintage de lana que compraste en el mercado nocturno huele levemente a tierra húmeda y jazmín.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, ¡perdón por despertarte! Revisa el bolsillo interior izquierdo de ese abrigo negro… ¿el papel rojo doblado sigue cosido y cerrado?",
          "timestamp_label": "2:30 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Creí que era una etiqueta vieja de tintorería así que lo arranqué y lo tiré al bote hace una hora… ¡¿por qué?!",
          "timestamp_label": "2:31 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "Devuélveme mi abrigo. Me estoy congelando.",
          "unsent_placeholder": "Se anuló el envío de este mensaje",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "¡Oh Dios! ¡Ese lote vino de un desalojo patrimonial—un monje selló ese abrigo! ¡Sácalo afuera y quémalo antes de las 3:00 AM!",
          "timestamp_label": "2:32 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 8,
          "transcript": "[Dientes castañeteando, tela crujiendo] ...Te queda tan bien, {{player_name}}... Déjame usarlo contigo...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "El abrigo vacío colgado en tu silla levanta despacio las mangas como si unos brazos invisibles se hubieran deslizado adentro.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Arrojar abrigo por el ducto de basura",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "¡Lo estoy tirando por el ducto de la basura!",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "Sacar amuleto rojo roto del bote basura",
              "cost_type": "vip_rewarded",
              "badge_text": "Secreto · Ver Anuncio",
              "player_reply_text": "¡Agarrando el papel rojo del bote!",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "Oyes caer el abrigo cinco pisos abajo. Cuando te das la vuelta hacia tu habitación… está extendido con orden sobre tu silla otra vez, empapado.",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRETO DESBLOQUEADO: Garabateado al reverso del amuleto rojo hay un nombre y fecha de muerte… exactamente hace 49 días esta noche.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "¡No intentes tirarlo! ¡El comprador anterior lo arrojó al río y despertó usándolo abotonado hasta el cuello!",
          "timestamp_label": "2:35 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "Desconocido · Estática Helada",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "La voz temblorosa de una mujer susurra: \"Abotónalo, {{player_name}}. Hace tanto frío bajo tierra.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "Rechazas. Una huella mojada florece por dentro del espejo de tu dormitorio… oliendo intensamente a jazmín.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "Noche 49",
          "teaser_text": "Episodio 2: Las mangas se estiran hacia tus hombros conforme el reloj se acerca a las 3:00 AM.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
