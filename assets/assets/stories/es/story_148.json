          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "¡La Estación 9 fue tapiada con ladrillo hace 15 años! ¿¡Por qué chirrían los frenos!?",
