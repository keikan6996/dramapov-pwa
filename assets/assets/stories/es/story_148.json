      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "11:58 PM · Despiertas sobresaltado en el último metro traqueteante. El letrero digital arriba falla cambiando de \"Central\" a \"ESTACIÓN 9\".",
