          "type": "voice_note",
          "sender_id": "stranger",
          "duration_sec": 8,
          "transcript": "[urgente, amortiguado por sirenas] \"¡{{player_name}}! ¿¡Me escuchas!? ¡Aprieta mi mano o contesta tu celular... no te quedes en ese tren!\"",
