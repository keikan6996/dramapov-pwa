          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "¡Eso es imposible! ¡Estoy manejando sobre concreto sólido ahora mismo… y hay un sedán rojo con luces traseras adelante de mí!",
          "timestamp_label": "2:12 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "Sigue mis luces traseras. La caída se siente como volar.",
