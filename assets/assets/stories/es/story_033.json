          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}, ¡¡FRENA EL AUTO!! ¡Veo tu punto de ubicación girando hacia el Puente Viejo del Río—ese puente colapsó en 2012!",
