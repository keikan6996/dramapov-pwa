    {
      "episode_number": 1,
      "title": "Atrapada en Elevador de Servicio",
      "start_node_id": "e1_n01",
      "default_ambient": "family_drama",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "7:50 PM · Gran Hotel Obsidian. Diez minutos antes de la gala de fusión, tu cuñada Vanessa arrebata tu invitación dorada VIP y golpea el paro de emergencia del elevador de servicio.",
          "style": "banner",
          "sfx": "knock",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "sil",
          "text": "¡Quédate en ese elevador de carga, Daniela! ¡Una contadora cualquiera como tú no merece conocer al Presidente de Obsidian Group... yo usaré tu pase!",
          "timestamp_label": "07:50 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "¡Vanessa, desbloquea este elevador ahora mismo! ¡Ese pase está registrado con mi ID biométrica... y el intercomunicador de seguridad está muerto!",
          "timestamp_label": "07:50 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "chairman",
          "text": "¡Hola, compañera de medianoche! ¿Sigues viniendo a esa gala corporativa aburrida que me contaste? Tienes 1 barrita de señal... ¿todo bien?",
          "timestamp_label": "07:52 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "sil",
          "text": "¡Qué bueno que soborné al botones para trabar el elevador de servicio dos horas!",
          "unsent_placeholder": "Vanessa anuló el envío de un mensaje",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Solo queda 1 barrita de señal celular dentro del cubo de acero:",
          "options": [
            {
              "option_id": "opt_story_114_e1_free",
              "label": "Escribir a \"Número Equivocado\" piso y hotel",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "¡SOS! ¡Mi cuñada robó mi pase VIP y me encerró en el Elevador de Servicio B del Gran Obsidian!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_114_e1_vip",
              "label": "Mandarle nota de voz antes que caiga señal",
              "cost_type": "vip_rewarded",
              "badge_text": "Secreto · Ver Anuncio",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Tres puntos parpadean al instante en tu chat de \"Número Equivocado\"... seguidos de una respuesta que te corta la respiración.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "chairman",
          "text": "¡¿Gran Obsidian?! ¡¿Elevador de Servicio B?! Aguanta... estoy literalmente arriba. ¡Desbloqueando tu elevador en 30 segundos!",
          "timestamp_label": "07:52 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Tu SOS susurrado se envía justo cuando la señal cae a cero... ¡y segundos después, el altavoz de emergencia superior cruje al encenderse!",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "chairman",
          "text": "¡Aquí el Presidente Julian de Obsidian Group! ¡Ingeniería, anulen el Elevador B YA... y detengan a quien porte el pase #007!",
          "timestamp_label": "07:52 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "¡CLANC! El elevador da un tirón hacia arriba, deslizándose suave directo al vestíbulo privado del penthouse en el piso 60.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "chairman",
          "text": "Seis meses texteando a medianoche... supongo que al fin es hora de conocernos en persona, Daniela.",
          "timestamp_label": "07:55 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "El Rescate del Penthouse",
          "teaser_text": "Las puertas del elevador se abren revelando al multimillonario más poderoso de la ciudad... quien resulta ser tu compañero favorito de mensajes.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
