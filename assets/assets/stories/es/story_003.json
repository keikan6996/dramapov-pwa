          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "narrator",
          "text": "Se te cae el estómago. Pagaste esos dos boletos en primera clase a Bali con tus propios ahorros.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n08"
        },
        {
          "id": "e1_n08",
          "type": "choice",
          "prompt": "Tanto Ryan como Chloe creen que aún pueden mentir. ¿Cómo contraatacas?",
          "options": [
            {
              "option_id": "opt_cancel_tickets",
              "label": "Cancelar boletos a Bali en silencio ahora",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Claro que sí, Ryan. Acabo de mandar una actualización a tu correo.",
              "next_node_id": "e1_n09a"
            },
            {
              "option_id": "opt_vip_play_audio",
              "label": "Guardar la nota de voz para el brindis",
              "cost_type": "vip_rewarded",
              "badge_text": "VIP · Brutal",
              "player_reply_text": "Ya está arreglado, Ryan. Espera a escuchar mi brindis esta noche.",
              "next_node_id": "e1_n09b"
            }
          ]
        },
        {
          "id": "e1_n09a",
          "type": "text",
          "sender_id": "ryan",
          "text": "Espera... ¿por qué el correo de la aerolínea dice \"REEMBOLSO PROCESADO\"? ¿¿Paulina??",
          "timestamp_label": "5:45 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n09b",
          "type": "narrator",
          "text": "Exportas la nota de voz de 14 segundos de Chloe a tu nube y le escribes al DJ del banquete: \"Cambia la canción de nuestro primer baile por la Pista 1.\"",
          "style": "system_alert",
          "sfx": "photo_snap",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "chloe",
          "text": "¡Okay, ya! Ryan y yo llevamos 8 meses juntos. ¡No hagas un escándalo frente a sus padres!",
          "timestamp_label": "5:46 PM",
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n11"
        },
