          "typing_delay_ms": 850,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "unsent_message",
          "sender_id": "chloe",
          "text": "¡¡DIOS MÍO IGNORA ESO ERA UNA BROMA PARA TU DESPEDIDA DE SOLTERA!!",
          "unsent_placeholder": "Se anuló el envío de este mensaje",
          "reveal_ms": 1700,
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Qué gracioso. Mi despedida de soltera fue la semana pasada, Chloe. Y no me tiemblan las manos… a ti sí.",
          "timestamp_label": "5:41 PM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "chloe",
          "text": "¡Por favor contesta, Paulina! ¡Escuchaste mal! ¡Le hablaba a mi nuevo novio, NO a Ryan!",
          "timestamp_label": "5:42 PM",
          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "text",
          "sender_id": "ryan",
          "text": "Hola amor, favor rápido: ¿me reenvías la confirmación del vuelo a Bali? Necesito revisar nuestros números de asiento. 😘",
