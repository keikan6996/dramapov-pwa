          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "La Habitación 14 está cerrada con candado por fuera, Doctor. Veo la luz roja brillando a través del vidrio esmerilado.",
