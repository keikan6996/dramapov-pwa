          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "player",
          "text": "Qué chistoso. El Hospital St. Jude está a veinte minutos de nuestra casa, Victor. ¿Es niño o niña?",
