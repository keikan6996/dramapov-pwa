        {
          "id": "e2_n11_ans",
          "type": "narrator",
          "text": "Leo respira agitado: \"¡Salí del callejón! Revisa tu app: dejó una reseña de 5 estrellas bajo TU cuenta: Nos vemos mañana a las 3:07.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n11_dec",
          "type": "narrator",
          "text": "Rechazas y revisas tu app. Un nuevo pedido recurrente está programado automáticamente para las 3:07 AM cada noche.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n12",
