          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "incoming_call",
          "caller_id": "ally",
          "caller_label": "Leo (Repartidor)",
          "ringtone_sfx": "call_ring",
