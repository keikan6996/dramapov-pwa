    {
      "episode_number": 1,
      "title": "Pedido Que Nunca Hiciste",
      "start_node_id": "e1_n01",
      "default_ambient": "night_city",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "3:07 AM · Los truenos sacuden tu estudio del 5to piso. Suena una notificación de la app de entregas.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Oye {{player_name}}, colgué tus fideos en la reja. Dile a tu compañera de cuarto detrás de la cortina que deje de mirarme fijo, amigo.",
          "timestamp_label": "3:07 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Espera: no pedí comida esta noche. Y vivo completamente sola.",
          "timestamp_label": "3:08 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "Está abriendo el pestillo de tu balcón ahora mismo.",
          "unsent_placeholder": "Se anuló el envío de este mensaje",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "¡No juegues conmigo! El pedido está a TU nombre y pagado en efectivo… ¡dejó caer un billete arrugado desde el 5to piso!",
          "timestamp_label": "3:09 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 10,
          "transcript": "[Lluvia fuerte, moto acelerando] ...Espera, escucha la grabación de la llamada cuando confirmaste el pedido… esa SÍ es tu voz...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "La cortina delgada de tu balcón ondea hacia adentro… aunque la puerta de vidrio está cerrada.",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "Preguntar a Leo cómo es el billete",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "¿Qué clase de billete dejó caer?",
              "next_node_id": "e1_n08_free"
            },
            {
              "option_id": "e1_opt_vip",
              "label": "Reproducir audio completo de confirmación",
              "cost_type": "vip_rewarded",
              "badge_text": "Secreto · Ver Anuncio",
              "player_reply_text": "¡Mándame el archivo de audio completo!",
              "next_node_id": "e1_n08_vip"
            }
          ]
        },
        {
          "id": "e1_n08_free",
          "type": "narrator",
          "text": "Leo responde temblando: \"No es dinero real, {{player_name}}... Es papel moneda fúnebre del inframundo. Quemado en la esquina.\"",
          "style": "banner",
          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n08_vip",
          "type": "narrator",
          "text": "SECRETO DESBLOQUEADO: Debajo de tu propia voz adormilada pidiendo fideos, una segunda voz susurra: \"Dos tazones. Uno para los vivos.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "text",
          "sender_id": "ally",
          "text": "Hermano, ya me voy manejando, buena suerte—espera, ¡¿por qué ya NO está la bolsa de plástico en tu reja?!",
          "timestamp_label": "3:11 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "incoming_call",
          "caller_id": "threat",
          "caller_label": "Llamada Automática de Entrega",
          "ringtone_sfx": "call_ring",
          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e1_n11_ans",
          "on_decline_node_id": "e1_n11_dec"
        },
        {
          "id": "e1_n11_ans",
          "type": "narrator",
          "text": "Una voz metálica recita: \"Tu pedido ha sido recibido... dentro de tu cocina.\" Una cuchara tintinea en la habitación contigua.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "Cuelgas. De inmediato, el olor a caldo frío e incienso húmedo se filtra bajo la puerta de tu habitación.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12"
        },
        {
          "id": "e1_n12",
          "type": "cliffhanger",
          "headline": "Cena Para Dos",
          "teaser_text": "Episodio 2: Dos tazones humeantes descansan sobre tu mesa… y una silla está jalada hacia afuera.",
          "sfx": "gasp",
          "ambient": "suspense",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
    {
      "episode_number": 2,
      "title": "Dos Pares de Palillos",
      "start_node_id": "e2_n01",
      "default_ambient": "cyber_pulse",
      "nodes": [
        {
          "id": "e2_n01",
          "type": "narrator",
          "text": "3:13 AM · Entornas la puerta de tu habitación. El vapor sube de dos tazones sobre tu mesita. Un par de palillos está clavado en vertical.",
          "style": "time_skip",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n02"
        },
        {
          "id": "e2_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "¡{{player_name}}! Mi GPS no me deja salir de tu callejón. ¡Cada vuelta me trae directo debajo de tu balcón!",
          "timestamp_label": "3:13 AM",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n03"
        },
        {
          "id": "e2_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Leo, hay dos tazones en mi cocina. ¡Los palillos están parados derechos como una ofrenda!",
          "timestamp_label": "3:14 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e2_n04"
        },
        {
          "id": "e2_n04",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 7,
          "transcript": "[Sorbiendo caldo, goteo de agua] ...Come mientras está caliente, {{player_name}}. No seas grosera con una invitada...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n05"
        },
        {
