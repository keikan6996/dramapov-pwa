        {
          "id": "e2_n06",
          "type": "text",
          "sender_id": "ally",
          "text": "¡Acabo de recordar esta calle! Una chica murió de hambre encerrada en un cuarto del 5to piso aquí hace cinco años. ¡NO toques la comida!",
          "timestamp_label": "3:16 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n07"
        },
        {
          "id": "e2_n07",
          "type": "choice",
          "prompt": "La silla raspa lentamente sobre las losetas del piso cuando ella empieza a voltear.",
          "options": [
            {
              "option_id": "e2_opt_free",
              "label": "Tirar el tazón de ofrenda de la mesa",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "¡Voy a voltear la mesa!",
              "next_node_id": "e2_n08_free"
            },
            {
              "option_id": "e2_opt_vip",
              "label": "Inclinarte con respeto y ofrecer el tazón",
              "cost_type": "vip_rewarded",
              "badge_text": "Secreto · Ver Anuncio",
              "player_reply_text": "Hago una reverencia y retrocedo...",
              "next_node_id": "e2_n08_vip"
