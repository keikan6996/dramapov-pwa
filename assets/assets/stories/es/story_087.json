          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "unsent_message",
          "sender_id": "vance",
          "text": "Objetivo confirmado en 412 Cedar Lane. Luz del porche apagada. Entrando.",
