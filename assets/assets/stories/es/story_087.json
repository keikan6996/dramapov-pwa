              "player_reply_text": "Salgo por la puerta del sótano—¡rumbo al camino del puerto!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_087_e1_vip",
              "label": "Deja el teléfono cifrado de señuelo",
              "cost_type": "vip_rewarded",
              "badge_text": "Secreto · Ver Anuncio",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Gateas entre los pinos mojados justo cuando dos disparos con silenciador destrozan la ventana de tu cocina. Tu teléfono vibra... GPS aún transmitiendo.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "cleanup",
          "text": "Gracias por dejar encendido el teléfono del Marshal, {{player_name}}. Puedo verte yendo al este hacia el muelle.",
