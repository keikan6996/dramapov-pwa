          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "¡¿Vance?! ¡Acabo de ver ese mensaje antes de que lo anularas! ¡¿A quién le estás mandando mi dirección?!",
