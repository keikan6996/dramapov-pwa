          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Lanzas el teléfono USMS a la caja de una camioneta repartidora que pasa y cambias a tu SIM prepago oculta. Dos sedanes negros persiguen de inmediato la camioneta.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "vance",
          "text": "¡Señuelo brillante! ¡Encuéntrame en el estacionamiento del viejo faro en 10 minutos—ven sola!",
          "timestamp_label": "11:58 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "voice_note",
          "sender_id": "cleanup",
          "duration_sec": 7,
          "transcript": "[lluvia, radio apagada] \"Dile a la testigo que no confíe en Vance. ¿Quién crees que nos vendió el expediente de 412 Cedar Lane por medio millón?\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "player",
          "text": "Espera... si Vance realmente me vendió, ¡entonces caminar al faro es caminar hacia una tumba!",
          "timestamp_label": "11:59 PM",
          "typing_delay_ms": 0,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n11_cliff"
        },
        {
          "id": "e1_n11_cliff",
          "type": "cliffhanger",
          "headline": "¿Quién Vendió el Expediente?",
          "teaser_text": "Tu agente espera en el faro... y el sicario jura que Vance es quien cobró por tu sentencia de muerte.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
      ]
    },
