          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "vance",
          "text": "¡Mantén la calma, {{player_name}}! ¡Clonaron mi teléfono en la oficina de campo de Portland—NO estoy afuera de tu casa! ¡Agarra tu maleta de emergencia y corre!",
          "timestamp_label": "11:56 PM",
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "cleanup",
          "typing_delay_ms": 800,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n06_choice",
          "text": "Lindo corte de pelo nuevo, {{player_name}}. El cártel manda saludos."
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Grava cruje afuera de tu cerca trasera. Muévete rápido:",
