      "title": "Asiento 1A",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "9:00 PM · Vuelo 001 de SkyCrown Airlines. Agotada tras inspeccionar tu nuevo hangar de jets, abordas el Asiento 1A en sudadera gris gastada... cuando Amber azota su bolso de diseñador en tu descansabrazos.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "amber",
          "text": "¡Disculpa, chica de sudadera de segunda mano... vete a Económica! ¡Mi novio Kevin es ejecutivo de SkyCrown Aviation y quiero el Asiento 1A!",
          "timestamp_label": "09:00 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "¿Ejecutivo de SkyCrown Aviation? Curioso... conozco a cada VP de nuestra empresa y nunca he visto a ningún Kevin.",
          "timestamp_label": "09:00 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "kevin",
          "text": "¡Cuida tu tono! ¡Pagué $14,000 con mi tarjeta negra corporativa por este vuelo! ¡Sobrecargo... baje a esta chica de sudadera antes de que llame a la Junta!",
          "timestamp_label": "09:02 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "kevin",
          "text": "Qué bueno que mi gerente dejó su tarjeta corporativa de viaje en el cajón de compras mientras está en Tokio...",
          "unsent_placeholder": "Kevin anuló el envío de un mensaje",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Amber te jala la manga de la sudadera para sacarte del 1A:",
          "options": [
            {
              "option_id": "opt_story_116_e1_free",
              "label": "Tocar con calma el timbre directo a cabina",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "No me toques... y no te molestes en llamar a la Junta. Preguntemos al Capitán.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_116_e1_vip",
              "label": "Escanear la tarjeta de Kevin en tu tableta",
              "cost_type": "vip_rewarded",
              "badge_text": "Secreto · Ver Anuncio",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Tocas dos veces el timbre oculto de Presidencia. La puerta de la cabina se desbloquea al instante.",
