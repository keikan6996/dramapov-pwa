          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "amber",
          "text": "¡Jaja! ¡¿Crees que el Capitán se pondrá del lado de una don nadie en sudadera sobre un ejecutivo?!",
          "timestamp_label": "09:02 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Tu app de Tesorería SkyCrown parpadea en rojo: Kevin no es ejecutivo... ¡es Auxiliar Júnior de Compras usando la tarjeta ROBADA de su jefe!",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "captain",
          "text": "¡Presidenta Julieta, confirmado! ¡Esa tarjeta corporativa fue reportada robada hace 20 minutos desde Tokio!",
