          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "¡¡Ariel!! ¡¿Estás viendo esto?! ¡¿Quién entró a la cuenta de Hannah?!",
