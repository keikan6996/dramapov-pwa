      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "3:00 AM · Chat Grupal de la Residencia. Una burbuja gris aparece bajo un nombre que nadie se atrevió a eliminar: \"Hannah está escribiendo...\"",
