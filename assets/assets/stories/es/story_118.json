          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "¡Tu hijo pagó CERO dólares por este penthouse, Martha! ¡Está registrado al 100% a nombre de mi empresa tenedora de soltera!",
