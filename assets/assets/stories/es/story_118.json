        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "mil",
          "text": "¡Tonterías! ¡Ya firmé el traspaso a nombre de mi hijo esta tarde! ¡Estás allanando... voy a llamar a seguridad del edificio!",
