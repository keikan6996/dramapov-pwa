    {
      "episode_number": 1,
      "title": "La Compensación de $10,000",
      "start_node_id": "e1_n01",
      "default_ambient": "luxury_lounge",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "6:00 PM · Ala VIP del Hospital Privado St. Jude. El mismo día en que Nathan da sus primeros pasos sin ayuda tras tus tres años de neurorrehabilitación secreta, deja un cheque de $10,000 sobre tu regazo.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "nathan",
          "text": "Toma los $10,000 y firma el divorcio, Julieta. Fiona volvió del extranjero... ¡ella es quien pagó en secreto a mi cirujana milagrosa!",
          "timestamp_label": "06:00 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "¡¿Fiona te dijo que ELLA pagó a la neurocirujana milagrosa?! Nathan, mírame las manos... ¡te di masaje en las piernas cada noche durante tres años!",
          "timestamp_label": "06:00 PM",
          "typing_delay_ms": 0,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "fiona",
          "text": "Ay, cualquier cuidadora puede frotar piernas, Julieta. ¡Solo yo tenía los contactos para llegar a la Presidenta anónima del Grupo Médico St. Jude!",
          "timestamp_label": "06:02 PM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "fiona",
          "text": "Menos mal que Nathan jamás revisó la cámara del tablero de la noche en que quedó paralizado...",
          "unsent_placeholder": "Fiona anuló el envío de un mensaje",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Nathan rodea la cintura de Fiona y sonríe con sorna:",
          "options": [
            {
              "option_id": "opt_story_109_e1_free",
              "label": "Firmar el divorcio y romper el cheque de $10K",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "Quédate tus $10,000. Los vas a necesitar para tu próxima factura médica.",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_story_109_e1_vip",
              "label": "Pedir al Dr. Ken sacar el choque de hace 3 años",
              "cost_type": "vip_rewarded",
              "badge_text": "Secreto · Ver Anuncio",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Firmas con soltura, partes el cheque por la mitad y dejas caer los pedazos sobre los zapatos de diseñador de Nathan.",
          "style": "banner",
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "nathan",
          "text": "¡Como quieras! ¡Mañana le agradeceré en persona a la Presidenta de St. Jude... con Fiona como mi prometida!",
          "timestamp_label": "06:02 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Envías un mensaje cifrado al Director del Hospital, Dr. Ken. En segundos, un archivo encriptado suena en tu teléfono.",
          "style": "system_alert",
          "sfx": "knock",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "director",
          "text": "¡Presidenta Julieta, saqué el ingreso de Urgencias de hace 3 años... el auto que huyó coincide con la placa registrada de Fiona!!",
          "timestamp_label": "06:02 PM",
          "typing_delay_ms": 650,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "narrator",
          "text": "Al salir del cuarto VIP, el Dr. Ken corre por el pasillo e inclina la cabeza en una profunda reverencia... justo donde Nathan aún no puede ver.",
          "style": "system_alert",
          "sfx": "heartbeat",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "director",
          "text": "Presidenta Julieta, la dosis final estabilizadora de nervios para Nathan está programada para mañana. ¿Cancelamos su exención benéfica VIP?",
