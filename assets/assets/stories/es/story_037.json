          "ring_duration_ms": 12000,
          "can_decline": true,
          "on_answer_node_id": "e2_n11_ans",
          "on_decline_node_id": "e2_n11_dec"
        },
        {
          "id": "e2_n11_ans",
          "type": "narrator",
          "text": "Owen exhala: \"¡Voy entrando a la entrada de grava! Espera… ¿el cuadro está sonriendo ahora? Antes se veía tan triste.\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n11_dec",
          "type": "narrator",
          "text": "Miras hacia el retrato una última vez: la horquilla de jade ahora aparece pintada prolijamente en su cabello.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n12",
