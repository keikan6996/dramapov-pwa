            },
            {
              "option_id": "opt_story_113_e1_vip",
              "label": "Mostrarles la escritura de compra del bistró",
              "cost_type": "vip_rewarded",
              "badge_text": "Secreto · Ver Anuncio",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
