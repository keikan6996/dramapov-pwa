          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "unsent_message",
          "sender_id": "stella",
          "text": "¡¿Cómo diablos sabe una mesera sobre nuestra deuda de fábrica?! ¡Cállala, Damon!",
          "unsent_placeholder": "Stella anuló el envío de un mensaje",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "unsent",
          "haptic": "medium",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "Damon chasquea los dedos con fuerza para llamar al gerente:",
          "options": [
            {
              "option_id": "opt_story_113_e1_free",
              "label": "Sonreír y llamar tú misma al Chef Henri",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "No hace falta gritar, Damon. Preguntemos al gerente de quién es la Mesa 1.",
