    {
      "episode_number": 1,
      "title": "Mesa Para Dos",
      "start_node_id": "e1_n01",
      "default_ambient": "piano_melancholy",
      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "7:30 PM · Bistró Le Jardin. Llevando delantal para ayudar a tu mentor el Chef Henri en su última noche ocupada antes de jubilarse, reconoces la risa arrogante en la Mesa 1.",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "brad_ex",
          "text": "¡Vaya, vaya! ¡Mira quién sigue sirviendo mesas, {{player_name}}! ¡Qué bueno que te dejé el año pasado... el papá de Stella tiene tres fábricas textiles!",
          "timestamp_label": "07:30 PM",
          "typing_delay_ms": 650,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "stella",
          "text": "Puaj, Damon, ¿ella es tu ex sin dinero? ¡Sirve nuestro champán de $2,000 de rodillas y te dejo cien dólares de propina!",
          "timestamp_label": "07:30 PM",
          "typing_delay_ms": 600,
          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "Cuidado con cómo gastas, Stella. Según supe, las fábricas textiles de tu padre llevan 60 días vencidas en un pagaré de $6 millones.",
