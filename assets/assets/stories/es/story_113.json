          "sfx": "ting_soft",
          "haptic": "light",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "chef",
          "text": "¿Todo bien, Jefa {{player_name}}? ¿Cancelo la reservación de la Mesa 1?",
