      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "1:17 AM · El Elevador 04 se detiene con sacudida violenta entre los pisos 38 y 39. Parpadean LEDs rojos de emergencia.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "¡Devon! Estoy atrapado en el Elevador 04. ¡El botón de llamada de emergencia está muerto!",
          "timestamp_label": "1:17 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "devon",
          "text": "Aguanta ahí, {{player_name}}. Revisando el registro eléctrico... Raro. Solo el Cubo 04 perdió energía, y mi terminal de gafetes dice que nadie más está en la torre.",
          "timestamp_label": "1:18 AM",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "devon",
          "duration_sec": 6,
          "transcript": "[estática, teclado sonando] Espera—el sensor de peso del Elevador 04 acaba de subir 180 libras. ¿Tiraste una caja ahí adentro?!",
