              "option_id": "opt_082_e1_vip",
              "label": "Fuerza el pestillo manual de la puerta",
              "cost_type": "vip_rewarded",
              "badge_text": "Secreto · Ver Anuncio",
              "player_reply_text": null,
              "next_node_id": "e1_n07_vip"
            }
          ]
        },
        {
          "id": "e1_n07_free",
          "type": "narrator",
          "text": "Te pegaste al rincón debajo del domo de seguridad. Pernos metálicos giran sueltos sobre tu cabeza... uno cae y suena a tus pies.",
          "style": "banner",
          "sfx": "lock_click",
          "haptic": "medium",
          "next_node_id": "e1_n08_free"
        },
        {
          "id": "e1_n08_free",
          "type": "text",
          "sender_id": "devon",
          "text": "Ay dios—¡lo veo en la cámara térmica del cubo! Trae una llave inglesa y un juego de cinchos. ¡Llamo al 911!",
          "timestamp_label": "1:20 AM",
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n07_vip",
          "type": "narrator",
          "text": "Fuerzas la puerta interior tres pulgadas. Una pared de concreto bloquea la mitad superior, pero el pasillo oscuro del Piso 38 queda justo bajo tus rodillas.",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n08_vip"
        },
        {
          "id": "e1_n08_vip",
          "type": "text",
          "sender_id": "devon",
          "text": "¡NO salgas gateando todavía! Si suelta el freno desde el techo, ¡la cabina te partirá a la mitad!",
          "timestamp_label": "1:20 AM",
          "typing_delay_ms": 600,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n09_merge"
        },
        {
          "id": "e1_n09_merge",
          "type": "unsent_message",
          "sender_id": "hatch",
          "text": "Entrega el disco de auditoría por la escotilla, {{player_name}}, y no corto el cable principal.",
          "unsent_placeholder": "Mensaje eliminado por el remitente",
          "reveal_ms": 1700,
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "heavy",
          "next_node_id": "e1_n10"
        },
        {
          "id": "e1_n10",
          "type": "text",
          "sender_id": "player",
          "text": "¿Cómo consiguió mi número de teléfono?! ¡Nadie sabe que llevo el disco de denunciante esta noche!",
          "timestamp_label": "1:21 AM",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n11"
        },
        {
          "id": "e1_n11",
          "type": "text",
          "sender_id": "devon",
          "text": "Espera... alguien acaba de anular mi escritorio de seguridad desde ADENTRO del vestíbulo. Mi pantalla se puso negra.",
          "timestamp_label": "1:21 AM",
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n12_cliff"
        },
        {
          "id": "e1_n12_cliff",
          "type": "cliffhanger",
          "headline": "Se Suelta el Freno",
          "teaser_text": "Los cables de acero gimen arriba. El Elevador 04 cae dos metros... y la escotilla del techo se desliza abierta.",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_episode_number": 2
        }
