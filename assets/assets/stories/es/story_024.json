          "can_decline": true,
          "on_answer_node_id": "e2_n11_ans",
          "on_decline_node_id": "e2_n11_dec"
        },
        {
          "id": "e2_n11_ans",
          "type": "narrator",
          "text": "Sam jadea: \"¡Gracias a Dios estás viva! Espera… ¿por qué hay una huella de mano de hollín en la espalda de tu abrigo?\"",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n11_dec",
          "type": "narrator",
          "text": "Bajas al andén iluminado… y notas que el fondo de pantalla de tu teléfono cambió a una foto de la Estación Ashwood.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n12"
        },
        {
          "id": "e2_n12",
          "type": "cliffhanger",
