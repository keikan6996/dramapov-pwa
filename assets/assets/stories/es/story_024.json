          "typing_delay_ms": 750,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e4_n05"
        },
        {
          "id": "e4_n05",
          "type": "narrator",
          "text": "El tren chirría hasta detenerse junto a una escalera de acero oxidada marcada \"CAJA INTERRUPTOR 4.\"",
