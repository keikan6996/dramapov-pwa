          "sfx": "gasp",
          "haptic": "medium",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n08_vip",
          "type": "narrator",
          "text": "SECRETO DESBLOQUEADO: El papel se vuelve ceniza tibia en tus dedos. El conductor hace una reverencia, y las luces fluorescentes vuelven al blanco brillante.",
          "style": "system_alert",
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e2_n09_merge"
        },
        {
          "id": "e2_n09_merge",
          "type": "narrator",
          "text": "Un letrero luminoso pasa veloz: ESTACIÓN CENTRAL. Te incorporas de golpe: el vagón está vacío y limpio.",
          "style": "system_alert",
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e2_n10"
        },
        {
          "id": "e2_n10",
          "type": "incoming_call",
          "caller_id": "ally",
