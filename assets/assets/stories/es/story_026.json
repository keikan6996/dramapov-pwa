          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Demasiado tarde, estoy parada justo frente a él doblando camisas. Espera: mi reflejo no parpadeó cuando yo parpadeé.",
