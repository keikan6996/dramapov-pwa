          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "Demasiado tarde, ¡ya bebí medio vaso antes de ver el color! ¡¿Qué hay dentro del tanque?!",
