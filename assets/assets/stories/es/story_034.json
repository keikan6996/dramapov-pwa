          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "Gael, acabo de subir a revisar la cisterna de la azotea. ¡NO bebas ni te laves los dientes con el agua esta noche!",
