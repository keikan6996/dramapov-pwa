          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}} ผมเพิ่งปีนขึ้นไปตรวจถังเก็บน้ำบนดาดฟ้า ห้ามดื่มหรือแปรงฟันด้วยน้ำประปาคืนนี้เด็ดขาดนะครับ!",
