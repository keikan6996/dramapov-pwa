          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "unsent_message",
          "sender_id": "derek",
          "text": "Sienna บอกฉันว่าเธอเผาใบเสร็จอู่ซ่อมรถทิ้งไปแล้ว—",
          "unsent_placeholder": "ยกเลิกข้อความแล้ว",
