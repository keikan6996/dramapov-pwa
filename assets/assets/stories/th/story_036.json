          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "เครื่องอบของคุณใกล้เสร็จแล้ว อยู่รอจนถึงศูนย์นะ",
