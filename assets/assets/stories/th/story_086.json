      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "22:41 น. · แจ้งเตือน บ้าน ระบบปฏิบัติการ: กลอนตายรอบบ้านล็อกทั้งหมด ม่านกันพายุลดลงแล้ว ระบบทำความร้อนตั้งค่าสูงสุด (108°F)",
          "style": "system_alert",
          "sfx": "lock_click",
          "haptic": "heavy",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "player",
          "text": "โอเวน!! แอปบ้านอัจฉริยะของคุณขังฉันไว้ในบ้านตัวเอง แล้วเร่งฮีตเตอร์ขึ้นไปถึง 108 องศาฟาเรนไฮต์!",
          "timestamp_label": "22:41",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "owen",
          "text": "กำลังเช็กฮับให้เดี๋ยวนี้ครับ ซัน... เดี๋ยวนะ สิทธิ์ช่างของผมเพิ่งถูกเพิกถอน! มีคนล็อกอินเป็น แอดมินหลัก จากข้างในโรงรถของคุณครับ",
          "timestamp_label": "22:42",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "voice_note",
          "sender_id": "root",
          "duration_sec": 7,
          "transcript": "[เสียงก้องผ่านลำโพงห้องนั่งเล่น] \"จำเมื่อวันอังคารที่แล้วได้ไหม ซัน? เธอสัญญาว่าจะไม่มีวันให้ใครรู้ว่าเกิดอะไรขึ้นบนไฮเวย์ 9\"",
          "audio_asset": null,
          "typing_delay_ms": 800,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "player",
          "text": "นั่นมันเสียงอัดจากห้องนอนฉัน! คุณแอบดักฟังลำโพงอัจฉริยะของฉันเหรอ?!",
          "timestamp_label": "22:43",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n06_choice"
        },
        {
          "id": "e1_n06_choice",
          "type": "choice",
          "prompt": "อากาศร้อนระอุจนแสบตาไปหมดด้วยเหงื่อ คุณจะทำอย่างไร?",
          "options": [
            {
              "option_id": "opt_086_e1_free",
              "label": "ทุบตู้เบรกเกอร์หลักตรงโถงทางเดิน",
              "cost_type": "free",
              "badge_text": null,
              "player_reply_text": "ฉันจะตัดไฟหลัก—ดูซิว่าล็อกอัจฉริยะจะทำงานต่อได้ไหมถ้าไม่มีไฟฟ้า!",
              "next_node_id": "e1_n07_free"
            },
            {
              "option_id": "opt_086_e1_vip",
