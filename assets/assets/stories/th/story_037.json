            {
              "option_id": "e1_opt_vip",
              "label": "ส่องไฟฉายไปด้านหลังกรอบรูป",
              "cost_type": "vip_rewarded",
              "badge_text": "ความลับ · ดูโฆษณา",
              "player_reply_text": "กำลังเช็กด้านหลังผืนผ้าใบ...",
              "next_node_id": "e1_n08_vip"
