        {
          "id": "e1_n11_dec",
          "type": "narrator",
          "text": "คุณกดปฏิเสธ ทันใดนั้นประตูห้องฝั่งตะวันออกก็เหวี่ยงปิดเอง ทิ้งให้คุณอยู่ตามลำพังกับผ้าใบว่างเปล่า",
          "style": "system_alert",
