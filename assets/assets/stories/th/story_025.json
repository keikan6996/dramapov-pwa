          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}}!! แกเห็นนี่ไหม?! ใครเข้าบัญชีของ แฮนนาห์ ได้วะ?!",
