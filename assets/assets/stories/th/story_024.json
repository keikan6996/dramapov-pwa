      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "02:19 น. · ขบวนรถไฟใต้ดินโคลงเคลงฝ่าอุโมงค์มืดอันไร้ที่สิ้นสุด ผู้โดยสารคนอื่นทุกคนนั่งนิ่งไม่ไหวติงและหลับตาสนิท",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "ally",
          "text": "{{player_name}} อยู่ไหนแล้ว? ฉันรออยู่ที่สถานีกลาง—รปภ. บอกว่าสาย 4 ปิดให้บริการไปตั้งแต่สองชั่วโมงก่อนแล้วนะ",
          "timestamp_label": "02:19",
          "typing_delay_ms": 600,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n03"
        },
        {
          "id": "e1_n03",
          "type": "text",
          "sender_id": "player",
          "text": "อะไรนะ?! ตอนนี้ฉันนั่งอยู่บนรถไฟสาย 4 จริงๆ นะ ป้ายไฟ LED เพิ่งเปลี่ยนเป็นคำว่า \"สถานี Ashwood\"",
          "timestamp_label": "02:20",
          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "ห้ามลืมตาขึ้นมาตอนประตูกำลังแยกออกเด็ดขาด",
          "unsent_placeholder": "ยกเลิกข้อความแล้ว",
          "reveal_ms": 1800,
          "typing_delay_ms": 700,
          "sfx": "gasp",
          "ambient": "heartbeat",
          "haptic": "medium",
          "next_node_id": "e1_n05"
        },
        {
          "id": "e1_n05",
          "type": "text",
          "sender_id": "ally",
          "text": "สถานี Ashwood ไฟไหม้พังตั้งแต่ปี 1998 แล้ว!! เขาปิดตายอุโมงค์นั้นไปแล้ว! {{player_name}} ดึงเบรกฉุกเฉินเดี๋ยวนี้!",
          "timestamp_label": "02:21",
          "typing_delay_ms": 700,
          "sfx": "ting",
          "haptic": "medium",
          "next_node_id": "e1_n06"
        },
        {
          "id": "e1_n06",
          "type": "voice_note",
          "sender_id": "threat",
          "duration_sec": 9,
          "transcript": "[เสียงรางเหล็กเสียดสีดังลั่น เสียงกระซิบประสาน] ...ขึ้นรถมุ่งหน้าสู่ปี 1998 ให้ครบ... กรุณาตรวจตั๋วด้วยครับ {{player_name}}...",
          "audio_asset": null,
          "typing_delay_ms": 900,
          "sfx": "gasp",
          "haptic": "heavy",
          "next_node_id": "e1_n07"
        },
        {
          "id": "e1_n07",
          "type": "choice",
          "prompt": "ผู้โดยสารทุกคนลืมตาขึ้นพร้อมกัน—แล้วหันศีรษะมาจ้องทางที่นั่งของคุณทั้งหมด",
          "options": [
            {
              "option_id": "e1_opt_free",
              "label": "วิ่งหนีทะลุไปยังตู้โดยสารถัดไป",
