          "typing_delay_ms": 0,
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "narrator",
          "text": "อ่านแล้ว 01:15 น. · ชื่อผู้ติดต่อ: \"ดี. ครอส — นักลงทุน\"",
