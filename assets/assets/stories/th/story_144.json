        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "husband",
          "text": "เฮ้ {{player_name}} ผมติดงานดึกที่ออฟฟิศนะ คุณกินยานอนหลับไปหรือยังครับ",
