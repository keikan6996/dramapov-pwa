          "haptic": "light",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "unsent_message",
          "sender_id": "threat",
          "text": "มันไม่ใช่คนหรอก และมันเกลียดแสงหน้าจอสว่างๆ ด้วย",
