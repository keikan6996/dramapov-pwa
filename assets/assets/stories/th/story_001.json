      "nodes": [
        {
          "id": "e1_n01",
          "type": "narrator",
          "text": "09:15 น. · ห้องแต่งตัวเจ้าสาว ผ้าคลุมหน้าเพิ่งติดเข็มกลัดเสร็จตอนที่ข้อความส่วนตัวเด้งสว่างขึ้นบนมือถือคุณ",
          "style": "banner",
          "sfx": "ting",
          "haptic": "light",
          "next_node_id": "e1_n02"
        },
        {
          "id": "e1_n02",
          "type": "text",
          "sender_id": "liam",
          "text": "ทอฝัน ได้โปรดอย่าเพิ่งเดินเข้าห้องบอลรูมนะ อ่านสิ่งที่ จูเลียน ปิดบังคุณไว้ก่อน",
