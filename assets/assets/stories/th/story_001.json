          "typing_delay_ms": 800,
          "sfx": "photo_snap",
          "haptic": "medium",
          "next_node_id": "e1_n04"
        },
        {
          "id": "e1_n04",
          "type": "text",
          "sender_id": "player",
          "text": "นี่ต้องเป็นของปลอมแน่ๆ ทำไม จูเลียน ถึงจะได้เงินถ้าหย่ากับฉันล่ะ?!",
